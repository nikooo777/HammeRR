import { Theme } from "theme.slint";
import {Button, CheckBox, ComboBox, LineEdit, ListView} from "widgets.slint";

export struct ShortcutRow { command: string, label: string, current: string, factory: string }

export component ShortcutsWindow inherits Window {
    background: Theme.panel;
    title: "Keyboard shortcuts - HammeRR";
    preferred-width: 820px;
    preferred-height: 900px;
    min-width: 760px;
    min-height: 850px;
    in property <[ShortcutRow]> commands;
    in property <[string]> keys;
    in property <string> selected;
    in property <string> selected-label;
    in-out property <int> primary-key;
    in-out property <bool> primary-control;
    in-out property <bool> primary-shift;
    in-out property <int> alternate-key;
    in-out property <bool> alternate-control;
    in-out property <bool> alternate-shift;
    in property <string> status;
    in property <string> storage;
    in property <string> message;
    in property <bool> can-save;
    in-out property <string> search;
    in property <string> result-count;
    in property <string> search-error;
    in property <bool> has-matches: true;
    callback filter-commands();
    callback choose(string);
    callback edited();
    callback save();
    callback reload();
    callback reset();
    callback cancel();
    forward-focus: focus;
    focus := FocusScope {
        key-pressed(event) => { if event.text == Key.Escape { root.cancel(); accept } else { reject } }
        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text {text:"Keyboard shortcuts";font-size:24px;font-weight:600;}
            Text {text:"These commands run while the viewport has keyboard focus. Text fields keep their normal editing shortcuts. Save shortcuts applies your changes now and at startup.";wrap:word-wrap;color:Theme.text-muted;}
            HorizontalLayout {
                spacing: 8px;
                LineEdit { text <=> root.search; placeholder-text: "Label, command ID or binding"; accessible-label: "Search commands"; horizontal-stretch: 1; edited => { root.filter-commands(); } }
                Button { text: "Clear search"; enabled: root.search != ""; clicked => { root.search = ""; root.filter-commands(); } }
                Text { text: root.result-count; vertical-alignment: center; }
            }
            if root.search-error != "": Text { text: root.search-error; color: Theme.warning; wrap: word-wrap; }
            HorizontalLayout {
                Text {text:"Command";width:180px;font-weight:600;}
                Text {text:"Current form";horizontal-stretch:1;font-weight:600;}
                Text {text:"Factory bindings";width:240px;font-weight:600;}
            }
            commands-list := ListView {
                height: root.search-error == "" ? 330px : 300px;
                for row in root.commands: Rectangle {
                    height: max(34px, row-layout.min-height);
                    background: root.selected == row.command ? Theme.selection : Theme.hover;
                    row-layout := HorizontalLayout {
                        spacing:8px;padding:4px;
                        Button {text:row.label;width:176px;clicked=>{root.choose(row.command);}}
                        Text {text:row.current;horizontal-stretch:1;vertical-alignment:center;}
                        Text {text:row.factory;width:232px;vertical-alignment:center;color:Theme.text-muted;}
                    }
                }
            }
            Text {text:root.has-matches ? root.selected-label : "No commands match; existing edits are retained";font-weight:600;}
            HorizontalLayout {
                spacing:12px;
                Text {text:"Primary";width:86px;vertical-alignment:center;}
                ComboBox {enabled:root.has-matches;model:root.keys;current-index <=> root.primary-key;accessible-label:"Primary shortcut key";selected=>{root.edited();}}
                CheckBox {enabled:root.has-matches;text:"Ctrl";checked <=> root.primary-control;toggled=>{root.edited();}}
                CheckBox {enabled:root.has-matches;text:"Shift";checked <=> root.primary-shift;toggled=>{root.edited();}}
            }
            HorizontalLayout {
                spacing:12px;
                Text {text:"Alternate";width:86px;vertical-alignment:center;}
                ComboBox {enabled:root.has-matches;model:root.keys;current-index <=> root.alternate-key;accessible-label:"Alternate shortcut key";selected=>{root.edited();}}
                CheckBox {enabled:root.has-matches;text:"Ctrl";checked <=> root.alternate-control;toggled=>{root.edited();}}
                CheckBox {enabled:root.has-matches;text:"Shift";checked <=> root.alternate-shift;toggled=>{root.edited();}}
            }
            Text {text:"Choose Unbound to remove a slot. Chords use logical keys with exact Ctrl and Shift; Alt and Meta bindings are unavailable. Duplicate chords must be changed together before Save.";wrap:word-wrap;color:Theme.text-muted;}
            Text {text:"Reserved: Escape, arrows, PageUp/PageDown, camera W/A/S/D/Q/E with or without Shift, and Ctrl+N/O/S/C/X/V. Camera movement, nudging, file and clipboard controls keep their existing bindings.";wrap:word-wrap;color:Theme.text-muted;}
            Text {text:root.storage;wrap:word-wrap;color:Theme.text-muted;}
            Text {text:root.status;wrap:word-wrap;color:Theme.warning;}
            Rectangle {vertical-stretch:1;}
            Text {text:root.message;wrap:word-wrap;min-height:36px;}
            HorizontalLayout {
                spacing:12px;
                Button {text:"Reload saved";clicked=>{root.reload();}}
                Button {text:"Reset saved shortcuts";clicked=>{root.reset();}}
                Rectangle {horizontal-stretch:1;}
                Button {text:"Cancel";clicked=>{root.cancel();}}
                Button {text:"Save shortcuts";enabled:root.can-save;clicked=>{root.save();}}
            }
        }
    }
}
