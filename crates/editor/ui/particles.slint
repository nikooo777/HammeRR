import {Button, ComboBox, LineEdit, ListView, ScrollView} from "std-widgets.slint";

export struct ParticleChoiceRow {name:string,detail:string}

export component ParticleBrowserWindow inherits Window {
    title:"Choose particle effect";
    preferred-width:1000px;preferred-height:720px;
    in-out property <string> query;
    in property <[string]> groups;
    in-out property <int> group-index;
    in property <[ParticleChoiceRow]> rows;
    in property <string> page-info;
    in property <bool> can-previous;
    in property <bool> can-next;
    in property <string> value;
    in property <string> target;
    in property <string> details;
    in property <bool> can-apply;
    in property <string> message;
    callback search();callback group-changed();callback page(int);callback choose(string);
    callback reload();callback apply();callback cancel();
    forward-focus:dialog-focus;
    dialog-focus:=FocusScope {
        key-pressed(event)=>{if event.text==Key.Escape{root.cancel();accept}else{reject}}
        VerticalLayout {
            padding:20px;spacing:12px;
            Text {text:"Choose a particle effect";font-size:23px;font-weight:600;}
            Text {text:root.target;color:#b6c0ce;}
            HorizontalLayout {
                spacing:10px;
                LineEdit {text<=>root.query;placeholder-text:"Search system names, particle files or materials";horizontal-stretch:1;edited=>{root.search();}}
                ComboBox {width:330px;model:root.groups;current-index<=>root.group-index;selected=>{root.group-changed();}}
            }
            HorizontalLayout {
                spacing:16px;vertical-stretch:1;
                VerticalLayout {
                    horizontal-stretch:1;spacing:10px;
                    ListView {
                        for row in root.rows:Rectangle {
                            height:64px;background:row.name==root.value ? #343c4a : (touch.has-hover ? #282f3b : #20252e);border-radius:5px;
                            VerticalLayout {
                                padding:8px;spacing:4px;
                                Text {text:row.name;color:#e1e6ed;overflow:elide;}
                                Text {text:row.detail;color:#9aa5b5;font-size:11px;overflow:elide;}
                            }
                            touch:=TouchArea {clicked=>{root.choose(row.name);}}
                        }
                    }
                    HorizontalLayout {
                        spacing:8px;
                        Button {text:"Previous";enabled:root.can-previous;clicked=>{root.page(-1);}}
                        Text {text:root.page-info;horizontal-alignment:center;vertical-alignment:center;horizontal-stretch:1;color:#aab2bf;}
                        Button {text:"Next";enabled:root.can-next;clicked=>{root.page(1);}}
                    }
                }
                ScrollView {
                    width:420px;
                    VerticalLayout {
                        spacing:12px;
                        Text {text:root.value=="" ? "Select a particle system to inspect it" : root.value;wrap:word-wrap;font-size:17px;}
                        Text {text:root.details;wrap:word-wrap;color:#b6c0ce;}
                        Rectangle {vertical-stretch:1;}
                    }
                }
            }
            Text {text:"Definition metadata only · no particle animation or viewport preview";wrap:word-wrap;color:#c8b785;}
            Text {text:"Global active manifest · DMX binary 2 / PCF 1 · map manifests and includes are unsupported";font-size:12px;wrap:word-wrap;color:#9aa5b5;}
            Text {text:root.message;wrap:word-wrap;color:#b6c0ce;min-height:32px;}
            HorizontalLayout {
                spacing:8px;
                Button {text:"Cancel";clicked=>{root.cancel();}}
                Button {text:"Reload particles";clicked=>{root.reload();}}
                Rectangle {horizontal-stretch:1;}
                Button {text:"Apply";enabled:root.can-apply;clicked=>{root.apply();}}
            }
        }
    }
}
