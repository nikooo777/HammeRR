import { Theme } from "theme.slint";
import { Button, CheckBox, ComboBox, LineEdit, ScrollView } from "widgets.slint";
import { FieldRow } from "kit.slint";

export struct VisibilityCategoryRow { id: string, label: string, detail: string, excluded: bool }
export struct VisibilityExclusionRow { index: int, summary: string }
export struct VisibilityProfileRow { name: string, detail: string }

component BoundsFields inherits VerticalLayout {
    in property <string> label-prefix;
    in property <bool> fields-enabled: true;
    in-out property <string> min-x: "-64";
    in-out property <string> min-y: "-64";
    in-out property <string> min-z: "-64";
    in-out property <string> max-x: "64";
    in-out property <string> max-y: "64";
    in-out property <string> max-z: "64";
    spacing: Theme.space;
    HorizontalLayout {
        spacing: Theme.space;
        Text { width: 84px; }
        Text { horizontal-stretch: 1; text: "X"; color: Theme.axis-x; }
        Text { horizontal-stretch: 1; text: "Y"; color: Theme.axis-y; }
        Text { horizontal-stretch: 1; text: "Z"; color: Theme.axis-z; }
    }
    HorizontalLayout {
        spacing: Theme.space;
        Text { width: 84px; text: "Minimum"; color: Theme.text-muted; vertical-alignment: center; }
        LineEdit { enabled: root.fields-enabled; min-width: 0px; horizontal-stretch: 1; text <=> root.min-x; input-type: decimal; accessible-label: root.label-prefix + " minimum X"; }
        LineEdit { enabled: root.fields-enabled; min-width: 0px; horizontal-stretch: 1; text <=> root.min-y; input-type: decimal; accessible-label: root.label-prefix + " minimum Y"; }
        LineEdit { enabled: root.fields-enabled; min-width: 0px; horizontal-stretch: 1; text <=> root.min-z; input-type: decimal; accessible-label: root.label-prefix + " minimum Z"; }
    }
    HorizontalLayout {
        spacing: Theme.space;
        Text { width: 84px; text: "Maximum"; color: Theme.text-muted; vertical-alignment: center; }
        LineEdit { enabled: root.fields-enabled; min-width: 0px; horizontal-stretch: 1; text <=> root.max-x; input-type: decimal; accessible-label: root.label-prefix + " maximum X"; }
        LineEdit { enabled: root.fields-enabled; min-width: 0px; horizontal-stretch: 1; text <=> root.max-y; input-type: decimal; accessible-label: root.label-prefix + " maximum Y"; }
        LineEdit { enabled: root.fields-enabled; min-width: 0px; horizontal-stretch: 1; text <=> root.max-z; input-type: decimal; accessible-label: root.label-prefix + " maximum Z"; }
    }
}

export component WorkingRegionWindow inherits Window {
    background: Theme.panel;
    title: "Working region - HammeRR";
    default-font-size: Theme.font;
    preferred-width: 720px;
    preferred-height: 720px;
    min-width: 540px;
    min-height: 430px;
    in-out property <string> min-x: "-64";
    in-out property <string> min-y: "-64";
    in-out property <string> min-z: "-64";
    in-out property <string> max-x: "64";
    in-out property <string> max-y: "64";
    in-out property <string> max-z: "64";
    in-out property <bool> region-enabled;
    in-out property <bool> follow-camera;
    in-out property <bool> draw-distance-enabled;
    in-out property <string> draw-distance: "2048";
    in-out property <bool> filter-enabled;
    in-out property <string> query;
    in-out property <int> kind;
    in-out property <string> classname;
    in-out property <bool> exact-class;
    in-out property <string> targetname;
    in-out property <string> material;
    in-out property <int> visibility;
    in-out property <bool> limit-filter-bounds;
    in-out property <string> filter-min-x: "-16384";
    in-out property <string> filter-min-y: "-16384";
    in-out property <string> filter-min-z: "-16384";
    in-out property <string> filter-max-x: "16384";
    in-out property <string> filter-max-y: "16384";
    in-out property <string> filter-max-z: "16384";
    in property <string> summary;
    in property <string> effective-box;
    in property <string> message;
    in-out property <int> section;
    in-out property <string> category-query;
    in property <[VisibilityCategoryRow]> categories;
    in property <string> category-summary;
    in property <string> category-message;
    in property <bool> categories-ready;
    in property <bool> category-previous;
    in property <bool> category-next;
    in property <[VisibilityExclusionRow]> exclusions;
    in property <string> exclusion-summary;
    in property <[VisibilityProfileRow]> profiles;
    in property <bool> profiles-ready;
    in property <string> profile-message;
    in property <string> profile-summary;
    in-out property <string> selected-profile;
    in property <string> selected-profile-detail;
    in-out property <string> profile-name;
    callback use-bounds();
    callback apply();
    callback clear();
    callback cancel();
    callback category-query-changed();
    callback category-page(int);
    callback category-exclusion(string, bool);
    callback exclude-matches();
    callback remove-exclusion(int);
    callback choose-profile(string);
    callback save-profile(bool);
    callback rename-profile();
    callback delete-profile();
    callback apply-profile();
    callback refresh-rules();
    forward-focus: keys;
    keys := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => { if event.text == Key.Escape { root.cancel(); accept } else { reject } }
        VerticalLayout {
            padding: Theme.space-xl;
            spacing: Theme.space-lg;
            Text { text: "Working region visibility"; color: Theme.text; font-size: Theme.font-display; font-weight: 600; }
            Text { text: root.summary; wrap: word-wrap; color: Theme.text-muted; }
            Text { text: "Box, distance and inclusion filters combine with AND. Matches to any exclusion stay hidden. Objects stay whole."; wrap: word-wrap; color: Theme.text-muted; }
            ComboBox {
                model: ["Box and filters", "Categories and exclusions", "Saved rule profiles"];
                current-index <=> root.section;
                accessible-label: "Working region section";
            }
            ScrollView {
                content-width: self.width;
                horizontal-scrollbar-policy: always-off;
                vertical-stretch: 1;
                if root.section == 0: VerticalLayout {
                    padding-right: Theme.space-xl;
                    spacing: Theme.space-lg;
                    Text { text: "Box · world units"; color: Theme.text; font-weight: 600; }
                    CheckBox { text: "Enable box"; checked <=> root.region-enabled; }
                    BoundsFields {
                        label-prefix: "Working region";
                        min-x <=> root.min-x; min-y <=> root.min-y; min-z <=> root.min-z;
                        max-x <=> root.max-x; max-y <=> root.max-y; max-z <=> root.max-z;
                    }
                    Button { text: "Use selection bounds"; clicked => { root.use-bounds(); } }
                    CheckBox { text: "Center box on camera"; checked <=> root.follow-camera; }
                    Text { text: "Keeps the entered box dimensions and moves its center with the camera while the box is enabled."; wrap: word-wrap; color: Theme.text-muted; }
                    if root.effective-box != "": Text { text: root.effective-box; wrap: word-wrap; color: Theme.text-faint; }
                    Rectangle { height: 1px; background: Theme.border; }
                    CheckBox { text: "Limit draw distance"; checked <=> root.draw-distance-enabled; }
                    FieldRow {
                        label: "Distance"; inset: false;
                        LineEdit { enabled: root.draw-distance-enabled; text <=> root.draw-distance; input-type: decimal; accessible-label: "Draw distance in world units"; }
                        Text { text: "world units"; color: Theme.text-muted; vertical-alignment: center; }
                    }
                    Text { text: "Measures from the camera to the nearest point on each whole object's bounds."; wrap: word-wrap; color: Theme.text-muted; }
                    Rectangle { height: 1px; background: Theme.border; }
                    CheckBox { text: "Enable object filter"; checked <=> root.filter-enabled; }
                    FieldRow {
                        label: "Search"; inset: false;
                        LineEdit { enabled: root.filter-enabled; text <=> root.query; placeholder-text: "IDs, types, classes, names and materials…"; accessible-label: "Object filter search"; }
                    }
                    FieldRow {
                        label: "Type"; inset: false;
                        ComboBox { enabled: root.filter-enabled; model: ["All types", "World brushes", "All entities", "Point entities", "Brush entities"]; current-index <=> root.kind; accessible-label: "Object filter type"; }
                    }
                    FieldRow {
                        label: "Class"; inset: false;
                        LineEdit { enabled: root.filter-enabled; min-width: 0px; horizontal-stretch: 1; text <=> root.classname; placeholder-text: "Entity class contains…"; accessible-label: "Object filter entity class"; }
                        CheckBox { enabled: root.filter-enabled; text: "Exact class"; checked <=> root.exact-class; }
                    }
                    FieldRow {
                        label: "Entity name"; inset: false;
                        LineEdit { enabled: root.filter-enabled; text <=> root.targetname; placeholder-text: "Targetname contains…"; accessible-label: "Object filter entity name"; }
                    }
                    FieldRow {
                        label: "Material"; inset: false;
                        LineEdit { enabled: root.filter-enabled; text <=> root.material; placeholder-text: "Material contains…"; accessible-label: "Object filter material"; }
                    }
                    FieldRow {
                        label: "Visibility"; inset: false;
                        ComboBox { enabled: root.filter-enabled; model: ["Visible and hidden", "Visible", "Hidden"]; current-index <=> root.visibility; accessible-label: "Object filter authored visibility"; }
                    }
                    Text { text: "Search, class, name and material use case-insensitive substrings. Exact class matches the complete class name. Visibility checks saved hidden state and never reveals hidden objects."; wrap: word-wrap; color: Theme.text-muted; }
                    CheckBox { enabled: root.filter-enabled; text: "Limit object filter to bounds"; checked <=> root.limit-filter-bounds; }
                    if root.limit-filter-bounds: BoundsFields {
                        label-prefix: "Object filter";
                        fields-enabled: root.filter-enabled;
                        min-x <=> root.filter-min-x; min-y <=> root.filter-min-y; min-z <=> root.filter-min-z;
                        max-x <=> root.filter-max-x; max-y <=> root.filter-max-y; max-z <=> root.filter-max-z;
                    }
                    Button { text: "Exclude these matches"; enabled: root.filter-enabled; clicked => { root.exclude-matches(); } }
                    Text { text: "Exclude these matches immediately adds this query to the exclusions and clears the inclusion filter."; wrap: word-wrap; color: Theme.text-muted; }
                    Text { text: "Changes affect editor display and picking. Saved visibility, selection, Undo history and compilation stay unchanged."; wrap: word-wrap; color: Theme.text-muted; }
                }
                if root.section == 1: VerticalLayout {
                    padding-right: Theme.space-xl;
                    spacing: Theme.space-lg;
                    Text { text: "Automatic categories"; color: Theme.text; font-weight: 600; }
                    Text { text: "Categories follow the map's object types and exact entity classes. Counts include saved-hidden owners. Category buttons apply immediately."; wrap: word-wrap; color: Theme.text-muted; }
                    LineEdit { text <=> root.category-query; placeholder-text: "Find categories by type or class…"; accessible-label: "Find visibility categories"; edited => { root.category-query-changed(); } }
                    Text { text: root.category-message; wrap: word-wrap; color: Theme.warning; }
                    Text { text: root.category-summary; wrap: word-wrap; color: Theme.text-muted; }
                    for category in root.categories: VerticalLayout {
                        spacing: Theme.space-xs;
                        HorizontalLayout {
                            spacing: Theme.space;
                            Text { text: category.label; color: Theme.text; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
                            Button { text: category.excluded ? "Remove category exclusion" : "Exclude category"; enabled: root.categories-ready; clicked => { root.category-exclusion(category.id, !category.excluded); } }
                        }
                        Text { text: category.detail; wrap: word-wrap; color: Theme.text-faint; }
                    }
                    HorizontalLayout {
                        spacing: Theme.space;
                        Button { text: "Previous"; enabled: root.categories-ready && root.category-previous; clicked => { root.category-page(-1); } }
                        Button { text: "Next"; enabled: root.categories-ready && root.category-next; clicked => { root.category-page(1); } }
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: "Refresh rules"; clicked => { root.refresh-rules(); } }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    Text { text: "Active exclusions"; color: Theme.text; font-weight: 600; }
                    Text { text: root.exclusion-summary; wrap: word-wrap; color: Theme.text-muted; }
                    for exclusion in root.exclusions: VerticalLayout {
                        spacing: Theme.space;
                        Text { text: exclusion.summary; wrap: word-wrap; color: Theme.text; }
                        Button { text: "Remove exclusion"; clicked => { root.remove-exclusion(exclusion.index); } }
                        Rectangle { height: 1px; background: Theme.border; }
                    }
                    Text { text: "Removing an exclusion applies immediately. Other overlapping rules, spatial filters and hidden state can still exclude its objects. Add custom exclusions from Box and filters."; wrap: word-wrap; color: Theme.text-muted; }
                }
                if root.section == 2: VerticalLayout {
                    padding-right: Theme.space-xl;
                    spacing: Theme.space-lg;
                    Text { text: "Saved rule profiles"; color: Theme.text; font-weight: 600; }
                    Text { text: "Profiles store the applied inclusion filter and exclusions in this map. Save, replace, rename and delete are undoable map edits. Apply selected profile changes rules immediately and keeps spatial settings."; wrap: word-wrap; color: Theme.text-muted; }
                    Text { text: root.profile-message; wrap: word-wrap; color: Theme.warning; }
                    Text { text: root.profile-summary; wrap: word-wrap; color: Theme.text-muted; }
                    for profile in root.profiles: Rectangle {
                        background: root.selected-profile == profile.name ? Theme.selection : Theme.panel;
                        height: profile-row.preferred-height;
                        profile-row := VerticalLayout {
                            padding: Theme.space;
                            spacing: Theme.space-xs;
                            Button { text: profile.name; enabled: root.profiles-ready; clicked => { root.choose-profile(profile.name); } }
                            Text { text: profile.detail; color: Theme.text-muted; wrap: word-wrap; }
                        }
                    }
                    if root.selected-profile != "": Text { text: root.selected-profile-detail; wrap: word-wrap; color: Theme.text-muted; }
                    FieldRow {
                        label: "Profile name"; inset: false;
                        LineEdit { text <=> root.profile-name; placeholder-text: "Name for a new or renamed profile"; accessible-label: "Visibility profile name"; }
                    }
                    HorizontalLayout {
                        spacing: Theme.space;
                        Button { text: "Save applied as profile"; enabled: root.profiles-ready; clicked => { root.save-profile(false); } }
                        Button { text: "Apply selected profile"; enabled: root.profiles-ready && root.selected-profile != ""; clicked => { root.apply-profile(); } }
                    }
                    Button { text: "Replace selected profile"; enabled: root.profiles-ready && root.selected-profile != ""; clicked => { root.save-profile(true); } }
                    HorizontalLayout {
                        spacing: Theme.space;
                        Button { text: "Rename profile"; enabled: root.profiles-ready && root.selected-profile != ""; clicked => { root.rename-profile(); } }
                        Button { text: "Delete profile"; enabled: root.profiles-ready && root.selected-profile != ""; clicked => { root.delete-profile(); } }
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: "Refresh rules"; clicked => { root.refresh-rules(); } }
                    }
                    Text { text: "Apply field changes before saving or replacing a profile. Clear working region removes active filters and keeps saved profiles."; wrap: word-wrap; color: Theme.text-muted; }
                }
            }
            Text { text: "Apply updates box, distance and inclusion. Other action buttons take effect immediately; Cancel closes this panel."; wrap: word-wrap; color: Theme.text-muted; }
            Text { text: root.message; wrap: word-wrap; color: Theme.warning; }
            HorizontalLayout {
                spacing: Theme.space;
                Button { text: "Clear working region"; clicked => { root.clear(); } }
                Rectangle { horizontal-stretch: 1; }
                Button { text: "Cancel"; clicked => { root.cancel(); } }
                Button { text: "Apply"; clicked => { root.apply(); } }
            }
        }
    }
}
