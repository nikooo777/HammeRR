import { Theme } from "theme.slint";
import { Button, CheckBox, ComboBox, LineEdit, ScrollView } from "widgets.slint";

export struct EntityGraphRow { title: string, details: string }
export struct EntityGraphNode { id: string, owner: string, title: string, subtitle: string, x: float, y: float, is-root: bool, virtual-node: bool }
export struct EntityGraphEdge { source: string, target: string, source-x: float, source-y: float, target-x: float, target-y: float, label: string, slot: int }

component GraphEdge inherits Rectangle {
    in property <EntityGraphEdge> edge;
    in property <float> pan-x;
    in property <float> pan-y;
    in property <float> zoom: 1;
    in property <string> dragging;
    in property <float> drag-x;
    in property <float> drag-y;
    in property <bool> selected;
    callback choose();
    private property <float> sx: pan-x + zoom * (edge.source == dragging ? drag-x : edge.source-x);
    private property <float> sy: pan-y + zoom * (edge.source == dragging ? drag-y : edge.source-y);
    private property <float> tx: pan-x + zoom * (edge.target == dragging ? drag-x : edge.target-x);
    private property <float> ty: pan-y + zoom * (edge.target == dragging ? drag-y : edge.target-y);
    private property <bool> upper: tx <= sx;
    private property <float> start-x: sx + (upper ? 110 : 220) * zoom;
    private property <float> start-y: sy + (upper ? 78 : 39) * zoom;
    private property <float> end-x: tx + (upper ? (edge.source == edge.target ? 166 : 110) : 0) * zoom;
    private property <float> end-y: ty + (upper ? 78 : 39) * zoom;
    private property <float> middle-x: (start-x + end-x) / 2 + mod(edge.slot, 5) * 6 * zoom;
    private property <float> rail-y: max(sy, ty) + (106 + mod(edge.slot, 5) * 7) * zoom;
    private property <float> label-x: upper ? (start-x + end-x) / 2 : middle-x;
    private property <float> label-y: upper ? rail-y : max(sy, ty) + 94 * zoom;
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        stroke: root.selected ? Theme.accent : Theme.info;
        stroke-width: root.selected ? 2px : 1px;
        MoveTo { x: root.start-x; y: root.start-y; }
        LineTo { x: root.upper ? root.start-x : root.middle-x; y: root.upper ? root.rail-y : root.start-y; }
        LineTo { x: root.upper ? root.end-x : root.middle-x; y: root.upper ? root.rail-y : root.end-y; }
        LineTo { x: root.end-x; y: root.end-y; }
        MoveTo { x: root.end-x - (root.upper ? 4 : 7); y: root.end-y + (root.upper ? 7 : -4); }
        LineTo { x: root.end-x; y: root.end-y; }
        LineTo { x: root.end-x + (root.upper ? 4 : -7); y: root.end-y + (root.upper ? 7 : 4); }
        MoveTo { x: root.label-x; y: root.upper ? root.rail-y : max(root.start-y, root.end-y); }
        LineTo { x: root.label-x; y: root.label-y; }
    }
    if root.zoom >= 0.7 || root.selected: Rectangle {
        x: root.label-x * 1px - self.width / 2;
        y: root.label-y * 1px - self.height / 2;
        width: 174px * root.zoom;
        height: 20px * root.zoom;
        background: root.selected ? Theme.accent-soft : Theme.canvas;
        border-radius: Theme.radius-sm;
        Text {
            text: root.edge.label;
            color: root.selected ? Theme.accent : Theme.text-muted;
            font-size: max(8px, Theme.font-small * root.zoom);
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        TouchArea { mouse-cursor: pointer; clicked => { root.choose(); } accessible-role: button; accessible-label: root.edge.label; }
    }
}

export component EntityGraphWindow inherits Window {
    background: Theme.panel;
    title: "Entity graph - HammeRR";
    preferred-width: 1060px;
    preferred-height: 960px;
    min-width: 760px;
    min-height: 800px;
    in-out property <string> roots;
    in property <string> root-summary;
    in-out property <string> direction: "Outgoing";
    in-out property <string> depth: "2";
    in-out property <string> scope: "Authored";
    in-out property <string> activator;
    in-out property <string> caller;
    in-out property <bool> caller-unbound;
    in-out property <string> search;
    in-out property <string> section: "Nodes";
    in-out property <string> mode: "Replace";
    in-out property <string> presentation: "Canvas";
    in property <string> summary;
    in property <string> message;
    in property <string> page-summary;
    in property <[EntityGraphRow]> rows;
    in property <[EntityGraphNode]> graph-nodes;
    in property <[EntityGraphEdge]> graph-edges;
    in property <string> canvas-message;
    in property <bool> canvas-ready;
    in-out property <string> layout: "Layered";
    in-out property <float> pan-x: 24;
    in-out property <float> pan-y: 24;
    in-out property <float> zoom: 1;
    in-out property <string> chosen-node;
    in-out property <int> chosen-edge: -1;
    in property <string> selection-details;
    in property <bool> can-act;
    in property <bool> has-previous;
    in property <bool> has-next;
    in-out property <float> aspect: 1;
    private property <string> dragging;
    private property <float> drag-x;
    private property <float> drag-y;
    private property <float> grab-x;
    private property <float> grab-y;
    private property <float> pan-start-x;
    private property <float> pan-start-y;
    private property <bool> panning;
    private property <bool> view-pending;
    private property <length> canvas-width;
    private property <length> canvas-height;
    callback inspect();
    callback fields-changed();
    callback roots-from-selection();
    callback change-section();
    callback page(int);
    callback select-connected();
    callback frame-connected();
    callback choose-node(string);
    callback choose-edge(int);
    callback select-node();
    callback frame-node();
    callback arrange();
    callback reset-diagram();
    callback move-node(string, float, float);
    callback change-view(float, float, float);
    callback close-dialog();
    function zoom-at(factor: float, x: float, y: float) {
        let next = min(4, max(0.1, root.zoom * factor));
        root.pan-x = x - (x - root.pan-x) * next / root.zoom;
        root.pan-y = y - (y - root.pan-y) * next / root.zoom;
        root.zoom = next;
        root.view-pending = true;
    }
    Timer {
        interval: 160ms;
        running: root.view-pending && root.canvas-ready;
        triggered => { root.view-pending = false; root.change-view(root.pan-x, root.pan-y, root.zoom); }
    }
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                if root.dragging != "" { root.dragging = ""; return accept; }
                root.close-dialog(); return accept;
            }
            return reject;
        }
        VerticalLayout {
            padding: Theme.space-xl;
            spacing: 8px;
            Text { text: "Entity graph"; font-size: Theme.font-display; font-weight: 600; }
            Text { text: "Inspect committed I/O. Expanded instance nodes are read-only source views; selection maps to their authored owner. Unapplied drafts and saved-hidden entities are excluded."; wrap: word-wrap; color: Theme.text-muted; }
            HorizontalLayout {
                spacing: 8px;
                Button { text: "Use selected entities"; clicked => { root.roots-from-selection(); } }
                Text { text: root.root-summary; wrap: word-wrap; horizontal-stretch: 1; }
            }
            HorizontalLayout {
                spacing: 8px;
                Text { text: "Root IDs (advanced)"; vertical-alignment: center; color: Theme.text-muted; }
                LineEdit { text <=> root.roots; placeholder-text: "entity:12, entity:34"; edited => { root.fields-changed(); } accessible-label: "Graph root entity IDs"; }
            }
            HorizontalLayout {
                spacing: 8px;
                Text { text: "Direction"; vertical-alignment: center; }
                ComboBox { model: ["Outgoing", "Incoming", "Both"]; current-value <=> root.direction; selected => { root.fields-changed(); } }
                Text { text: "Depth"; vertical-alignment: center; }
                LineEdit { text <=> root.depth; preferred-width: 48px; edited => { root.fields-changed(); } accessible-label: "Graph depth"; }
                Text { text: "Scope"; vertical-alignment: center; }
                ComboBox { model: ["Authored", "Expanded instances"]; current-value <=> root.scope; selected => { root.fields-changed(); } }
                Button { text: "Inspect graph"; clicked => { root.inspect(); } }
                Rectangle { horizontal-stretch: 1; }
            }
            HorizontalLayout {
                spacing: 8px;
                Text { text: "Activator ID"; vertical-alignment: center; color: Theme.text-muted; }
                LineEdit { text <=> root.activator; placeholder-text: "Optional source ID"; edited => { root.fields-changed(); } accessible-label: "Graph activator source ID"; }
                Text { text: "Caller ID"; vertical-alignment: center; color: Theme.text-muted; }
                LineEdit { text <=> root.caller; enabled: !root.caller-unbound; placeholder-text: "Blank uses output owner"; edited => { root.fields-changed(); } accessible-label: "Graph caller source ID"; }
            }
            HorizontalLayout {
                spacing: 8px;
                CheckBox { text: "Unbound caller"; checked <=> root.caller-unbound; toggled => { root.fields-changed(); } }
                Text { text: "Activator requires an ID. Context describes one lookup scenario, without simulating event propagation."; wrap: word-wrap; color: Theme.text-muted; horizontal-stretch: 1; }
            }
            Text { text: root.summary; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 8px;
                ComboBox { model: ["Canvas", "List"]; current-value <=> root.presentation; accessible-label: "Graph presentation"; }
                if root.presentation == "Canvas": ComboBox { model: ["Layered", "Grid"]; current-value <=> root.layout; accessible-label: "Graph layout"; }
                if root.presentation == "Canvas": Button { text: "Arrange"; enabled: root.canvas-ready; clicked => { root.arrange(); } }
                if root.presentation == "Canvas": Button { text: "Reset diagram"; enabled: root.canvas-ready; clicked => { root.reset-diagram(); } }
                Rectangle { horizontal-stretch: 1; }
                if root.presentation == "Canvas": Button { text: "−"; enabled: root.canvas-ready; clicked => { root.zoom-at(1 / 1.2, root.canvas-width / 2px, root.canvas-height / 2px); } accessible-label: "Zoom graph out"; }
                if root.presentation == "Canvas": Text { text: round(root.zoom * 100) + "%"; vertical-alignment: center; color: Theme.text-muted; }
                if root.presentation == "Canvas": Button { text: "+"; enabled: root.canvas-ready; clicked => { root.zoom-at(1.2, root.canvas-width / 2px, root.canvas-height / 2px); } accessible-label: "Zoom graph in"; }
            }
            if root.presentation == "Canvas": graph-canvas := Rectangle {
                background: Theme.canvas;
                border-width: 1px;
                border-color: Theme.border-strong;
                border-radius: Theme.radius;
                clip: true;
                vertical-stretch: 1;
                min-height: 220px;
                changed width => { root.canvas-width = self.width; }
                changed height => { root.canvas-height = self.height; }
                pan := TouchArea {
                    enabled: root.canvas-ready;
                    mouse-cursor: root.panning ? move : grab;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.cancel { root.panning = false; root.pan-x = root.pan-start-x; root.pan-y = root.pan-start-y; }
                        else if event.button == PointerEventButton.left || event.button == PointerEventButton.middle {
                            if event.kind == PointerEventKind.down { keys.focus(); root.pan-start-x = root.pan-x; root.pan-start-y = root.pan-y; root.panning = true; }
                            else if event.kind == PointerEventKind.up && root.panning {
                                root.panning = false;
                                if root.pan-x != root.pan-start-x || root.pan-y != root.pan-start-y { root.change-view(root.pan-x, root.pan-y, root.zoom); }
                            }
                        }
                    }
                    moved => {
                        if root.panning { root.pan-x = root.pan-start-x + (self.mouse-x - self.pressed-x) / 1px; root.pan-y = root.pan-start-y + (self.mouse-y - self.pressed-y) / 1px; }
                    }
                    scroll-event(event) => { root.zoom-at(event.delta-y > 0px ? 1.15 : 1 / 1.15, self.mouse-x / 1px, self.mouse-y / 1px); accept }
                }
                for edge[index] in root.graph-edges: GraphEdge {
                    width: parent.width; height: parent.height;
                    edge: edge; pan-x: root.pan-x; pan-y: root.pan-y; zoom: root.zoom;
                    dragging: root.dragging; drag-x: root.drag-x; drag-y: root.drag-y;
                    selected: root.chosen-edge == index;
                    choose => { root.choose-edge(index); }
                }
                for node in root.graph-nodes: card := Rectangle {
                    x: (root.pan-x + root.zoom * (root.dragging == node.id ? root.drag-x : node.x)) * 1px;
                    y: (root.pan-y + root.zoom * (root.dragging == node.id ? root.drag-y : node.y)) * 1px;
                    width: 220px * root.zoom;
                    height: 78px * root.zoom;
                    background: root.chosen-node == node.id ? Theme.selection : node.virtual-node ? Theme.agent-soft : Theme.control;
                    border-color: root.chosen-node == node.id ? Theme.accent : node.is-root ? Theme.info : Theme.border-strong;
                    border-width: node.is-root || root.chosen-node == node.id ? 2px : 1px;
                    border-radius: Theme.radius;
                    VerticalLayout {
                        padding: 9px * root.zoom;
                        spacing: 4px * root.zoom;
                        Text { text: node.title; color: Theme.text; font-weight: 600; font-size: max(8px, Theme.font * root.zoom); overflow: elide; }
                        Text { text: node.subtitle; color: Theme.text-muted; font-size: max(8px, Theme.font-small * root.zoom); overflow: elide; }
                        Text { text: node.virtual-node ? "Read-only instance source" : node.is-root ? "Captured root" : node.id; color: node.virtual-node ? Theme.agent-text : Theme.info; font-size: max(8px, Theme.font-small * root.zoom); overflow: elide; }
                    }
                    node-touch := TouchArea {
                        mouse-cursor: move;
                        accessible-role: checkbox;
                        accessible-label: node.title + ", " + node.subtitle;
                        accessible-checked: root.chosen-node == node.id;
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.cancel { root.dragging = ""; }
                            else if event.button == PointerEventButton.left {
                                if event.kind == PointerEventKind.down {
                                    keys.focus(); root.choose-node(node.id); root.dragging = node.id;
                                    root.drag-x = node.x; root.drag-y = node.y;
                                    root.grab-x = self.mouse-x / 1px / root.zoom; root.grab-y = self.mouse-y / 1px / root.zoom;
                                } else if event.kind == PointerEventKind.up && root.dragging == node.id {
                                    if root.drag-x != node.x || root.drag-y != node.y { root.move-node(node.id, root.drag-x, root.drag-y); }
                                    root.dragging = "";
                                }
                            }
                        }
                        moved => {
                            if root.dragging == node.id {
                                root.drag-x = (card.x / 1px + self.mouse-x / 1px - root.pan-x) / root.zoom - root.grab-x;
                                root.drag-y = (card.y / 1px + self.mouse-y / 1px - root.pan-y) / root.zoom - root.grab-y;
                            }
                        }
                        scroll-event(event) => { root.zoom-at(event.delta-y > 0px ? 1.15 : 1 / 1.15, (card.x + self.mouse-x) / 1px, (card.y + self.mouse-y) / 1px); accept }
                    }
                }
                if !root.canvas-ready: Text { x: 20px; y: 20px; width: parent.width - 40px; text: root.canvas-message; wrap: word-wrap; color: Theme.text-muted; }
            }
            if root.presentation == "Canvas": Text { text: "Drag empty space to pan · wheel or +/− to zoom · drag nodes to place · click an edge label for I/O details. Layout and view are session-local."; wrap: word-wrap; color: Theme.text-muted; font-size: Theme.font-small; }
            if root.presentation == "List": HorizontalLayout {
                spacing: 8px;
                Text { text: "Search rows"; vertical-alignment: center; }
                LineEdit { text <=> root.search; placeholder-text: "Name, class, entity ID, output or input"; edited => { root.fields-changed(); } accessible-label: "Search graph rows"; }
                ComboBox { model: ["Nodes", "Relationships", "Unresolved (whole map)"]; current-value <=> root.section; selected => { root.change-section(); } }
            }
            if root.presentation == "List": Text { text: root.page-summary; }
            if root.presentation == "List": ScrollView {
                content-width: self.width;
                vertical-stretch: 1;
                min-height: 220px;
                VerticalLayout {
                    alignment: start;
                    padding-right: Theme.space-lg;
                    spacing: 8px;
                    for row in root.rows: VerticalLayout {
                        padding: 8px;
                        spacing: 4px;
                        Text { text: row.title; font-weight: 600; wrap: word-wrap; }
                        Text { text: row.details; wrap: word-wrap; color: Theme.text-muted; }
                    }
                }
            }
            if root.presentation == "List": HorizontalLayout {
                spacing: 8px;
                Button { text: "Previous page"; enabled: root.has-previous; clicked => { root.page(-1); } }
                Button { text: "Next page"; enabled: root.has-next; clicked => { root.page(1); } }
                Rectangle { horizontal-stretch: 1; }
            }
            if root.selection-details != "": ScrollView {
                content-width: self.width;
                vertical-stretch: 0;
                min-height: 48px;
                preferred-height: 74px;
                max-height: 96px;
                VerticalLayout { alignment: start; padding-right: Theme.space-lg; spacing: 4px; Text { text: root.selection-details; wrap: word-wrap; } }
            }
            if root.chosen-node != "": HorizontalLayout {
                spacing: 8px;
                Button { text: "Select owner"; enabled: root.can-act; clicked => { root.select-node(); } }
                Button { text: "Frame node"; enabled: root.can-act; clicked => { root.frame-node(); } }
                Text { text: "Captured roots stay fixed when selection changes."; color: Theme.text-muted; wrap: word-wrap; }
                Rectangle { horizontal-stretch: 1; }
            }
            if root.message != "": Text { text: root.message; wrap: word-wrap; color: Theme.warning; }
            HorizontalLayout {
                spacing: 8px;
                ComboBox { model: ["Replace", "Add", "Remove", "Toggle"]; current-value <=> root.mode; }
                Button { text: "Select connected"; enabled: root.can-act; clicked => { root.select-connected(); } }
                Button { text: "Frame connected"; enabled: root.can-act; clicked => { root.frame-connected(); } }
                Rectangle { horizontal-stretch: 1; }
                Button { text: "Close"; clicked => { root.close-dialog(); } }
            }
        }
    }
}
