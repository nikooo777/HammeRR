    object: bool,
    id: string,
    title: string,
    detail: string,
    enabled: bool,
}

component StatusText inherits Text {
    color: Theme.text-faint;
    vertical-alignment: center;
    font-size: Theme.font;
}

component TransformVector inherits HorizontalLayout {
    in-out property <string> x-value: "0";
    in-out property <string> y-value: "0";
    in-out property <string> z-value: "0";
    in property <bool> enabled: true;
    callback apply();
    spacing: 7px;
    Text { text: "X"; color: Theme.axis-x; vertical-alignment: center; }
    LineEdit { enabled: root.enabled; min-width: 0px; preferred-width: 80px; horizontal-stretch: 1; text <=> root.x-value; input-type: decimal; accepted => { root.apply(); } }
    Text { text: "Y"; color: Theme.axis-y; vertical-alignment: center; }
    LineEdit { enabled: root.enabled; min-width: 0px; preferred-width: 80px; horizontal-stretch: 1; text <=> root.y-value; input-type: decimal; accepted => { root.apply(); } }
    Text { text: "Z"; color: Theme.axis-z; vertical-alignment: center; }
    LineEdit { enabled: root.enabled; min-width: 0px; preferred-width: 80px; horizontal-stretch: 1; text <=> root.z-value; input-type: decimal; accepted => { root.apply(); } }
}

export component AppWindow inherits Window {
    title: (root.background-display ? "HammeRR background: " : "") + root.map-title + " - HammeRR";
    in property <bool> background-display;
    preferred-width: 1600px;
    preferred-height: 960px;
    background: Theme.panel;
    default-font-size: Theme.font;
    forward-focus: focus;

    in property <image> frame;
    in property <string> map-title: "untitled.vmf";
    in property <string> message;
    in property <string> stats;
    in property <string> preview-error;
    in property <string> camera;
    in property <string> mcp-status;
    in property <bool> flying;
    in property <int> projection-index;
    in property <string> workplane-axis: "Z";
    in property <string> brush-preview;
    in-out property <string> grid-size: "16";
    in-out property <string> fly-speed: "600";
    in-out property <bool> grid-visible: true;
    in-out property <bool> snap-grid: true;
    in-out property <bool> drawing-block;
    in-out property <string> brush-elevation: "0";
    in-out property <string> brush-depth: "128";
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <bool> compiling;
    in property <string> compile-label;
    in property <string> compile-token;
    in property <bool> compile-cancellable;
    callback build-status();
    callback compile-region();
    callback working-region();
    callback clear-working-region();
    in property <bool> working-region-active;
    in property <string> compile-region-label: "Compile region…";
    callback cancel-build();
    in property <bool> launching;
    in property <bool> game-running;
    in property <bool> has-selection;
    in property <bool> face-mode;
    in property <bool> has-faces;
    in property <bool> can-sample-face;
    in property <bool> can-clip;
    in property <bool> clipping;
    in property <bool> has-clip-preview;
    in property <string> clip-summary;
    in property <bool> clip-positioning;
    in-out property <int> clip-handles-mode: 1;
    in-out property <bool> clip-handles-snap: true;
    in-out property <string> clip-angle-step: "15";
    callback clip-handles-changed();
    callback cancel-clip-positioning();
    in property <bool> clip-point-mode;
    in property <int> clip-point-count;
    in property <string> clip-points-summary;
    in-out property <int> clip-keep-index: 2;
    in-out property <string> clip-normal-x: "1";
    in-out property <string> clip-normal-y: "0";
    in-out property <string> clip-normal-z: "0";
    in-out property <string> clip-distance: "0";
    in-out property <string> clip-material;
    in property <string> selection-pivot;
    in-out property <bool> show-transform;
    in-out property <int> transform-mode;
    in-out property <int> grid-snap-mode;
    in-out property <int> transform-pivot-mode;
    in-out property <string> transform-x: "0";
    in-out property <string> transform-y: "0";
    in-out property <string> transform-z: "0";
    in-out property <string> pivot-x: "0";
    in-out property <string> pivot-y: "0";
    in-out property <string> pivot-z: "0";
    in property <bool> pivot-picking;
    in property <bool> can-pick-pivot;
    in property <bool> can-snap-pivot;
    in property <string> pivot-grid-error;
    in property <bool> can-cancel-pivot-pick;
    in property <string> pivot-pick-notice;
    in property <string> pivot-pick-source;
    callback pick-transform-pivot();
    callback snap-transform-pivot-to-grid();
    callback cancel-transform-pivot-pick();
    in-out property <bool> transform-texture-lock: true;
    in-out property <bool> transform-texture-scale-lock: true;
    in-out property <bool> transform-reflect-x: true;
    in-out property <bool> transform-reflect-y: false;
    in-out property <bool> transform-reflect-z: false;
    in-out property <int> transform-shear-axis: 0;
    in-out property <int> transform-shear-reference: 1;
    in-out property <string> transform-shear-factor: "0.5";
    in-out property <int> handles-mode-index;
    in-out property <int> transform-space-index;
    in-out property <string> rotation-step: "15";
    in-out property <int> area-rule-index;
    in-out property <int> area-mode-index;
    in property <bool> has-transform-preview;
    in property <bool> agent-preview;
    in property <string> transform-preview-summary;
    in property <[string]> transform-preview-values: ["0", "0", "0", "0", "0", "0", "1", "1", "1"];
    in property <bool> has-area-preview;
    in property <bool> has-paint-preview;
    in property <bool> has-texture-stroke;
    in-out property <int> texture-paint-mode;
    in property <string> texture-sample-material;
    in property <image> texture-sample-preview;
    in property <string> paint-token;
    in-out property <float> paint-radius: 12;
    callback paint-settings-changed();
    in property <string> interaction-summary;
    function refresh-transform-values() {
        root.transform-x = root.has-transform-preview && root.transform-mode < 3 ? root.transform-preview-values[root.transform-mode * 3] : root.transform-mode == 2 ? "1" : "0";
        root.transform-y = root.has-transform-preview && root.transform-mode < 3 ? root.transform-preview-values[root.transform-mode * 3 + 1] : root.transform-mode == 2 ? "1" : "0";
        root.transform-z = root.has-transform-preview && root.transform-mode < 3 ? root.transform-preview-values[root.transform-mode * 3 + 2] : root.transform-mode == 2 ? "1" : "0";
    }
    changed transform-mode => { root.refresh-transform-values(); }
    changed transform-preview-values => { if root.has-transform-preview { root.refresh-transform-values(); } }
    changed has-transform-preview => { if root.has-transform-preview { root.refresh-transform-values(); } }
    in-out property <bool> show-tools: true;
    in-out property <bool> sky-preview: false;
    in-out property <bool> lighting-preview: false;
    in-out property <int> lighting-channel: 0;
    in-out property <bool> lighting-sky-ambient: false;
    in-out property <int> lighting-quality: 1;
    in-out property <string> lighting-exposure-ev: "0";
    in property <string> lighting-status: "Authored lighting preview is off";
    in property <string> lighting-error;
    in-out property <bool> normal-maps: false;
    in-out property <bool> surface-shading: false;
    in property <string> normal-map-status: "Normal map preview is off";
    in-out property <int> sky-channel: 0;
    in-out property <string> sky-exposure-ev: "0";
    in property <string> sky-preview-error;
    in-out property <bool> instance-contents: false;
    in property <string> instance-contents-status: "Instance contents have not been refreshed";
    callback inspect-instance-contents();
    callback create-instance-reference();
    callback extract-instance();
    callback edit-instance-reference();
    in property <bool> can-edit-instance-reference;
    in-out property <bool> rope-preview: false;
    in-out property <bool> selection-outlines: true;
    in-out property <bool> selection-tint: true;
    in-out property <bool> entity-images: true;
    in-out property <bool> additive-sprite-guides: false;
    in-out property <bool> entity-model-guides: true;
    in property <string> rope-preview-status: "Rope preview is off";
    in property <string> fog-preview-status: "Fog preview is off";
    callback fog-preview();
    callback color-correction-preview();
    in property <string> color-correction-status: "Color correction is off";
    in property <string> color-correction-error;
    callback sky3d-preview();
    in property <string> sky3d-preview-status: "3D sky preview is off";
    in property <string> sky3d-render-error;
    in-out property <string> sky-preview-status: "Set world skyname to select a 2D sky";
    in-out property <bool> show-leak: true;
    in-out property <int> surface-view;
    in-out property <int> smoothing-view-group: 1;
