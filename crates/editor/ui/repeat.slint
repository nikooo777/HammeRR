import { Theme } from "theme.slint";
import {Button,CheckBox,ComboBox,LineEdit,ScrollView,SpinBox} from "widgets.slint";

component VectorRow inherits HorizontalLayout {
    in property <string> label;
    in-out property <string> value-x:"0";
    in-out property <string> value-y:"0";
    in-out property <string> value-z:"0";
    callback edited();
    spacing:8px;
    Text {text:root.label;width:160px;vertical-alignment:center;}
    Text {text:"X";vertical-alignment:center;}
    LineEdit {min-width:60px;preferred-width:100px;horizontal-stretch:1;text<=>root.value-x;input-type:decimal;edited=>{root.edited();}}
    Text {text:"Y";vertical-alignment:center;}
    LineEdit {min-width:60px;preferred-width:100px;horizontal-stretch:1;text<=>root.value-y;input-type:decimal;edited=>{root.edited();}}
    Text {text:"Z";vertical-alignment:center;}
    LineEdit {min-width:60px;preferred-width:100px;horizontal-stretch:1;text<=>root.value-z;input-type:decimal;edited=>{root.edited();}}
}

export component RepeatWindow inherits Window {
    background: Theme.panel;
    title:"Repeat array";preferred-width:660px;preferred-height:860px;
    in property <string> selection;
    in-out property <int> count:3;
    in-out property <int> space-index:0;
    in-out property <string> move-x:"64";
    in-out property <string> move-y:"0";
    in-out property <string> move-z:"0";
    in-out property <string> rotate-x:"0";
    in-out property <string> rotate-y:"0";
    in-out property <string> rotate-z:"0";
    in-out property <string> scale-x:"1";
    in-out property <string> scale-y:"1";
    in-out property <string> scale-z:"1";
    in-out property <string> pivot-x:"0";
    in-out property <string> pivot-y:"0";
    in-out property <string> pivot-z:"0";
    in-out property <bool> texture-lock:true;
    in property <bool> ready;
    in property <string> summary;
    in property <string> message;
    callback preview();callback apply();callback cancel();callback invalidate();
    forward-focus:dialog-focus;
    dialog-focus:=FocusScope {
        key-pressed(event)=>{if event.text==Key.Escape{root.cancel();accept}else{reject}}
        VerticalLayout {
            padding: Theme.space-xl;spacing:12px;
            Text {text:"Repeat selected objects";font-size: Theme.font-display;}
            Text {text:root.selection;wrap:word-wrap;color:Theme.text-muted;}
            HorizontalLayout {
                spacing:10px;
                Text {text:"Additional copies";vertical-alignment:center;}
                SpinBox {minimum:1;maximum:64;value<=>root.count;edited=>{root.invalidate();}}
                Text {text:"Originals stay in place";vertical-alignment:center;color:Theme.text-muted;}
            }
            HorizontalLayout {
                spacing:10px;
                Text {text:"Step space";vertical-alignment:center;}
                ComboBox {model:["World", "Source local"];current-index<=>root.space-index;selected=>{root.invalidate();}}
            }
            VectorRow {label:"Move step · units";value-x<=>root.move-x;value-y<=>root.move-y;value-z<=>root.move-z;edited=>{root.invalidate();}}
            VectorRow {label:"Rotate step · °";value-x<=>root.rotate-x;value-y<=>root.rotate-y;value-z<=>root.rotate-z;edited=>{root.invalidate();}}
            VectorRow {label:"Scale factor per copy";value-x<=>root.scale-x;value-y<=>root.scale-y;value-z<=>root.scale-z;edited=>{root.invalidate();}}
            Text {text:"1 keeps size. 1.1 adds 10% per copy: copy 2 uses 1.21. Scaling requires brushes or brush entities; point and model entities are unsupported.";wrap:word-wrap;color:Theme.text-muted;}
            VectorRow {label:"Fixed world pivot";value-x<=>root.pivot-x;value-y<=>root.pivot-y;value-z<=>root.pivot-z;edited=>{root.invalidate();}}
            Text {text:root.space-index==1?"Copy n scales the originals by factorⁿ, rotates by n × the step about the world pivot, then moves by n × the move step. All axes use the same original source frame identified in the preview.":"Copy n scales the originals by factorⁿ, rotates by n × the step about the world pivot, then moves by n × the world move step.";wrap:word-wrap;color:Theme.text-muted;}
            CheckBox {text:"Keep textures attached";checked<=>root.texture-lock;toggled=>{root.invalidate();}}
            Text {text:"Names become unique name_copyN values. Exact internal entity links follow each copy; external links stay. Shared names and ambiguous internal links must be resolved first.";wrap:word-wrap;color:Theme.text-muted;}
            Text {text:"Named sets with scripts or dynamic I/O cannot be repeated. Other custom metadata stays verbatim. Context notes copy within the map budget; saved partitions stay on originals.";wrap:word-wrap;color:Theme.text-muted;}
            Button {text:"Preview array";clicked=>{root.preview();}}
            ScrollView {
                vertical-stretch:1;
                Text {text:root.summary;wrap:word-wrap;color:Theme.text;vertical-alignment:top;}
            }
            Text {text:root.message;wrap:word-wrap;color:Theme.text-muted;min-height:32px;}
            HorizontalLayout {
                spacing:10px;
                Button {text:"Cancel";clicked=>{root.cancel();}}
                Rectangle {horizontal-stretch:1;}
                Button {text:"Apply array";enabled:root.ready;clicked=>{root.apply();}}
            }
        }
    }
}
