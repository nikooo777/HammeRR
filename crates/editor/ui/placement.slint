import { Theme } from "theme.slint";
import {Button,CheckBox,ComboBox,LineEdit} from "widgets.slint";

export component PlacementWindow inherits Window {
    background: Theme.panel;
    title:"Place on surface";preferred-width:640px;preferred-height:720px;
    in property <string> selection;
    in property <[string]> source-choices;
    in-out property <int> source-index;
    in property <string> source-error;
    in-out property <int> method;
    in-out property <bool> align:false;
    in-out property <bool> texture-lock:true;
    in-out property <string> offset:"0";
    in property <float> aspect:1;
    in property <bool> ready;
    in property <bool> picking;
    in property <string> summary;
    in property <string> message;
    callback preview();callback apply();callback cancel();callback invalidate();callback frame();callback choose-source(int);
    forward-focus:dialog-focus;
    dialog-focus:=FocusScope {
        key-pressed(event)=>{if event.text==Key.Escape{root.cancel();accept}else{reject}}
        VerticalLayout {
            padding:20px;spacing:14px;
            Text {text:"Place selection on a surface";font-size:20px;}
            Text {text:root.selection+" · selected objects move together";wrap:word-wrap;color:Theme.text-muted;}
            HorizontalLayout {
                spacing:10px;
                Text {text:"Target";vertical-alignment:center;width:70px;}
                ComboBox {horizontal-stretch:1;model:["Floor","Ceiling","Pick surface","Snap selected corner"];current-index<=>root.method;selected=>{if root.method==3{root.align=false;root.offset="0";}root.invalidate();}}
            }
            if root.method==3:VerticalLayout {
                spacing:6px;
                Text {text:"Source corner";color:Theme.text;}
                ComboBox {model:root.source-choices;current-index<=>root.source-index;selected=>{root.choose-source(root.source-index);}}
                if root.source-index>0:Text {text:root.source-choices[root.source-index];wrap:word-wrap;color:Theme.text-muted;}
                Text {text:root.source-error=="" ? "All selected objects translate together; no rotation, normal offset or grid rounding." : root.source-error;wrap:word-wrap;color:Theme.text-muted;}
            }
            HorizontalLayout {
                spacing:10px;
                Text {text:"Offset";vertical-alignment:center;width:70px;}
                LineEdit {width:110px;enabled:root.method!=3;text<=>root.offset;input-type:decimal;edited=>{root.invalidate();}}
                Text {text:"units away from surface";vertical-alignment:center;color:Theme.text-muted;}
            }
            CheckBox {text:"Align local up to surface";enabled:root.method!=3;checked<=>root.align;toggled=>{root.invalidate();}}
            CheckBox {text:"Keep textures attached";checked<=>root.texture-lock;toggled=>{root.invalidate();}}
            HorizontalLayout {
                spacing:10px;
                Button {text:root.method==3 ? "Pick target corner" : root.method==2 ? "Pick surface" : "Preview placement";clicked=>{root.preview();}}
                Button {text:"Frame preview";enabled:root.ready;clicked=>{root.frame();}}
            }
            Text {text:root.summary;wrap:word-wrap;color:Theme.text;}
            Rectangle {vertical-stretch:1;}
            Text {text:root.message;wrap:word-wrap;color:Theme.text-muted;min-height:30px;}
            HorizontalLayout {
                spacing:10px;
                Button {text:"Cancel";clicked=>{root.cancel();}}
                Rectangle {horizontal-stretch:1;}
                Button {text:"Apply placement";enabled:root.ready;clicked=>{root.apply();}}
            }
        }
    }
}
