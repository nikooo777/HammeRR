import { Theme } from "theme.slint";
import { Button, ComboBox, LineEdit, ScrollView } from "widgets.slint";
import { FieldRow, SectionHeader } from "kit.slint";

component ReferenceVector inherits FieldRow {
    in property <string> label-x;
    in property <string> label-y;
    in property <string> label-z;
    in property <bool> enabled;
    in-out property <string> value-x;
    in-out property <string> value-y;
    in-out property <string> value-z;
    callback edited();
    inset: false;
    spacing: Theme.space;
    min-height: Theme.control-height + Theme.font + Theme.space-sm;
    for label[index] in [root.label-x, root.label-y, root.label-z]: VerticalLayout {
        spacing: Theme.space-xs;
        min-height: axis-label.preferred-height + Theme.space-xs + Theme.control-height;
        axis-label := Text { text: label; color: Theme.text-muted; font-size: Theme.font; }
        LineEdit {
            min-width: 70px;
            horizontal-stretch: 1;
            enabled: root.enabled;
            input-type: decimal;
            accessible-label: root.label + " " + label;
            text: index == 0 ? root.value-x : index == 1 ? root.value-y : root.value-z;
            edited(value) => {
                if index == 0 { root.value-x = value; }
                else if index == 1 { root.value-y = value; }
                else { root.value-z = value; }
                root.edited();
            }
        }
    }
}

export component InstanceReferenceWindow inherits Window {
    title: root.collapse-active ? "Collapse references - HammeRR" : root.edit-mode ? "Edit instance reference - HammeRR" : "Instance reference - HammeRR";
    preferred-width: 760px;
    preferred-height: 720px;
    min-width: 520px;
    min-height: 440px;
    background: Theme.panel;
    private property <length> field-label-width: 104px;
    in property <bool> edit-mode;
    in property <bool> owned;
    in property <bool> ready;
    in property <bool> shared-form;
    in property <bool> collapse-active;
    in property <bool> can-collapse;
    in-out property <int> collapse-scope;
    in property <string> source;
    in property <string> status;
    in property <string> contents;
    in property <string> message;
    in property <string> raw-origin;
    in property <string> raw-angles;
    in-out property <string> file;
    in-out property <string> origin-x;
    in-out property <string> origin-y;
    in-out property <string> origin-z;
    in-out property <string> pitch;
    in-out property <string> yaw;
    in-out property <string> roll;
    callback edited(int);
    callback browse();
    callback check-file();
    callback review();
    callback refresh-contents();
    callback preview-collapse();
    callback apply();
    callback cancel();
    forward-focus: dialog-focus;
    dialog-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); accept } else { reject }
        }
        VerticalLayout {
            padding: Theme.space-xl;
            spacing: Theme.space-lg;
            Text { text: root.collapse-active ? "Collapse references" : root.edit-mode ? "Edit instance reference" : "Create instance reference"; font-size: Theme.font-display; font-weight: 600; color: Theme.text; }
            ScrollView {
                vertical-stretch: 1;
                content-width: self.width;
                VerticalLayout {
                    alignment: start;
                    padding-right: Theme.space-lg;
                    spacing: Theme.space-lg;
                    if root.source != "": Text { text: root.source; color: Theme.text-faint; wrap: word-wrap; font-size: Theme.font; }
                    if !root.collapse-active: VerticalLayout {
                        spacing: Theme.space-lg;
                        FieldRow {
                            inset: false; label: "VMF reference"; label-width: root.field-label-width;
                            LineEdit { text <=> root.file; enabled: root.owned; placeholder-text: "parts/arch.vmf"; edited => { root.edited(0); } accessible-label: "VMF reference"; }
                            Button { text: "Browse…"; enabled: root.owned; clicked => { root.browse(); } }
                        }
                        ReferenceVector {
                            label: "Position"; label-width: root.field-label-width; label-x: "X"; label-y: "Y"; label-z: "Z"; enabled: root.owned;
                            value-x <=> root.origin-x; value-y <=> root.origin-y; value-z <=> root.origin-z;
                            edited => { root.edited(1); }
                        }
                        if root.raw-origin != "": Text { text: "Invalid stored Position: " + root.raw-origin; color: Theme.warning; wrap: word-wrap; }
                        ReferenceVector {
                            label: "Rotation"; label-width: root.field-label-width; label-x: "Pitch"; label-y: "Yaw"; label-z: "Roll"; enabled: root.owned;
                            value-x <=> root.pitch; value-y <=> root.yaw; value-z <=> root.roll;
                            edited => { root.edited(2); }
                        }
                        if root.raw-angles != "": Text { text: "Invalid stored Rotation: " + root.raw-angles; color: Theme.warning; wrap: word-wrap; }
                    }
                    if !root.collapse-active || root.shared-form: HorizontalLayout {
                        spacing: Theme.space;
                        if !root.collapse-active: Button { text: "Check file"; enabled: root.owned; clicked => { root.check-file(); } }
                        if !root.collapse-active: Button { text: "Refresh instance contents"; clicked => { root.refresh-contents(); } }
                        if root.shared-form: Button { text: root.collapse-active ? "Review collapse" : "Review shared form"; clicked => { root.review(); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if root.status != "": Text { text: root.status; color: Theme.text-muted; wrap: word-wrap; }
                    if root.edit-mode || root.collapse-active: FieldRow {
                        inset: false; label: "Collapse scope"; label-width: root.field-label-width;
                        ComboBox { model: ["All visible references", "Selected references"]; current-index <=> root.collapse-scope; enabled: root.can-collapse && !root.collapse-active; accessible-label: "Collapse scope"; horizontal-stretch: 1; }
                    }
                    if root.edit-mode && !root.collapse-active: HorizontalLayout {
                        spacing: Theme.space;
                        Button { text: "Preview collapse references…"; enabled: root.can-collapse; clicked => { root.preview-collapse(); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if (root.edit-mode || root.collapse-active) && root.collapse-scope == 1: Text { text: "Select any set of complete visible root references. Unselected and hidden references stay unchanged."; color: Theme.text-faint; wrap: word-wrap; font-size: Theme.font; }
                    SectionHeader { inset: false; text: root.collapse-active ? "Reviewed contents" : "Instance contents"; collapsible: false; }
                    if root.contents != "": Text { text: root.contents; color: Theme.text-muted; wrap: word-wrap; }
                    Text { text: root.collapse-active ? "Creates independent editable parent objects from the reviewed compiler-supported contents. Reference markers are removed; child object settings and prepared bindings are retained. Child files stay unchanged. Apply is one Undo step." : "Check file confirms path and presence. Refresh instance contents or Compile checks committed child contents. Edit child sources as separate maps; collapse creates independent parent objects."; color: Theme.text-faint; wrap: word-wrap; font-size: Theme.font; }
                    if root.message != "": Text { text: root.message; color: Theme.warning; wrap: word-wrap; }
                }
            }
            HorizontalLayout {
                spacing: Theme.space;
                Button { text: root.collapse-active ? "Cancel collapse" : "Cancel"; clicked => { root.cancel(); } }
                Rectangle { horizontal-stretch: 1; }
                Button { text: root.collapse-active ? "Apply collapse" : root.edit-mode ? "Apply" : "Create"; primary: true; enabled: root.ready && root.owned; clicked => { root.apply(); } }
            }
        }
    }
}
