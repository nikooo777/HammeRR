import { Button, CheckBox, ComboBox, LineEdit, ListView, ScrollView, Slider, SpinBox, TextEdit } from "std-widgets.slint";

export struct EntityClassRow {
    classname: string,
    description: string,
}

export struct ConnectionRow {
    source: string,
    index: int,
    label: string,
    detail: string,
    warning: string,
}

component ConnectionField inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <[string]> suggestions;
    in property <string> help;
    in-out property <string> value;
    callback changed();
    spacing: 4px;
    Text { text: root.label; font-weight: 600; }
    HorizontalLayout {
        spacing: 6px;
        LineEdit {
            horizontal-stretch: 1;
            text <=> root.value;
            placeholder-text: root.placeholder;
            accessible-label: root.label;
            edited => { root.changed(); }
        }
        if root.suggestions.length > 1: ComboBox {
            width: 170px;
            model: root.suggestions;
            current-index: 0;
            accessible-label: root.label + " suggestions";
            selected(value) => { if self.current-index > 0 { root.value = value; root.changed(); } }
        }
    }
    if root.help != "": Text { text: root.help; wrap: word-wrap; font-size: 12px; }
}

export component ConnectionWindow inherits Window {
    title: "Entity Connections - HammeRR";
    preferred-width: 1040px;
    preferred-height: 820px;
    in-out property <string> source-id;
    in property <string> source-label;
    in property <string> generation;
    in property <string> revision;
    in property <string> draft-token;
    in property <[ConnectionRow]> outgoing;
    in property <[ConnectionRow]> incoming;
    in property <bool> editing;
    in property <bool> can-apply;
    in property <string> message;
    in property <string> warnings;
    in property <[string]> outputs;
    in property <[string]> targets;
    in property <[string]> inputs;
    in property <string> output-help;
    in property <string> target-help;
    in property <string> input-help;
    in-out property <string> output;
    in-out property <string> target;
    in-out property <string> input;
    in-out property <string> parameter;
    in-out property <string> delay;
    in-out property <string> times;
    in-out property <string> target-filter;
    in-out property <int> firing-mode;
    in-out property <int> direction;
    callback choose(source: string, index: int);
    callback delete-connection(index: int);
    callback add();
    callback fields-changed();
    callback filter-changed();
    callback apply();
    callback cancel();
    forward-focus: dialog-focus;
    dialog-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); accept } else { reject }
        }
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            Text { text: root.source-label; font-size: 20px; font-weight: 600; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 18px;
                vertical-stretch: 1;
                VerticalLayout {
                    width: 450px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        ComboBox { model: ["Outgoing", "Incoming"]; current-index <=> root.direction; }
                        Button { text: "Add connection"; clicked => { root.add(); } }
                    }
                    ListView {
                        vertical-stretch: 1;
                        for row in (root.direction == 0 ? root.outgoing : root.incoming): VerticalLayout {
                            padding-bottom: 12px;
                            spacing: 4px;
                            Text { text: row.label; wrap: word-wrap; font-weight: 600; }
                            Text { text: row.detail; wrap: word-wrap; font-size: 12px; }
                            if row.warning != "": Text { text: row.warning; wrap: word-wrap; color: #d28b26; font-size: 12px; }
                            HorizontalLayout {
                                spacing: 8px;
                                Button {
                                    text: root.direction == 0 ? "Edit connection" : "Edit source connection";
                                    clicked => { root.choose(row.source, row.index); }
                                }
                                if root.direction == 0: Button {
                                    text: "Delete connection";
                                    clicked => { root.delete-connection(row.index); }
                                }
                            }
                        }
                    }
                    Text {
                        text: root.direction == 0 ? root.outgoing.length + " outgoing connections" : root.incoming.length + " incoming connections · choose one to edit its source";
                        wrap: word-wrap;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 10px;
                    if !root.editing: Text { text: "Choose a connection to edit, or add a new one."; wrap: word-wrap; }
                    if root.editing: VerticalLayout {
                        spacing: 10px;
                        ConnectionField {
                            label: "When this output fires";
                            value <=> root.output;
                            suggestions: root.outputs;
                            help: root.output-help;
                            placeholder: "Output name";
                            changed => { root.fields-changed(); }
                        }
                        LineEdit {
                            text <=> root.target-filter;
                            placeholder-text: "Search map targets by name, class or ID";
                            input-type: search;
                            edited => { root.filter-changed(); }
                        }
                        ConnectionField {
                            label: "Send to";
                            value <=> root.target;
                            suggestions: root.targets;
                            help: root.target-help;
                            placeholder: "Target name, prefix* or !self";
                            changed => { root.fields-changed(); }
                        }
                        ConnectionField {
                            label: "Run this input";
                            value <=> root.input;
                            suggestions: root.inputs;
                            help: root.input-help;
                            placeholder: "Input name";
                            changed => { root.fields-changed(); }
                        }
                        ConnectionField {
                            label: "With parameter";
                            value <=> root.parameter;
                            placeholder: "Empty uses the output's value";
                            changed => { root.fields-changed(); }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Delay (seconds)"; vertical-alignment: center; }
                            LineEdit {
                                text <=> root.delay;
                                input-type: decimal;
                                accessible-label: "Delay in seconds";
                                edited => { root.fields-changed(); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Fire"; vertical-alignment: center; }
                            ComboBox {
                                model: ["Unlimited", "Once", "Specific count"];
                                current-index <=> root.firing-mode;
                                selected => {
                                    root.times = root.firing-mode == 0 ? "-1" : root.firing-mode == 1 ? "1" : "2";
                                    root.fields-changed();
                                }
                            }
                            if root.firing-mode == 2: LineEdit {
                                text <=> root.times;
                                input-type: number;
                                accessible-label: "Firing count";
                                edited => { root.fields-changed(); }
                            }
                        }
                    }
                    Text { text: root.message; wrap: word-wrap; color: root.can-apply ? #388348 : #c47622; }
                    if root.warnings != "": TextEdit { text: root.warnings; read-only: true; wrap: word-wrap; vertical-stretch: 1; }
                    Rectangle { vertical-stretch: 1; }
                }
            }
            HorizontalLayout {
                spacing: 12px;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
                Button { text: "Apply connection"; enabled: root.editing && root.can-apply; clicked => { root.apply(); } }
            }
        }
    }
}

export struct RenameRow {
    section: string,
    section-note: string,
    label: string,
    change: string,
    reason: string,
    review: bool,
    changed: bool,
    details: string,
}

component RenameReference inherits VerticalLayout {
    in property <RenameRow> entry;
    in property <bool> show-details;
    padding-bottom: 16px;
    spacing: 4px;
    Text { text: root.entry.label; wrap: word-wrap; font-weight: 600; }
    Text { text: root.entry.change; wrap: word-wrap; }
    Text { text: root.entry.reason; wrap: word-wrap; color: root.entry.review ? #dcaa59 : #a5aab4; font-size: 12px; }
    if root.show-details: Text { text: root.entry.details; wrap: word-wrap; font-size: 11px; color: #818999; }
}

export component RenameWindow inherits Window {
    title: "Entity References and Rename - HammeRR";
    preferred-width: 920px;
    preferred-height: 740px;
    in property <string> entity-label;
    in property <string> old-name;
    in property <string> draft-token;
    in property <[RenameRow]> references;
    in property <[RenameRow]> changes;
    in property <[RenameRow]> attention;
    in property <[RenameRow]> other;
    in property <string> summary;
    in property <string> members;
    in property <string> message;
    in property <bool> can-apply;
    in property <bool> requires-review;
    in property <bool> has-proposal;
    in property <int> shared-count;
    in-out property <string> new-name;
    in-out property <bool> rename-group;
    in-out property <bool> accept-review;
    in-out property <bool> show-details;
    callback fields-changed();
    callback apply();
    callback cancel();
    forward-focus: rename-focus;
    rename-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); accept } else { reject }
        }
        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text { text: root.has-proposal ? "Rename entity" : "Entity references"; font-size: 24px; font-weight: 600; }
            Text { text: root.entity-label; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    Text { text: "Current name"; font-weight: 600; }
                    Text { text: root.old-name == "" ? "Unnamed" : root.old-name; wrap: word-wrap; accessible-label: "Current entity name"; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    Text { text: "New name"; font-weight: 600; }
                    LineEdit {
                        text <=> root.new-name;
                        accessible-label: "New entity name";
                        placeholder-text: "Choose an unused entity name";
                        edited => { root.fields-changed(); }
                    }
                }
            }
            if root.shared-count > 1: CheckBox {
                text: "Rename all " + root.shared-count + " entities named “" + root.old-name + "”";
                checked <=> root.rename-group;
                toggled => { root.fields-changed(); }
            }
            Text { text: root.summary; wrap: word-wrap; font-weight: 600; accessible-label: "Rename summary"; }
            if root.rename-group: Text { text: root.members; wrap: word-wrap; font-size: 12px; color: #929cae; }
            if root.references.length == 0: Text { text: root.has-proposal ? "No linked fields need updating." : "No references found."; wrap: word-wrap; }
            ListView {
                vertical-stretch: 1;
                for row in root.references: VerticalLayout {
                    spacing: 8px;
                    if row.section != "": Text {
                        text: row.section;
                        font-size: 18px;
                        font-weight: 600;
                        color: row.review ? #dcaa59 : #ffffff;
                    }
                    if row.section-note != "": Text { text: row.section-note; wrap: word-wrap; font-size: 12px; }
                    RenameReference { entry: row; show-details: root.show-details; }
                }
            }
            if root.requires-review: CheckBox {
                text: "I’ve reviewed these effects; leave these fields unchanged";
                checked <=> root.accept-review;
                toggled => { root.fields-changed(); }
            }
            CheckBox {
                text: "Show engine details";
                checked <=> root.show-details;
                toggled => { root.fields-changed(); }
            }
            Text { text: root.message; wrap: word-wrap; color: root.can-apply ? #73b98d : #dcaa59; }
            HorizontalLayout {
                spacing: 12px;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
                Rectangle { horizontal-stretch: 1; }
                Button { text: "Apply rename"; enabled: root.can-apply; clicked => { root.apply(); } }
            }
        }
    }
}

export component EntityWindow inherits Window {
    title: root.brush-mode ? "Brush Entity - HammeRR" : "Place Entity - HammeRR";
    preferred-width: 900px;
    preferred-height: 700px;
    in property <bool> brush-mode;
    in property <[EntityClassRow]> classes;
    in property <string> definition;
    in property <string> catalog-status;
    in property <string> message;
    in-out property <string> filter;
    in-out property <string> classname;
    in-out property <string> origin-x;
    in-out property <string> origin-y;
    in-out property <string> origin-z;
    callback filter-changed();
    callback class-selected();
    callback pick-surface();
    callback create();
    callback load-fgd();
    callback cancel();

    forward-focus: dialog-focus;
    dialog-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); accept } else { reject }
        }
        VerticalLayout {
            padding: 12px;
            spacing: 10px;
            HorizontalLayout {
                LineEdit {
                    placeholder-text: "Search classes or descriptions";
                    input-type: search;
                    text <=> root.filter;
                    edited => { root.filter-changed(); }
                }
                Button { text: "Load FGD…"; clicked => { root.load-fgd(); } }
            }
            Text { text: root.catalog-status; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 12px;
                vertical-stretch: 1;
                ListView {
                    width: 280px;
                    for class in root.classes: VerticalLayout {
                        padding-bottom: 4px;
                        Button {
                            text: class.classname;
                            clicked => {
                                root.classname = class.classname;
                                root.class-selected();
                            }
                        }
                    }
                }
                TextEdit { text: root.definition; read-only: true; wrap: word-wrap; }
            }
            LineEdit {
                placeholder-text: "Classname (custom classes are supported)";
                text <=> root.classname;
                edited => { root.class-selected(); }
            }
            if !root.brush-mode: HorizontalLayout {
                spacing: 6px;
                Text { text: "Position"; vertical-alignment: center; }
                LineEdit { text <=> root.origin-x; placeholder-text: "X"; }
                LineEdit { text <=> root.origin-y; placeholder-text: "Y"; }
                LineEdit { text <=> root.origin-z; placeholder-text: "Z"; }
            }
            Text { text: root.message; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 10px;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
                if !root.brush-mode: Button {
                    text: "Pick surface…";
                    enabled: root.classname != "";
                    clicked => { root.pick-surface(); }
                }
                Button {
                    text: root.brush-mode ? "Tie selected brushes to entity" : "Place entity";
                    enabled: root.classname != "";
                    clicked => { root.create(); }
                }
            }
        }
    }
}

export struct EntityFlag {
    label: string,
    value: string,
    checked: bool,
}

export component GameLogWindow inherits Window {
    title: "CS:S Game Log - HammeRR";
    preferred-width: 900px;
    preferred-height: 600px;
    in property <string> content;
    callback cancel();
    forward-focus: dialog-focus;
    dialog-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); accept } else { reject }
        }
        VerticalLayout {
            padding: 12px;
            TextEdit {
                text: root.content;
                read-only: true;
                font-family: "monospace";
                wrap: no-wrap;
            }
            Button { text: "Close"; clicked => { root.cancel(); } }
        }
    }
}

export struct KeyValue {
    key: string,
    value: string,
    label: string,
    description: string,
    type-name: string,
    numeric: bool,
    read-only: bool,
    choices: [string],
    choice-values: [string],
    choice-index: int,
    flags: [EntityFlag],
    control: string,
    advanced: bool,
    components: [string],
    component-labels: [string],
    swatch: color,
    has-intensity: bool,
    intensity: string,
    intensity-value: float,
    number-value: float,
    minimum: float,
    maximum: float,
}

export component ColorWindow inherits Window {
    title: "Choose Color - HammeRR";
    width: 500px;
    height: 490px;
    in property <string> field-label;
    in-out property <int> red;
    in-out property <int> green;
    in-out property <int> blue;
    in property <bool> has-intensity;
    in-out property <string> intensity;
    in-out property <float> brightness;
    in property <string> message;
    callback apply();
    callback cancel();
    forward-focus: dialog-focus;
    dialog-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); accept } else { reject }
        }
        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            alignment: start;
            Text { text: root.field-label; font-size: 18px; }
            Rectangle { height: 70px; background: rgb(root.red, root.green, root.blue); border-radius: 6px; }
            HorizontalLayout {
                spacing: 8px;
                for preset in [#ffd296, #ffffff, #8cbeff, #ff7070, #8aff9c, #000000]: Rectangle {
                    height: 30px;
                    background: preset;
                    border-radius: 4px;
                    TouchArea { clicked => { root.red = preset.red; root.green = preset.green; root.blue = preset.blue; } }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                Text { width: 45px; text: "Red"; vertical-alignment: center; }
                Slider { minimum: 0; maximum: 255; value: root.red; changed(value) => { root.red = round(value); } }
                SpinBox { width: 90px; minimum: 0; maximum: 255; value <=> root.red; }
            }
            HorizontalLayout {
                spacing: 10px;
                Text { width: 45px; text: "Green"; vertical-alignment: center; }
                Slider { minimum: 0; maximum: 255; value: root.green; changed(value) => { root.green = round(value); } }
                SpinBox { width: 90px; minimum: 0; maximum: 255; value <=> root.green; }
            }
            HorizontalLayout {
                spacing: 10px;
                Text { width: 45px; text: "Blue"; vertical-alignment: center; }
                Slider { minimum: 0; maximum: 255; value: root.blue; changed(value) => { root.blue = round(value); } }
                SpinBox { width: 90px; minimum: 0; maximum: 255; value <=> root.blue; }
            }
            if root.has-intensity: VerticalLayout {
                spacing: 6px;
                Text { text: "Brightness"; }
                HorizontalLayout {
                    spacing: 10px;
                    Slider { minimum: 0; maximum: max(1000, root.brightness); value: root.brightness; released(value) => { root.brightness = value; root.intensity = "\{value}"; } }
                    LineEdit { width: 100px; text <=> root.intensity; input-type: decimal; }
                }
            }
            Text { text: root.message; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 10px;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
                Button { text: "Apply color"; clicked => { root.apply(); } }
            }
        }
    }
}

export struct MaterialGroup { id: string, label: string }
export struct MaterialTile { name: string, preview: image, favorite: bool }
export struct MaterialTileRow { tiles: [MaterialTile] }

export component MaterialWindow inherits Window {
    in property <bool> sprite-resource;
    title: "Choose Material - HammeRR";
    preferred-width: 1180px;
    preferred-height: 760px;
    in-out property <string> filter;
    in-out property <string> material;
    in-out property <string> group: "all";
    in-out property <int> offset;
    in property <[MaterialGroup]> groups;
    in property <[MaterialTileRow]> rows;
    in property <int> total;
    in property <string> catalog-label;
    in property <string> favorites-status;
    in property <string> reload-status;
    in-out property <string> asset-generation;
    in property <bool> favorite;
    in property <image> preview;
    in-out property <int> preview-channel;
    in property <string> detail;
    in property <bool> available;
    callback search();
    callback preview-material();
    callback use-material();
    callback toggle-favorite();
    callback reload-material-assets();
    callback inspect-source();
    callback cancel();
    forward-focus: dialog-focus;
    dialog-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); accept } else { reject }
        }
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            LineEdit { placeholder-text: "Search materials across folders and categories"; text <=> root.filter; edited => { root.offset = 0; root.search(); } }
            HorizontalLayout {
                spacing: 16px;
                vertical-stretch: 1;
                ListView {
                    width: 210px;
                    for group in root.groups: Button {
                        text: group.label;
                        enabled: root.group != group.id;
                        clicked => { root.group = group.id; root.offset = 0; root.search(); }
                    }
                }
                VerticalLayout {
                    spacing: 8px;
                    Text { text: root.catalog-label; }
                    ListView {
                        vertical-stretch: 1;
                        for row in root.rows: HorizontalLayout {
                            spacing: 8px;
                            padding-bottom: 8px;
                            for tile in row.tiles: Rectangle {
                                width: 165px;
                                height: 170px;
                                background: root.material == tile.name ? #344653 : #252a33;
                                border-radius: 6px;
                                accessible-role: button;
                                accessible-label: tile.name;
                                accessible-action-default => { root.material = tile.name; root.preview-material(); }
                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 6px;
                                    Image { height: 110px; source: tile.preview; image-fit: contain; }
                                    Text { text: (tile.favorite ? "★ " : "") + tile.name; wrap: word-wrap; font-size: 11px; }
                                }
                                TouchArea { clicked => { root.material = tile.name; root.preview-material(); } }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: "Previous"; enabled: root.offset > 0; clicked => { root.offset = max(0, root.offset - 36); root.search(); } }
                        Button { text: "Next"; enabled: root.offset + 36 < root.total; clicked => { root.offset += 36; root.search(); } }
                    }
                }
                VerticalLayout {
                    width: 230px;
                    spacing: 10px;
                    Rectangle {
                        height: 220px;
                        background: #292c35;
                        preview-image := Image { width: parent.width; height: parent.height; source: root.preview; image-fit: contain; }
                        if !root.available: Text { text: "No texture preview"; horizontal-alignment: center; vertical-alignment: center; color: #aab0bb; }
                    }
                    HorizontalLayout {
                        Button { text: "Color"; enabled: root.preview-channel != 0; clicked => { root.preview-channel = 0; root.preview-material(); } }
                        Button { text: "Alpha"; enabled: root.preview-channel != 1; clicked => { root.preview-channel = 1; root.preview-material(); } }
                    }
                    details-scroll := ScrollView {
                        vertical-stretch: 1;
                        content-width: self.visible-width;
                        Text {
                            width: details-scroll.visible-width - 16px;
                            text: root.detail;
                            wrap: word-wrap;
                        }
                    }
                    Button { text: "Source…"; enabled: root.material != ""; clicked => { root.inspect-source(); } }
                    Button { text: root.favorite ? "Remove favorite" : "Add favorite"; enabled: root.material != ""; clicked => { root.toggle-favorite(); } }
                    favorites-state := Text { text: root.favorites-status; wrap: word-wrap; font-size: 11px; }
                }
            }
            if root.reload-status != "": ScrollView {
                height: 70px;
                Text { text: root.reload-status; wrap: word-wrap; vertical-alignment: top; }
            }
            LineEdit { text <=> root.material; placeholder-text: "Material path"; accepted => { root.preview-material(); } }
            HorizontalLayout {
                spacing: 10px;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
                Button { text: "Reload material assets"; clicked => { root.reload-material-assets(); } }
                Button { text: "Use material"; enabled: root.material != ""; clicked => { root.use-material(); } }
            }
        }
    }
}

export component TerrainWindow inherits Window {
    title: "Edit terrain";
    preferred-width: 520px;
    out property <length> operation-height: root.operation-index == 11 ? 470px : root.operation-index == 8 ? 540px : root.operation-index == 10 ? 480px : root.operation-index == 6 || root.operation-index == 7 ? 470px : root.operation-index == 0 || root.operation-index >= 6 ? 380px : 760px;
    preferred-height: root.operation-height;
    in property <string> selection-label;
    in property <string> message;
    in property <bool> stale;
    in property <bool> ready;
    in property <bool> mask-available;
    in property <string> mask-label;
    in-out property <bool> use-mask;
    in-out property <int> grid-index;
    in-out property <int> operation-index;
    in-out property <int> direction-index;
    in property <string> physics-current;
    in property <string> player-current;
    in property <string> ray-current;
    in-out property <int> physics-index;
    in-out property <int> player-index;
    in-out property <int> ray-index;
    in-out property <bool> sew-blend;
    in property <string> smoothing-current;
    in-out property <int> smoothing-index;
    in-out property <string> smoothing-angle: "45";
    in-out property <float> smoothing-slider: 45;
    in-out property <string> center-x: "0";
    in-out property <string> center-y: "0";
    in-out property <string> center-z: "0";
    in-out property <string> radius: "128";
    in-out property <string> amount: "16";
    in-out property <string> strength: "0.5";
    in-out property <string> blend-value: "128";
    in-out property <string> seed: "1";
    in-out property <string> vertex-x: "0";
    in-out property <string> vertex-y: "0";
    in-out property <string> vertex-z: "0";
    in-out property <float> radius-slider: 128;
    in-out property <float> amount-slider: 16;
    in-out property <float> strength-slider: 0.5;
    in-out property <float> blend-slider: 128;
    callback edited();
    callback preview-edit();
    callback apply();
    callback cancel();
    callback pick-center();
    callback draw-stroke();
    callback move-handles();
    forward-focus: dialog-focus;
    dialog-focus := FocusScope {
        key-pressed(event) => { if event.text == Key.Escape {root.cancel(); accept} else {reject} }
        VerticalLayout {
            padding: 20px;
            spacing: 14px;
            Text {text: root.selection-label; font-size: 17px; wrap: word-wrap;}
            Text {text: "Operation";}
            ComboBox {model:["Grid resolution", "Raise / lower", "Flatten", "Smooth", "Noise", "Paint blend", "Fill blend", "Invert blend", "Collision", "Sew borders & corners", "Border smoothing", "Move selected vertices", "Subdivide base cage"]; current-index <=> root.operation-index; enabled: !root.stale; selected => {root.edited();}}
            if root.operation-index == 11: VerticalLayout {
                spacing:8px;
                Text {text:root.mask-label;wrap:word-wrap;color:#b6bac3;}
                Text {text:"World offset · units";}
                HorizontalLayout {
                    spacing:8px;
                    Text {text:"X";vertical-alignment:center;}
                    LineEdit {preferred-width:100px;min-width:0px;horizontal-stretch:1;text <=> root.vertex-x;enabled:root.mask-available && !root.stale;edited=>{root.edited();}}
                    Text {text:"Y";vertical-alignment:center;}
                    LineEdit {preferred-width:100px;min-width:0px;horizontal-stretch:1;text <=> root.vertex-y;enabled:root.mask-available && !root.stale;edited=>{root.edited();}}
                    Text {text:"Z";vertical-alignment:center;}
                    LineEdit {preferred-width:100px;min-width:0px;horizontal-stretch:1;text <=> root.vertex-z;enabled:root.mask-available && !root.stale;edited=>{root.edited();}}
                }
                Text {text:"Moves only the retained vertex selection by exact world coordinates. X/Y reshape the terrain sideways; Z changes height. Each offset can be −4096 to 4096 units. Neighboring triangles follow their shared vertices.";wrap:word-wrap;color:#b6bac3;}
                Button {text:"Move with handles…";enabled:root.mask-available && !root.stale;clicked=>{root.move-handles();}}
                Text {text:"Drag an axis or plane, then review with Apply or Cancel. Handles follow the editor's grid snapping.";wrap:word-wrap;color:#b6bac3;font-size:12px;}
            }
            if root.operation-index >= 1 && root.operation-index <= 7: VerticalLayout {
                spacing: 4px;
                CheckBox {text:"Affect only selected terrain vertices";checked <=> root.use-mask;enabled:root.mask-available && !root.stale;toggled=>{root.edited();}}
                Text {text:root.mask-label;wrap:word-wrap;color:#a7adb8;font-size:12px;}
            }
            if root.operation-index == 0: VerticalLayout {
                spacing: 12px;
                Text {text: "Grid resolution";}
                ComboBox {model: ["5 × 5 · power 2", "9 × 9 · power 3", "17 × 17 · power 4"]; current-index <=> root.grid-index; enabled: !root.stale; selected => {root.edited();}}
                Text {text: "Finer grids keep existing height and blend samples. Coarser grids can lose detail. Start corner, materials and mapping stay fixed."; wrap: word-wrap; color: #b6bac3;}
            }
            if root.operation-index >= 1 && root.operation-index <= 5: VerticalLayout {
                spacing: 8px;
                Text {text: "Brush center · world coordinates";}
                HorizontalLayout {
                    spacing: 8px;
                    Text {text: "X"; vertical-alignment: center;} LineEdit {text <=> root.center-x; edited => {root.edited();}}
                    Text {text: "Y"; vertical-alignment: center;} LineEdit {text <=> root.center-y; edited => {root.edited();}}
                    Text {text: "Z"; vertical-alignment: center;} LineEdit {text <=> root.center-z; edited => {root.edited();}}
                }
                Button {text:"Pick center in viewport…"; enabled:!root.stale; clicked=>{root.pick-center();}}
                Text {text: "Brush direction";}
                ComboBox {model:["Up / down · world Z", "Along the face normal"]; current-index <=> root.direction-index; selected => {root.edited();}}
                Text {text: "Radius · world units";}
                HorizontalLayout {
                    spacing: 12px;
                    Slider {minimum:1; maximum:max(512,root.radius-slider); value:root.radius-slider; released(value)=>{root.radius="\{value}";root.edited();}}
                    LineEdit {preferred-width:90px; horizontal-stretch:0; text <=> root.radius; edited=>{root.edited();}}
                }
            }
            if root.operation-index == 1 || root.operation-index == 4: VerticalLayout {
                spacing: 8px;
                Text {text:root.operation-index == 1 ? "Height change · negative lowers" : "Noise amount · world units";}
                HorizontalLayout {
                    spacing:12px;
                    Slider {minimum:-max(128,abs(root.amount-slider)); maximum:max(128,abs(root.amount-slider)); value:root.amount-slider; released(value)=>{root.amount="\{value}";root.edited();}}
                    LineEdit {preferred-width:90px; horizontal-stretch:0; text <=> root.amount; edited=>{root.edited();}}
                }
            }
            if root.operation-index == 2 || root.operation-index == 3 || root.operation-index == 5: VerticalLayout {
                spacing:8px;
                Text {text:"Strength · 0 leaves terrain unchanged, 1 applies fully"; wrap:word-wrap;}
                HorizontalLayout {
                    spacing:12px;
                    Slider {minimum:0; maximum:1; value:root.strength-slider; released(value)=>{root.strength="\{value}";root.edited();}}
                    LineEdit {preferred-width:90px; horizontal-stretch:0; text <=> root.strength; edited=>{root.edited();}}
                }
            }
            if root.operation-index == 4: HorizontalLayout {
                spacing:12px;
                Text {text:"Noise seed"; vertical-alignment:center;}
                LineEdit {text <=> root.seed; edited=>{root.edited();}}
            }
            if root.operation-index == 5 || root.operation-index == 6: VerticalLayout {
                spacing:8px;
                Text {text:"Blend value · 0 first texture, 255 second texture"; wrap:word-wrap;}
                HorizontalLayout {
                    spacing:12px;
                    Slider {minimum:0; maximum:255; value:root.blend-slider; released(value)=>{root.blend-value="\{value}";root.edited();}}
                    LineEdit {preferred-width:90px; horizontal-stretch:0; text <=> root.blend-value; edited=>{root.edited();}}
                }
            }
            if root.operation-index == 8: VerticalLayout {
                spacing:8px;
                Text {text:"Physics collision · currently " + root.physics-current; wrap:word-wrap;}
                ComboBox {model:["Keep current", "Enabled", "Disabled"]; current-index <=> root.physics-index; selected=>{root.edited();}}
                Text {text:"Player collision · currently " + root.player-current;}
                ComboBox {model:["Keep current", "Enabled", "Disabled"]; current-index <=> root.player-index; selected=>{root.edited();}}
                Text {text:"Ray collision · currently " + root.ray-current;}
                ComboBox {model:["Keep current", "Enabled", "Disabled"]; current-index <=> root.ray-index; selected=>{root.edited();}}
            }
            if root.operation-index == 10: VerticalLayout {
                spacing: 10px;
                Text {text:"Border smoothing · currently " + root.smoothing-current; wrap:word-wrap;}
                ComboBox {model:["Automatic", "Hard borders", "Angle limit"]; current-index <=> root.smoothing-index; selected=>{root.edited();}}
                if root.smoothing-index == 2: VerticalLayout {
                    spacing:8px;
                    Text {text:"Maximum angle · degrees";}
                    HorizontalLayout {
                        spacing:12px;
                        Slider {minimum:0;maximum:180;value:root.smoothing-slider;released(value)=>{root.smoothing-angle="\{value}";root.edited();}}
                        LineEdit {preferred-width:90px;horizontal-stretch:0;text <=> root.smoothing-angle;edited=>{root.edited();}}
                    }
                }
                Text {text:"Changes border shading in the viewport and Direct LDR builds. Both neighboring surfaces must allow the blend. Geometry and collision stay fixed."; wrap:word-wrap;color:#b6bac3;}
            }
            if root.operation-index == 9: CheckBox {text:"Also sew blend values"; checked <=> root.sew-blend; toggled=>{root.edited();}}
            if root.operation-index == 12: Text {text:"Round the selected base faces into a connected surface. Replaces existing sculpting; preserves blend values and materials. Matching full edges share samples. Outer base edges stay fixed.";wrap:word-wrap;color:#b6bac3;}
            if root.operation-index == 12: Text {text:"Select every base face you want rounded. Half-edge junctions and corner-only contacts need separate actions. Powers and start corners stay fixed.";wrap:word-wrap;color:#b6bac3;font-size:12px;}
            if root.operation-index != 0 && root.operation-index != 10 && root.operation-index != 11 && root.operation-index != 12: Text {text:root.operation-index == 9 ? "Join full/half borders or matching corners at different resolutions. Shared points are averaged; finer border points follow the coarser grid. Interior vertices stay fixed." : root.operation-index == 8 ? "Keep current preserves each face. Geometry, blend values and other flags stay fixed. Individual triangle removal is separate." : root.operation-index == 2 ? "Flatten moves toward the plane through the brush center. Center Z sets its height with world-Z direction." : root.operation-index == 3 ? "Smooth uses the original neighboring samples. A brush fades toward its edge." : root.operation-index == 4 ? "The same seed and source give the same noise preview. A brush fades toward its edge." : root.operation-index == 5 ? "Paint moves blend values toward the chosen value, fading toward the brush edge. Choose a two-texture material to see the blend." : root.operation-index == 6 ? "Fill applies one blend value to the complete selected terrain grids." : root.operation-index == 7 ? "Invert swaps first- and second-texture weights across the complete grids." : "Raise / lower follows the chosen direction and fades toward the brush edge."; wrap:word-wrap; color:#b6bac3;}
            Rectangle {vertical-stretch: 1;}
            if root.operation-index >= 1 && root.operation-index <= 5: Text {text:"A stroke applies this brush at each sample. Overlapping samples build up the edit.";wrap:word-wrap;font-size:12px;color:#b6bac3;}
            if root.operation-index >= 1 && root.operation-index <= 5: Button {text:"Draw stroke in viewport…";enabled:!root.stale;clicked=>{root.draw-stroke();}}
            Text {text: root.message; wrap: word-wrap; color: #a7adb8;}
            HorizontalLayout {
                spacing: 8px;
                Button {text: "Cancel"; clicked => {root.cancel();}}
                Button {text: "Preview"; enabled: !root.stale; clicked => {root.preview-edit();}}
                Button {text: "Apply"; enabled: !root.stale && root.ready; clicked => {root.apply();}}
            }
        }
    }
}

export component SurfaceWindow inherits Window {
    title: "Face Textures - HammeRR";
    preferred-width: 620px;
    preferred-height: 760px;
    in property <string> selection-label;
    in property <string> message;
    in property <bool> stale;
    in property <bool> sample-present;
    in property <string> sample-label;
    in property <image> sample-preview;
    in-out property <int> operation-index;
    in-out property <int> alignment-index;
    in-out property <int> justify-u-index;
    in-out property <int> justify-v-index;
    in-out property <string> material;
    in property <image> preview;
    in-out property <string> shift-u;
    in-out property <string> shift-v;
    in-out property <string> scale-u;
    in-out property <string> scale-v;
    in-out property <string> rotation;
    in-out property <bool> fit;
    in-out property <bool> direct-vectors;
    in-out property <string> u-x;
    in-out property <string> u-y;
    in-out property <string> u-z;
    in-out property <string> v-x;
    in-out property <string> v-y;
    in-out property <string> v-z;
    in-out property <bool> ready;
    in-out property <string> reviewed-fields;
    in-out property <string> reviewed-token;
    in-out property <string> owned-token;
    callback browse();
    callback fit-atlas();
    callback preview-edit();
    callback apply();
    callback cancel();
    forward-focus: dialog-focus;
    dialog-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); accept } else { reject }
        }
        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text { text: root.selection-label; font-size: 18px; }
            ComboBox {
                model: ["Edit texture settings", "Paint sampled material", "Copy sampled projection", "Wrap across a shared edge", "Wrap connected faces"];
                current-index <=> root.operation-index;
                selected => { root.ready = false; }
            }
            if root.operation-index != 0: VerticalLayout {
                spacing: 16px;
                HorizontalLayout {
                    spacing: 16px;
                    Image { width: 96px; height: 96px; source: root.sample-preview; image-fit: contain; }
                    VerticalLayout {
                        spacing: 8px;
                        Text { text: "Sampled texture"; font-size: 16px; }
                        Text { text: root.sample-label; wrap: word-wrap; color: #c8ccd4; }
                    }
                }
                Text {
                    text: root.operation-index == 1 ? "Apply the sampled material. Keep the target faces' offsets, scale and rotation." : root.operation-index == 2 ? "Copy the material and its world-space texture projection. Useful for matching parallel surfaces." : root.operation-index == 3 ? "Fold the sampled projection around each shared edge so the texture meets continuously. Each target must touch the sampled face." : "Carry the sampled texture through connected faces, folding it at each shared edge. Include intermediate faces. Disconnected targets and closed loops that need a seam are rejected; select an open strip to leave a seam.";
                    wrap: word-wrap;
                }
                Text { text: "The sample keeps its captured values even if the source is edited. Sample again to refresh it."; color: #969ca8; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; }
            }
            if root.operation-index == 0: ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 10px;
                    Text { text: "Blank fields keep each face's current value."; color: #969ca8; }
                    HorizontalLayout {
                        spacing: 12px;
                        Image { width: 72px; height: 72px; source: root.preview; image-fit: contain; }
                        VerticalLayout {
                            spacing: 6px;
                            Text { text: "Material"; }
                            LineEdit { text <=> root.material; placeholder-text: "Mixed · keep current materials"; edited => { root.ready = false; } }
                            Button { text: "Browse materials…"; clicked => { root.browse(); } }
                            Button { text: "Fit atlas region…"; clicked => { root.fit-atlas(); } }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text { text: "Projection"; vertical-alignment: center; }
                        ComboBox {
                            enabled: !root.direct-vectors;
                            model: ["Keep current axes", "Align to world", "Align to face"];
                            current-index <=> root.alignment-index;
                            selected => { if self.current-index != 0 { root.rotation = "0"; } root.ready = false; }
                        }
                    }
                    Text { text: "Offset · texture pixels"; }
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Horizontal"; vertical-alignment: center; }
                        LineEdit { text <=> root.shift-u; input-type: decimal; placeholder-text: "Keep"; edited => { root.ready = false; } }
                        Text { text: "Vertical"; vertical-alignment: center; }
                        LineEdit { text <=> root.shift-v; input-type: decimal; placeholder-text: "Keep"; edited => { root.ready = false; } }
                    }
                    Text { text: "Scale · world units per texture pixel"; }
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Horizontal"; vertical-alignment: center; }
                        LineEdit { text <=> root.scale-u; input-type: decimal; placeholder-text: "Keep"; edited => { root.ready = false; } }
                        Text { text: "Vertical"; vertical-alignment: center; }
                        LineEdit { text <=> root.scale-v; input-type: decimal; placeholder-text: "Keep"; edited => { root.ready = false; } }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Rotation · degrees"; vertical-alignment: center; }
                        LineEdit { enabled: !root.direct-vectors; text <=> root.rotation; input-type: decimal; placeholder-text: "Keep"; edited => { root.ready = false; } }
                    }
                    Slider {
                        enabled: !root.direct-vectors;
                        minimum: -180; maximum: 180;
                        value: root.rotation == "" ? 0 : root.rotation.to-float();
                        released(value) => { root.rotation = "\{round(value)}"; root.ready = false; }
                    }
                    CheckBox { text: "Advanced U/V world vectors"; checked <=> root.direct-vectors; toggled => { root.ready = false; } }
                    if root.direct-vectors: VerticalLayout {
                        spacing: 8px;
                        Text { text: "U runs horizontally across the texture; V runs vertically. Components use world X, Y and Z. Blank keeps each face’s value."; wrap: word-wrap; color: #b6bac3; }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { width: 16px; text: ""; }
                            Text { text: "X"; horizontal-stretch: 1; }
                            Text { text: "Y"; horizontal-stretch: 1; }
                            Text { text: "Z"; horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { width: 16px; text: "U"; vertical-alignment: center; }
                            LineEdit { text <=> root.u-x; input-type: decimal; placeholder-text: "X · mixed / keep"; accessible-label: "U vector X"; edited => { root.ready = false; } }
                            LineEdit { text <=> root.u-y; input-type: decimal; placeholder-text: "Y · mixed / keep"; accessible-label: "U vector Y"; edited => { root.ready = false; } }
                            LineEdit { text <=> root.u-z; input-type: decimal; placeholder-text: "Z · mixed / keep"; accessible-label: "U vector Z"; edited => { root.ready = false; } }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { width: 16px; text: "V"; vertical-alignment: center; }
                            LineEdit { text <=> root.v-x; input-type: decimal; placeholder-text: "X · mixed / keep"; accessible-label: "V vector X"; edited => { root.ready = false; } }
                            LineEdit { text <=> root.v-y; input-type: decimal; placeholder-text: "Y · mixed / keep"; accessible-label: "V vector Y"; edited => { root.ready = false; } }
                            LineEdit { text <=> root.v-z; input-type: decimal; placeholder-text: "Z · mixed / keep"; accessible-label: "V vector Z"; edited => { root.ready = false; } }
                        }
                        Text { text: "Component magnitudes are preserved. Click Preview textures before Apply textures."; wrap: word-wrap; color: #b6bac3; }
                    }
                    CheckBox { text: "Fit one texture tile to each face"; checked <=> root.fit; toggled => { root.ready = false; } }
                    Text { text: "Placement within a texture tile · keeps scale"; }
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Horizontal"; vertical-alignment: center; }
                        ComboBox { model: ["Keep offset", "Left", "Center", "Right"]; current-index <=> root.justify-u-index; selected => { root.ready = false; } }
                        Text { text: "Vertical"; vertical-alignment: center; }
                        ComboBox { model: ["Keep offset", "Top", "Center", "Bottom"]; current-index <=> root.justify-v-index; selected => { root.ready = false; } }
                    }
                }
            }
            Text { text: root.message; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 10px;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
                Button { text: "Preview textures"; enabled: !root.stale && (root.operation-index == 0 || root.sample-present); clicked => { root.preview-edit(); } }
                Button { text: "Apply textures"; enabled: !root.stale && (root.operation-index == 0 || root.sample-present) && (root.operation-index != 0 || !root.direct-vectors || root.ready); clicked => { root.apply(); } }
            }
        }
    }
}

component PropertyField inherits VerticalLayout {
    in property <KeyValue> field;
    in property <bool> advanced;
    in property <bool> model-browsing;
    property <bool> show-help;
    callback edited(string);
    callback component-edited(int, string);
    callback removed();
    callback flag-toggled(string, bool);
    callback pick-color();
    callback pick-material();
    callback pick-model();
    callback pick-sound();
    callback pick-particle();
    spacing: 5px;
    padding-bottom: 12px;
    HorizontalLayout {
        Text { text: root.field.label; color: #d8dce4; vertical-alignment: center; horizontal-stretch: 1; }
        if root.field.description != "": Button { text: "?"; width: 24px; clicked => { root.show-help = !root.show-help; } }
    }
    if root.advanced: Text { text: root.field.key + " · " + root.field.type-name; color: #8a909c; font-size: 11px; }
    if root.field.control == "choices": ComboBox {
        model: root.field.choices;
        current-index: root.field.choice-index;
        enabled: !root.field.read-only;
        selected => { root.edited(root.field.choice-values[self.current-index]); }
    }
    if root.field.control == "boolean": CheckBox {
        text: "Enabled";
        checked: root.field.value == "1";
        enabled: !root.field.read-only;
        toggled => { root.edited(self.checked ? "1" : "0"); }
    }
    if root.field.control == "flags": VerticalLayout {
        spacing: 3px;
        for flag in root.field.flags: CheckBox {
            text: flag.label;
            checked: flag.checked;
            enabled: !root.field.read-only;
            toggled => { root.flag-toggled(flag.value, self.checked); }
        }
    }
    if root.field.control == "vector": HorizontalLayout {
        spacing: 6px;
        for component[index] in root.field.components: VerticalLayout {
            spacing: 3px;
            width: (parent.width - 12px) / 3;
            Text { text: root.field.component-labels[index]; color: #8a909c; font-size: 11px; }
            LineEdit { min-width: 0px; text: component; input-type: decimal; enabled: !root.field.read-only; accepted(value) => { root.component-edited(index, value); } }
        }
    }
    if root.field.control == "color": VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            Rectangle { width: 38px; height: 30px; background: root.field.swatch; border-radius: 4px; TouchArea { enabled: !root.field.read-only; clicked => { root.pick-color(); } } }
            Button { text: "Choose color…"; horizontal-stretch: 1; enabled: !root.field.read-only; clicked => { root.pick-color(); } }
        }
        if root.field.has-intensity: VerticalLayout {
            spacing: 5px;
            Text { text: "Brightness"; color: #aab0bb; }
            HorizontalLayout {
                spacing: 8px;
                Slider { minimum: 0; maximum: max(1000, root.field.intensity-value); value: root.field.intensity-value; enabled: !root.field.read-only; released(value) => { root.component-edited(3, "\{value}"); } }
                LineEdit { width: 90px; text: root.field.intensity; input-type: decimal; enabled: !root.field.read-only; accepted(value) => { root.component-edited(3, value); } }
            }
        }
    }
    if root.field.control == "slider": Slider {
        value: root.field.number-value;
        minimum: root.field.minimum;
        maximum: root.field.maximum;
        enabled: !root.field.read-only;
        released(value) => { root.edited(root.field.type-name == "integer" ? "\{round(value)}" : "\{value}"); }
    }
    if root.field.control == "text" || root.field.control == "number" || root.field.control == "slider" || root.field.control == "material" || root.field.control == "model" || root.field.control == "sound" || root.field.control == "particle": HorizontalLayout {
        spacing: 6px;
        LineEdit {
            horizontal-stretch: 1;
            text: root.field.value;
            enabled: !root.field.read-only;
            input-type: root.field.numeric ? InputType.decimal : InputType.text;
            accepted(value) => { root.edited(value); }
        }
        if root.field.control == "material": Button { text: "Browse…"; enabled: !root.field.read-only; clicked => { root.pick-material(); } }
        if root.field.control == "model" && root.model-browsing: Button { text: "Browse…"; enabled: !root.field.read-only; clicked => { root.pick-model(); } }
        if root.field.control == "sound" && root.model-browsing: Button { text: "Browse…"; enabled: !root.field.read-only; clicked => { root.pick-sound(); } }
        if root.field.control == "particle" && root.model-browsing: Button { text: "Browse…"; enabled: !root.field.read-only; clicked => { root.pick-particle(); } }
    }
    if root.show-help: Text { text: root.field.description; wrap: word-wrap; color: #8a909c; font-size: 12px; }
    if root.advanced && (root.field.control == "color" || root.field.control == "vector" || root.field.control == "flags"): LineEdit {
        text: root.field.value;
        placeholder-text: "Stored value";
        enabled: !root.field.read-only;
        accepted(value) => { root.edited(value); }
    }
    if root.advanced: Button { text: "Remove property"; enabled: root.field.key != "classname" && !root.field.read-only; clicked => { root.removed(); } }
}

export struct ManagedFieldRow {
    field: KeyValue,
    status: string,
    can-reset: bool,
}

export component PropertiesWindow inherits Window {
    title: "Properties - HammeRR";
    preferred-width: 740px;
    preferred-height: 780px;
    in-out property <string> draft-token;
    in property <string> heading;
    in property <string> summary;
    in property <string> message;
    in property <bool> can-apply;
    in property <[ManagedFieldRow]> fields;
    in property <bool> world-settings;
    in-out property <string> filter;
    in-out property <string> custom-key;
    in-out property <string> custom-value;
    callback search();
    callback edit(string, string);
    callback component-edit(string, int, string);
    callback flag-edit(string, string, bool);
    callback reset(string);
    callback remove(string);
    callback pick-color(string);
    callback pick-material(string);
    callback inspect-sky-assets();
    callback apply();
    callback cancel();
    forward-focus: dialog-focus;
    dialog-focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => { if event.text == Key.Escape { root.cancel(); accept } else { reject } }
        VerticalLayout {
            padding: 20px; spacing: 12px;
            Text { text: root.heading; font-size: 23px; font-weight: 600; }
            Text { text: root.summary; wrap: word-wrap; }
            if root.world-settings: Button {
                text: "Inspect applied sky…";
                clicked => { root.inspect-sky-assets(); }
            }
            LineEdit { text <=> root.filter; placeholder-text: "Find a property…"; edited => { root.search(); } }
            ListView {
                for row in root.fields: VerticalLayout {
                    padding-bottom: 16px; spacing: 6px;
                    PropertyField {
                        field: row.field;
                        edited(value) => { root.edit(row.field.key, value); }
                        component-edited(index, value) => { root.component-edit(row.field.key, index, value); }
                        flag-toggled(flag, checked) => { root.flag-edit(row.field.key, flag, checked); }
                        pick-color => { root.pick-color(row.field.key); }
                        pick-material => { root.pick-material(row.field.key); }
                    }
                    Text { text: row.status; wrap: word-wrap; color: #aab0bb; font-size: 12px; }
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: "Use default"; enabled: row.can-reset && !row.field.read-only; clicked => { root.reset(row.field.key); } }
                        Button { text: "Remove override"; enabled: !row.field.read-only; clicked => { root.remove(row.field.key); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                LineEdit { text <=> root.custom-key; placeholder-text: "Custom property key"; }
                LineEdit { text <=> root.custom-value; placeholder-text: "Value"; }
                Button { text: "Stage value"; enabled: root.custom-key != ""; clicked => { root.edit(root.custom-key, root.custom-value); } }
            }
            Text { text: root.message; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 10px;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
                Button { text: "Apply properties"; enabled: root.can-apply; clicked => { root.apply(); } }
            }
        }
    }
}

export struct ObjectReportRow { id: string, label: string, detail: string }

export struct RecoveryRow { id: string, title: string, detail: string }

export struct CheckIssueRow { id: string, title: string, location: string, severity: string }

export component ChecksWindow inherits Window {
    title: "Map checks - HammeRR";
    preferred-width: 1040px; preferred-height: 760px;
    in-out property <string> query;
    in-out property <int> severity;
    in-out property <int> page;
    in property <bool> has-next;
    in property <bool> stale;
    in property <string> summary;
    in property <string> page-summary;
    in property <[CheckIssueRow]> rows;
    in-out property <string> report-token;
    in-out property <string> selected-id;
    in property <string> detail-title;
    in property <string> detail;
    in property <string> location;
    in property <bool> can-select;
    in property <bool> can-repair;
    in property <string> preview-token;
    in property <string> preview-text;
    in property <string> message;
    in property <float> aspect: 1.6;
    callback run-checks();
    callback filter();
    callback inspect(string);
    callback navigate(bool);
    callback review-repair();
    callback apply-repair();
    callback cancel-repair();
    callback cancel();
    forward-focus: dialog-focus;
    dialog-focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => { if event.text == Key.Escape { root.cancel(); accept } else { reject } }
        VerticalLayout {
            padding: 20px; spacing: 12px;
            HorizontalLayout {
                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Map checks"; font-size: 24px; font-weight: 600; }
                    Text { text: root.summary; color: #b5c0ce; }
                }
                Button { text: "Run checks"; clicked => { root.run-checks(); } }
            }
            if root.stale: Text { text: "Results are out of date. Run checks again before selecting or repairing an issue."; color: #efa47c; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 10px;
                LineEdit { text <=> root.query; placeholder-text: "Search issues…"; edited => { root.page = 0; root.filter(); } }
                ComboBox { model: ["All severities", "Errors", "Warnings", "Notes"]; current-index <=> root.severity; selected => { root.page = 0; root.filter(); } }
            }
            HorizontalLayout {
                spacing: 18px;
                VerticalLayout {
                    horizontal-stretch: 1; min-width: 390px; spacing: 8px;
                    ScrollView {
                        VerticalLayout {
                            spacing: 6px;
                            for row in root.rows: Button {
                                text: (row.severity == "error" ? "Error · " : row.severity == "warning" ? "Warning · " : "Note · ") + row.title + "\n" + row.location;
                                checked: root.selected-id == row.id;
                                height: 62px;
                                clicked => { root.inspect(row.id); }
                            }
                        }
                    }
                    Text { text: root.page-summary; color: #8a909c; font-size: 12px; }
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: "Previous"; enabled: root.page > 0; clicked => { root.page -= 1; root.filter(); } }
                        Button { text: "Next"; enabled: root.has-next; clicked => { root.page += 1; root.filter(); } }
                    }
                }
                Rectangle { width: 1px; background: #343940; }
                VerticalLayout {
                    horizontal-stretch: 1; min-width: 450px; spacing: 12px;
                    Text { text: root.detail-title; font-size: 19px; font-weight: 600; wrap: word-wrap; }
                    Text { text: root.detail; wrap: word-wrap; }
                    Text { text: root.location; color: #9da7b5; wrap: word-wrap; font-size: 12px; }
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: "Select issue"; enabled: root.can-select; clicked => { root.navigate(false); } }
                        Button { text: "Focus issue"; enabled: root.can-select; clicked => { root.navigate(true); } }
                    }
                    Button { text: "Review repair…"; enabled: root.can-repair; clicked => { root.review-repair(); } }
                    if root.preview-token != "": VerticalLayout {
                        spacing: 8px;
                        Text { text: "Proposed repair"; font-size: 16px; font-weight: 600; }
                        TextEdit { text: root.preview-text; read-only: true; wrap: word-wrap; preferred-height: 140px; max-height: 230px; }
                        Text { text: "Apply records one undo step. Cancel leaves the map unchanged."; wrap: word-wrap; color: #9da7b5; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Cancel repair"; clicked => { root.cancel-repair(); } }
                            Button { text: "Apply repair"; enabled: !root.stale; clicked => { root.apply-repair(); } }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
            if root.message != "": Text { text: root.message; color: #efa47c; wrap: word-wrap; }
            Text { text: "Checks include hidden objects and exclude pending edits. Compile and test in CS:S to check leaks and playability."; color: #8a909c; font-size: 12px; wrap: word-wrap; }
            Button { text: "Cancel / close"; clicked => { root.cancel(); } }
        }
    }
}

export struct RecentMapRow { path: string, title: string, detail: string }

export component RecentMapsWindow inherits Window {
    title: "Recent maps - HammeRR";
    preferred-width: 760px;
    preferred-height: 720px;
    in property <[RecentMapRow]> rows;
    in property <string> summary;
    in property <string> selected-detail;
    in property <bool> selected-available;
    in property <bool> writable;
    in property <bool> dirty-map;
    in property <string> warning;
    in property <string> message;
    in-out property <string> selected-path;
    in-out property <string> map-guard;
    in-out property <bool> discard-changes;
    in-out property <bool> confirm-clear;
    callback select-map(string);
    callback open-selected();
    callback remove-selected();
    callback clear-list();
    callback refresh();
    callback cancel();
    forward-focus: dialog-focus;
    dialog-focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => { if event.text == Key.Escape { root.cancel(); accept } else { reject } }
        VerticalLayout {
            padding: 20px; spacing: 10px;
            Text { text: "Recent maps"; font-size: 23px; font-weight: 600; }
            Text { text: "Reopen a map with its retained build settings. Game content stays mounted from this editor session."; wrap: word-wrap; color: #aab0bb; }
            HorizontalLayout {
                Text { text: root.summary; horizontal-stretch: 1; vertical-alignment: center; }
                Button { text: "Refresh list"; clicked => { root.refresh(); } }
            }
            ListView {
                min-height: 140px;
                for row in root.rows: VerticalLayout {
                    spacing: 3px; padding-bottom: 10px;
                    Button { text: row.title + (root.selected-path == row.path ? " · selected" : ""); clicked => { root.select-map(row.path); } }
                    Text { text: row.path; wrap: word-wrap; color: #c8ccd4; font-size: 12px; }
                    Text { text: row.detail; color: #aab0bb; font-size: 12px; }
                }
            }
            Text { text: root.selected-detail; wrap: word-wrap; color: #c8ccd4; }
            if root.dirty-map: CheckBox { text: "Discard current unsaved edits when opening"; checked <=> root.discard-changes; }
            HorizontalLayout {
                spacing: 10px;
                Button { text: "Open selected map"; enabled: root.selected-available && (!root.dirty-map || root.discard-changes); clicked => { root.open-selected(); } }
                Button { text: "Remove from list"; enabled: root.writable && root.selected-path != ""; clicked => { root.remove-selected(); } }
            }
            HorizontalLayout {
                spacing: 10px;
                CheckBox { text: "Confirm clear list"; checked <=> root.confirm-clear; }
                Button { text: "Clear list"; enabled: root.writable && root.confirm-clear && root.rows.length > 0; clicked => { root.clear-list(); } }
            }
            if root.warning != "": Text { text: root.warning; wrap: word-wrap; color: #efa47c; }
            if root.message != "": Text { text: root.message; wrap: word-wrap; }
            Button { text: "Cancel / close"; clicked => { root.cancel(); } }
        }
    }
}

export component RecoveryWindow inherits Window {
    title: "Recovery - HammeRR";
    preferred-width: 780px;
    preferred-height: 790px;
    in property <bool> available;
    in property <bool> busy;
    in property <bool> dirty-map;
    in property <string> status;
    in property <string> storage;
    in property <string> warning;
    in property <string> message;
    in property <string> summary;
    in property <string> selected-detail;
    in property <[RecoveryRow]> rows;
    in property <bool> has-next;
    in-out property <string> settings-revision;
    in-out property <bool> autosave-enabled;
    in-out property <int> interval-seconds: 120;
    in-out property <int> keep-count: 10;
    in-out property <bool> settings-dirty;
    in-out property <bool> current-map-only;
    in-out property <int> page;
    in-out property <string> selected-id;
    in-out property <bool> confirm-delete;
    in-out property <bool> discard-changes;
    in-out property <string> map-generation;
    in-out property <string> map-revision;
    callback refresh();
    callback reload-settings();
    callback apply-settings();
    callback select-snapshot(string);
    callback snapshot-now();
    callback restore-snapshot();
    callback delete-snapshot();
    callback cancel();
    forward-focus: dialog-focus;
    dialog-focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => { if event.text == Key.Escape { root.cancel(); accept } else { reject } }
        VerticalLayout {
            padding: 20px; spacing: 10px;
            Text { text: "Autosave and recovery"; font-size: 23px; font-weight: 600; }
            Text { text: root.status; color: #b9cadc; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 12px;
                CheckBox { text: "Autosave changes"; checked <=> root.autosave-enabled; toggled => { root.settings-dirty = true; } }
                Text { text: "Every (seconds)"; vertical-alignment: center; }
                SpinBox { value <=> root.interval-seconds; minimum: 30; maximum: 3600; edited => { root.settings-dirty = true; } }
                Text { text: "Keep per map"; vertical-alignment: center; }
                SpinBox { value <=> root.keep-count; minimum: 1; maximum: 50; edited => { root.settings-dirty = true; } }
            }
            HorizontalLayout {
                spacing: 10px;
                Button { text: "Reload settings"; clicked => { root.reload-settings(); } }
                Button { text: "Apply settings"; enabled: root.available && root.settings-dirty; clicked => { root.apply-settings(); } }
                Button { text: "Save snapshot now"; enabled: root.available && !root.busy; clicked => { root.snapshot-now(); } }
            }
            Text { text: "Snapshots include applied edits, even in unnamed maps. Use Save to update the map file."; wrap: word-wrap; color: #9da7b5; }
            HorizontalLayout {
                spacing: 10px;
                Text { text: root.summary; vertical-alignment: center; horizontal-stretch: 1; }
                CheckBox { text: "Current map only"; checked <=> root.current-map-only; toggled => { root.page = 0; root.refresh(); } }
                Button { text: "Refresh list"; clicked => { root.refresh(); } }
            }
            ListView {
                min-height: 140px;
                for row in root.rows: VerticalLayout {
                    spacing: 3px; padding-bottom: 8px;
                    Button { text: row.title + (root.selected-id == row.id ? " · selected" : ""); clicked => { root.select-snapshot(row.id); } }
                    Text { text: row.detail; color: #aab0bb; font-size: 12px; }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Button { text: "Previous"; enabled: root.page > 0; clicked => { root.page -= 1; root.refresh(); } }
                Button { text: "Next"; enabled: root.has-next; clicked => { root.page += 1; root.refresh(); } }
            }
            Text { text: root.selected-detail; wrap: word-wrap; color: #c8ccd4; }
            if root.dirty-map: CheckBox { text: "Discard current unsaved edits when opening the recovered copy"; checked <=> root.discard-changes; }
            HorizontalLayout {
                spacing: 10px;
                Button { text: "Open recovered copy"; enabled: root.selected-id != "" && (!root.dirty-map || root.discard-changes); clicked => { root.restore-snapshot(); } }
                CheckBox { text: "Confirm permanent deletion"; checked <=> root.confirm-delete; }
                Button { text: "Delete snapshot"; enabled: root.selected-id != "" && root.confirm-delete && !root.busy; clicked => { root.delete-snapshot(); } }
            }
            Text { text: "Recovered maps open as unsaved copies. Choose a save path to keep them."; wrap: word-wrap; color: #9da7b5; }
            if root.warning != "": Text { text: root.warning; wrap: word-wrap; color: #efa47c; }
            if root.message != "": Text { text: root.message; wrap: word-wrap; }
            Text { text: "Storage: " + root.storage; wrap: word-wrap; color: #8a909c; font-size: 11px; }
            Button { text: "Cancel / close"; clicked => { root.cancel(); } }
        }
    }
}

export component PointfileWindow inherits Window {
    title: "Pointfile - HammeRR";
    preferred-width: 660px; preferred-height: 360px;
    in-out property <string> path;
    in property <string> source;
    in property <string> summary;
    in property <string> position;
    in property <string> message;
    in property <string> token;
    in property <string> stamp;
    in property <float> aspect: 1.6;
    in property <bool> current;
    in property <bool> has-path;
    in property <int> total;
    in-out property <int> point: 1;
    callback load(); callback browse(); callback clear(); callback frame();
    callback navigate(int); callback cancel();
    forward-focus: dialog-focus;
    dialog-focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => { if event.text == Key.Escape { root.cancel(); accept } else { reject } }
        VerticalLayout {
            padding: 20px; spacing: 14px;
            Text { text: "Follow a leak path"; font-size: 24px; font-weight: 600; }
            Text { text: "Load a pointfile or explore the latest compile's leak. Navigation moves the editor camera."; wrap: word-wrap; color: #b6bac3; }
            HorizontalLayout {
                spacing: 8px;
                LineEdit { text <=> root.path; placeholder-text: "Path to a .lin pointfile"; horizontal-stretch: 1; }
                Button { text: "Browse…"; clicked => { root.browse(); } }
                Button { text: "Load"; enabled: root.path != ""; clicked => { root.load(); } }
            }
            Text { text: root.source; wrap: word-wrap; }
            Text { text: root.summary; wrap: word-wrap; color: root.has-path && !root.current ? #efa47c : #b6bac3; }
            HorizontalLayout {
                spacing: 8px;
                Text { text: "Point"; vertical-alignment: center; }
                SpinBox { preferred-width: 110px; horizontal-stretch: 0; value <=> root.point; minimum: 1; maximum: max(1, root.total); enabled: root.current; }
                Text { text: "of " + root.total; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Button { text: "Go"; enabled: root.current; clicked => { root.navigate(root.point - 1); } }
                Button { text: "Previous"; enabled: root.current && root.point > 1; clicked => { root.navigate(root.point - 2); } }
                Button { text: "Next"; enabled: root.current && root.point < root.total; clicked => { root.navigate(root.point); } }
            }
            Text { text: root.position; color: #b6bac3; }
            if root.message != "": Text { text: root.message; wrap: word-wrap; color: #efa47c; }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 8px;
                Button { text: "Frame path"; enabled: root.current; clicked => { root.frame(); } }
                Button { text: "Unload path"; enabled: root.has-path; clicked => { root.clear(); } }
                Button { text: "Close"; clicked => { root.cancel(); } }
            }
        }
    }
}

export struct StatisticRow { name: string, count: string }

component StatisticCard inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> detail;
    background: #25262a; border-radius: 8px;
    VerticalLayout {
        padding: 16px; spacing: 8px;
        Text { text: root.label; color: #b6bac3; }
        Text { text: root.value; font-size: 30px; font-weight: 600; }
        Text { text: root.detail; font-size: 12px; color: #b6bac3; wrap: word-wrap; }
    }
}

export component StatisticsWindow inherits Window {
    title: "Map statistics - HammeRR";
    preferred-width: 840px; preferred-height: 680px;
    in property <string> brushes;
    in property <string> brush-detail;
    in property <string> faces;
    in property <string> face-detail;
    in property <string> entities;
    in property <string> entity-detail;
    in property <string> details;
    in property <string> summary;
    in property <string> generation;
    in property <string> revision;
    in property <[StatisticRow]> rows;
    in property <bool> has-next;
    in-out property <int> section;
    in-out property <int> page;
    callback refresh();
    callback cancel();
    forward-focus: dialog-focus;
    dialog-focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => { if event.text == Key.Escape { root.cancel(); accept } else { reject } }
        VerticalLayout {
            padding: 20px; spacing: 14px;
            Text { text: "Map statistics"; font-size: 24px; font-weight: 600; }
            Text { text: "Current map, including hidden objects. Previews are excluded."; color: #b6bac3; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 12px;
                StatisticCard { label: "Brushes"; value: root.brushes; detail: root.brush-detail; }
                StatisticCard { label: "Brush sides"; value: root.faces; detail: root.face-detail; }
                StatisticCard { label: "Entities"; value: root.entities; detail: root.entity-detail; }
            }
            Text { text: root.details; wrap: word-wrap; color: #b6bac3; }
            HorizontalLayout {
                spacing: 12px;
                ComboBox { model: ["Materials · sides", "Entity classes · entities", "Model paths · references", "Lightmap scales · sides", "Terrain powers · displacements"]; current-index <=> root.section; selected => { root.page = 0; root.refresh(); } }
                Button { text: "Refresh"; clicked => { root.refresh(); } }
            }
            HorizontalLayout {
                Text { text: root.section == 0 ? "Material" : root.section == 1 ? "Entity class" : root.section == 2 ? "Model path" : root.section == 3 ? "Units per lightmap texel" : "Displacement power"; color: #b6bac3; horizontal-stretch: 1; }
                Text { text: "Count"; color: #b6bac3; width: 80px; horizontal-alignment: right; }
            }
            ListView {
                for row in root.rows: HorizontalLayout {
                    spacing: 12px; padding-top: 5px; padding-bottom: 5px;
                    Text { text: row.name == "" ? "(empty path)" : row.name; wrap: word-wrap; horizontal-stretch: 1; }
                    Text { text: row.count; width: 80px; horizontal-alignment: right; }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Text { text: root.summary; vertical-alignment: center; horizontal-stretch: 1; }
                Button { text: "Previous"; enabled: root.page > 0; clicked => { root.page -= 1; root.refresh(); } }
                Button { text: "Next"; enabled: root.has-next; clicked => { root.page += 1; root.refresh(); } }
            }
            Text { text: "Authored counts, not compiled BSP budgets. Brush sides count plane records. Hidden brushes include those inside hidden entities. Locate IDs with Object report."; wrap: word-wrap; color: #9298a4; font-size: 12px; }
            Button { text: "Close"; clicked => { root.cancel(); } }
        }
    }
}

export component ReportWindow inherits Window {
    title: "Object report - HammeRR";
    preferred-width: 960px; preferred-height: 760px;
    in-out property <string> query;
    in-out property <string> classname;
    in-out property <string> targetname;
    in-out property <string> material;
    in-out property <int> kind;
    in-out property <int> visibility;
    in-out property <int> page;
    in-out property <int> selection-mode;
    in-out property <bool> limit-bounds;
    in-out property <string> min-x: "-16384";
    in-out property <string> min-y: "-16384";
    in-out property <string> min-z: "-16384";
    in-out property <string> max-x: "16384";
    in-out property <string> max-y: "16384";
    in-out property <string> max-z: "16384";
    in property <float> aspect: 1.6;
    in-out property <string> generation;
    in-out property <string> revision;
    in property <bool> has-next;
    in property <[ObjectReportRow]> rows;
    in property <string> summary;
    in property <string> message;
    callback search();
    callback select-result(string, bool);
    callback select-all(bool);
    callback visibility-action(string);
    callback cancel();
    forward-focus: dialog-focus;
    dialog-focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => { if event.text == Key.Escape { root.cancel(); accept } else { reject } }
        VerticalLayout {
            padding: 20px; spacing: 12px;
            Text { text: "Find objects"; font-size: 23px; font-weight: 600; }
            LineEdit { text <=> root.query; placeholder-text: "Search IDs, names, classes and materials…"; edited => { root.page = 0; root.search(); } }
            HorizontalLayout {
                spacing: 8px;
                LineEdit { text <=> root.classname; placeholder-text: "Entity class"; edited => { root.page = 0; root.search(); } }
                LineEdit { text <=> root.targetname; placeholder-text: "Entity name"; edited => { root.page = 0; root.search(); } }
                LineEdit { text <=> root.material; placeholder-text: "Material"; edited => { root.page = 0; root.search(); } }
            }
            HorizontalLayout {
                spacing: 8px;
                ComboBox { model: ["All types", "World brushes", "All entities", "Point entities", "Brush entities"]; current-index <=> root.kind; selected => { root.page = 0; root.search(); } }
                ComboBox { model: ["Visible and hidden", "Visible", "Hidden"]; current-index <=> root.visibility; selected => { root.page = 0; root.search(); } }
                Button { text: "Refresh"; clicked => { root.search(); } }
            }
            CheckBox { text: "Limit to a map region"; checked <=> root.limit-bounds; toggled => { root.page = 0; root.search(); } }
            if root.limit-bounds: VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Minimum XYZ"; vertical-alignment: center; width: 120px; }
                    LineEdit { text <=> root.min-x; input-type: decimal; edited => { root.page = 0; root.search(); } }
                    LineEdit { text <=> root.min-y; input-type: decimal; edited => { root.page = 0; root.search(); } }
                    LineEdit { text <=> root.min-z; input-type: decimal; edited => { root.page = 0; root.search(); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Maximum XYZ"; vertical-alignment: center; width: 120px; }
                    LineEdit { text <=> root.max-x; input-type: decimal; edited => { root.page = 0; root.search(); } }
                    LineEdit { text <=> root.max-y; input-type: decimal; edited => { root.page = 0; root.search(); } }
                    LineEdit { text <=> root.max-z; input-type: decimal; edited => { root.page = 0; root.search(); } }
                }
            }
            Text { text: root.summary; }
            ListView {
                for row in root.rows: VerticalLayout {
                    spacing: 4px; padding-bottom: 12px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: row.label; horizontal-stretch: 1; vertical-alignment: center; }
                        Button { text: "Select"; clicked => { root.select-result(row.id, false); } }
                        Button { text: "Frame"; clicked => { root.select-result(row.id, true); } }
                    }
                    Text { text: row.detail; wrap: word-wrap; color: #aab0bb; font-size: 12px; }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Button { text: "Previous"; enabled: root.page > 0; clicked => { root.page -= 1; root.search(); } }
                Button { text: "Next"; enabled: root.has-next; clicked => { root.page += 1; root.search(); } }
                ComboBox { model: ["Replace selection", "Add to selection", "Remove from selection", "Toggle selection"]; current-index <=> root.selection-mode; }
                Button { text: "Select all matches"; clicked => { root.select-all(false); } }
                Button { text: "Frame all matches"; clicked => { root.select-all(true); } }
            }
            HorizontalLayout {
                spacing: 8px;
                Button { text: "Hide selected"; clicked => { root.visibility-action("hide"); } }
                Button { text: "Isolate selected"; clicked => { root.visibility-action("isolate"); } }
                Button { text: "Show selected"; clicked => { root.visibility-action("show"); } }
                Button { text: "Show all"; clicked => { root.visibility-action("show_all"); } }
                Button { text: "Restore visibility"; clicked => { root.visibility-action("restore"); } }
            }
            Text { text: "Hidden objects are saved as hidden and omitted from compilation."; wrap: word-wrap; color: #aab0bb; }
            Text { text: root.message; wrap: word-wrap; }
            Button { text: "Close"; clicked => { root.cancel(); } }
        }
    }
}

export struct Activity {
    actor: string,
    text: string,
}

component StatusText inherits Text {
    color: #8a909c;
    vertical-alignment: center;
    font-size: 12px;
}

component SectionTitle inherits Text {
    color: #8a909c;
    font-size: 11px;
    font-weight: 600;
}

component ToolbarSeparator inherits Rectangle {
    width: 1px;
    background: #2c3038;
}

component TransformVector inherits HorizontalLayout {
    in-out property <string> x-value: "0";
    in-out property <string> y-value: "0";
    in-out property <string> z-value: "0";
    in property <bool> enabled: true;
    callback apply();
    spacing: 7px;
    Text { text: "X"; color: #dc858d; vertical-alignment: center; }
    LineEdit { enabled: root.enabled; min-width: 0px; preferred-width: 80px; horizontal-stretch: 1; text <=> root.x-value; input-type: decimal; accepted => { root.apply(); } }
    Text { text: "Y"; color: #86c9a4; vertical-alignment: center; }
    LineEdit { enabled: root.enabled; min-width: 0px; preferred-width: 80px; horizontal-stretch: 1; text <=> root.y-value; input-type: decimal; accepted => { root.apply(); } }
    Text { text: "Z"; color: #90b1e0; vertical-alignment: center; }
    LineEdit { enabled: root.enabled; min-width: 0px; preferred-width: 80px; horizontal-stretch: 1; text <=> root.z-value; input-type: decimal; accepted => { root.apply(); } }
}

export component AppWindow inherits Window {
    title: root.map-title + " - HammeRR";
    preferred-width: 1600px;
    preferred-height: 960px;
    background: #111317;
    default-font-size: 13px;
    forward-focus: focus;

    in property <image> frame;
    in property <string> map-title: "untitled.vmf";
    in property <string> message;
    in property <string> stats;
    in property <string> preview-error;
    in property <string> camera;
    in property <string> mcp-status;
    in property <bool> flying;
    in property <int> projection-index;
    in property <string> workplane-axis: "Z";
    in property <string> brush-preview;
    in-out property <string> grid-size: "16";
    in-out property <string> fly-speed: "600";
    in-out property <bool> grid-visible: true;
    in-out property <bool> snap-grid: true;
    in-out property <bool> drawing-block;
    in-out property <string> brush-elevation: "0";
    in-out property <string> brush-depth: "128";
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <bool> compiling;
    in property <string> compile-label;
    in property <string> compile-token;
    in property <bool> compile-cancellable;
    callback build-status();
    callback compile-region();
    callback working-region();
    callback clear-working-region();
    in property <bool> working-region-active;
    in property <string> compile-region-label: "Compile region…";
    callback cancel-build();
    in property <bool> launching;
    in property <bool> game-running;
    in property <bool> has-selection;
    in property <bool> face-mode;
    in property <bool> has-faces;
    in property <bool> can-sample-face;
    in property <bool> can-clip;
    in property <bool> clipping;
    in property <bool> has-clip-preview;
    in property <string> clip-summary;
    in property <bool> clip-positioning;
    in-out property <int> clip-handles-mode: 1;
    in-out property <bool> clip-handles-snap: true;
    in-out property <string> clip-angle-step: "15";
    callback clip-handles-changed();
    callback cancel-clip-positioning();
    in property <bool> clip-point-mode;
    in property <int> clip-point-count;
    in property <string> clip-points-summary;
    in-out property <int> clip-keep-index: 2;
    in-out property <string> clip-normal-x: "1";
    in-out property <string> clip-normal-y: "0";
    in-out property <string> clip-normal-z: "0";
    in-out property <string> clip-distance: "0";
    in-out property <string> clip-material;
    in property <string> selection-pivot;
    in-out property <bool> show-transform;
    in-out property <int> transform-mode;
    in-out property <int> transform-pivot-mode;
    in-out property <string> transform-x: "0";
    in-out property <string> transform-y: "0";
    in-out property <string> transform-z: "0";
    in-out property <string> pivot-x: "0";
    in-out property <string> pivot-y: "0";
    in-out property <string> pivot-z: "0";
    in property <bool> pivot-picking;
    in property <bool> can-pick-pivot;
    in property <bool> can-cancel-pivot-pick;
    in property <string> pivot-pick-notice;
    in property <string> pivot-pick-source;
    callback pick-transform-pivot();
    callback cancel-transform-pivot-pick();
    in-out property <bool> transform-texture-lock: true;
    in-out property <bool> transform-texture-scale-lock: true;
    in-out property <bool> transform-reflect-x: true;
    in-out property <bool> transform-reflect-y: false;
    in-out property <bool> transform-reflect-z: false;
    in-out property <int> transform-shear-axis: 0;
    in-out property <int> transform-shear-reference: 1;
    in-out property <string> transform-shear-factor: "0.5";
    in-out property <int> handles-mode-index;
    in-out property <int> transform-space-index;
    in-out property <string> rotation-step: "15";
    in-out property <int> area-rule-index;
    in-out property <int> area-mode-index;
    in property <bool> has-transform-preview;
    in property <string> transform-preview-summary;
    in property <[string]> transform-preview-values: ["0", "0", "0", "0", "0", "0", "1", "1", "1"];
    in property <bool> has-area-preview;
    in property <bool> has-paint-preview;
    in property <bool> has-texture-stroke;
    in-out property <int> texture-paint-mode;
    in property <string> texture-sample-material;
    in property <image> texture-sample-preview;
    in property <string> paint-token;
    in-out property <float> paint-radius: 12;
    callback paint-settings-changed();
    in property <string> interaction-summary;
    function refresh-transform-values() {
        root.transform-x = root.has-transform-preview && root.transform-mode < 3 ? root.transform-preview-values[root.transform-mode * 3] : root.transform-mode == 2 ? "1" : "0";
        root.transform-y = root.has-transform-preview && root.transform-mode < 3 ? root.transform-preview-values[root.transform-mode * 3 + 1] : root.transform-mode == 2 ? "1" : "0";
        root.transform-z = root.has-transform-preview && root.transform-mode < 3 ? root.transform-preview-values[root.transform-mode * 3 + 2] : root.transform-mode == 2 ? "1" : "0";
    }
    changed transform-mode => { root.refresh-transform-values(); }
    changed transform-preview-values => { if root.has-transform-preview { root.refresh-transform-values(); } }
    changed has-transform-preview => { if root.has-transform-preview { root.refresh-transform-values(); } }
    in-out property <bool> show-tools: true;
    in-out property <bool> sky-preview: false;
    in-out property <bool> lighting-preview: false;
    in-out property <int> lighting-quality: 1;
    in-out property <string> lighting-exposure-ev: "0";
    in property <string> lighting-status: "Authored lighting preview is off";
    in property <string> lighting-error;
    in-out property <bool> normal-maps: false;
    in property <string> normal-map-status: "Normal map preview is off";
    in-out property <int> sky-channel: 0;
    in-out property <string> sky-exposure-ev: "0";
    in property <string> sky-preview-error;
    in-out property <bool> instance-contents: false;
    in property <string> instance-contents-status: "Instance contents have not been refreshed";
    callback inspect-instance-contents();
    in-out property <bool> rope-preview: false;
    in-out property <bool> selection-outlines: true;
    in-out property <bool> entity-images: true;
    in-out property <bool> additive-sprite-guides: false;
    in-out property <bool> entity-model-guides: true;
    in property <string> rope-preview-status: "Rope preview is off";
    in property <string> fog-preview-status: "Fog preview is off";
    callback fog-preview();
    in-out property <string> sky-preview-status: "Set world skyname to select a 2D sky";
    in-out property <bool> show-leak: true;
    in-out property <int> surface-view;
    in-out property <int> smoothing-view-group: 1;
    in-out property <string> material: "dev/dev_measuregeneric01";

    in property <string> selection-title: "Nothing selected";
    in property <string> selection-detail;
    in property <bool> entity-selected;
    in property <string> entity-helper-status;
    in property <bool> has-fgd-model-guide;
    callback reload-model-guides();
    in property <bool> can-inspect-model;
    in property <bool> can-cubemap-faces;
    callback inspect-model();
    in property <bool> brush-entity-selected;
    in property <bool> can-tie;
    in property <[KeyValue]> entity-properties;
    in-out property <bool> advanced-properties;
    in property <image> material-preview;
    in property <bool> has-material-preview;
    in property <bool> can-apply-material;
    in property <[Activity]> activity;

    out property <length> viewport-width: viewport.width;
    out property <length> viewport-height: viewport.height;

    callback new-map();
    callback open-map();
    callback recent-maps();
    callback save-map();
    callback compile-map();
    callback run-map();
    callback game-log();
    callback stop-game();
    callback undo();
    callback redo();
    callback history();
    callback create-block();
    callback projection-changed(int);
    callback spatial-changed();
    callback frame-selection();
    callback saved-views();
    callback measurements();
    callback grid-defaults();
    in property <bool> grid-defaults-error;
    callback navigation-defaults();
    callback fly-speed-changed();
    in property <bool> navigation-defaults-error;
    callback preview-defaults();
    in property <bool> preview-defaults-error;
    callback keyboard-shortcuts();
    in property <bool> shortcuts-error;
    in property <string> frame-shortcut: "F";
    callback start-clip();
    callback clip-points-action(int);
    callback preview-clip-plane();
    callback clip-settings-changed();
    callback clip-inputs-changed();
    callback apply-clip();
    callback cancel-clip();
    callback apply-transform();
    callback preview-snap-to-grid();
    callback transform-tool-changed();
    callback area-settings-changed();
    callback apply-transform-preview();
    callback apply-area-selection();
    callback cancel-interaction();
    callback delete-selection();
    callback apply-material();
    callback selection-mode-changed(int);
    callback edit-face-textures();
    callback create-overlay();
    callback cubemap-faces();
    callback edit-face-lighting();
    callback create-terrain(int, int);
    in property <[string]> terrain-corner-choices: ["Corner 1", "Corner 2", "Corner 3", "Corner 4"];
    in-out property <int> terrain-corner-index;
    callback remove-terrain();
    callback change-terrain-resolution();
    callback edit-terrain-triangles();
    in property <bool> terrain-triangle-picking;
    callback cancel-terrain-triangle-pick();
    in property <bool> terrain-center-picking;
    in property <bool> surface-picking;
    in property <bool> overlay-handling;
    in property <string> overlay-handle-notice;
    in property <bool> can-cancel-overlay-handles;
    callback cancel-overlay-handles();
    callback cancel-terrain-center-pick();
    in property <bool> terrain-stroking;
    callback cancel-terrain-stroke();
    in property <bool> terrain-handling;
    callback cancel-terrain-handles();
    in property <bool> can-remove-terrain;
    in property <string> terrain-creation-error;
    callback replace-materials();
    callback map-face-group();
    callback select-volume();
    callback surface-view-changed();
    callback sample-face-texture();
    callback browse-material(key: string);
    callback browse-model();
    callback browse-sound(string);
    callback browse-particle();
    callback place-on-surface();
    callback repeat-array();
    callback copy-objects();
    callback cut-objects();
    callback paste-objects();
    callback object-groups();
    callback layers();
    callback prefabs();
    callback cancel-surface-pick();
    callback material-changed();
    callback pick-color(key: string);
    callback property-component-edited(key: string, index: int, value: string);
    callback options-changed();
    callback property-edited(key: string, value: string);
    callback property-removed(key: string);
    callback flag-toggled(key: string, flag: string, checked: bool);
    callback place-entity();
    callback edit-connections();
    callback edit-references();
    callback world-settings();
    callback batch-properties();
    callback object-report();
    callback map-statistics();
    callback pointfile();
    callback recovery();
    callback map-checks();
    callback design-context();
    callback brush-shapes();
    callback draw-polygon();
    callback create-linked-path();
    callback brush-components();
    callback hollow-brushes();
    callback carve-brushes();
    callback merge-brushes();
    callback tie-entity();
    callback move-to-world();
    // Returns whether the key was handled.
    callback key(text: string, down: bool, control: bool, shift: bool, alt: bool, meta: bool) -> bool;
    // button: 0 = left, 1 = right, 2 = middle
    callback mouse-button(button: int, down: bool, x: length, y: length, control: bool, alt: bool);
    callback mouse-moved(x: length, y: length);
    callback wheel(delta: length, x: length, y: length);
    callback viewport-focus-lost();

    VerticalLayout {
        Rectangle {
            height: 44px;
            background: #1a1d23;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 8px;

                Button {
                    text: "New";
                    clicked => {
                        root.new-map();
                    }
                }

                Button {
                    text: "Open…";
                    clicked => {
                        root.open-map();
                    }
                }

                Button {
                    text: "Recent…";
                    clicked => { root.recent-maps(); }
                }

                Button {
                    text: "Save";
                    clicked => {
                        root.save-map();
                    }
                }

                Button {
                    text: "Build settings…";
                    clicked => { root.build-status(); }
                }

                Button { text: root.compile-region-label; clicked => { root.compile-region(); } }

                Button {
                    text: root.compiling ? "Compiling…" : "Compile";
                    enabled: !root.compiling && !root.launching;
                    clicked => { root.compile-map(); }
                }

                Button {
                    text: root.launching ? "Launching…" : "Run Map";
                    enabled: !root.compiling && !root.launching && !root.game-running;
                    clicked => { root.run-map(); }
                }

                Button {
                    text: "Game Log";
                    clicked => { root.game-log(); }
                }

                Button {
                    text: "Stop Map";
                    enabled: root.game-running;
                    clicked => { root.stop-game(); }
                }

                ToolbarSeparator { }

                Button {
                    text: "Undo";
                    enabled: root.can-undo;
                    clicked => {
                        root.undo();
                    }
                }

                Button {
                    text: "Redo";
                    enabled: root.can-redo;
                    clicked => {
                        root.redo();
                    }
                }

                Button { text: "History…"; clicked => { root.history(); } }

                ToolbarSeparator { }

                Button {
                    text: root.projection-index == 0 ? "Add brush" : root.drawing-block ? "Select objects" : "Draw brush";
                    clicked => {
                        root.create-block();
                    }
                }

                Button {
                    text: "Delete";
                    enabled: root.has-selection;
                    clicked => {
                        root.delete-selection();
                    }
                }

                ToolbarSeparator { }

                Button { text: "Working region…"; clicked => { root.working-region(); } }
                CheckBox {
                    text: "Tool textures";
                    checked <=> root.show-tools;
                    toggled => {
                        root.options-changed();
                    }
                }

                CheckBox {
                    text: "Leak path";
                    checked <=> root.show-leak;
                    toggled => { root.options-changed(); }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                Text {
                    text: root.mcp-status;
                    color: #6fbf73;
                    vertical-alignment: center;
                    font-size: 12px;
                }
            }
        }

        if root.working-region-active: Rectangle {
            height: 38px; background: #28313c;
            HorizontalLayout {
                padding: 5px; padding-left: 14px; spacing: 12px;
                Text { text: "Working region active · editor view only"; color: #f2c487; vertical-alignment: center; horizontal-stretch: 1; }
                Button { text: "Working region…"; clicked => { root.working-region(); } }
                Button { text: "Clear working region"; clicked => { root.clear-working-region(); } }
            }
        }
        if root.compile-label != "": Rectangle {
            height: 40px;
            background: #20252e;
            HorizontalLayout {
                padding: 5px;
                padding-left: 14px;
                spacing: 10px;
                Text { text: root.compile-label; vertical-alignment: center; horizontal-stretch: 1; color: #dce2ec; }
                Button { text: "Build details…"; clicked => { root.build-status(); } }
                if root.compiling: Button { text: "Cancel build"; enabled: root.compile-cancellable; clicked => { root.cancel-build(); } }
            }
        }

        if root.preview-error != "": Rectangle {
            min-height: 42px;
            background: #392027;
            HorizontalLayout {
                padding: 7px;
                padding-left: 14px;
                spacing: 10px;
                Text { text: root.preview-error; color: #ffd4d4; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                Button { text: "Check map…"; clicked => { root.map-checks(); } }
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;

            viewport := Rectangle {
                horizontal-stretch: 1;
                background: #08090b;

                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.frame;
                    image-fit: fill;
                }

                focus := FocusScope {
                    key-pressed(event) => {
                        if (event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta && event.text == "o") {
                            root.open-map();
                            return accept;
                        }
                        root.key(event.text, true, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? EventResult.accept : EventResult.reject
                    }
                    key-released(event) => {
                        root.key(event.text, false, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) ? EventResult.accept : EventResult.reject
                    }
                    focus-lost => {
                        root.viewport-focus-lost();
                    }

                    touch := TouchArea {
                        mouse-cursor: root.flying ? MouseCursor.move : (root.surface-picking || root.overlay-handling || root.pivot-picking || ((root.drawing-block || root.clipping) && root.projection-index != 0)) ? MouseCursor.crosshair : MouseCursor.default;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                focus.focus();
                            }
                            if (event.kind == PointerEventKind.down || event.kind == PointerEventKind.up) {
                                root.mouse-button(
                                    event.button == PointerEventButton.left ? 0 : event.button == PointerEventButton.right ? 1 : 2,
                                    event.kind == PointerEventKind.down,
                                    self.mouse-x,
                                    self.mouse-y,
                                    event.modifiers.control,
                                    event.modifiers.alt);
                            }
                        }
                        moved => {
                            root.mouse-moved(self.mouse-x, self.mouse-y);
                        }
                        scroll-event(event) => {
                            root.wheel(event.delta-y, self.mouse-x, self.mouse-y);
                            accept
                        }
                    }
                }

                Rectangle {
                    x: 12px;
                    y: 12px;
                    width: min(790px, parent.width - 24px);
                    height: 42px;
                    background: #20252eee;
                    border-color: #394252;
                    border-width: 1px;
                    border-radius: 8px;
                    HorizontalLayout {
                        padding: 7px;
                        spacing: 8px;
                        ComboBox {
                            width: 150px;
                            model: ["Perspective", "Top · XY", "Front · XZ", "Side · YZ"];
                            current-index: root.projection-index;
                            selected => { root.projection-changed(self.current-index); }
                        }
                        Button { text: root.frame-shortcut == "" ? "Frame" : "Frame · " + root.frame-shortcut; accessible-label: "Frame selection"; clicked => { root.frame-selection(); } }
                        Button { text: "Saved views…"; clicked => { root.saved-views(); } }
                        Button { text: "Measurements…"; clicked => { root.measurements(); } }
                        Text { text: "Grid"; vertical-alignment: center; color: #c8ccd4; }
                        LineEdit { width: 65px; text <=> root.grid-size; input-type: decimal; accessible-label: "Viewport grid size"; accepted => { root.spatial-changed(); } }
                        CheckBox { text: "Snap"; checked <=> root.snap-grid; toggled => { root.spatial-changed(); } }
                        CheckBox { text: "Show grid"; checked <=> root.grid-visible; toggled => { root.spatial-changed(); } }
                    }
                }

                if root.overlay-handle-notice != "": Rectangle {
                    x: 12px;
                    y: root.overlay-handling ? 64px : 114px;
                    width: min(720px, parent.width - 24px);
                    height: 64px;
                    background: #20252eee;
                    border-color: #394252;
                    border-width: 1px;
                    border-radius: 8px;
                    HorizontalLayout {
                        padding: 10px;
                        spacing: 12px;
                        Text {text:root.overlay-handle-notice;wrap:word-wrap;color:#91b9e9;}
                        if root.can-cancel-overlay-handles: Button {text:"Cancel handles";clicked=>{root.cancel-overlay-handles();}}
                    }
                }

                if root.pivot-pick-notice != "": Rectangle {
                    x: 12px;
                    y: root.pivot-picking ? 64px : 136px;
                    width: min(760px, parent.width - 24px);
                    height: 64px;
                    background: #20252eee;
                    border-color: #394252;
                    border-width: 1px;
                    border-radius: 8px;
                    HorizontalLayout {
                        padding: 10px;
                        spacing: 12px;
                        Text { text: root.pivot-pick-notice; wrap: word-wrap; color: #91b9e9; }
                        if root.can-cancel-pivot-pick: Button { text: "Cancel pivot pick"; clicked => { root.cancel-transform-pivot-pick(); } }
                    }
                }

                if !root.drawing-block && !root.clipping && !root.overlay-handling && !root.pivot-picking: Rectangle {
                    x: 12px;
                    y: 64px;
                    width: min(root.handles-mode-index == 4 ? 550px : root.handles-mode-index == 5 ? 610px : 900px, parent.width - 24px);
                    height: 44px;
                    background: #20252eee;
                    border-color: #394252;
                    border-width: 1px;
                    border-radius: 8px;
                    HorizontalLayout {
                        padding: 7px;
                        spacing: 8px;
                        ComboBox {
                            width: 150px;
                            model: ["Select", "Move handles", "Rotate handles", "Scale handles", "Paint selection", "Paint texture"];
                            current-index <=> root.handles-mode-index;
                            selected => { root.transform-tool-changed(); }
                        }
                        if root.handles-mode-index > 0 && root.handles-mode-index < 4: ComboBox {
                            width: 125px;
                            model: ["World axes", "Local axes"];
                            current-index <=> root.transform-space-index;
                            selected => { root.transform-tool-changed(); }
                        }
                        if root.handles-mode-index > 0 && root.handles-mode-index < 4: CheckBox {
                            text: "Follow move/rotation";
                            checked <=> root.transform-texture-lock;
                            toggled => { root.transform-tool-changed(); }
                        }
                        if root.handles-mode-index == 3: CheckBox {
                            text: "Stretch with scale";
                            checked <=> root.transform-texture-scale-lock;
                            toggled => { root.transform-tool-changed(); }
                        }
                        if root.handles-mode-index == 2: HorizontalLayout {
                            spacing: 6px;
                            Text { text: "Angle snap · °"; color: #c8ccd4; vertical-alignment: center; }
                            LineEdit { width: 65px; text <=> root.rotation-step; input-type: decimal; accepted => { root.transform-tool-changed(); } }
                        }
                        if root.handles-mode-index == 5: ComboBox {
                            width: 170px;
                            model: ["Material only", "Copy projection"];
                            current-index <=> root.texture-paint-mode;
                            selected => { root.paint-settings-changed(); }
                        }
                        if root.handles-mode-index >= 4: HorizontalLayout {
                            spacing: 6px;
                            horizontal-stretch: 0;
                            Text { text: "Radius · " + round(root.paint-radius) + " px"; color: #c8ccd4; vertical-alignment: center; horizontal-stretch: 0; }
                            Slider { width: 120px; minimum: 2; maximum: 64; value: root.paint-radius; changed(value) => { root.paint-radius = round(value); root.paint-settings-changed(); } }
                        }
                        if root.handles-mode-index < 4: Text { text: "Area"; color: #c8ccd4; vertical-alignment: center; }
                        if root.handles-mode-index < 4: ComboBox {
                            width: 125px;
                            model: ["Intersects", "Fully inside"];
                            current-index <=> root.area-rule-index;
                            selected => { root.area-settings-changed(); }
                        }
                        if root.handles-mode-index != 5: ComboBox {
                            width: 100px;
                            model: ["Replace", "Add", "Remove", "Toggle"];
                            current-index <=> root.area-mode-index;
                            selected => { root.area-settings-changed(); }
                        }
                    }
                }
                if root.handles-mode-index == 5: Rectangle {
                    x: 12px; y: 118px; width: min(680px, parent.width - 24px); height: 44px;
                    background: #20252eee; border-color: #394252; border-width: 1px; border-radius: 8px;
                    HorizontalLayout {
                        padding: 6px; spacing: 8px;
                        Image { width: 30px; height: 30px; source: root.texture-sample-preview; image-fit: contain; }
                        Text { text: root.texture-sample-material == "" ? "Select one source face, then sample its texture" : root.texture-sample-material; color: #c8ccd4; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                        Button { text: "Sample face"; enabled: root.can-sample-face; clicked => { root.sample-face-texture(); } }
                    }
                }
                if root.has-transform-preview || root.has-area-preview || root.has-paint-preview: Rectangle {
                    x: 12px;
                    y: root.handles-mode-index == 5 ? 168px : 118px;
                    width: min(700px, parent.width - 24px);
                    height: 46px;
                    background: #20252eee;
                    border-color: #4c829f;
                    border-width: 1px;
                    border-radius: 8px;
                    HorizontalLayout {
                        padding: 7px;
                        spacing: 8px;
                        Text { text: root.interaction-summary; color: #9dd8f1; vertical-alignment: center; horizontal-stretch: 1; }
                        Button { text: root.has-transform-preview ? "Apply transform" : root.has-texture-stroke ? "Apply textures" : "Apply selection"; clicked => { if root.has-transform-preview { root.apply-transform-preview(); } else { root.apply-area-selection(); } } }
                        Button { text: "Cancel"; clicked => { root.cancel-interaction(); } }
                    }
                }
                if root.drawing-block && root.projection-index != 0: Rectangle {
                    x: 12px;
                    y: 64px;
                    width: min(570px, parent.width - 24px);
                    height: 74px;
                    background: #20252eee;
                    border-color: #4c829f;
                    border-width: 1px;
                    border-radius: 8px;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Start " + root.workplane-axis; color: #c8ccd4; vertical-alignment: center; }
                            LineEdit { width: 85px; text <=> root.brush-elevation; input-type: decimal; accepted => { root.spatial-changed(); } }
                            Text { text: "Depth " + root.workplane-axis; color: #c8ccd4; vertical-alignment: center; }
                            LineEdit { width: 85px; text <=> root.brush-depth; input-type: decimal; accepted => { root.spatial-changed(); } }
                            Button { text: "Done"; clicked => { root.create-block(); } }
                        }
                        Text { text: root.brush-preview == "" ? "Drag a footprint to place a brush · Esc cancels" : root.brush-preview; color: #9dd8f1; font-size: 12px; }
                    }
                }

                if root.clipping: Rectangle {
                    x: 12px;
                    y: 64px;
                    width: min(740px, parent.width - 24px);
                    height: 234px;
                    background: #20252eee;
                    border-color: #4c829f;
                    border-width: 1px;
                    border-radius: 8px;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Clip brushes"; color: #d7e5ef; font-size: 13px; vertical-alignment: center; }
                            Button { text: root.clip-point-mode ? "Use plane / line" : "Pick three points"; clicked => { root.clip-points-action(root.clip-point-mode ? 3 : 0); } }
                            if root.clip-point-mode: Button { text: "Remove last point"; enabled: root.clip-point-count > 0; clicked => { root.clip-points-action(1); } }
                            if root.clip-point-mode: Button { text: "Start again"; enabled: root.clip-point-count > 0; clicked => { root.clip-points-action(2); } }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Keep"; color: #c8ccd4; vertical-alignment: center; }
                            ComboBox {
                                width: 200px;
                                model: ["Arrow side", "Opposite side", "Both sides"];
                                current-index <=> root.clip-keep-index;
                                selected => { root.clip-settings-changed(); }
                            }
                            Text { text: "Cyan arrow points to the front side"; color: #9dd8f1; vertical-alignment: center; }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Handles"; color: #c8ccd4; vertical-alignment: center; }
                            ComboBox {
                                width: 155px;
                                model: ["Hidden", "Move plane", "Rotate plane"];
                                current-index <=> root.clip-handles-mode;
                                selected => { root.clip-handles-changed(); }
                            }
                            CheckBox { text: "Snap"; checked <=> root.clip-handles-snap; toggled => { root.clip-handles-changed(); } }
                            if root.clip-handles-mode == 2: LineEdit { width: 55px; text <=> root.clip-angle-step; input-type: decimal; accepted => { root.clip-handles-changed(); } }
                            if root.clip-handles-mode == 2: Text { text: "° steps"; color: #c8ccd4; vertical-alignment: center; }
                            if root.clip-positioning: Button { text: "Cancel positioning"; clicked => { root.cancel-clip-positioning(); } }
                            Text { text: "World axes"; color: #9dd8f1; vertical-alignment: center; horizontal-alignment: right; horizontal-stretch: 1; }
                        }
                        if root.clip-point-mode: Text { text: root.clip-points-summary; color: #ffc66d; font-size: 12px; wrap: word-wrap; }
                        if !root.clip-point-mode: HorizontalLayout {
                            spacing: 6px;
                            Text { text: "Normal X"; color: #dc858d; vertical-alignment: center; }
                            LineEdit { width: 65px; text <=> root.clip-normal-x; input-type: decimal; edited => { root.clip-inputs-changed(); } accepted => { root.preview-clip-plane(); } }
                            Text { text: "Y"; color: #86c9a4; vertical-alignment: center; }
                            LineEdit { width: 65px; text <=> root.clip-normal-y; input-type: decimal; edited => { root.clip-inputs-changed(); } accepted => { root.preview-clip-plane(); } }
                            Text { text: "Z"; color: #90b1e0; vertical-alignment: center; }
                            LineEdit { width: 65px; text <=> root.clip-normal-z; input-type: decimal; edited => { root.clip-inputs-changed(); } accepted => { root.preview-clip-plane(); } }
                            Text { text: "Distance · units"; color: #c8ccd4; vertical-alignment: center; }
                            LineEdit { width: 80px; text <=> root.clip-distance; input-type: decimal; edited => { root.clip-inputs-changed(); } accepted => { root.preview-clip-plane(); } }
                            Button { text: "Preview plane"; clicked => { root.preview-clip-plane(); } }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Text { text: "Cut material"; color: #c8ccd4; vertical-alignment: center; }
                            LineEdit { min-width: 0px; horizontal-stretch: 1; text <=> root.clip-material; placeholder-text: "Inherit each brush's material"; edited => { root.clip-inputs-changed(); } accepted => { root.preview-clip-plane(); } }
                            Button { text: "Browse…"; clicked => { root.browse-material("@clip"); } }
                            Button { text: "Apply cut"; enabled: root.has-clip-preview && !root.clip-positioning; clicked => { root.apply-clip(); } }
                            Button { text: "Cancel cut"; clicked => { root.cancel-clip(); } }
                        }
                        Text { text: root.clip-summary; color: #9dd8f1; font-size: 12px; wrap: word-wrap; }
                    }
                }

                Rectangle {
                    x: 10px;
                    y: parent.height - self.height - 10px;
                    width: hint.preferred-width + 16px;
                    height: hint.preferred-height + 10px;
                    border-radius: 4px;
                    background: #000000a0;

                    hint := Text {
                        text: root.clipping ? "Drag a plane handle · release keeps the preview · Apply cut changes the map · Esc cancels" : root.handles-mode-index == 5 ? "Drag to paint the sampled texture · release applies · Esc cancels" : root.handles-mode-index == 4 ? "Drag to paint visible hits · release selects · Ctrl toggles · Esc cancels" : root.handles-mode-index != 0 && !root.face-mode ? "Drag a handle · release applies · Esc cancels · drag elsewhere to select an area" : root.face-mode ? "Click or drag to select faces · Ctrl toggles · areas include faces through geometry" : "Click or drag to select · Ctrl toggles · right mouse navigates" + (root.frame-shortcut == "" ? "" : " · " + root.frame-shortcut + " frames") + " · Esc cancels";
                        color: #c8ccd4;
                        font-size: 12px;
                    }
                }
            }

            Rectangle {
                width: 360px;
                background: #16181d;

                ScrollView {
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    SectionTitle {
                        text: "VIEWPORT";
                    }
                    Button { text: root.grid-defaults-error ? "Grid defaults… · needs attention" : "Grid defaults…"; clicked => { root.grid-defaults(); } }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Fly speed"; vertical-alignment: center; }
                        LineEdit { horizontal-stretch: 1; text <=> root.fly-speed; input-type: decimal; accessible-label: "Fly speed"; accepted => { root.fly-speed-changed(); } }
                        Text { text: "units/s"; vertical-alignment: center; }
                    }
                    Button { text: root.navigation-defaults-error ? "Navigation defaults… · needs attention" : "Navigation defaults…"; clicked => { root.navigation-defaults(); } }
                    Button { text: root.preview-defaults-error ? "Preview defaults… · needs attention" : "Preview defaults…"; clicked => { root.preview-defaults(); } }
                    Button { text: root.shortcuts-error ? "Keyboard shortcuts… · needs attention" : "Keyboard shortcuts…"; clicked => { root.keyboard-shortcuts(); } }
                    ComboBox {
                        model: ["Textured", "Flat shading", "Wireframe", "Lightmap density", "Smoothing groups"];
                        current-index <=> root.surface-view;
                        selected => { root.surface-view-changed(); }
                    }
                    CheckBox {
                        text: "Selection outlines";
                        checked <=> root.selection-outlines;
                        toggled => { root.options-changed(); }
                    }
                    CheckBox {
                        text: "Normal map preview";
                        checked <=> root.normal-maps;
                        toggled => { root.options-changed(); }
                    }
                    if root.normal-maps: Text { text: root.normal-map-status + (root.lighting-preview ? "\nTextured flat brushes · unshadowed authored lights" : "\nTextured flat brushes · fixed editor light"); color: #aeb9c8; wrap: word-wrap; font-size: 12px; }
                    CheckBox {
                        text: "Unshadowed authored lighting";
                        checked <=> root.lighting-preview;
                        toggled => { root.options-changed(); }
                    }
                    if root.lighting-preview: VerticalLayout {
                        spacing: 8px;
                        ComboBox {
                            model: ["Fast · vertex lighting", "Detail · per-fragment lighting"];
                            current-index <=> root.lighting-quality;
                            selected => { root.options-changed(); }
                        }
                        HorizontalLayout {
                            Text { text: "Lighting exposure (EV)"; color: #bac2ce; vertical-alignment: center; }
                            LineEdit {
                                text <=> root.lighting-exposure-ev;
                                input-type: decimal;
                                placeholder-text: "−8 to 8";
                                accepted => { root.options-changed(); }
                            }
                        }
                        Text { text: root.lighting-status + "\nNo shadows, sun, ambient or bounce · editor display"; color: #aeb9c8; wrap: word-wrap; font-size: 12px; }
                    }
                    if root.lighting-error != "": Text { text: root.lighting-error; color: #f0b377; wrap: word-wrap; font-size: 12px; }
                    CheckBox {
                        text: "Entity images";
                        checked <=> root.entity-images;
                        toggled => { root.options-changed(); }
                    }
                    CheckBox {
                        text: "Additive Sprite guides";
                        enabled: root.entity-images;
                        checked <=> root.additive-sprite-guides;
                        toggled => { root.options-changed(); }
                    }
                    CheckBox {
                        text: "Entity model guides";
                        checked <=> root.entity-model-guides;
                        toggled => { root.options-changed(); }
                    }
                    Text { text: "FGD resource guides · boxes remain when off"; color: #aeb9c8; wrap: word-wrap; font-size: 12px; }
                    CheckBox {
                        text: "2D sky preview";
                        checked <=> root.sky-preview;
                        toggled => { root.options-changed(); }
                    }
                    if root.sky-preview: VerticalLayout {
                        spacing: 4px;
                        Text { text: "Sky channel"; color: #bac2ce; }
                        ComboBox {
                            model: ["LDR", "HDR · editor preview"];
                            current-index <=> root.sky-channel;
                            selected => { root.options-changed(); }
                        }
                        if root.sky-channel == 1: HorizontalLayout {
                            Text { text: "HDR sky exposure (EV)"; color: #bac2ce; vertical-alignment: center; }
                            LineEdit {
                                text <=> root.sky-exposure-ev;
                                placeholder-text: "−8 to 8";
                                accepted => { root.options-changed(); }
                            }
                        }
                        if root.sky-channel == 1: Text { text: "Sky brightness only · −8 to +8 EV"; color: #aeb9c8; wrap: word-wrap; font-size: 12px; }
                    }
                    if root.sky-preview-error != "": Text { text: root.sky-preview-error; color: #efb56b; wrap: word-wrap; }
                    if root.sky-preview: Text {
                        text: root.sky-preview-status + "\nPerspective · Textured · Tool textures";
                        color: #aeb9c8;
                        wrap: word-wrap;
                    }
                    Button { text: "Fog preview…"; clicked => { root.fog-preview(); } }
                    Text { text: root.fog-preview-status; color: #aeb9c8; wrap: word-wrap; font-size: 12px; }
                    CheckBox {
                        text: "Instance contents";
                        checked <=> root.instance-contents;
                        toggled => { root.options-changed(); }
                    }
                    Button { text: "Instance contents…"; clicked => { root.inspect-instance-contents(); } }
                    if root.instance-contents: Text { text: root.instance-contents-status; color: #aeb9c8; wrap: word-wrap; font-size: 12px; }
                    CheckBox {
                        text: "Rope preview";
                        checked <=> root.rope-preview;
                        toggled => { root.options-changed(); }
                    }
                    if root.rope-preview: Text {
                        text: root.rope-preview-status + "\nStatic authored curves · no physics";
                        color: #aeb9c8;
                        wrap: word-wrap;
                        font-size: 12px;
                    }
                    if root.surface-view == 4: HorizontalLayout {
                        Text { text: "Highlight group"; color: #c8ccd4; vertical-alignment: center; }
                        SpinBox { minimum: 1; maximum: 32; value <=> root.smoothing-view-group; edited => { root.surface-view-changed(); } }
                    }
                    if root.surface-view >= 3: Text { text: "Authored settings · baked lighting is pending"; color: #aeb9c8; wrap: word-wrap; }
                    SectionTitle { text: "SELECTION"; }
                    ComboBox {
                        model: ["Objects", "Faces · materials & textures"];
                        current-index: root.face-mode ? 1 : 0;
                        selected => { root.selection-mode-changed(self.current-index); }
                    }
                    if !root.face-mode: Text { text: "Alt+click: cycle overlapping objects"; color: #aeb9c8; wrap: word-wrap; }

                        if root.has-faces: VerticalLayout {
                            spacing: 6px;
                            SectionTitle { text: "TERRAIN"; }
                            if root.terrain-center-picking: VerticalLayout {
                                Text {text:"Click selected terrain to set the brush center.";wrap:word-wrap;color:#91b9e9;}
                                Button {text:"Cancel picking"; clicked=>{root.cancel-terrain-center-pick();}}
                            }
                            if root.terrain-triangle-picking: VerticalLayout {
                                Text {text:"Click selected terrain to pick a triangle or vertex. Escape cancels.";wrap:word-wrap;color:#91b9e9;}
                                Button {text:"Cancel picking";clicked=>{root.cancel-terrain-triangle-pick();}}
                            }
                            if root.terrain-stroking: VerticalLayout {
                                Text {text:"Drag on selected terrain, then release to review. Escape cancels.";wrap:word-wrap;color:#91b9e9;}
                                Button {text:"Cancel stroke";clicked=>{root.cancel-terrain-stroke();}}
                            }
                            if root.terrain-handling: VerticalLayout {
                                Text {text:"Move selected terrain vertices";wrap:word-wrap;color:#a7adb8;}
                                Button {text:"Cancel terrain move";clicked=>{root.cancel-terrain-handles();}}
                            }
                            if !root.can-remove-terrain: VerticalLayout {
                                spacing: 6px;
                                Text { text: "Terrain grid"; color: #c8ccd4; }
                                terrain-grid := ComboBox { model: ["5 × 5 · power 2", "9 × 9 · power 3", "17 × 17 · power 4"]; current-index: 0; }
                                Text { text: "Start corner"; color: #c8ccd4; }
                                ComboBox { model: root.terrain-corner-choices; current-index <=> root.terrain-corner-index; enabled: root.terrain-creation-error == ""; }
                                Button { text: "Create terrain"; enabled: root.terrain-creation-error == ""; clicked => { root.create-terrain(terrain-grid.current-index + 2, root.terrain-corner-index); } }
                                Text { text: root.terrain-creation-error == "" ? "Creates a terrain surface. Terrain does not seal maps. Undo restores the brush." : root.terrain-creation-error; wrap: word-wrap; color: #919aaa; font-size: 12px; }
                            }
                            if root.can-remove-terrain: VerticalLayout {
                                spacing: 6px;
                                Button { text: "Edit terrain…"; clicked => { root.change-terrain-resolution(); } }
                                Button { text: "Terrain triangles…"; clicked => { root.edit-terrain-triangles(); } }
                                Button { text: "Remove terrain"; clicked => { root.remove-terrain(); } }
                                Text { text: "Removing the last terrain face restores the parent brush's volume. Undo keeps all grid data."; wrap: word-wrap; color: #919aaa; font-size: 12px; }
                            }
                        }
                    Button { text: "Select a volume…"; clicked => { root.select-volume(); } }
                    HorizontalLayout {
                        spacing: 6px;
                        Button { text: "Object groups…"; clicked => { root.object-groups(); } }
                        Button { text: "Layers…"; clicked => { root.layers(); } }
                        Button { text: "Prefabs…"; clicked => { root.prefabs(); } }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        Button { text: "Entity…"; clicked => { root.place-entity(); } }
                        Button { text: "Tie to entity…"; enabled: root.can-tie; clicked => { root.tie-entity(); } }
                    }

                    if root.brush-entity-selected: Button {
                        text: "Move to world";
                        clicked => { root.move-to-world(); }
                    }

                    Text {
                        text: root.selection-title;
                        color: #e6e8ec;
                        font-size: 15px;
                        wrap: word-wrap;
                    }

                    if root.selection-detail != "": Text {
                        text: root.selection-detail;
                        color: #8a909c;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: "Copy"; enabled: root.has-selection; clicked => { root.copy-objects(); } }
                        Button { text: "Cut"; enabled: root.has-selection; clicked => { root.cut-objects(); } }
                        Button { text: "Paste…"; clicked => { root.paste-objects(); } }
                    }
                    if root.has-selection: CheckBox {
                        text: "Transform selection";
                        checked <=> root.show-transform;
                        toggled => { if self.checked { root.handles-mode-index = root.transform-mode >= 3 ? 0 : root.transform-mode + 1; root.transform-tool-changed(); } }
                    }
                    if root.has-selection:Button {text:"Place on surface…";clicked=>{root.place-on-surface();}}
                    if root.has-selection:Button {text:"Repeat array…";clicked=>{root.repeat-array();}}
                    if root.surface-picking:VerticalLayout {
                        Text {text:"Click a visible surface. Escape cancels picking.";wrap:word-wrap;color:#91b9e9;}
                        Button {text:"Cancel picking";clicked=>{root.cancel-surface-pick();}}
                    }
                    Button {
                        text: "Hollow brushes…";
                        enabled: root.can-clip;
                        clicked => { root.hollow-brushes(); }
                    }
                    Button {
                        text: "Carve brushes…";
                        enabled: root.can-clip;
                        clicked => { root.carve-brushes(); }
                    }
                    Button {
                        text: "Merge brushes…";
                        enabled: root.can-clip;
                        clicked => { root.merge-brushes(); }
                    }
                    Button {
                        text: "Reshape brushes…";
                        enabled: root.can-clip;
                        clicked => { root.brush-components(); }
                    }
                    Button {
                        text: "Clip selected brushes";
                        enabled: root.can-clip && !root.clipping;
                        clicked => { root.start-clip(); }
                    }
                    if root.has-selection && root.show-transform: VerticalLayout {
                        spacing: 7px;
                        if root.has-transform-preview: Text {
                            text: root.transform-preview-summary;
                            color: #e6e8ec;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        ComboBox {
                            enabled: !root.has-transform-preview;
                            model: ["Move", "Rotate", "Scale", "Mirror", "Shear"];
                            current-index <=> root.transform-mode;
                            selected => { root.handles-mode-index = self.current-index >= 3 ? 0 : self.current-index + 1; root.transform-tool-changed(); }
                        }
                        Text {
                            text: root.transform-mode == 0 ? "Offset · units" : root.transform-mode == 1 ? (root.transform-space-index == 0 ? "World-axis rotation · degrees" : "Local-axis rotation · degrees") : root.transform-mode == 2 ? (root.transform-space-index == 0 ? "World-axis scale · factors" : "Local-axis scale · factors") : root.transform-mode == 3 ? "Reflect checked coordinates across the pivot" : "Shift one coordinate in proportion to another";
                            color: #aab2c2; font-size: 12px;
                        }
                        if root.transform-mode < 3: TransformVector {
                            enabled: !root.has-transform-preview;
                            x-value <=> root.transform-x;
                            y-value <=> root.transform-y;
                            z-value <=> root.transform-z;
                            apply => { root.apply-transform(); }
                        }
                        if root.transform-mode == 3: HorizontalLayout {
                            spacing: 12px;
                            CheckBox { text: "Mirror X"; enabled: !root.has-transform-preview; checked <=> root.transform-reflect-x; }
                            CheckBox { text: "Mirror Y"; enabled: !root.has-transform-preview; checked <=> root.transform-reflect-y; }
                            CheckBox { text: "Mirror Z"; enabled: !root.has-transform-preview; checked <=> root.transform-reflect-z; }
                        }
                        if root.transform-mode == 4: VerticalLayout {
                            spacing: 6px;
                            HorizontalLayout {
                                Text { text: "Shift coordinate"; color: #c8ccd4; vertical-alignment: center; }
                                ComboBox { enabled: !root.has-transform-preview; model: ["X", "Y", "Z"]; current-index <=> root.transform-shear-axis; }
                            }
                            HorizontalLayout {
                                Text { text: "By coordinate"; color: #c8ccd4; vertical-alignment: center; }
                                ComboBox { enabled: !root.has-transform-preview; model: ["X", "Y", "Z"]; current-index <=> root.transform-shear-reference; }
                            }
                            HorizontalLayout {
                                Text { text: "Factor"; color: #c8ccd4; vertical-alignment: center; }
                                LineEdit { enabled: !root.has-transform-preview; text <=> root.transform-shear-factor; input-type: decimal; accepted => { root.apply-transform(); } }
                            }
                            Text { text: "A factor of 0.5 shifts the chosen coordinate by half the reference distance from the pivot. Choose different axes."; color: #8a909c; font-size: 12px; wrap: word-wrap; }
                        }
                        if root.transform-mode >= 3: ComboBox {
                            enabled: !root.has-transform-preview;
                            model: ["World axes", "Local axes"];
                            current-index <=> root.transform-space-index;
                            selected => { root.transform-tool-changed(); }
                        }
                        if root.transform-mode != 0: VerticalLayout {
                            spacing: 6px;
                            HorizontalLayout {
                                Text { text: "Pivot"; color: #c8ccd4; vertical-alignment: center; }
                                ComboBox {
                                    horizontal-stretch: 1;
                                    model: ["Selection center", "World origin", "Custom"];
                                    enabled: !root.has-transform-preview;
                                    current-index <=> root.transform-pivot-mode;
                                selected => { root.transform-tool-changed(); }
                                }
                            }
                            if root.transform-pivot-mode == 0: Text { text: root.selection-pivot; color: #8a909c; font-size: 12px; }
                            Button { text: "Pick pivot…"; enabled: root.can-pick-pivot; clicked => { root.pick-transform-pivot(); } }
                            if root.pivot-pick-source != "": Text { text: root.pivot-pick-source; color: #8a909c; font-size: 12px; wrap: word-wrap; }
                            if root.transform-pivot-mode == 2: TransformVector {
                                enabled: !root.has-transform-preview;
                                x-value <=> root.pivot-x;
                                y-value <=> root.pivot-y;
                                z-value <=> root.pivot-z;
                                apply => { root.transform-tool-changed(); }
                            }
                        }
                        if root.can-apply-material && root.transform-mode < 3: CheckBox { text: "Follow move and rotation"; enabled: !root.has-transform-preview; checked <=> root.transform-texture-lock; toggled => { root.transform-tool-changed(); } }
                        if root.can-apply-material && root.transform-mode == 2: CheckBox { text: "Stretch textures when scaling"; enabled: !root.has-transform-preview; checked <=> root.transform-texture-scale-lock; toggled => { root.transform-tool-changed(); } }
                        if root.can-apply-material && root.transform-mode == 2: Text { text: root.transform-texture-scale-lock ? "The texture stretches with the brush." : "The texture keeps its size and repeats across the resized brush."; color: #8a909c; font-size: 12px; wrap: word-wrap; }
                        if root.can-apply-material && root.transform-mode >= 3: CheckBox { text: root.transform-mode == 3 ? "Mirror textures with geometry" : "Keep textures attached while shearing"; enabled: !root.has-transform-preview; checked <=> root.transform-texture-scale-lock; toggled => { root.transform-tool-changed(); } }
                        if root.transform-mode >= 3: Text { text: "Edits brushes and brush entities. Point entities and terrain require separate support."; color: #8a909c; font-size: 12px; wrap: word-wrap; }
                        if root.transform-mode == 2: Text { text: "Resizes brushes and spaces entity origins."; color: #8a909c; font-size: 12px; wrap: word-wrap; }
                        Button {
                            text: root.transform-mode == 0 ? "Move selection" : root.transform-mode == 1 ? "Rotate selection" : root.transform-mode == 2 ? "Scale selection" : root.transform-mode == 3 ? "Mirror selection" : "Shear selection";
                            enabled: !root.has-transform-preview;
                            clicked => { root.apply-transform(); }
                        }
                        Button {
                            text: "Preview snap to grid";
                            enabled: !root.has-transform-preview;
                            clicked => { root.preview-snap-to-grid(); }
                        }
                        Text { text: "Anchor: selection bounds minimum. Moves the whole selection to the nearest grid point. Relative positions and brush shapes stay fixed."; color: #8a909c; font-size: 12px; wrap: word-wrap; }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        Button { text: "World settings…"; clicked => { root.world-settings(); } }
                        Button { text: "Object report…"; clicked => { root.object-report(); } }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Button { text: "Map statistics…"; clicked => { root.map-statistics(); } }
                        Button { text: "Pointfile…"; clicked => { root.pointfile(); } }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Button { text: "Check map…"; clicked => { root.map-checks(); } }
                        Button { text: "Recovery…"; clicked => { root.recovery(); } }
                    }
                    Button { text: "Brush shapes…"; clicked => { root.brush-shapes(); } }
                    Button { text: "Draw polygon…"; clicked => { root.draw-polygon(); } }
                    Button { text: "Create linked path…"; clicked => { root.create-linked-path(); } }
                    Button { text: "Design context…"; clicked => { root.design-context(); } }
                    Button { text: "Edit selected entity properties…"; clicked => { root.batch-properties(); } }
                    if root.entity-selected: Button {
                        text: "Connections…";
                        clicked => { root.edit-connections(); }
                    }

                    if root.entity-selected: Button {
                        text: "References and rename…";
                        clicked => { root.edit-references(); }
                    }

                    if root.can-inspect-model: Button {text:"Model details…";clicked=>{root.inspect-model();}}
                    if root.can-cubemap-faces: Button { text: "Cubemap faces…"; clicked => { root.cubemap-faces(); } }

                    if root.entity-selected && root.entity-helper-status != "": Text {
                        text: root.entity-helper-status;
                        wrap: word-wrap;
                        color: #bac2ce;
                        font-size: 12px;
                    }

                    if root.has-fgd-model-guide: Button {
                        text: "Reload models";
                        clicked => { root.reload-model-guides(); }
                    }

                    if root.entity-selected: CheckBox {
                        text: "Advanced properties";
                        checked <=> root.advanced-properties;
                    }

                    if root.entity-selected: ListView {
                        min-height: 180px;
                        vertical-stretch: 1;
                        for row in root.entity-properties: VerticalLayout {
                            if !row.advanced || root.advanced-properties: PropertyField {
                                field: row;
                                advanced: root.advanced-properties;
                                model-browsing: true;
                                edited(value) => { root.property-edited(row.key, value); }
                                component-edited(index, value) => { root.property-component-edited(row.key, index, value); }
                                removed => { root.property-removed(row.key); }
                                flag-toggled(flag, checked) => { root.flag-toggled(row.key, flag, checked); }
                                pick-color => { root.pick-color(row.key); }
                                pick-material => { root.browse-material(row.key); }
                                pick-model => { root.browse-model(); }
                                pick-sound => { root.browse-sound(row.key); }
                                pick-particle => { root.browse-particle(); }
                            }
                        }
                    }

                    if root.entity-selected && root.advanced-properties: HorizontalLayout {
                        spacing: 6px;
                        new-key := LineEdit { width: 110px; placeholder-text: "Property key"; }
                        new-value := LineEdit {
                            horizontal-stretch: 1;
                            placeholder-text: "Value";
                            accepted(text) => {
                                root.property-edited(new-key.text, text);
                                new-key.text = "";
                                self.text = "";
                            }
                        }
                    }

                    if !root.entity-selected: Rectangle {
                        vertical-stretch: 1;
                    }

                    if root.can-apply-material: VerticalLayout {
                        spacing: 8px;
                        SectionTitle { text: root.face-mode ? "FACE MATERIAL" : "BRUSH MATERIAL"; }
                        if root.has-faces: Button { text: "Sample face texture"; enabled: root.can-sample-face; clicked => { root.sample-face-texture(); } }
                        if root.has-faces: Button { text: "Edit face textures…"; clicked => { root.edit-face-textures(); } }
                        if root.has-faces: Button { text: "Map textures together…"; clicked => { root.map-face-group(); } }
                        if root.has-faces: Button { text: "Face lighting…"; clicked => { root.edit-face-lighting(); } }
                        HorizontalLayout {
                            spacing: 10px;
                            if root.has-material-preview: Image { width: 64px; height: 64px; source: root.material-preview; image-fit: contain; }
                            Text { text: root.material; wrap: word-wrap; color: #c8ccd4; horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Button { text: "Browse materials…"; clicked => { root.browse-material(""); } }
                            Button { text: "Apply"; clicked => { root.apply-material(); } }
                        }
                        LineEdit {
                            text <=> root.material;
                            placeholder-text: "Material path";
                            accepted => { root.material-changed(); root.apply-material(); }
                        }
                    }

                    Button { text: "Overlay…"; clicked => { root.create-overlay(); } }
                    Button { text: "Replace materials…"; clicked => { root.replace-materials(); } }

                    SectionTitle {
                        text: "ACTIVITY";
                    }

                    ListView {
                        height: 100px;

                        for entry in root.activity: HorizontalLayout {
                            spacing: 6px;
                            padding-bottom: 2px;

                            Text {
                                width: 40px;
                                text: entry.actor;
                                color: entry.actor == "agent" ? #6fbf73 : #6c9bd2;
                                font-size: 12px;
                            }

                            Text {
                                horizontal-stretch: 1;
                                text: entry.text;
                                color: #c8ccd4;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
                }
            }
        }

        Rectangle {
            height: 26px;
            background: #1a1d23;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 20px;

                StatusText {
                    text: root.message;
                    color: #c8ccd4;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                StatusText {
                    text: root.stats;
                }

                StatusText {
                    text: root.camera;
                    font-family: "monospace";
                }
            }
        }
    }
}
