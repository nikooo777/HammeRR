import { Theme } from "theme.slint";
import {Button} from "widgets.slint";

export struct PreviewDefaultRow {
    label: string,
    current: string,
    defaults: string,
}

export component PreviewDefaultsWindow inherits Window {
    background: Theme.panel;
    title: "Preview defaults - HammeRR";
    preferred-width: 720px;
    preferred-height: 720px;
    min-width: 650px;
    min-height: 680px;
    in property <[PreviewDefaultRow]> rows;
    in property <string> defaults;
    in property <string> storage;
    in property <string> status;
    in property <string> message;
    in property <bool> ready;
    callback save();
    callback apply();
    callback reload();
    callback reset();
    callback close-dialog();
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => { if event.text == Key.Escape { root.close-dialog(); accept } else { reject } }
        VerticalLayout {
            padding: Theme.space-xl;
            spacing: 12px;
            Text { text: "Preview defaults"; font-size: Theme.font-display; font-weight: 600; }
            Text { text: "Choose preview and guide visibility in the viewport, then save the settings you want at startup."; color: Theme.text-muted; wrap: word-wrap; }
            HorizontalLayout {
                Text { text: "Setting"; horizontal-stretch: 1; font-weight: 600; }
                Text { text: "Current session"; width: 125px; font-weight: 600; }
                Text { text: "Startup defaults"; width: 125px; font-weight: 600; }
            }
            for row in root.rows: Rectangle {
                height: 28px;
                HorizontalLayout {
                    Text { text: row.label; horizontal-stretch: 1; vertical-alignment: center; }
                    Text { text: row.current; width: 125px; vertical-alignment: center; }
                    Text { text: row.defaults; width: 125px; vertical-alignment: center; }
                }
            }
            Text { text: root.defaults; wrap: word-wrap; color: Theme.text-muted; }
            Text { text: root.storage; wrap: word-wrap; color: Theme.text-muted; }
            Text { text: root.status; wrap: word-wrap; color: Theme.warning; }
            Text { text: "Only these five toggles are saved. Sky channel and exposure, fog, rendering mode, grid, cameras and active tools keep their own settings. Ordinary viewport changes stay temporary until Save current as defaults."; wrap: word-wrap; color: Theme.text-muted; }
            Rectangle { vertical-stretch: 1; }
            Text { text: root.message; wrap: word-wrap; min-height: 34px; }
            HorizontalLayout {
                spacing: 10px;
                Button { text: "Reload defaults"; clicked => { root.reload(); } }
                Button { text: "Reset saved defaults"; clicked => { root.reset(); } }
                Rectangle { horizontal-stretch: 1; }
            }
            HorizontalLayout {
                spacing: 10px;
                Button { text: "Close"; clicked => { root.close-dialog(); } }
                Rectangle { horizontal-stretch: 1; }
                Button { text: "Apply saved defaults"; enabled: root.ready; clicked => { root.apply(); } }
                Button { text: "Save current as defaults"; enabled: root.ready; clicked => { root.save(); } }
            }
        }
    }
}
