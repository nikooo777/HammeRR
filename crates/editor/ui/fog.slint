import { Theme, FieldRow, SectionHeader } from "kit.slint";
import { Button, ComboBox, LineEdit, ScrollView, Slider, Switch } from "widgets.slint";

export component FogWindow inherits Window {
    background: Theme.panel;
    title: "Fog preview - HammeRR";
    preferred-width: 760px;
    preferred-height: 760px;
    min-width: 560px;
    min-height: 620px;

    in-out property <bool> preview-enabled;
    in-out property <int> controller-index;
    in property <[string]> controllers;
    in property <string> effective-controller;
    in property <string> current;
    in property <string> detail;
    in property <string> message;
    in property <bool> can-apply;
    in property <string> document-label;
    in property <bool> available;
    in property <bool> scene-display-available;
    in-out property <int> scene-display-mode-index;
    in-out property <string> scene-exposure-ev: "0";
    in-out property <bool> scene-display-dirty;
    in property <string> scene-display-requested;
    in property <string> scene-display-effective;
    in property <string> scene-display-owner;
    in property <string> scene-display-availability;
    in property <string> scene-display-message;
    in property <bool> scene-display-issue;
    in property <bool> has-issue;
    in-out property <bool> selection-dirty;
    in property <string> selection-status;
    in-out property <int> channel-index;
    in property <[string]> channels;
    in-out property <int> environment-index;
    in property <[string]> environments;
    in property <string> environment-detail;
    in-out property <int> initial-rule-index;
    in property <[string]> initial-rules;
    in property <string> initial-rule-detail;
    in-out property <int> water-radial-index;
    in property <[string]> water-radial-contexts;
    in property <string> water-radial-detail;
    in property <bool> water-radial-recorded;
    in-out property <int> pass-index;
    in property <[string]> passes;
    in-out property <bool> pass-dirty;
    in property <bool> can-record-pass;
    in property <string> pass-status;
    in property <string> pass-detail;
    in property <bool> pass-issue;
    in property <bool> environment-busy;
    in property <bool> environment-automatic;
    in property <bool> can-prepare-environment;
    in property <string> channel-detail;
    in property <bool> document-active: true;
    in property <bool> playing;
    in property <bool> transitioning;
    in property <bool> can-play;
    in property <bool> can-seek;
    in property <string> playback-status;
    in property <string> time-label;
    in property <string> time-limits;
    in property <float> max-time-seconds: 1;
    in-out property <float> time-value;
    in-out property <string> seek-time;
    in-out property <bool> time-dirty;
    in-out property <bool> scrub-dirty;
    in-out property <int> input-index;
    in property <[string]> inputs;
    in-out property <int> input-controller-index;
    in property <[string]> input-controllers;
    in-out property <string> input-value;
    in property <string> input-help;
    in property <string> input-target;
    in property <string> input-state;
    in property <bool> input-has-value;
    in property <bool> can-send-input;
    in-out property <bool> input-dirty;
    in-out property <bool> scene-display-expanded;
    in-out property <bool> environment-expanded;
    in-out property <bool> input-expanded: true;
    in-out property <bool> limits-expanded;
    in-out property <bool> player-expanded: true;
    in-out property <int> player-index;
    in property <[string]> player-controllers;
    in-out property <bool> player-dirty;
    in property <bool> can-switch-player;
    in property <string> player-status;
    in property <string> player-state;
    in property <string> player-detail;
    in property <bool> player-issue;
    in-out property <bool> trigger-expanded;
    in-out property <int> trigger-index;
    in property <[string]> triggers;
    in-out property <bool> trigger-dirty;
    in property <bool> can-enter-trigger;
    in property <bool> can-leave-trigger;
    in property <string> trigger-membership;
    in property <string> trigger-detail;
    in property <string> trigger-status;
    in property <bool> trigger-issue;
    in property <string> scope;

    callback choice-changed();
    callback scene-display-changed();
    callback apply-scene-display();
    callback refresh();
    callback apply();
    callback cancel();
    callback play-pause();
    callback reset();
    callback seek();
    callback scrub(float);
    callback time-edited();
    callback input-changed();
    callback input-edited();
    callback send-input();
    callback prepare-environment();
    callback cancel-work();
    callback clear-preview();
    callback player-changed();
    callback switch-player-controller();
    callback pass-changed();
    callback record-render-pass();
    callback trigger-changed();
    callback enter-trigger();
    callback leave-trigger();

    forward-focus: dialog-focus;
    dialog-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); accept } else { reject }
        }
        VerticalLayout {
            padding: Theme.space-xl;
            spacing: Theme.space-lg;
            Text { text: "Fog preview"; font-size: Theme.font-display; font-weight: 600; }
            if root.document-label != "": Text { text: root.document-label; color: Theme.text-faint; overflow: elide; }
            if root.current != "": Text { text: root.current; wrap: word-wrap; color: root.has-issue ? Theme.warning : Theme.text-muted; }
            HorizontalLayout {
                spacing: Theme.space;
                Switch {
                    text: "Enable fog preview";
                    checked <=> root.preview-enabled;
                    enabled: root.available;
                    toggled => { root.selection-dirty = true; root.choice-changed(); }
                }
                Text { text: root.selection-dirty ? root.selection-status : ""; color: Theme.text-faint; vertical-alignment: center; horizontal-alignment: right; horizontal-stretch: 1; wrap: word-wrap; }
                Button { text: "Apply preview"; enabled: root.can-apply; primary: true; clicked => { root.apply(); } }
            }
            FieldRow {
                inset: false; label: "Initial controller"; label-width: 128px;
                if !root.environment-automatic: ComboBox {
                    accessible-label: "Initial fog controller";
                    model: root.controllers;
                    current-index <=> root.controller-index;
                    enabled: root.available;
                    selected => { root.selection-dirty = true; root.choice-changed(); }
                }
                if root.environment-automatic: Text { text: root.effective-controller; color: Theme.text-muted; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
            }
            FieldRow {
                inset: false; label: "Channel"; label-width: 128px;
                ComboBox {
                    width: 140px;
                    accessible-label: "Fog preview channel";
                    model: root.channels;
                    current-index <=> root.channel-index;
                    enabled: root.available;
                    selected => { root.selection-dirty = true; root.choice-changed(); }
                }
                Text { text: root.channel-detail; color: Theme.text-faint; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
            }
            ScrollView {
                content-width: self.width;
                horizontal-scrollbar-policy: always-off;
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;
                    padding-right: Theme.space-lg;
                    spacing: Theme.space-lg;
                    VerticalLayout {
                        spacing: Theme.space;
                        SectionHeader { text: "Scene display"; inset: false; expanded <=> root.scene-display-expanded; detail: root.scene-display-dirty ? "Unapplied display" : root.scene-display-requested; }
                        if root.scene-display-expanded: VerticalLayout {
                            spacing: Theme.space;
                        FieldRow {
                            inset: false; label: "Display mode"; label-width: 128px;
                            ComboBox {
                                model: ["Legacy", "HDR"];
                                current-index <=> root.scene-display-mode-index;
                                enabled: root.scene-display-available;
                                accessible-label: "Scene display mode";
                                selected => { root.scene-display-dirty = true; root.scene-display-changed(); }
                            }
                        }
                        FieldRow {
                            inset: false; label: "Scene exposure EV"; label-width: 128px;
                            LineEdit {
                                text <=> root.scene-exposure-ev;
                                input-type: decimal;
                                placeholder-text: "−8 to 8";
                                enabled: root.scene-display-available && root.scene-display-mode-index == 1;
                                accessible-label: "Scene exposure EV";
                                edited => { root.scene-display-dirty = true; root.scene-display-changed(); }
                                accepted => { root.apply-scene-display(); }
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.space;
                            Button { text: "Apply scene display"; enabled: root.scene-display-available && root.scene-display-dirty; clicked => { root.apply-scene-display(); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        FieldRow { inset: false; label: "Requested"; label-width: 128px; Text { text: root.scene-display-requested; wrap: word-wrap; color: Theme.text-muted; } }
                        FieldRow { inset: false; label: "Active pane"; label-width: 128px; Text { text: root.scene-display-effective; wrap: word-wrap; color: Theme.text-muted; } }
                        FieldRow { inset: false; label: "Exposure owner"; label-width: 128px; Text { text: root.scene-display-owner; wrap: word-wrap; color: Theme.text-muted; } }
                        FieldRow { inset: false; label: "Availability"; label-width: 128px; Text { text: root.scene-display-availability; wrap: word-wrap; color: root.scene-display-issue ? Theme.warning : Theme.text-muted; } }
                        Text { text: "HDR applies to Perspective, Textured panes. Scene exposure affects the complete scene, including sky and fog. Legacy panes retain their component exposures."; wrap: word-wrap; color: Theme.text-faint; font-size: Theme.font-small; }
                        }
                        if root.scene-display-issue && !root.scene-display-expanded: Text { text: root.scene-display-availability; wrap: word-wrap; color: Theme.warning; }
                        if root.scene-display-message != "": Text { text: root.scene-display-message; wrap: word-wrap; color: Theme.warning; }
                    }
                    SectionHeader { text: "Playback"; inset: false; collapsible: false; detail: root.transitioning ? "Transition inputs" : ""; }
                    HorizontalLayout {
                        spacing: Theme.space;
                        Button { text: root.playing ? "Pause" : "Play"; enabled: root.available && (root.playing || (root.can-play && root.document-active)); clicked => { root.play-pause(); } }
                        Button { text: "Reset"; enabled: root.available && !root.environment-busy; clicked => { root.reset(); } }
                        Text { text: root.document-active ? root.playback-status : "Inactive document · playback suspended"; color: Theme.text-muted; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                    }
                    FieldRow {
                        inset: false; label: "Time"; label-width: 128px;
                        Slider {
                            minimum: 0; maximum: max(0.001, root.max-time-seconds); step: 0.01;
                            value <=> root.time-value;
                            enabled: root.available && root.can-seek;
                            accessible-label: "Fog preview time in seconds";
                            changed => { root.scrub-dirty = true; root.time-edited(); }
                            released(value) => { root.scrub(value); }
                        }
                        LineEdit {
                            width: 80px; text <=> root.seek-time;
                            accessible-label: "Fog seek time in seconds";
                            enabled: root.available && root.can-seek;
                            edited => { root.time-dirty = true; root.time-edited(); }
                            accepted => { root.seek(); }
                        }
                        Button { text: "Seek"; width: 64px; enabled: root.available && root.can-seek; clicked => { root.seek(); } }
                    }
                    HorizontalLayout {
                        spacing: Theme.space;
                        Text { text: root.time-label; color: Theme.text-muted; }
                        Text { text: (root.time-dirty || root.scrub-dirty ? "Unsubmitted time · " : "") + root.time-limits; color: Theme.text-faint; horizontal-alignment: right; horizontal-stretch: 1; }
                    }
                    Text { text: "Reset clears preview events and restores initial values under the selected rule. Seek preserves the event sequence."; color: Theme.text-faint; wrap: word-wrap; font-size: Theme.font-small; }
                    SectionHeader { text: "Environment"; inset: false; expanded <=> root.environment-expanded; }
                    if root.environment-expanded: VerticalLayout {
                        spacing: Theme.space;
                        FieldRow {
                            inset: false; label: "Environment"; label-width: 128px;
                            ComboBox {
                                model: root.environments; current-index <=> root.environment-index;
                                accessible-label: "Fog preview environment";
                                enabled: root.available;
                                selected => { root.selection-dirty = true; root.choice-changed(); }
                            }
                        }
                        if root.environment-detail != "": Text { text: root.environment-detail; color: Theme.text-faint; wrap: word-wrap; }
                        FieldRow {
                            inset: false; label: "Initial rule"; label-width: 128px;
                            ComboBox {
                                model: root.initial-rules; current-index <=> root.initial-rule-index;
                                accessible-label: "Initial fog rule";
                                enabled: root.available;
                                selected => { root.selection-dirty = true; root.choice-changed(); }
                            }
                        }
                        if root.initial-rule-detail != "": Text { text: root.initial-rule-detail; color: Theme.text-faint; wrap: word-wrap; }
                        FieldRow {
                            inset: false; label: "Water radial"; label-width: 128px;
                            ComboBox {
                                model: root.water-radial-contexts; current-index <=> root.water-radial-index;
                                accessible-label: "Water radial context";
                                enabled: root.available;
                                selected => { root.selection-dirty = true; root.choice-changed(); }
                            }
                        }
                        if root.water-radial-detail != "": Text { text: root.water-radial-detail; color: Theme.text-faint; wrap: word-wrap; }
                        Text { text: "Applying a different initial or water radial rule resets all preview events and time and pauses playback."; color: Theme.text-faint; wrap: word-wrap; font-size: Theme.font-small; }
                        if root.environment-automatic || root.environment-busy: HorizontalLayout {
                            spacing: Theme.space;
                            Button { text: root.environment-busy ? "Preparing environment…" : "Prepare environment"; enabled: root.can-prepare-environment; clicked => { root.prepare-environment(); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        if root.water-radial-recorded: VerticalLayout {
                            spacing: Theme.space;
                            FieldRow {
                                inset: false; label: "Setup"; label-width: 128px;
                                ComboBox {
                                    model: root.passes; current-index <=> root.pass-index;
                                    accessible-label: "Fog setup to record";
                                    enabled: root.available;
                                    selected => { root.pass-dirty = true; root.pass-changed(); }
                                }
                            }
                            if root.pass-detail != "": Text { text: root.pass-detail; color: root.pass-issue ? Theme.warning : Theme.text-faint; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: Theme.space;
                                Button { text: "Record setup"; enabled: root.can-record-pass; clicked => { root.record-render-pass(); } }
                                Text { text: root.pass-dirty ? "Unsubmitted setup" : ""; color: Theme.text-faint; vertical-alignment: center; horizontal-stretch: 1; }
                            }
                            if root.pass-status != "": Text { text: root.pass-status; color: Theme.text-muted; wrap: word-wrap; }
                            Text { text: "Record a setup at the current preview time. Disabled fog preserves the last write. Sky fog requires a selected sky camera. Seek and rendering do not record setups."; color: Theme.text-faint; wrap: word-wrap; font-size: Theme.font-small; }
                        }
                    }
                    SectionHeader { text: "Player controller"; detail: root.player-dirty ? "Unsubmitted target" : ""; inset: false; expanded <=> root.player-expanded; }
                    if root.player-expanded: VerticalLayout {
                        spacing: Theme.space;
                        FieldRow {
                            inset: false; label: "Target"; label-width: 128px;
                            ComboBox {
                                model: root.player-controllers; current-index <=> root.player-index;
                                accessible-label: "Player fog controller target";
                                enabled: root.available;
                                selected => { root.player-dirty = true; root.player-changed(); }
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.space;
                            Button { text: "Switch player fog"; enabled: root.can-switch-player; clicked => { root.switch-player-controller(); } }
                            Text { text: root.player-status; color: Theme.text-muted; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                        }
                        if root.player-state != "": Text { text: root.player-state; color: Theme.text-muted; wrap: word-wrap; }
                        if root.player-detail != "": Text { text: root.player-detail; color: root.player-issue ? Theme.warning : Theme.text-faint; wrap: word-wrap; }
                        Text { text: "Inputs and player switches share one ordered history. A switch copies the target's current delivered fog and interrupts from the last player write. Initial controller selection remains a manual snap."; color: Theme.text-faint; wrap: word-wrap; font-size: Theme.font-small; }
                    }
                    SectionHeader { text: "Controller input"; detail: (root.input-dirty ? "Unsubmitted input · " : "") + root.input-target; inset: false; expanded <=> root.input-expanded; }
                    if root.input-expanded: VerticalLayout {
                        spacing: Theme.space;
                        FieldRow {
                            inset: false; label: "Target"; label-width: 128px;
                            ComboBox {
                                model: root.input-controllers; current-index <=> root.input-controller-index;
                                accessible-label: "Controller input target";
                                enabled: root.available;
                                selected => { root.input-dirty = true; root.input-changed(); }
                            }
                        }
                        FieldRow {
                            inset: false; label: "Input"; label-width: 128px;
                            ComboBox {
                                model: root.inputs; current-index <=> root.input-index;
                                accessible-label: "Fog controller input";
                                enabled: root.available;
                                selected => { root.input-dirty = true; root.input-changed(); }
                            }
                        }
                        if root.input-has-value: FieldRow {
                            inset: false; label: "Value"; label-width: 128px;
                            LineEdit {
                                text <=> root.input-value; enabled: root.available;
                                accessible-label: "Fog controller input value";
                                edited => { root.input-dirty = true; root.input-edited(); }
                                accepted => { root.send-input(); }
                            }
                        }
                        if root.input-help != "": Text { text: root.input-help; color: Theme.text-faint; wrap: word-wrap; }
                        HorizontalLayout {
                            spacing: Theme.space;
                            Button { text: "Send input"; enabled: root.can-send-input; clicked => { root.send-input(); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        if root.input-state != "": Text { text: root.input-state; color: Theme.text-muted; wrap: word-wrap; }
                        Text { text: "Inputs change the chosen controller in preview without changing the initial or player controller selection."; color: Theme.text-faint; wrap: word-wrap; font-size: Theme.font-small; }
                    }
                    SectionHeader { text: "Trigger touches"; detail: root.trigger-dirty ? "Unsubmitted source" : ""; inset: false; expanded <=> root.trigger-expanded; }
                    if root.trigger-expanded: VerticalLayout {
                        spacing: Theme.space;
                        FieldRow {
                            inset: false; label: "Source"; label-width: 128px;
                            ComboBox {
                                model: root.triggers; current-index <=> root.trigger-index;
                                accessible-label: "Fog trigger touch source";
                                enabled: root.available;
                                selected => { root.trigger-dirty = true; root.trigger-changed(); }
                            }
                        }
                        if root.trigger-detail != "": Text { text: root.trigger-detail; color: root.trigger-issue ? Theme.warning : Theme.text-faint; wrap: word-wrap; }
                        HorizontalLayout {
                            spacing: Theme.space;
                            Button { text: "Enter"; enabled: root.can-enter-trigger; clicked => { root.enter-trigger(); } }
                            Button { text: "Leave"; enabled: root.can-leave-trigger; clicked => { root.leave-trigger(); } }
                            Text { text: root.trigger-membership; color: Theme.text-muted; vertical-alignment: center; horizontal-stretch: 1; }
                        }
                        if root.trigger-status != "": Text { text: root.trigger-status; color: Theme.text-muted; wrap: word-wrap; }
                        Text { text: "Enter and Leave record explicit touches at the current preview time. One virtual alive player starts outside every source. Camera movement does not detect touches."; color: Theme.text-faint; wrap: word-wrap; font-size: Theme.font-small; }
                    }
                    SectionHeader { text: "Current settings"; inset: false; collapsible: false; }
                    Text { text: root.detail; color: Theme.text-muted; wrap: word-wrap; }
                    if root.scope != "": SectionHeader { text: "Preview limits"; inset: false; expanded <=> root.limits-expanded; }
                    if root.scope != "" && root.limits-expanded: Text { text: root.scope; color: Theme.text-faint; wrap: word-wrap; }
                }
            }
            Text { text: "Edit source fog fields in Inspector."; color: Theme.text-faint; font-size: Theme.font-small; }
            if root.message != "": Text { text: root.message; color: Theme.warning; wrap: word-wrap; }
            HorizontalLayout {
                spacing: Theme.space;
                Button { text: "Refresh choices"; clicked => { root.refresh(); } }
                Button { text: "Clear preview"; enabled: root.available; clicked => { root.clear-preview(); } }
                if root.environment-busy: Button { text: "Cancel work"; clicked => { root.cancel-work(); } }
                Rectangle { horizontal-stretch: 1; }
                Button { text: "Close"; clicked => { root.cancel(); } }
            }
        }
    }
}
