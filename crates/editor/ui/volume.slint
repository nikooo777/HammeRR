import { Theme } from "theme.slint";
import { Button, ComboBox, LineEdit } from "widgets.slint";

export component VolumeWindow inherits Window {
    background: Theme.panel;
    title: "Select a volume - HammeRR";
    preferred-width: 650px;
    preferred-height: 560px;
    in-out property <string> min-x;
    in-out property <string> min-y;
    in-out property <string> min-z;
    in-out property <string> max-x;
    in-out property <string> max-y;
    in-out property <string> max-z;
    in-out property <int> target;
    in-out property <int> rule;
    in-out property <int> mode;
    in property <string> bounds-label;
    in property <string> summary: "Preview the region to see what matches.";
    in property <string> message;
    in property <bool> ready;
    callback edited();
    callback use-bounds();
    callback preview-edit();
    callback frame();
    callback apply();
    callback cancel();
    forward-focus: keys;
    keys := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => { if event.text == Key.Escape { root.cancel(); accept } else { reject } }
        VerticalLayout {
            padding: 24px;
            spacing: 14px;
            Text { text: "Select a volume"; font-size: 24px; font-weight: 600; }
            Text { text: "Choose objects or faces inside a box in world space."; color: Theme.text-muted; }
            HorizontalLayout {
                spacing: 12px;
                ComboBox { model: ["Objects", "Faces"]; current-index <=> root.target; selected => { root.edited(); } }
                ComboBox { model: ["Intersects the box", "Fully inside the box"]; current-index <=> root.rule; selected => { root.edited(); } }
            }
            Text { text: "Box corners · world units"; font-weight: 600; }
            HorizontalLayout {
                spacing: 10px;
                Text { width: 80px; text: ""; }
                Text { horizontal-stretch: 1; text: "X"; }
                Text { horizontal-stretch: 1; text: "Y"; }
                Text { horizontal-stretch: 1; text: "Z · height"; }
            }
            HorizontalLayout {
                spacing: 10px;
                Text { width: 80px; text: "Minimum"; vertical-alignment: center; }
                LineEdit { text <=> root.min-x; input-type: decimal; edited => { root.edited(); } }
                LineEdit { text <=> root.min-y; input-type: decimal; edited => { root.edited(); } }
                LineEdit { text <=> root.min-z; input-type: decimal; edited => { root.edited(); } }
            }
            HorizontalLayout {
                spacing: 10px;
                Text { width: 80px; text: "Maximum"; vertical-alignment: center; }
                LineEdit { text <=> root.max-x; input-type: decimal; edited => { root.edited(); } }
                LineEdit { text <=> root.max-y; input-type: decimal; edited => { root.edited(); } }
                LineEdit { text <=> root.max-z; input-type: decimal; edited => { root.edited(); } }
            }
            Button { text: root.bounds-label; clicked => { root.use-bounds(); } }
            HorizontalLayout {
                spacing: 12px;
                Text { text: "When applied"; vertical-alignment: center; }
                ComboBox { model: ["Replace selection", "Add to selection", "Remove from selection", "Toggle matches"]; current-index <=> root.mode; selected => { root.edited(); } }
            }
            Text { text: root.summary; font-weight: 600; wrap: word-wrap; }
            Text { text: "Blue lines mark the box; highlights show the resulting selection. Hidden geometry is skipped. Terrain uses its supporting brush faces."; color: Theme.text-muted; wrap: word-wrap; }
            Text { text: root.message; wrap: word-wrap; }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 10px;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
                Button { text: "Frame box"; enabled: root.ready; clicked => { root.frame(); } }
                Button { text: "Preview matches"; clicked => { root.preview-edit(); } }
                Button { text: "Select matches"; enabled: root.ready; clicked => { root.apply(); } }
            }
        }
    }
}
