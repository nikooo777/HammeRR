import { Theme } from "theme.slint";
import { SectionHeader } from "kit.slint";
import { Button, CheckBox, ComboBox, LineEdit, ScrollView, SpinBox } from "widgets.slint";

component VectorRow inherits HorizontalLayout {
    in property <string> label;
    in-out property <string> value-x: "0";
    in-out property <string> value-y: "0";
    in-out property <string> value-z: "0";
    callback edited();
    spacing: Theme.space;
    Text { text: root.label; width: Theme.workspace-field-label-width; vertical-alignment: center; color: Theme.text; }
    Text { text: "X"; vertical-alignment: center; color: Theme.text-muted; }
    LineEdit { min-width: Theme.placement-field-min-width; preferred-width: Theme.placement-field-width; horizontal-stretch: 1; text <=> root.value-x; input-type: decimal; edited => { root.edited(); } }
    Text { text: "Y"; vertical-alignment: center; color: Theme.text-muted; }
    LineEdit { min-width: Theme.placement-field-min-width; preferred-width: Theme.placement-field-width; horizontal-stretch: 1; text <=> root.value-y; input-type: decimal; edited => { root.edited(); } }
    Text { text: "Z"; vertical-alignment: center; color: Theme.text-muted; }
    LineEdit { min-width: Theme.placement-field-min-width; preferred-width: Theme.placement-field-width; horizontal-stretch: 1; text <=> root.value-z; input-type: decimal; edited => { root.edited(); } }
}

component RangeRow inherits HorizontalLayout {
    in property <string> label;
    in-out property <string> minimum;
    in-out property <string> maximum;
    callback edited();
    spacing: Theme.space;
    Text { text: root.label; width: Theme.workspace-field-label-width; vertical-alignment: center; color: Theme.text; }
    Text { text: "From"; vertical-alignment: center; color: Theme.text-muted; }
    LineEdit { min-width: Theme.placement-field-min-width; horizontal-stretch: 1; text <=> root.minimum; input-type: decimal; edited => { root.edited(); } }
    Text { text: "To"; vertical-alignment: center; color: Theme.text-muted; }
    LineEdit { min-width: Theme.placement-field-min-width; horizontal-stretch: 1; text <=> root.maximum; input-type: decimal; edited => { root.edited(); } }
}

export component RepeatWindow inherits Window {
    background: Theme.panel;
    default-font-size: Theme.font;
    title: root.scatter-mode ? "Surface scatter" : "Repeat array";
    preferred-width: Theme.workspace-dialog-width;
    preferred-height: Theme.workspace-dialog-height;
    in property <bool> scatter-mode;
    in property <string> selection;
    in property <string> target-faces;
    in-out property <int> count: 3;
    in-out property <int> space-index: 0;
    in-out property <int> pivot-source: 0;
    in property <bool> last-settings-available;
    in-out property <string> move-x: "64";
    in-out property <string> move-y: "0";
    in-out property <string> move-z: "0";
    in-out property <string> rotate-x: "0";
    in-out property <string> rotate-y: "0";
    in-out property <string> rotate-z: "0";
    in-out property <string> scale-x: "1";
    in-out property <string> scale-y: "1";
    in-out property <string> scale-z: "1";
    in-out property <string> pivot-x: "0";
    in-out property <string> pivot-y: "0";
    in-out property <string> pivot-z: "0";
    in-out property <string> seed: "1";
    in-out property <bool> align: true;
    in-out property <bool> automatic-anchor: true;
    in-out property <string> heading-min: "0";
    in-out property <string> heading-max: "360";
    in-out property <string> uniform-scale-min: "1";
    in-out property <string> uniform-scale-max: "1";
    in-out property <string> normal-offset: "0";
    in-out property <bool> naming-expanded: false;
    in-out property <int> name-style: 0;
    in-out property <string> name-prefix;
    in-out property <string> name-suffix: "_copy";
    in-out property <int> name-start: 1;
    in-out property <int> internal-links: 0;
    in-out property <int> external-links: 0;
    in-out property <bool> texture-lock: true;
    in property <bool> ready;
    in property <string> summary;
    in property <string> message;
    callback preview();
    callback apply();
    callback cancel();
    callback invalidate();
    callback use-last-settings();
    callback capture-sources();
    callback capture-faces();
    forward-focus: dialog-focus;
    dialog-focus := FocusScope {
        key-pressed(event) => { if event.text == Key.Escape { root.cancel(); accept } else { reject } }
        VerticalLayout {
            padding: Theme.space-xl;
            spacing: Theme.space-lg;
            Text { text: root.scatter-mode ? "Scatter objects on surfaces" : "Repeat selected objects"; font-size: Theme.font-display; font-weight: 600; color: Theme.text; }
            ScrollView {
                vertical-stretch: 1;
                content-width: self.visible-width;
                VerticalLayout {
                    alignment: start;
                    padding-right: Theme.space-lg;
                    spacing: Theme.space-lg;
                    if root.scatter-mode: VerticalLayout {
                        spacing: Theme.space;
                        HorizontalLayout {
                            spacing: Theme.space;
                            Button { text: "Use selected objects"; clicked => { root.capture-sources(); } }
                            Text { text: root.selection; horizontal-stretch: 1; wrap: word-wrap; color: Theme.text-muted; vertical-alignment: center; }
                        }
                        HorizontalLayout {
                            spacing: Theme.space;
                            Button { text: "Use selected faces"; clicked => { root.capture-faces(); } }
                            Text { text: root.target-faces; horizontal-stretch: 1; wrap: word-wrap; color: Theme.text-muted; vertical-alignment: center; }
                        }
                    }
                    if !root.scatter-mode && root.selection != "": Text { text: root.selection; wrap: word-wrap; color: Theme.text-muted; }
                    if !root.scatter-mode: HorizontalLayout {
                        alignment: start;
                        Button { text: "Use last array settings"; enabled: root.last-settings-available; clicked => { root.use-last-settings(); } }
                    }
                    HorizontalLayout {
                        spacing: Theme.space;
                        Text { text: "Additional copies"; width: Theme.workspace-field-label-width; vertical-alignment: center; color: Theme.text; }
                        SpinBox { horizontal-stretch: 1; minimum: 1; maximum: 64; value <=> root.count; edited => { root.invalidate(); } }
                    }
                    if root.scatter-mode: VerticalLayout {
                        spacing: Theme.space-lg;
                        HorizontalLayout {
                            spacing: Theme.space;
                            Text { text: "Seed"; width: Theme.workspace-field-label-width; vertical-alignment: center; color: Theme.text; }
                            LineEdit { horizontal-stretch: 1; text <=> root.seed; edited => { root.invalidate(); } }
                        }
                        Text { text: "Keep the seed to repeat a layout. Copies can overlap."; wrap: word-wrap; color: Theme.text-muted; }
                        CheckBox { text: "Align to surface"; checked <=> root.align; toggled => { root.invalidate(); } }
                        Text { text: "The first source sets the local up direction."; wrap: word-wrap; color: Theme.text-muted; }
                        RangeRow { label: "Heading range · °"; minimum <=> root.heading-min; maximum <=> root.heading-max; edited => { root.invalidate(); } }
                        RangeRow { label: "Uniform scale range"; minimum <=> root.uniform-scale-min; maximum <=> root.uniform-scale-max; edited => { root.invalidate(); } }
                        HorizontalLayout {
                            spacing: Theme.space;
                            Text { text: "Normal offset · units"; width: Theme.workspace-field-label-width; vertical-alignment: center; color: Theme.text; }
                            LineEdit { horizontal-stretch: 1; text <=> root.normal-offset; input-type: decimal; edited => { root.invalidate(); } }
                        }
                        Text { text: "Scale varies per copy. Offset moves each pivot along the target normal."; wrap: word-wrap; color: Theme.text-muted; }
                    }
                    if !root.scatter-mode: VerticalLayout {
                        spacing: Theme.space-lg;
                        HorizontalLayout {
                            spacing: Theme.space;
                            Text { text: "Step space"; width: Theme.workspace-field-label-width; vertical-alignment: center; color: Theme.text; }
                            ComboBox { horizontal-stretch: 1; model: ["World", "Source local"]; current-index <=> root.space-index; selected => { root.invalidate(); } }
                        }
                        VectorRow { label: "Move step · units"; value-x <=> root.move-x; value-y <=> root.move-y; value-z <=> root.move-z; edited => { root.invalidate(); } }
                        VectorRow { label: "Rotate step · °"; value-x <=> root.rotate-x; value-y <=> root.rotate-y; value-z <=> root.rotate-z; edited => { root.invalidate(); } }
                        VectorRow { label: "Scale factor per copy"; value-x <=> root.scale-x; value-y <=> root.scale-y; value-z <=> root.scale-z; edited => { root.invalidate(); } }
                        Text { text: "1 keeps size. 1.1 adds 10% per copy. Models need equal XYZ factors."; wrap: word-wrap; color: Theme.text-muted; }
                        Text { text: "Copies start from the originals. Steps accumulate."; wrap: word-wrap; color: Theme.text-muted; }
                        if root.space-index == 1: Text { text: "Preview identifies the source for local axes."; wrap: word-wrap; color: Theme.text-muted; }
                    }
                    if root.scatter-mode: CheckBox { text: "Automatic placement anchor"; checked <=> root.automatic-anchor; toggled => { root.invalidate(); } }
                    if root.scatter-mode && root.automatic-anchor: Text { text: "Use a point source’s origin; otherwise use the assembly center."; wrap: word-wrap; color: Theme.text-muted; }
                    if !root.scatter-mode || !root.automatic-anchor: HorizontalLayout {
                        spacing: Theme.space;
                        Text { text: "Pivot source"; width: Theme.workspace-field-label-width; vertical-alignment: center; color: Theme.text; }
                        ComboBox { horizontal-stretch: 1; model: ["Selection center", "Current transform pivot", "Custom world point"]; current-index <=> root.pivot-source; selected => { root.invalidate(); } }
                    }
                    if (!root.scatter-mode || !root.automatic-anchor) && root.pivot-source == 2: VectorRow { label: "Custom world point"; value-x <=> root.pivot-x; value-y <=> root.pivot-y; value-z <=> root.pivot-z; edited => { root.invalidate(); } }
                    if root.scatter-mode: Text { text: "Models require uniform scale. Preview checks the supported range."; wrap: word-wrap; color: Theme.text-muted; }
                    CheckBox { text: "Keep textures attached"; checked <=> root.texture-lock; toggled => { root.invalidate(); } }
                    SectionHeader {
                        inset: false;
                        text: "Naming and references";
                        expanded <=> root.naming-expanded;
                        detail: root.naming-expanded ? "" : (root.name-style == 0 && root.name-prefix == "" && root.name-suffix == "_copy" && root.name-start == 1 && root.internal-links == 0 && root.external-links == 0 ? "Default names and links" : "Custom names and links");
                    }
                    if root.naming-expanded: VerticalLayout {
                        spacing: Theme.space-lg;
                        HorizontalLayout {
                            spacing: Theme.space;
                            Text { text: "Name format"; width: Theme.workspace-field-label-width; vertical-alignment: center; color: Theme.text; }
                            ComboBox { horizontal-stretch: 1; model: ["Source name + index", "Index before source name"]; current-index <=> root.name-style; selected => { root.invalidate(); } }
                        }
                        HorizontalLayout {
                            spacing: Theme.space;
                            Text { text: "Name prefix"; width: Theme.workspace-field-label-width; vertical-alignment: center; color: Theme.text; }
                            LineEdit { horizontal-stretch: 1; text <=> root.name-prefix; edited => { root.invalidate(); } }
                        }
                        HorizontalLayout {
                            spacing: Theme.space;
                            Text { text: "Name suffix"; width: Theme.workspace-field-label-width; vertical-alignment: center; color: Theme.text; }
                            LineEdit { horizontal-stretch: 1; text <=> root.name-suffix; edited => { root.invalidate(); } }
                        }
                        HorizontalLayout {
                            spacing: Theme.space;
                            Text { text: "Start index"; width: Theme.workspace-field-label-width; vertical-alignment: center; color: Theme.text; }
                            SpinBox { minimum: 1; maximum: 1000000; value <=> root.name-start; edited => { root.invalidate(); } }
                        }
                        Text { text: root.name-style == 0 ? "Name = prefix + source name + suffix + index." : "Name = prefix + index + _ + source name + suffix."; wrap: word-wrap; color: Theme.text-muted; }
                        Text { text: "Preview checks the names and shows collision suffixes."; wrap: word-wrap; color: Theme.text-muted; }
                        HorizontalLayout {
                            spacing: Theme.space;
                            Text { text: "Internal links"; width: Theme.workspace-field-label-width; vertical-alignment: center; color: Theme.text; }
                            ComboBox { horizontal-stretch: 1; model: ["Follow each copy", "Keep original targets"]; current-index <=> root.internal-links; selected => { root.invalidate(); } }
                        }
                        HorizontalLayout {
                            spacing: Theme.space;
                            Text { text: "External links"; width: Theme.workspace-field-label-width; vertical-alignment: center; color: Theme.text; }
                            ComboBox { horizontal-stretch: 1; model: ["Keep external links", "Reject external links"]; current-index <=> root.external-links; selected => { root.invalidate(); } }
                        }
                        Text { text: "Rotation or scaling can require you to resolve unsupported spatial metadata first."; wrap: word-wrap; color: Theme.text-muted; }
                    }
                    if root.summary != "": Text { text: root.summary; wrap: word-wrap; color: Theme.text; }
                }
            }
            Text { text: root.message; wrap: word-wrap; color: Theme.text-muted; min-height: Theme.row-height; }
            HorizontalLayout {
                spacing: Theme.space;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
                Rectangle { horizontal-stretch: 1; }
                Button { text: root.scatter-mode ? "Preview scatter" : "Preview array"; clicked => { root.preview(); } }
                Button { text: "Apply placement"; enabled: root.ready; clicked => { root.apply(); } }
            }
        }
    }
}
