import { Theme } from "theme.slint";
import {Button} from "widgets.slint";

export component NavigationDefaultsWindow inherits Window {
    background: Theme.panel;
    title: "Navigation defaults - HammeRR";
    preferred-width: 720px;
    preferred-height: 700px;
    min-width: 650px;
    min-height: 650px;
    in property <string> current;
    in property <string> saved;
    in property <string> defaults;
    in property <string> storage;
    in property <string> status;
    in property <string> message;
    in property <bool> ready;
    callback save();
    callback apply();
    callback reload();
    callback reset();
    callback close-dialog();
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => { if event.text == Key.Escape { root.close-dialog(); accept } else { reject } }
        VerticalLayout {
            padding: Theme.space-xl;
            spacing: 12px;
            Text { text: "Navigation defaults"; font-size: Theme.font-display; font-weight: 600; }
            Text { text: "Set Fly speed in the viewport, then explicitly save the speed you want at startup."; color: Theme.text-muted; wrap: word-wrap; }
            HorizontalLayout {
                Text { text: "Setting"; horizontal-stretch: 1; font-weight: 600; }
                Text { text: "Current session"; width: 145px; font-weight: 600; }
                Text { text: "Startup defaults"; width: 145px; font-weight: 600; }
            }
            HorizontalLayout {
                Text { text: "Fly speed"; horizontal-stretch: 1; }
                Text { text: root.current; width: 145px; }
                Text { text: root.saved; width: 145px; }
            }
            Text { text: root.defaults; wrap: word-wrap; color: Theme.text-muted; }
            Text { text: root.storage; wrap: word-wrap; color: Theme.text-muted; }
            Text { text: root.status; wrap: word-wrap; color: Theme.warning; }
            Text { text: "25–20000 Hammer units/s · factory 600 · Shift moves 4× faster. In perspective, hold the right mouse button and scroll to change the same speed. Speed edits and wheel changes stay temporary until Save current as defaults. Camera positions and navigation sensitivities are not stored."; wrap: word-wrap; color: Theme.text-muted; }
            Rectangle { vertical-stretch: 1; }
            Text { text: root.message; wrap: word-wrap; min-height: 34px; }
            HorizontalLayout {
                spacing: 10px;
                Button { text: "Reload defaults"; clicked => { root.reload(); } }
                Button { text: "Reset saved defaults"; clicked => { root.reset(); } }
                Rectangle { horizontal-stretch: 1; }
            }
            HorizontalLayout {
                spacing: 10px;
                Button { text: "Close"; clicked => { root.close-dialog(); } }
                Rectangle { horizontal-stretch: 1; }
                Button { text: "Apply saved defaults"; enabled: root.ready; clicked => { root.apply(); } }
                Button { text: "Save current as defaults"; enabled: root.ready; clicked => { root.save(); } }
            }
        }
    }
}
