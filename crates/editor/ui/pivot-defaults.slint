import { Theme } from "theme.slint";
import {Button} from "widgets.slint";

export component PivotDefaultsWindow inherits Window {
    background: Theme.panel;
    title: "Transform pivot defaults - HammeRR";
    preferred-width: 690px;
    preferred-height: 660px;
    min-width: 620px;
    min-height: 620px;
    in property <string> current;
    in property <string> defaults;
    in property <string> storage;
    in property <string> status;
    in property <string> message;
    in property <bool> ready;
    in property <bool> can-apply;
    in property <string> apply-status;
    callback save();
    callback apply();
    callback reload();
    callback reset();
    callback close-dialog();
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => { if event.text == Key.Escape { root.close-dialog(); accept } else { reject } }
        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text { text: "Transform pivot defaults"; font-size: 24px; font-weight: 600; }
            Text { text: "Save only the transform pivot you want at startup."; color: Theme.text-muted; wrap: word-wrap; }
            Text { text: root.current; wrap: word-wrap; font-size: 17px; }
            Text { text: root.defaults; wrap: word-wrap; font-size: 17px; }
            Text { text: root.storage; wrap: word-wrap; color: Theme.text-muted; }
            Text { text: root.status; wrap: word-wrap; color: Theme.warning; }
            Text { text: "Save keeps this pivot for new document windows. A custom pivot is a fixed world point and does not follow a surface. New/Open in this window keep the current pivot."; wrap: word-wrap; color: Theme.text-muted; }
            Text { text: root.apply-status; wrap: word-wrap; color: Theme.warning; }
            Rectangle { vertical-stretch: 1; }
            Text { text: root.message; wrap: word-wrap; min-height: 34px; }
            HorizontalLayout {
                spacing: 10px;
                Button { text: "Reload defaults"; clicked => { root.reload(); } }
                Button { text: "Reset saved defaults"; clicked => { root.reset(); } }
                Rectangle { horizontal-stretch: 1; }
            }
            HorizontalLayout {
                spacing: 10px;
                Button { text: "Close"; clicked => { root.close-dialog(); } }
                Rectangle { horizontal-stretch: 1; }
                Button { text: "Apply saved defaults"; enabled: root.can-apply; clicked => { root.apply(); } }
                Button { text: "Save current as defaults"; enabled: root.ready; clicked => { root.save(); } }
            }
        }
    }
}
