import { Theme } from "theme.slint";
import { Button, ComboBox, LineEdit, ScrollView } from "widgets.slint";

export component InstanceExtractionWindow inherits Window {
    title: "Extract selection to instance - HammeRR";
    preferred-width: 760px;
    preferred-height: 650px;
    background: Theme.hover;
    in-out property <string> file;
    in-out property <int> pivot-mode;
    in-out property <string> pivot-x: "0";
    in-out property <string> pivot-y: "0";
    in-out property <string> pivot-z: "0";
    in property <string> summary;
    in property <string> message;
    in property <bool> active;
    in property <bool> owned;
    in property <bool> ready;
    in property <bool> busy;
    callback prepare();
    callback extract();
    callback review();
    callback cancel();
    forward-focus: keys;
    keys := FocusScope {
      key-pressed(event) => { if event.text == Key.Escape { root.cancel(); accept } else { reject } }
    VerticalLayout {
        padding: Theme.space-xl;
        spacing: 14px;
        Text { text: "Extract selection to instance"; color: Theme.text; font-size: Theme.font-display; }
        Text { text: "New child VMF · explicit relative path under the saved parent"; color: Theme.text-muted; }
        LineEdit { text <=> root.file; enabled: !root.active; placeholder-text: "assemblies/platform.vmf"; }
        HorizontalLayout {
            spacing: 8px;
            Text { text: "Pivot"; color: Theme.text-muted; vertical-alignment: center; }
            ComboBox { model: ["World origin (0, 0, 0)", "Selection centre", "Custom"]; current-index <=> root.pivot-mode; enabled: !root.active; accessible-label: "Extraction pivot"; horizontal-stretch: 1; }
        }
        if root.pivot-mode == 2 || root.active: HorizontalLayout {
            spacing: 8px;
            for label[index] in ["X", "Y", "Z"]: VerticalLayout {
                spacing: 4px;
                Text { text: label; color: Theme.text-muted; }
                LineEdit {
                    enabled: !root.active && root.pivot-mode == 2;
                    input-type: decimal;
                    text: index == 0 ? root.pivot-x : index == 1 ? root.pivot-y : root.pivot-z;
                    edited(value) => {
                        if index == 0 { root.pivot-x = value; }
                        else if index == 1 { root.pivot-y = value; }
                        else { root.pivot-z = value; }
                    }
                }
            }
        }
        Text { text: "Custom uses finite X, Y and Z. Selection centre is computed when preparing. The child uses local coordinates; original placement and compiled texture mapping must stay unchanged. Cancel to change a prepared pivot."; color: Theme.text-muted; wrap: word-wrap; }
        ScrollView {
            content-width: self.width;
            vertical-stretch: 1;
            VerticalLayout { Text { text: root.summary; color: Theme.text-muted; wrap: word-wrap; } }
        }
        Text { text: root.message; color: Theme.warning; wrap: word-wrap; }
        Text { text: "Undo restores the parent objects. The exported child stays on disk; Redo changes only the parent. Refresh instance contents explicitly after extraction."; color: Theme.text-muted; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 10px;
            Button { text: "Prepare extraction"; enabled: !root.active; clicked => { root.prepare(); } }
            Button { text: "Review shared extraction"; enabled: root.active && !root.owned && !root.busy; clicked => { root.review(); } }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Button { text: "Extract"; enabled: root.ready && root.owned && !root.busy; clicked => { root.extract(); } }
            Button { text: "Cancel"; clicked => { root.cancel(); } }
        }
    }
    }
}
