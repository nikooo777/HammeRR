import { Theme } from "theme.slint";
import { Button, LineEdit, ListView, ScrollView, SpinBox } from "widgets.slint";

export struct OverlayTargetRow {
    entity: string,
    label: string,
    detail: string,
    eligible: bool,
}

export component OverlayWindow inherits Window {
    background: Theme.panel;
    title: "Overlay - HammeRR";
    preferred-width: 780px;
    preferred-height: 790px;
    in-out property <string> material;
    in-out property <string> targetname;
    in-out property <int> render-order;
    in-out property <string> u-start: "0";
    in-out property <string> u-end: "1";
    in-out property <string> v-start: "0";
    in-out property <string> v-end: "1";
    in-out property <string> fade-min: "-1";
    in-out property <string> fade-max: "0";
    in property <image> material-image;
    in property <string> material-detail;
    in property <string> source-label;
    in property <int> source-count: 1;
    in property <string> outline;
    in property <string> draft-label;
    in property <string> message;
    in property <bool> ready;
    in property <bool> can-preview;
    in property <bool> can-review;
    in property <bool> can-refit;
    in property <bool> reference-required;
    in property <[OverlayTargetRow]> refit-references;
    in property <string> refit-reference-label;
    callback choose-refit-reference(string);
    in property <bool> refit-mode;
    in property <bool> rebind-mode;
    in property <bool> can-rebind;
    in property <bool> can-edit-corners;
    in property <bool> can-preview-corners;
    in property <bool> can-handle-corners;
    in property <bool> corners-mode;
    in property <string> corner-frame;
    in-out property <string> corner-0-u;
    in-out property <string> corner-0-v;
    in-out property <string> corner-1-u;
    in-out property <string> corner-1-v;
    in-out property <string> corner-2-u;
    in-out property <string> corner-2-v;
    in-out property <string> corner-3-u;
    in-out property <string> corner-3-v;

    in property <[OverlayTargetRow]> overlay-targets;
    in-out property <string> overlay-search;
    in property <string> overlay-page;
    in property <string> rebind-target;
    in property <bool> overlay-previous;
    in property <bool> overlay-next;
    callback search-overlays();
    callback overlay-page-change(int);
    callback choose-overlay(string);
    callback rebind();
    callback edit-corners();
    callback preview-corners();
    callback handle-corners();
    callback corners-edited();
    callback edited();
    callback browse-material();
    callback fit();
    callback preview();
    callback review();
    callback refit();
    callback apply();
    callback cancel();
    forward-focus: keys;
    keys := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => { if event.text == Key.Escape { root.cancel(); accept } else { reject } }
        VerticalLayout {
            padding: Theme.space-xl;
            spacing: 10px;
            Text { text: root.corners-mode ? "Edit overlay corners" : root.rebind-mode ? "Rebind existing overlay" : root.refit-mode ? "Refit existing overlay" : "Fit an overlay to faces"; font-size: Theme.font-display; font-weight: 600; }
            Text { text: root.source-label; wrap: word-wrap; color: Theme.text-muted; }
            if root.source-count > 1: Text { text: "One projection spans the bound faces. Native rendering clips it to each face and leaves gaps clear. Corner editing keeps the stored axes and every binding. Rebind uses the selected destination set and its first eligible quad; multi-face refit requires an explicit reference quad."; wrap: word-wrap; color: Theme.text-muted; }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 10px;
                    if root.reference-required: VerticalLayout {
                        spacing: 6px;
                        Text { text: "Reference face"; font-weight: 600; }
                        Text { text: root.refit-reference-label; wrap: word-wrap; }
                        Text { text: "Its current edges set the projection axes. Refit, then review the new outline."; wrap: word-wrap; color: Theme.text-muted; }
                        ListView {
                            height: min(root.refit-references.length * 36px, 144px);
                            for entry in root.refit-references: Button {
                                text: entry.label;
                                enabled: entry.eligible;
                                clicked => { root.choose-refit-reference(entry.entity); }
                            }
                        }
                    }
                    if !root.corners-mode: VerticalLayout {
                        spacing: 10px;
                        Text { text: "Existing overlay · rebind to the selected destination faces"; font-weight: 600; wrap: word-wrap; }
                        LineEdit { text <=> root.overlay-search; placeholder-text: "Search overlay names or materials"; accessible-label: "Search existing overlays"; edited => { root.search-overlays(); } }
                        ListView {
                            height: root.overlay-targets.length > 0 ? 140px : 0px;
                            for entry in root.overlay-targets: VerticalLayout {
                                spacing: 3px; padding-bottom: 6px;
                                Button { text: entry.label; enabled: entry.eligible; clicked => { root.choose-overlay(entry.entity); } }
                                Text { text: entry.detail; wrap: word-wrap; color: Theme.text-muted; font-size: Theme.font; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Previous overlays"; enabled: root.overlay-previous; clicked => { root.overlay-page-change(-1); } }
                            Text { text: root.overlay-page; vertical-alignment: center; horizontal-stretch: 1; }
                            Button { text: "Next overlays"; enabled: root.overlay-next; clicked => { root.overlay-page-change(1); } }
                        }
                        Text { text: root.rebind-target; wrap: word-wrap; color: Theme.text-muted; }
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        VerticalLayout {
                            spacing: 5px;
                            Text { text: root.corners-mode || root.source-count > 1 ? "Projection outline" : "Source face outline"; font-weight: 600; }
                            Rectangle {
                                min-width: 320px; min-height: 180px; background: Theme.hover; border-color: Theme.border-strong; border-width: 1px; border-radius: 4px;
                                if root.outline != "": Path {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    width: 320px; height: 180px;
                                    viewbox-width: 320; viewbox-height: 180;
                                    commands: root.outline;
                                    stroke: Theme.info; stroke-width: 2px; fill: Theme.info-soft;
                                }
                                if root.outline == "": Text {
                                    text: "Fit / Preview to check the four corners";
                                    horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; color: Theme.text-muted;
                                }
                            }
                            Text { text: "Face plane · original proportions"; font-size: Theme.font; color: Theme.text-muted; }
                        }
                        VerticalLayout {
                            width: 220px; spacing: 5px;
                            Text { text: "Material thumbnail"; font-weight: 600; }
                            Rectangle {
                                height: 180px; background: Theme.hover; border-color: Theme.border-strong; border-width: 1px; border-radius: 4px;
                                Image { width: parent.width; height: parent.height; source: root.material-image; image-fit: contain; }
                            }
                            Text { text: root.material-detail; wrap: word-wrap; font-size: Theme.font; color: Theme.text-muted; }
                        }
                    }
                    if root.corners-mode: VerticalLayout {
                        spacing: 8px;
                        Text { text: "Projection corners · local world units"; font-weight: 600; }
                        Text { text: "U and V follow the existing projection axes. Keep corners 0–3 in perimeter order. Texture ranges below are separate."; wrap: word-wrap; color: Theme.text-muted; }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Corner 0"; width: 76px; vertical-alignment: center; }
                            Text { text: "U"; vertical-alignment: center; }
                            LineEdit { text <=> root.corner-0-u; input-type: decimal; accessible-label: "Overlay corner 0 U"; edited => { root.corners-edited(); } }
                            Text { text: "V"; vertical-alignment: center; }
                            LineEdit { text <=> root.corner-0-v; input-type: decimal; accessible-label: "Overlay corner 0 V"; edited => { root.corners-edited(); } }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Corner 1"; width: 76px; vertical-alignment: center; }
                            Text { text: "U"; vertical-alignment: center; }
                            LineEdit { text <=> root.corner-1-u; input-type: decimal; accessible-label: "Overlay corner 1 U"; edited => { root.corners-edited(); } }
                            Text { text: "V"; vertical-alignment: center; }
                            LineEdit { text <=> root.corner-1-v; input-type: decimal; accessible-label: "Overlay corner 1 V"; edited => { root.corners-edited(); } }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Corner 2"; width: 76px; vertical-alignment: center; }
                            Text { text: "U"; vertical-alignment: center; }
                            LineEdit { text <=> root.corner-2-u; input-type: decimal; accessible-label: "Overlay corner 2 U"; edited => { root.corners-edited(); } }
                            Text { text: "V"; vertical-alignment: center; }
                            LineEdit { text <=> root.corner-2-v; input-type: decimal; accessible-label: "Overlay corner 2 V"; edited => { root.corners-edited(); } }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Corner 3"; width: 76px; vertical-alignment: center; }
                            Text { text: "U"; vertical-alignment: center; }
                            LineEdit { text <=> root.corner-3-u; input-type: decimal; accessible-label: "Overlay corner 3 U"; edited => { root.corners-edited(); } }
                            Text { text: "V"; vertical-alignment: center; }
                            LineEdit { text <=> root.corner-3-v; input-type: decimal; accessible-label: "Overlay corner 3 V"; edited => { root.corners-edited(); } }
                        }
                        Text { text: root.corner-frame; wrap: word-wrap; color: Theme.text-muted; font-size: Theme.font; }
                        Button { text: "Preview corners"; enabled: root.can-preview-corners; clicked => { root.preview-corners(); } }
                        Button { text: "Viewport handles"; enabled: root.can-handle-corners; clicked => { root.handle-corners(); } }
                        Text { text: "Preview corners, then drag a cyan corner in the viewport. Release to review with Apply corners. Escape or Cancel handles restores the draft from before the drag. Motion is unsnapped in the fixed projection plane."; wrap: word-wrap; color: Theme.text-muted; }
                    }
                    Text { text: "Material"; font-weight: 600; }
                    HorizontalLayout {
                        spacing: 10px;
                        LineEdit { enabled: !root.refit-mode; text <=> root.material; horizontal-stretch: 1; accessible-label: "Overlay material"; edited => { root.edited(); } }
                        Button { text: "Browse materials…"; enabled: !root.refit-mode; clicked => { root.browse-material(); } }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Name"; width: 72px; vertical-alignment: center; }
                        LineEdit { enabled: !root.refit-mode; text <=> root.targetname; placeholder-text: "Optional runtime name"; accessible-label: "Overlay name"; horizontal-stretch: 1; edited => { root.edited(); } }
                        Text { text: "Render order"; vertical-alignment: center; }
                        SpinBox { enabled: !root.refit-mode; minimum: 0; maximum: 3; value <=> root.render-order; accessible-label: "Overlay render order"; edited => { root.edited(); } }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Texture"; width: 72px; vertical-alignment: center; }
                        Text { text: "U start"; vertical-alignment: center; }
                        LineEdit { enabled: !root.refit-mode; text <=> root.u-start; width: 80px; input-type: decimal; accessible-label: "Overlay U start"; edited => { root.edited(); } }
                        Text { text: "U end"; vertical-alignment: center; }
                        LineEdit { enabled: !root.refit-mode; text <=> root.u-end; width: 80px; input-type: decimal; accessible-label: "Overlay U end"; edited => { root.edited(); } }
                        Text { text: "V start"; vertical-alignment: center; }
                        LineEdit { enabled: !root.refit-mode; text <=> root.v-start; width: 80px; input-type: decimal; accessible-label: "Overlay V start"; edited => { root.edited(); } }
                        Text { text: "V end"; vertical-alignment: center; }
                        LineEdit { enabled: !root.refit-mode; text <=> root.v-end; width: 80px; input-type: decimal; accessible-label: "Overlay V end"; edited => { root.edited(); } }
                    }
                    Text { text: root.refit-mode ? "Existing-overlay edits preserve the material, name, texture ranges, render order and fades." : "Fit resets U and V to 0–1. Reverse a range to mirror. Higher render orders draw later."; wrap: word-wrap; color: Theme.text-muted; font-size: Theme.font; }
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Fade"; width: 72px; vertical-alignment: center; }
                        Text { text: "Start distance"; vertical-alignment: center; }
                        LineEdit { enabled: !root.refit-mode; text <=> root.fade-min; input-type: decimal; accessible-label: "Overlay fade start distance"; edited => { root.edited(); } }
                        Text { text: "End distance"; vertical-alignment: center; }
                        LineEdit { enabled: !root.refit-mode; text <=> root.fade-max; input-type: decimal; accessible-label: "Overlay fade end distance"; edited => { root.edited(); } }
                    }
                    Text { text: "World units · end 0 disables fading; start -1 lets the game choose the start."; wrap: word-wrap; color: Theme.text-muted; font-size: Theme.font; }
                    Text { text: root.draft-label; wrap: word-wrap; font-weight: 600; }
                    Text { text: "Cyan lines mark the projection corners. The viewport does not preview the projected material. Compile and run the map to see the overlay."; wrap: word-wrap; color: Theme.text-muted; }
                }
            }
            Text { text: root.message; wrap: word-wrap; color: Theme.warning; }
            HorizontalLayout {
                spacing: 8px;
                Button { text: "Review current draft"; enabled: root.can-review; clicked => { root.review(); } }
                Rectangle { horizontal-stretch: 1; }
                Button { text: "Fit / Preview"; enabled: root.can-preview; clicked => { root.fit(); } }
                Button { text: "Preview settings"; enabled: root.can-preview; clicked => { root.preview(); } }
            }
            HorizontalLayout {
                spacing: 10px;
                Button { text: "Edit selected corners"; enabled: root.can-edit-corners; clicked => { root.edit-corners(); } }
                Button { text: "Refit selected overlay"; enabled: root.can-refit; clicked => { root.refit(); } }
                Button { text: "Preview rebind"; enabled: root.can-rebind; clicked => { root.rebind(); } }
                Rectangle { horizontal-stretch: 1; }
                Button { text: "Cancel"; clicked => { root.cancel(); } }
                Button { text: root.corners-mode ? "Apply corners" : root.rebind-mode ? "Apply rebind" : root.refit-mode ? "Apply refit" : "Apply overlay"; enabled: root.ready; clicked => { root.apply(); } }
            }
        }
    }
}
