        { id: "run-map", title: "Run map", group: "Build", enabled: !root.compiling && !root.launching && !root.game-running },
        { id: "stop-map", title: "Stop map", group: "Build", enabled: root.game-running },
        { id: "cancel-build", title: "Cancel build", group: "Build", enabled: root.compiling && root.compile-cancellable },
        { id: "build-settings", title: "Build settings…", group: "Build", enabled: true },
        { id: "compile-region", title: root.compile-region-label, group: "Build", enabled: true },
        { id: "game-log", title: "Game log…", group: "Build", enabled: true },
