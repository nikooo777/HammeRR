import {Button, ComboBox, LineEdit, ListView} from "std-widgets.slint";

export struct SelectionDefaultRow {
    label: string,
    current: string,
    defaults: string,
}

export struct SelectionProfileRow { id: string, name: string, filters: string }

export component SelectionDefaultsWindow inherits Window {
    title: "Selection defaults - HammeRR";
    preferred-width: 720px;
    preferred-height: 720px;
    min-width: 650px;
    min-height: 680px;
    in property <[SelectionDefaultRow]> rows;
    in property <[SelectionProfileRow]> profiles;
    in-out property <int> section;
    in-out property <string> selected-profile;
    in-out property <string> profile-name;
    callback choose-profile(string);
    callback save-profile();
    callback replace-profile();
    callback apply-profile();
    callback rename-profile();
    callback delete-profile();
    in property <string> defaults;
    in property <string> storage;
    in property <string> status;
    in property <string> message;
    in property <bool> ready;
    callback save();
    callback apply();
    callback reload();
    callback reset();
    callback close-dialog();
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => { if event.text == Key.Escape { root.close-dialog(); accept } else { reject } }
        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text { text: "Selection defaults"; font-size: 24px; font-weight: 600; }
            ComboBox { model: ["Startup defaults", "Named profiles"]; current-index <=> root.section; accessible-label: "Selection settings section"; }
            if root.section == 0: VerticalLayout {
                spacing: 10px;
                Text { text: "Choose Pick object types, then save the filters to use for future documents."; color: #b6c1cf; wrap: word-wrap; }
                HorizontalLayout {
                    Text { text: "Setting"; horizontal-stretch: 1; font-weight: 600; }
                    Text { text: "Current session"; width: 125px; font-weight: 600; }
                    Text { text: "Startup defaults"; width: 125px; font-weight: 600; }
                }
                for row in root.rows: Rectangle {
                    height: 28px;
                    HorizontalLayout {
                        Text { text: row.label; horizontal-stretch: 1; vertical-alignment: center; }
                        Text { text: row.current; width: 125px; vertical-alignment: center; }
                        Text { text: row.defaults; width: 125px; vertical-alignment: center; }
                    }
                }
                Text { text: root.defaults; wrap: word-wrap; color: #b6c1cf; }
            }
            if root.section == 1: VerticalLayout {
                spacing: 10px;
                Text { text: "Save current filters under a name, then explicitly apply a profile when needed. Startup defaults stay separate."; color: #b6c1cf; wrap: word-wrap; }
                ListView {
                    height: 96px;
                    for profile in root.profiles: Rectangle {
                        height: 48px;
                        background: root.selected-profile == profile.id ? #2d4056 : #1a2430;
                        HorizontalLayout {
                            spacing: 10px; padding: 4px;
                            Button { text: profile.name; width: 190px; enabled: root.ready; clicked => { root.choose-profile(profile.id); } }
                            Text { text: profile.filters; horizontal-stretch: 1; wrap: word-wrap; vertical-alignment: center; }
                        }
                    }
                }
                LineEdit { text <=> root.profile-name; accessible-label: "Profile name"; placeholder-text: "Profile name"; }
                HorizontalLayout {
                    Button { text: "Save current as profile"; enabled: root.ready; clicked => { root.save-profile(); } }
                    Button { text: "Apply selected profile"; enabled: root.ready && root.selected-profile != ""; clicked => { root.apply-profile(); } }
                }
                HorizontalLayout {
                    Button { text: "Replace selected profile"; enabled: root.ready && root.selected-profile != ""; clicked => { root.replace-profile(); } }
                    Button { text: "Rename profile"; enabled: root.ready && root.selected-profile != ""; clicked => { root.rename-profile(); } }
                    Button { text: "Delete profile"; enabled: root.ready && root.selected-profile != ""; clicked => { root.delete-profile(); } }
                }
            }
            Text { text: root.storage; wrap: word-wrap; color: #b6c1cf; }
            Text { text: root.status; wrap: word-wrap; color: #e3c597; }
            if root.section == 0: Text { text: "New/Open retain current filters. Reset keeps the last valid profiles, or an empty list if none were loaded."; wrap: word-wrap; color: #b6c1cf; }
            Rectangle { vertical-stretch: 1; }
            Text { text: root.message; wrap: word-wrap; min-height: 34px; }
            if root.section == 0: HorizontalLayout {
                spacing: 10px;
                Button { text: "Reload defaults"; clicked => { root.reload(); } }
                Button { text: "Reset saved defaults"; clicked => { root.reset(); } }
                Rectangle { horizontal-stretch: 1; }
            }
            HorizontalLayout {
                spacing: 10px;
                Button { text: "Close"; clicked => { root.close-dialog(); } }
                if root.section == 1: Button { text: "Reload defaults"; clicked => { root.reload(); } }
                Rectangle { horizontal-stretch: 1; }
                if root.section == 0: Button { text: "Apply saved defaults"; enabled: root.ready; clicked => { root.apply(); } }
                if root.section == 0: Button { text: "Save current as defaults"; enabled: root.ready; clicked => { root.save(); } }
            }
        }
    }
}
