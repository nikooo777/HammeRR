import { Theme } from "theme.slint";
import { Button, TextEdit } from "widgets.slint";

export struct SkyAssetFaceRow {
    label: string,
    ldr-status: string,
    hdr-status: string,
    detail: string,
}

export component SkyAssetsWindow inherits Window {
    background: Theme.panel;
    title: "Sky assets - HammeRR";
    preferred-width: 980px;
    preferred-height: 860px;
    min-width: 840px;
    min-height: 720px;
    in property <string> family;
    in property <string> summary;
    in property <string> issues;
    in property <[SkyAssetFaceRow]> faces;
    in-out property <int> selected-face;
    out property <string> report: root.faces.length > 0 ? root.faces[root.selected-face].detail : "No sky faces inspected. Set a valid mounted family in World settings and apply it, then refresh.";
    in property <string> read-summary;
    in property <string> scope;
    callback refresh-assets();
    callback close-dialog();
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.close-dialog(); return accept; }
            return reject;
        }
    }
    VerticalLayout {
        padding: 18px;
        spacing: 10px;
        Text { text: "Sky assets"; font-size: 24px; font-weight: 600; }
        Text { text: root.family; wrap: word-wrap; }
        Text { text: root.summary; wrap: word-wrap; font-weight: 600; }
        if root.issues != "": TextEdit {
            text: root.issues;
            read-only: true;
            wrap: word-wrap;
            height: 70px;
            accessible-label: "Sky family issues";
        }
        HorizontalLayout {
            spacing: 16px;
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 6px;
                width: 310px;
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: "Face"; width: 110px; font-weight: 600; }
                    Text { text: "LDR assets"; width: 90px; font-weight: 600; }
                    Text { text: "HDR assets"; width: 90px; font-weight: 600; }
                }
                for face[index] in root.faces: HorizontalLayout {
                    spacing: 6px;
                    Button {
                        text: face.label;
                        width: 110px;
                        accessible-label: face.label;
                        primary: root.selected-face == index;
                        clicked => { root.selected-face = index; }
                    }
                    Text { text: face.ldr-status; width: 90px; color: face.ldr-status == "ready" ? Theme.success : Theme.warning; }
                    Text { text: face.hdr-status; width: 90px; color: face.hdr-status == "ready" ? Theme.success : Theme.warning; }
                }
                Rectangle { vertical-stretch: 1; }
            }
            VerticalLayout {
                spacing: 6px;
                Text { text: root.faces.length > 0 ? root.faces[root.selected-face].label : "Face details"; font-weight: 600; }
                TextEdit {
                    text: root.report;
                    read-only: true;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                    accessible-label: "Sky material and texture inspection";
                }
            }
        }
        Text { text: root.read-summary; wrap: word-wrap; color: Theme.text-muted; font-size: 12px; }
        Text { text: root.scope; wrap: word-wrap; color: Theme.text-muted; font-size: 12px; }
        Text {
            text: "Inspects the applied world skyname. Apply properties before inspecting pending sky changes. Viewport Sky channel selects LDR or a stricter HDR editor preview. Structural readiness does not validate HDR pixel radiance. This inspection does not pack custom sky assets.";
            wrap: word-wrap;
            color: Theme.text-muted;
            font-size: 12px;
        }
        HorizontalLayout {
            spacing: 8px;
            Button { text: "Refresh sky assets"; clicked => { root.refresh-assets(); } }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Close"; clicked => { root.close-dialog(); } }
        }
    }
}
