import { Theme } from "theme.slint";
import { Button, ScrollView } from "widgets.slint";

export component InstanceContentsWindow inherits Window {
    title: "Instance contents - HammeRR";
    preferred-width: 850px;
    preferred-height: 690px;
    background: Theme.hover;
    in property <string> summary;
    in property <string> source;
    in property <string> owners;
    in property <string> diagnostics;
    in property <string> page-summary;
    in property <string> message;
    in property <float> aspect: 1;
    in property <bool> loading;
    in property <bool> cancellable;
    in property <bool> can-clear;
    in property <bool> can-frame;
    in property <bool> has-previous;
    in property <bool> has-next;
    callback refresh-contents();
    callback cancel-refresh();
    callback clear-contents();
    callback frame-contents();
    callback previous();
    callback next();
    callback close-dialog();
    forward-focus: keys;
    keys := FocusScope {
      key-pressed(event) => { if event.text == Key.Escape { root.close-dialog(); accept } else { reject } }
    VerticalLayout {
        padding: Theme.space-xl;
        spacing: 12px;
        Text { text: "Instance contents"; font-size: Theme.font-display; font-weight: 600; color: Theme.text; }
        Text { text: root.summary; color: Theme.text-muted; wrap: word-wrap; }
        Text { text: root.source; color: Theme.text-faint; wrap: word-wrap; font-size: Theme.font; }
        HorizontalLayout {
            spacing: 8px;
            Button { text: "Refresh instance contents"; enabled: !root.loading; clicked => { root.refresh-contents(); } }
            Button { text: "Cancel refresh"; enabled: root.cancellable; clicked => { root.cancel-refresh(); } }
            Button { text: "Clear"; enabled: root.can-clear; clicked => { root.clear-contents(); } }
            Button { text: "Frame instance contents"; enabled: root.can-frame; clicked => { root.frame-contents(); } }
        }
        ScrollView {
            content-width: self.width;
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 12px;
                Text { text: root.owners; color: Theme.text-muted; wrap: word-wrap; }
                Text { text: root.diagnostics; color: Theme.warning; wrap: word-wrap; }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Button { text: "Previous"; enabled: root.has-previous; clicked => { root.previous(); } }
            Text { text: root.page-summary; color: Theme.text-faint; vertical-alignment: center; horizontal-stretch: 1; }
            Button { text: "Next"; enabled: root.has-next; clicked => { root.next(); } }
        }
        Text { text: "Four helper levels · root-relative VMF paths · root owner selection\nNo child edits, material preview or surface placement. Refresh after source changes."; color: Theme.text-faint; font-size: Theme.font; wrap: word-wrap; }
        if root.message != "": Text { text: root.message; color: Theme.warning; wrap: word-wrap; }
        Button { text: "Close"; clicked => { root.close-dialog(); } }
    }
    }
}
