import { Button, CheckBox, ComboBox, ListView } from "std-widgets.slint";

export struct CarveRow { solid: string, label: string, selected: bool, cutter: bool }

export component CarveWindow inherits Window {
    title: "Carve brushes - HammeRR";
    preferred-width: 800px; preferred-height: 650px;
    in property <[CarveRow]> targets;
    in property <[string]> cutters;
    in property <string> source;
    in property <string> stamp;
    in property <string> token;
    in property <string> summary;
    in property <string> message;
    in property <bool> ready;
    in property <bool> can-preview;
    in-out property <int> cutter: 0;
    in-out property <bool> multiple-cutters;
    callback toggle-multiple();
    callback choose-cut-role(string);
    callback choose-cutter();
    callback choose-target(string);
    callback preview-edit();
    callback discard();
    callback apply();
    callback cancel();
    forward-focus: keys;
    keys := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => { if event.text == Key.Escape { root.cancel(); accept } else { reject } }
        VerticalLayout {
            padding: 24px; spacing: 12px;
            Text { text: "Subtract brush shapes"; font-size: 24px; font-weight: 600; }
            Text { text: "Choose the shapes to subtract and the target brushes to carve. Only their combined overlapping volume is removed. Cutters stay unchanged."; wrap: word-wrap; color: #aeb9c8; }
            CheckBox { text: "Use multiple cutter brushes"; checked <=> root.multiple-cutters; toggled => {root.toggle-multiple();} }
            if !root.multiple-cutters: Text { text: "Cutter · shape to subtract"; font-weight: 600; }
            if !root.multiple-cutters: ComboBox { model: root.cutters; current-index <=> root.cutter; enabled: root.cutters.length > 1; selected => { root.choose-cutter(); } }
            Text { text: root.multiple-cutters ? "Brush roles · cutters are retained" : "Target brushes"; font-size: 18px; font-weight: 600; }
            ListView {
                vertical-stretch: 1; min-height: 160px;
                for target in root.targets: VerticalLayout {
                    min-height: 44px; padding-top: 6px; padding-bottom: 6px; spacing: 4px;
                    if root.multiple-cutters: HorizontalLayout {
                        spacing: 12px;
                        Text {text: target.label; wrap: word-wrap; horizontal-stretch: 1;}
                        CheckBox {text: "Cutter"; checked:target.cutter; toggled => {root.choose-cut-role(target.solid);} }
                        CheckBox {text: "Target"; checked:target.selected; enabled:!target.cutter; toggled => {root.choose-target(target.solid);} }
                    }
                    if !root.multiple-cutters: CheckBox {
                        text: target.label + (target.cutter ? " · Cutter" : "");
                        checked: target.selected;
                        enabled: !target.cutter;
                        toggled => { root.choose-target(target.solid); }
                    }
                }
            }
            Text { text: root.summary; font-size: 17px; font-weight: 600; wrap: word-wrap; }
            Text { text: "New cut faces inherit their cutter's material, texture projection and lighting. Original faces keep their settings. Whole world brushes may disappear; removing every brush from an entity is rejected."; wrap: word-wrap; color: #aeb9c8; }
            Text { text: "1–8 convex cutters · up to 16 targets · 256 fragments at every stage. Displacement brushes are unsupported."; wrap: word-wrap; font-size: 12px; color: #aeb9c8; }
            if root.message != "": Text { text: root.message; wrap: word-wrap; color: #ffc66d; }
            HorizontalLayout {
                spacing: 10px;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
                Button { text: "Discard preview"; enabled: root.token != ""; clicked => { root.discard(); } }
                Rectangle { horizontal-stretch: 1; }
                Button { text: "Preview carve"; enabled: root.can-preview; clicked => { root.preview-edit(); } }
                Button { text: "Apply carve"; enabled: root.ready; clicked => { root.apply(); } }
            }
        }
    }
}
