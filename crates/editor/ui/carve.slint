import { Theme } from "theme.slint";
import { Button, CheckBox, ComboBox, LineEdit, ListView } from "widgets.slint";

export struct CarveRow { solid: string, label: string, selected: bool, cutter: bool }

export component CarveWindow inherits Window {
    background: Theme.panel;
    title: "Carve brushes - HammeRR";
    preferred-width: 800px; preferred-height: 790px;
    in property <[CarveRow]> targets;
    in property <[string]> cutters;
    in property <string> source;
    in property <string> stamp;
    in property <string> token;
    in property <string> summary;
    in property <string> message;
    in property <bool> ready;
    in property <bool> can-preview;
    in-out property <int> cutter: 0;
    in-out property <bool> multiple-cutters;
    in-out property <int> cut-material-policy: 0;
    in-out property <string> cut-material;
    callback toggle-multiple();
    callback choose-cut-role(string);
    callback choose-cutter();
    callback choose-target(string);
    callback cut-material-changed();
    callback choose-material();
    callback preview-edit();
    callback discard();
    callback apply();
    callback cancel();
    forward-focus: keys;
    keys := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => { if event.text == Key.Escape { root.cancel(); accept } else { reject } }
        VerticalLayout {
            padding: Theme.space-xl; spacing: 12px;
            Text { text: "Subtract brush shapes"; font-size: Theme.font-display; font-weight: 600; }
            Text { text: "Choose the shapes to subtract and the target brushes to carve. Only their combined overlapping volume is removed. Cutters stay unchanged."; wrap: word-wrap; color: Theme.text-muted; }
            CheckBox { text: "Use multiple cutter brushes"; checked <=> root.multiple-cutters; toggled => {root.toggle-multiple();} }
            if !root.multiple-cutters: Text { text: "Cutter · shape to subtract"; font-weight: 600; }
            if !root.multiple-cutters: ComboBox { model: root.cutters; current-index <=> root.cutter; enabled: root.cutters.length > 1; selected => { root.choose-cutter(); } }
            Text { text: root.multiple-cutters ? "Brush roles · cutters are retained" : "Target brushes"; font-size: Theme.font-heading; font-weight: 600; }
            ListView {
                vertical-stretch: 1; min-height: 160px;
                for target in root.targets: VerticalLayout {
                    min-height: 44px; padding-top: 6px; padding-bottom: 6px; spacing: 4px;
                    if root.multiple-cutters: HorizontalLayout {
                        spacing: 12px;
                        Text {text: target.label; wrap: word-wrap; horizontal-stretch: 1;}
                        CheckBox {text: "Cutter"; checked:target.cutter; toggled => {root.choose-cut-role(target.solid);} }
                        CheckBox {text: "Target"; checked:target.selected; enabled:!target.cutter; toggled => {root.choose-target(target.solid);} }
                    }
                    if !root.multiple-cutters: CheckBox {
                        text: target.label + (target.cutter ? " · Cutter" : "");
                        checked: target.selected;
                        enabled: !target.cutter;
                        toggled => { root.choose-target(target.solid); }
                    }
                }
            }
            Text { text: "New cut faces"; font-size: Theme.font-heading; font-weight: 600; }
            ComboBox {
                model: ["Use cutter surface settings", "Use corresponding target surface settings", "Use named material with cutter mapping"];
                current-index <=> root.cut-material-policy;
                selected => { root.cut-material-changed(); }
            }
            if root.cut-material-policy == 2: HorizontalLayout {
                spacing: 10px;
                LineEdit { text <=> root.cut-material; placeholder-text: "Material name"; edited => { root.cut-material-changed(); } }
                Button { text: "Browse materials…"; clicked => { root.choose-material(); } }
            }
            Text {
                text: root.cut-material-policy == 1
                    ? "Each new face copies the original target face with the same outward direction, including world texture projection, lighting and metadata. A missing or ambiguous parallel face rejects the preview; choose a named material for other cuts."
                    : root.cut-material-policy == 2
                    ? "Only the new cut-face material changes. Cutter texture projection, lighting and metadata are retained. Original target faces keep their settings."
                    : "New faces copy their cutter's material, world texture projection, lighting and metadata. Nodraw cutters produce nodraw cut faces. Original target faces keep their settings.";
                wrap: word-wrap; color: Theme.text-muted;
            }
            Text { text: root.summary; font-size: Theme.font-heading; font-weight: 600; wrap: word-wrap; }
            Text { text: "Whole world brushes may disappear; removing every brush from an entity is rejected."; wrap: word-wrap; color: Theme.text-muted; }
            Text { text: "1–8 convex cutters · up to 16 targets · 256 fragments at every stage. Displacement brushes are unsupported."; wrap: word-wrap; font-size: Theme.font; color: Theme.text-muted; }
            if root.message != "": Text { text: root.message; wrap: word-wrap; color: Theme.warning; }
            HorizontalLayout {
                spacing: 10px;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
                Button { text: "Discard preview"; enabled: root.token != ""; clicked => { root.discard(); } }
                Rectangle { horizontal-stretch: 1; }
                Button { text: "Preview carve"; enabled: root.can-preview; clicked => { root.preview-edit(); } }
                Button { text: "Apply carve"; enabled: root.ready; clicked => { root.apply(); } }
            }
        }
    }
}
