import { Button, CheckBox, ComboBox, LineEdit, ListView, ScrollView, Slider, SpinBox, TextEdit } from "std-widgets.slint";

export component CompileWindow inherits Window {
    title: "Build status - HammeRR";
    width: 720px;
    height: 920px;
    in property <[string]> recipe-names;
    in-out property <string> selected-recipe <=> recipe-selector.current-value;
    in-out property <string> recipe-name;
    in property <string> recipe-status;
    in property <string> recipe-description;
    in property <bool> custom-recipes-enabled;
    in property <bool> custom-recipe-selected;
    callback choose-recipe(int);
    callback apply-recipe();
    callback save-recipe();
    callback replace-recipe();
    callback rename-recipe();
    callback delete-recipe();
    callback cancel-recipe-edit();
    callback reload-recipes();
    in property <bool> recipes-reload-enabled;
    in property <int> lighting-choice;
    in property <bool> lighting-enabled;
    in property <string> lighting-description;
    in property <bool> bake-static-prop-vertices;
    in property <bool> prop-vertex-lighting-enabled;
    in property <string> prop-vertex-lighting-description;
    callback change-bake-static-prop-vertices(bool);
    in property <bool> brush-texture-shadows;
    in property <bool> brush-texture-shadows-enabled;
    in property <string> brush-texture-shadows-description;
    callback change-brush-texture-shadows(bool);
    in property <bool> pack-sky-assets;
    callback change-pack-sky-assets(bool);
    in property <bool> pack-water-assets;
    in property <string> water-packing-description;
    callback change-pack-water-assets(bool);
    in property <bool> pack-static-prop-assets;
    in property <string> static-prop-packing-description;
    callback change-pack-static-prop-assets(bool);
    in property <bool> generate-reflections;
    in property <string> reflection-description;
    callback change-reflections(bool);
    in property <string> capture-summary;
    in property <string> capture-details;
    in property <bool> capture-editable;
    in property <bool> capture-editing;
    in property <bool> capture-current;
    in-out property <string> capture-engine-root;
    in-out property <string> capture-steam-root;
    callback begin-capture-edit();
    callback choose-capture-root(int);
    callback apply-capture-runtime();
    callback cancel-capture-edit();
    in property <[string]> lighting-modes;
    in-out property <string> selected-lighting <=> lighting-selector.current-value;
    in-out property <string> selected-physics <=> physics-selector.current-value;
    in property <[string]> physics-modes;
    in property <string> physics-description;
    in property <int> smoothing-angle;
    callback change-smoothing-angle(int);
    in property <[string]> bounce-modes;
    in-out property <string> selected-bounces <=> bounce-selector.current-value;
    callback change-bounces(int);
    in-out property <string> lighting-work-limit-millions;
    in-out property <bool> lighting-work-limit-editing;
    in property <string> lighting-work-description;
    callback change-lighting-work-limit(string);
    in property <[string]> sky-qualities;
    in-out property <string> selected-sky-quality <=> sky-selector.current-value;
    in property <bool> sky-enabled;
    callback change-sky-quality(int);
    in property <bool> refine-ambient-probes;
    in property <bool> ambient-probe-refinement-enabled;
    in property <string> ambient-probe-refinement-description;
    callback change-refine-ambient-probes(bool);
    in property <[string]> visibility-modes;
    in-out property <string> selected-visibility <=> visibility-selector.current-value;
    in property <string> visibility-description;
    callback change-visibility(int);
    in property <string> summary;
    in property <string> details;
    in property <string> diagnostics;
    in property <string> message;
    in property <bool> cancellable;
    in property <bool> launch-ready;
    in property <string> launch-details;
    callback cancel-build();
    callback play-build();
    callback inspect-baked-lightmaps();
    callback inspect-baked-surfaces();
    callback inspect-baked-prop-vertices();
    callback inspect-compiled-lights();
    callback inspect-visibility();
    callback inspect-compiled-details();
    callback close-dialog();
    callback change-lighting(int);
    callback change-physics(int);
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.close-dialog(); return accept; }
            return reject;
        }
    }
    VerticalLayout {
        spacing: 0px;
        ScrollView {
            content-width: self.width;
            VerticalLayout {
                padding: 24px;
                spacing: 14px;
                Text { text: "Build status"; font-size: 24px; font-weight: 600; }
                HorizontalLayout {
                    spacing: 12px;
                    Text { text: "Build recipe"; vertical-alignment: center; }
                    recipe-selector := ComboBox { model: root.recipe-names; enabled: root.lighting-enabled; selected(value) => { root.choose-recipe(self.current-index); } }
                    Button { text: "Apply recipe"; enabled: root.lighting-enabled; clicked => { root.apply-recipe(); } }
                }
                Text { text: root.recipe-status; wrap: word-wrap; color: #bac2ce; }
                Text { text: root.recipe-description; wrap: word-wrap; color: #bac2ce; }
                HorizontalLayout {
                    spacing: 12px;
                    Text { text: "Recipe name"; vertical-alignment: center; }
                    LineEdit { text <=> root.recipe-name; placeholder-text: "Evening lighting check"; enabled: root.custom-recipes-enabled; horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button { text: "Save current as new"; enabled: root.custom-recipes-enabled && root.recipe-name != ""; clicked => { root.save-recipe(); } }
                    Button { text: "Replace with current"; enabled: root.custom-recipes-enabled && root.custom-recipe-selected && root.recipe-name != ""; clicked => { root.replace-recipe(); } }
                    Button { text: "Rename recipe"; enabled: root.custom-recipes-enabled && root.custom-recipe-selected && root.recipe-name != ""; clicked => { root.rename-recipe(); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button { text: "Delete recipe"; enabled: root.custom-recipes-enabled && root.custom-recipe-selected; clicked => { root.delete-recipe(); } }
                    Button { text: "Cancel recipe edit"; clicked => { root.cancel-recipe-edit(); } }
                    Button { text: "Reload recipes"; enabled: root.recipes-reload-enabled; clicked => { root.reload-recipes(); } }
                    Rectangle { horizontal-stretch: 1; }
                }
                Text { text: "Recipes change the settings below. Apply recipe does not start a build. Active builds freeze settings and recipe edits."; wrap: word-wrap; color: #bac2ce; }
                HorizontalLayout {
                    spacing: 12px;
                    Text { text: "Build lighting"; vertical-alignment: center; }
                    lighting-selector := ComboBox { model: root.lighting-modes; enabled: root.lighting-enabled; selected(value) => { root.change-lighting(self.current-index); } }
                }
                Text { text: root.lighting-description; wrap: word-wrap; color: #bac2ce; }
                CheckBox { text: "Brush texture shadows"; checked: root.brush-texture-shadows; enabled: root.brush-texture-shadows-enabled; toggled => { root.change-brush-texture-shadows(self.checked); } }
                Text { text: root.brush-texture-shadows-description; wrap: word-wrap; color: #bac2ce; }
                CheckBox { text: "Bake static-prop vertex lighting"; checked: root.bake-static-prop-vertices; enabled: root.prop-vertex-lighting-enabled; toggled => { root.change-bake-static-prop-vertices(self.checked); } }
                Text { text: root.prop-vertex-lighting-description; wrap: word-wrap; color: #bac2ce; }
                CheckBox { text: "Pack sky assets"; checked: root.pack-sky-assets; enabled: root.lighting-enabled; toggled => { root.change-pack-sky-assets(self.checked); } }
                Text { text: "Packs the selected sky family’s supported materials and textures into the BSP. Missing or unsupported assets stop the build."; wrap: word-wrap; color: #bac2ce; }
                CheckBox { text: "Pack liquid assets"; checked: root.pack-water-assets; enabled: root.lighting-enabled; toggled => { root.change-pack-water-assets(self.checked); } }
                Text { text: root.water-packing-description; wrap: word-wrap; color: #bac2ce; }
                CheckBox { text: "Pack static prop assets"; checked: root.pack-static-prop-assets; enabled: root.lighting-enabled; toggled => { root.change-pack-static-prop-assets(self.checked); } }
                Text { text: root.static-prop-packing-description; wrap: word-wrap; color: #bac2ce; }
                CheckBox { text: "Generate reflections"; checked: root.generate-reflections; enabled: root.lighting-enabled; toggled => { root.change-reflections(self.checked); } }
                Text { text: root.reflection-description; wrap: word-wrap; color: #bac2ce; }
                Text { text: root.capture-summary; wrap: word-wrap; color: #bac2ce; }
                if !root.capture-editing: HorizontalLayout {
                    Button { text: "Configure capture…"; enabled: root.capture-editable; clicked => { root.begin-capture-edit(); } }
                    Rectangle { horizontal-stretch: 1; }
                }
                if root.capture-editing: VerticalLayout {
                    spacing: 8px;
                    Text { text: root.capture-details; wrap: word-wrap; color: #bac2ce; }
                    Text { text: "CS:S installation override"; }
                    HorizontalLayout {
                        LineEdit { text <=> root.capture-engine-root; placeholder-text: "Automatic from mounted CS:S game"; enabled: root.capture-editable; horizontal-stretch: 1; }
                        Button { text: "Choose CS:S folder…"; enabled: root.capture-editable; clicked => { root.choose-capture-root(0); } }
                    }
                    Text { text: "Steam client override"; }
                    HorizontalLayout {
                        LineEdit { text <=> root.capture-steam-root; placeholder-text: "Automatic from checked Steam client configuration"; enabled: root.capture-editable; horizontal-stretch: 1; }
                        Button { text: "Choose Steam folder…"; enabled: root.capture-editable; clicked => { root.choose-capture-root(1); } }
                    }
                    Text { text: "Leave an override empty to use its checked automatic value. Apply validates both paths. These machine settings stay outside map recipes and recent maps."; wrap: word-wrap; color: #bac2ce; }
                    if !root.capture-current: Text { text: "Capture configuration changed. Cancel this edit and review the current configuration."; wrap: word-wrap; color: #ffb36b; }
                    HorizontalLayout {
                        Button { text: "Apply capture runtime"; enabled: root.capture-editable && root.capture-current; clicked => { root.apply-capture-runtime(); } }
                        Button { text: "Cancel runtime edit"; clicked => { root.cancel-capture-edit(); } }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    Text { text: "Physics bodies"; vertical-alignment: center; }
                    physics-selector := ComboBox { model: root.physics-modes; enabled: root.lighting-enabled; selected(value) => { root.change-physics(self.current-index); } }
                }
                Text { text: root.physics-description; wrap: word-wrap; color: #bac2ce; }
                HorizontalLayout {
                    spacing: 12px;
                    Text { text: "Visibility quality"; vertical-alignment: center; }
                    visibility-selector := ComboBox { model: root.visibility-modes; enabled: root.lighting-enabled; selected(value) => { root.change-visibility(self.current-index); } }
                }
                Text { text: root.visibility-description; wrap: word-wrap; color: #bac2ce; }
                HorizontalLayout {
                    spacing: 12px;
                    Text { text: "Indirect light"; vertical-alignment: center; }
                    bounce-selector := ComboBox { model: root.bounce-modes; enabled: root.sky-enabled; selected(value) => { root.change-bounces(self.current-index); } }
                }
                Text { text: "Diffuse bounces preserve each light style while reflecting light from world brushes and terrain into shaded world surfaces and brush entities. More bounces add work within the same build limit. Used by Direct LDR and Direct LDR + HDR."; wrap: word-wrap; color: #bac2ce; }
                HorizontalLayout {
                    spacing: 12px;
                    Text { text: "Brush smoothing angle"; vertical-alignment: center; }
                    SpinBox { minimum: 0; maximum: 90; value: root.smoothing-angle; enabled: root.sky-enabled; edited => { root.change-smoothing-angle(self.value); } }
                    Slider { minimum: 0; maximum: 90; value: root.smoothing-angle; enabled: root.sky-enabled; changed => { root.change-smoothing-angle(round(self.value)); } }
                    Text { text: "°"; vertical-alignment: center; }
                }
                Text { text: "0 keeps unassigned faces flat. Larger angles blend neighboring brush faces. Assigned smooth/hard groups keep their rules."; wrap: word-wrap; color: #bac2ce; }
                HorizontalLayout {
                    spacing: 12px;
                    Text { text: "Sampling quality"; vertical-alignment: center; }
                    sky-selector := ComboBox { model: root.sky-qualities; enabled: root.sky-enabled; selected(value) => { root.change-sky-quality(self.current-index); } }
                }
                Text { text: "More directions improve soft sun shadows, sky/model ambient and bounced light, and take longer. Used by Direct LDR and Direct LDR + HDR."; wrap: word-wrap; color: #bac2ce; }
                CheckBox { text: "Refine ambient probes"; checked: root.refine-ambient-probes; enabled: root.ambient-probe-refinement-enabled; toggled => { root.change-refine-ambient-probes(self.checked); } }
                Text { text: root.ambient-probe-refinement-description; wrap: word-wrap; color: #bac2ce; }
                HorizontalLayout {
                    spacing: 12px;
                    Text { text: "Lighting work limit (millions)"; vertical-alignment: center; }
                    LineEdit {
                        text <=> root.lighting-work-limit-millions;
                        enabled: root.lighting-enabled;
                        edited => { root.lighting-work-limit-editing = true; }
                        accepted => { root.change-lighting-work-limit(self.text); }
                    }
                    Button { text: "Apply work limit"; enabled: root.lighting-enabled; clicked => { root.change-lighting-work-limit(root.lighting-work-limit-millions); } }
                }
                Text { text: "0.000001–10000 million work units; default 1000. Up to six decimal places retain exact work units. " + root.lighting-work-description; wrap: word-wrap; color: #bac2ce; }
                Text { text: root.summary; font-size: 16px; font-weight: 600; wrap: word-wrap; }
                Text { text: root.details; wrap: word-wrap; color: #bac2ce; }
                Text { text: "Diagnostics"; font-weight: 600; }
                TextEdit { text: root.diagnostics; read-only: true; min-height: 160px; max-height: 160px; }
                Text { text: root.launch-details; wrap: word-wrap; color: #bac2ce; }
                Text { text: root.message; wrap: word-wrap; color: #bac2ce; }
            }
        }
        HorizontalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 8px;
            spacing: 8px;
            Button { text: "Inspect baked lightmaps…"; clicked => { root.inspect-baked-lightmaps(); } }
            Button { text: "Inspect baked prop vertices…"; clicked => { root.inspect-baked-prop-vertices(); } }
            Button { text: "Baked surfaces…"; clicked => { root.inspect-baked-surfaces(); } }
            Rectangle { horizontal-stretch: 1; }
        }
        HorizontalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 8px;
            Button { text: "Inspect compiled lights…"; clicked => { root.inspect-compiled-lights(); } }
            Button { text: "Inspect visibility…"; clicked => { root.inspect-visibility(); } }
            Button { text: "Compiled details…"; clicked => { root.inspect-compiled-details(); } }
            Rectangle { horizontal-stretch: 1; }
        }
        HorizontalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 8px;
            padding-bottom: 24px;
            spacing: 8px;
            Button { text: "Cancel build"; enabled: root.cancellable; clicked => { root.cancel-build(); } }
            Button { text: "Play built map"; enabled: root.launch-ready; clicked => { root.play-build(); } }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Close"; clicked => { root.close-dialog(); } }
        }
    }
}

export component BakedLightmapsWindow inherits Window {
    title: "Baked lightmaps - HammeRR";
    width: 760px;
    height: 980px;
    in property <float> aspect: 1;
    in-out property <string> channel: "LDR";
    in-out property <int> compiled-face;
    in-out property <int> style-index;
    in-out property <int> map-index;
    in-out property <int> page-offset;
    in-out property <int> page-size: 32;
    in property <string> build-state;
    in property <string> channels;
    in property <string> faces;
    in property <string> mapping-status;
    in property <[string]> origin-rows;
    in property <string> origin-details;
    in property <[bool]> origin-selectable;
    in property <[string]> match-rows;
    in property <bool> has-source;
    in-out property <int> contributor-offset;
    in-out property <int> match-offset;
    callback inspect-selected-authored();
    callback inspect-origin(int);
    callback inspect-match(int);
    callback find-matches();
    in property <string> selected;
    in property <string> diagnostics;
    in property <image> preview;
    in property <bool> has-preview;
    in property <bool> can-frame;
    callback inspect-face();
    callback frame-face();
    callback query-changed();
    callback close-dialog();
    forward-focus: keys;
    keys := FocusScope {
      key-pressed(event) => { if event.text == Key.Escape { root.close-dialog(); accept } else { reject } }
      VerticalLayout {
        spacing: 0px;
      ScrollView {
        content-width: self.width;
        VerticalLayout {
          padding: 24px;
          spacing: 12px;
          Text { text: "Baked BSP face lightmaps"; font-size: 24px; font-weight: 600; }
          Text { text: root.build-state; wrap: word-wrap; color: #ffcb80; }
          Text { text: root.channels; wrap: word-wrap; }
          HorizontalLayout {
              spacing: 8px;
              Text { text: "Channel"; vertical-alignment: center; }
              ComboBox { model: ["LDR", "HDR"]; current-value <=> root.channel; selected(value) => { root.query-changed(); } }
              Text { text: "Compiled face"; vertical-alignment: center; }
              SpinBox { minimum: 0; maximum: 65535; value <=> root.compiled-face; edited => { root.query-changed(); } }
              Button { text: "Inspect face"; clicked => { root.inspect-face(); } }
              Button { text: "Frame face"; enabled: root.can-frame; clicked => { root.frame-face(); } }
          }
          HorizontalLayout {
              spacing: 8px;
              Text { text: "Style index"; vertical-alignment: center; }
              SpinBox { minimum: 0; maximum: 3; value <=> root.style-index; edited => { root.query-changed(); } }
              Text { text: "Map index"; vertical-alignment: center; }
              SpinBox { minimum: 0; maximum: 3; value <=> root.map-index; edited => { root.query-changed(); } }
              Text { text: "0 = base · 1–3 = bump maps"; vertical-alignment: center; }
          }
          Text { text: "Compiled indices identify this build. Authored origins are retained compiler contributors; splits and merges can produce many-to-many matches."; wrap: word-wrap; color: #bac2ce; }
          HorizontalLayout {
              spacing: 12px;
              Rectangle {
                  background: #11151d;
                  width: 220px;
                  height: 220px;
                  if root.has-preview: Image { source: root.preview; image-fit: contain; width: 100%; height: 100%; }
                  if !root.has-preview: Text { text: "No image"; color: #bac2ce; horizontal-alignment: center; vertical-alignment: center; }
              }
              TextEdit { text: root.selected; read-only: true; horizontal-stretch: 1; }
          }
          Text { text: "Image: per-channel Reinhard compression of intensity / 255, then gamma 1/2.2. Nearest sample reduction to ≤128 px. Linear statistics retain RGBExp32 intensity; this image does not reproduce game tone mapping."; wrap: word-wrap; color: #bac2ce; }
          HorizontalLayout {
              spacing: 8px;
              Text { text: "Face page starts at"; vertical-alignment: center; }
              SpinBox { minimum: 0; maximum: 65535; value <=> root.page-offset; edited => { root.query-changed(); } }
              Text { text: "Rows per page"; vertical-alignment: center; }
              SpinBox { minimum: 1; maximum: 32; value <=> root.page-size; edited => { root.query-changed(); } }
          }
          TextEdit { text: root.faces; read-only: true; min-height: 70px; max-height: 80px; }
          Text { text: root.mapping-status; wrap: word-wrap; color: #ffcb80; }
          HorizontalLayout {
              spacing: 8px;
              Button { text: "Inspect selected authored face"; clicked => { root.inspect-selected-authored(); } }
              Text { text: "Contributor page starts at"; vertical-alignment: center; }
              SpinBox { minimum: 0; maximum: 262144; value <=> root.contributor-offset; edited => { root.query-changed(); } }
          }
          ListView {
              height: 78px;
              for row[i] in root.origin-rows: Button { text: row; enabled: root.origin-selectable[i]; clicked => { root.inspect-origin(i); } }
          }
          if root.origin-details != "": TextEdit { text: root.origin-details; read-only: true; wrap: word-wrap; min-height: 45px; max-height: 70px; }
          HorizontalLayout {
              spacing: 8px;
              Text { text: "Match page starts at"; vertical-alignment: center; }
              SpinBox { minimum: 0; maximum: 65536; value <=> root.match-offset; }
              Button { text: "Find matches"; enabled: root.has-source; clicked => { root.find-matches(); } }
              Text { text: "Lists inspect locally; editor selection stays unchanged."; wrap: word-wrap; }
          }
          ListView {
              height: 78px;
              for row[i] in root.match-rows: Button { text: row; clicked => { root.inspect-match(i); } }
          }
          TextEdit { text: root.diagnostics; read-only: true; min-height: 70px; max-height: 110px; }
        }
      }
        HorizontalLayout {
            padding: 16px;
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Close"; clicked => { root.close-dialog(); } }
        }
      }
    }
}
