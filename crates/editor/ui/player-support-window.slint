import { Button, CheckBox, ComboBox, ScrollView, SpinBox } from "widgets.slint";
import { Theme, MutedText, FieldRow, SectionHeader, SelectableRow } from "kit.slint";

export struct PlayerSupportRow {
    title: string,
    detail: string,
}

export component PlayerSupportWindow inherits Window {
    background: Theme.panel;
    title: "Player support - HammeRR";
    default-font-size: Theme.font;
    preferred-width: 740px;
    preferred-height: 820px;
    min-width: 560px;
    min-height: 560px;
    in-out property <int> duration-ms: 5000;
    in-out property <int> interval-ms: 50;
    in-out property <int> sample-limit: 128;
    in-out property <int> team-index: 0;
    in-out property <int> input-index: 0;
    in-out property <bool> probe-enabled;
    in-out property <int> probe-distance: 2;
    in-out property <bool> settings-expanded: true;
    in-out property <bool> samples-expanded: true;
    in-out property <bool> support-expanded;
    in property <[string]> inputs;
    in property <int> minimum-probe-distance: 1;
    in property <int> maximum-probe-distance: 128;
    in property <int> minimum-duration: 100;
    in property <int> maximum-duration: 30000;
    in property <int> minimum-interval: 15;
    in property <int> maximum-interval: 1000;
    in property <int> minimum-samples: 3;
    in property <int> maximum-samples: 1024;
    in property <[PlayerSupportRow]> samples;
    in property <int> selected-row: -1;
    in property <string> status;
    in property <string> summary;
    in property <string> availability;
    in property <string> message;
    in property <string> page-label;
    in property <string> sample-identity;
    in property <string> motion;
    in property <string> hull;
    in property <string> support;
    in property <string> support-motion;
    in property <string> support-state;
    in property <string> observation;
    in property <string> input-status;
    in property <string> probe-status;
    in property <string> probe-details;
    in property <string> guide-status;
    in property <bool> busy;
    in property <bool> can-start;
    in property <bool> can-cancel;
    in property <bool> can-clear;
    in property <bool> can-frame;
    in property <bool> previous-page;
    in property <bool> next-page;
    in property <bool> can-show-guide;
    in property <bool> can-toggle-guide;
    in property <bool> can-clear-guide;
    in property <bool> guide-visible;
    callback start-observation();
    callback cancel-observation();
    callback clear-observation();
    callback choose-sample(int);
    callback page-samples(int);
    callback frame-sample();
    callback start-finished(string);
    callback close-dialog();
    callback show-guide();
    callback toggle-guide();
    callback clear-guide();
    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.close-dialog(); accept } else { reject }
        }
        VerticalLayout {
            padding: Theme.space-xl;
            spacing: Theme.space-lg;
            Text { text: "Player support"; color: Theme.text; font-size: Theme.font-display; font-weight: 600; }
            MutedText { text: "Observe a fresh player's movement and support in the compiled map, with optional diagnostic hull sweeps."; }
            ScrollView {
                content-width: self.width;
                horizontal-scrollbar-policy: always-off;
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;
                    padding-right: Theme.space-lg;
                    spacing: Theme.space-lg;
                    settings-header := SectionHeader { text: "Observation settings"; inset: false; expanded <=> root.settings-expanded; }
                    if settings-header.expanded: VerticalLayout {
                        spacing: Theme.space;
                        FieldRow {
                            label: "Team"; label-width: 112px; inset: false;
                            ComboBox { model: ["Counter-terrorists", "Terrorists"]; current-index <=> root.team-index; enabled: !root.busy; accessible-label: "Observed player team"; }
                        }
                        FieldRow {
                            label: "Input"; label-width: 112px; inset: false;
                            ComboBox { model: root.inputs; current-index <=> root.input-index; enabled: !root.busy; accessible-label: "Native player input"; }
                        }
                        FieldRow {
                            label: "Duration"; label-width: 112px; inset: false;
                            SpinBox { minimum: root.minimum-duration; maximum: root.maximum-duration; value <=> root.duration-ms; enabled: !root.busy; accessible-label: "Observation duration in milliseconds"; }
                            Text { text: "ms"; color: Theme.text-muted; vertical-alignment: center; width: 48px; }
                        }
                        FieldRow {
                            label: "Sample interval"; label-width: 112px; inset: false;
                            SpinBox { minimum: root.minimum-interval; maximum: root.maximum-interval; value <=> root.interval-ms; enabled: !root.busy; accessible-label: "Sample interval in native milliseconds"; }
                            Text { text: "ms"; color: Theme.text-muted; vertical-alignment: center; width: 48px; }
                        }
                        FieldRow {
                            label: "Sample limit"; label-width: 112px; inset: false;
                            SpinBox { minimum: root.minimum-samples; maximum: root.maximum-samples; value <=> root.sample-limit; enabled: !root.busy; accessible-label: "Maximum retained samples"; }
                            Text { text: "samples"; color: Theme.text-muted; vertical-alignment: center; width: 48px; }
                        }
                        CheckBox { text: "Probe movement hull"; checked <=> root.probe-enabled; enabled: !root.busy; }
                        FieldRow {
                            label: "Probe distance"; label-width: 112px; inset: false;
                            SpinBox { minimum: root.minimum-probe-distance; maximum: root.maximum-probe-distance; value <=> root.probe-distance; enabled: root.probe-enabled && !root.busy; accessible-label: "Diagnostic hull sweep distance in world units"; }
                            Text { text: "units"; color: Theme.text-muted; vertical-alignment: center; width: 48px; }
                        }
                        MutedText { text: "Duration and interval use native simulation time. Rows require acknowledgement of the selected input. Probes sweep downward along world Z without moving the player."; font-size: Theme.font-small; }
                    }
                    if root.status != "": Text { text: root.status; color: Theme.text; wrap: word-wrap; }
                    if root.summary != "": MutedText { text: root.summary; }
                    if root.availability != "": Text { text: root.availability; color: Theme.warning; wrap: word-wrap; }
                    if root.message != "": Text { text: root.message; color: Theme.danger; wrap: word-wrap; }
                    samples-header := SectionHeader { text: "Samples"; detail: root.page-label; inset: false; expanded <=> root.samples-expanded; }
                    if samples-header.expanded: VerticalLayout {
                        spacing: Theme.space;
                        ScrollView {
                            content-width: self.width;
                            horizontal-scrollbar-policy: always-off;
                            height: root.samples.length == 0 ? 36px : 220px;
                            VerticalLayout {
                                alignment: start;
                                padding-right: Theme.space-lg;
                                spacing: Theme.space-xs;
                                for row[index] in root.samples: SelectableRow {
                                    label: row.title;
                                    selected: root.selected-row == index;
                                    min-height: 54px;
                                    clicked => { root.choose-sample(index); }
                                    VerticalLayout {
                                        padding: Theme.space;
                                        spacing: Theme.space-xs;
                                        Text { text: row.title; color: Theme.text; overflow: elide; }
                                        Text { text: row.detail; color: Theme.text-muted; overflow: elide; }
                                    }
                                }
                                if root.samples.length == 0: MutedText { text: root.busy ? "Waiting for retained samples and confirmed cleanup." : "No retained player samples."; }
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.space;
                            Button { text: "Previous"; enabled: root.previous-page; clicked => { root.page-samples(-1); } }
                            Button { text: "Next"; enabled: root.next-page; clicked => { root.page-samples(1); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                    SectionHeader { text: "Selected sample"; inset: false; collapsible: false; }
                    MutedText { text: root.sample-identity; }
                    if root.input-status != "": Text { text: root.input-status; color: Theme.text; wrap: word-wrap; }
                    if root.motion != "": VerticalLayout {
                        spacing: Theme.space;
                        motion-header := SectionHeader { text: "Movement"; inset: false; expanded: false; }
                        if motion-header.expanded: Text { text: root.motion; color: Theme.text; wrap: word-wrap; }
                    }
                    if root.hull != "": VerticalLayout {
                        spacing: Theme.space;
                        hull-header := SectionHeader { text: "Movement hull"; inset: false; }
                        if hull-header.expanded: Text { text: root.hull; color: Theme.text; wrap: word-wrap; }
                    }
                    if root.support != "": VerticalLayout {
                        spacing: Theme.space;
                        support-header := SectionHeader { text: "Support"; inset: false; expanded <=> root.support-expanded; }
                        if support-header.expanded: VerticalLayout {
                            spacing: Theme.space;
                            Text { text: root.support; color: Theme.text; wrap: word-wrap; }
                            if root.support-motion != "": VerticalLayout {
                                spacing: Theme.space;
                                support-motion-header := SectionHeader { text: "Support pose and velocity"; inset: false; }
                                if support-motion-header.expanded: Text { text: root.support-motion; color: Theme.text; wrap: word-wrap; }
                            }
                            if root.support-state != "": VerticalLayout {
                                spacing: Theme.space;
                                state-header := SectionHeader { text: "Raw support state"; inset: false; expanded: false; }
                                if state-header.expanded: Text { text: root.support-state; color: Theme.text; wrap: word-wrap; }
                            }
                        }
                    }
                    if root.probe-status != "": VerticalLayout {
                        spacing: Theme.space;
                        SectionHeader { text: "Diagnostic sweep"; inset: false; collapsible: false; }
                        Text { text: root.probe-status; color: Theme.text; wrap: word-wrap; }
                        if root.probe-details != "": VerticalLayout {
                            spacing: Theme.space;
                            probe-header := SectionHeader { text: "Sweep details"; inset: false; expanded: false; }
                            if probe-header.expanded: Text { text: root.probe-details; color: Theme.text; wrap: word-wrap; }
                        }
                        MutedText { text: "The endpoint is the hull reference position. A sweep does not prove actual contact or traversal."; font-size: Theme.font-small; }
                    }
                    HorizontalLayout {
                        spacing: Theme.space;
                        Button { text: "Frame sample"; enabled: root.can-frame; clicked => { root.frame-sample(); } }
                        Button { text: "Show sample guide"; enabled: root.can-show-guide; clicked => { root.show-guide(); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if root.guide-status != "": MutedText { text: root.guide-status; }
                    HorizontalLayout {
                        spacing: Theme.space;
                        Button { text: root.guide-visible ? "Hide guide" : "Show guide"; enabled: root.can-toggle-guide; clicked => { root.toggle-guide(); } }
                        Button { text: "Clear guide"; enabled: root.can-clear-guide; clicked => { root.clear-guide(); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    observation-header := SectionHeader { text: "Observation"; inset: false; expanded: false; }
                    if observation-header.expanded: MutedText { text: root.observation; }
                    MutedText { text: "Surface values without a ground owner are cached. A diagnostic hit does not identify an authored face or terrain triangle."; font-size: Theme.font-small; }
                }
            }
            HorizontalLayout {
                spacing: Theme.space;
                Button { text: "Close"; clicked => { root.close-dialog(); } }
                Button { text: "Cancel"; enabled: root.can-cancel; clicked => { root.cancel-observation(); } }
                Button { text: "Clear"; enabled: root.can-clear; clicked => { root.clear-observation(); } }
                Rectangle { horizontal-stretch: 1; }
                Button { text: "Start"; primary: true; enabled: root.can-start && !root.busy; clicked => { root.start-observation(); } }
            }
        }
    }
}
