import { Theme } from "theme.slint";
import { Button, CheckBox, ComboBox, LineEdit, ListView, SpinBox } from "widgets.slint";

export struct OpeningRow { key: string, label: string, open: bool }

export component HollowWindow inherits Window {
    background: Theme.panel;
    title: "Hollow brushes - HammeRR";
    preferred-width: 820px; preferred-height: 690px;
    in property <[OpeningRow]> faces;
    in property <string> source;
    in property <string> stamp;
    in property <string> token;
    in property <string> summary;
    in property <string> selection-label;
    in property <string> message;
    in property <bool> ready;
    in property <bool> can-preview;
    in property <int> cavities;
    in-out property <int> cavity: 1;
    in-out property <int> direction;
    in-out property <string> thickness: "16";
    callback edited();
    callback choose-opening(string);
    callback close-openings();
    callback preview-edit();
    callback look-inside();
    callback apply();
    callback cancel();
    forward-focus: keys;
    keys := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => { if event.text == Key.Escape { root.cancel(); accept } else { reject } }
        VerticalLayout {
            padding: 24px; spacing: 16px;
            Text { text: "Turn solids into walls"; font-size: 24px; font-weight: 600; }
            Text { text: root.selection-label; color: Theme.text-muted; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 16px;
                VerticalLayout {
                    spacing: 6px;
                    Text { text: "Wall thickness · units"; font-weight: 600; }
                    LineEdit { text <=> root.thickness; input-type: decimal; accessible-label: "Wall thickness"; edited => { root.edited(); } }
                }
                VerticalLayout {
                    spacing: 6px;
                    Text { text: "Build walls"; font-weight: 600; }
                    ComboBox { model: ["Inside the original size", "Outside the original size"]; current-index <=> root.direction; selected => { root.edited(); } }
                }
            }
            Text { text: root.direction == 0 ? "The outer shape stays the same. Walls reduce the space inside." : "The original shape becomes the empty space. Walls grow outward."; color: Theme.text-muted; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 12px;
                Text { text: "Openings"; font-size: 18px; font-weight: 600; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Button { text: "Close all openings"; enabled: root.faces.length > 0; clicked => { root.close-openings(); } }
            }
            Text { text: "Check faces to leave open. Unchecked faces become walls. Keep at least one wall per brush."; color: Theme.text-muted; wrap: word-wrap; }
            ListView {
                vertical-stretch: 1; min-height: 150px;
                for face in root.faces: VerticalLayout {
                    padding-top: 4px; padding-bottom: 4px;
                    CheckBox { text: face.label; checked: face.open; toggled => { root.choose-opening(face.key); } }
                }
            }
            Text { text: root.summary; font-size: 17px; font-weight: 600; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 10px;
                if root.cavities > 1: Text { text: "Cavity"; vertical-alignment: center; }
                if root.cavities > 1: SpinBox { minimum: 1; maximum: max(1,root.cavities); value <=> root.cavity; }
                Button { text: "Look inside"; enabled: root.token != ""; clicked => { root.look-inside(); } }
            }
            Text { text: "Look inside moves the camera into the preview. Use Wireframe for an outside view of the walls. Cancel keeps the camera position."; color: Theme.text-muted; wrap: word-wrap; font-size: 12px; }
            if root.message != "": Text { text: root.message; color: Theme.warning; wrap: word-wrap; }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 10px;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
                Button { text: "Preview walls"; enabled: root.can-preview; clicked => { root.preview-edit(); } }
                Button { text: "Create walls"; enabled: root.ready; clicked => { root.apply(); } }
            }
        }
    }
}
