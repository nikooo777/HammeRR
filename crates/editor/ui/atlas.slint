import { Button, LineEdit } from "std-widgets.slint";

export component AtlasWindow inherits Window {
    title: "Fit atlas region - HammeRR";
    preferred-width: 720px;
    preferred-height: 770px;
    in property <string> selection-label;
    in property <string> details;
    in property <string> message;
    in property <bool> stale;
    in property <bool> ready;
    in property <bool> loaded;
    in property <image> preview;
    in property <float> texture-width: 1;
    in property <float> texture-height: 1;
    in property <float> region-u;
    in property <float> region-v;
    in property <float> region-width;
    in property <float> region-height;
    in property <bool> valid-region;
    in property <float> usable-u;
    in property <float> usable-v;
    in property <float> usable-width;
    in property <float> usable-height;
    in property <bool> valid-usable-region;
    in property <bool> has-padding;
    in property <string> usable-details;
    in-out property <string> material;
    in-out property <string> region-x: "0";
    in-out property <string> region-y: "0";
    in-out property <string> region-pixels-wide: "1";
    in-out property <string> region-pixels-high: "1";
    in-out property <string> region-padding: "0";
    callback edited();
    callback inspect-material();
    callback browse();
    callback preview-fit();
    callback apply-fit();
    callback cancel();
    forward-focus: keys;
    keys := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => { if event.text == Key.Escape { root.cancel(); accept } else { reject } }
        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            Text { text: "Fit atlas region"; font-size: 24px; font-weight: 600; }
            Text { text: root.selection-label; color: #bac2ce; }
            HorizontalLayout {
                spacing: 8px;
                Text { text: "Material"; vertical-alignment: center; }
                LineEdit { text <=> root.material; horizontal-stretch: 1; edited => { root.edited(); } }
                Button { text: "Browse materials…"; clicked => { root.browse(); } }
                Button { text: "Inspect material"; enabled: !root.stale; clicked => { root.inspect-material(); } }
            }
            Text { text: root.details; wrap: word-wrap; color: #bac2ce; }
            Text { text: "The base image stays cached until Reload material assets."; wrap: word-wrap; color: #bac2ce; }
            HorizontalLayout {
                spacing: 20px;
                Rectangle {
                    width: 320px;
                    height: 320px;
                    background: #141923;
                    image-area := Rectangle {
                        width: root.texture-width >= root.texture-height ? parent.width : parent.height * root.texture-width / root.texture-height;
                        height: root.texture-width >= root.texture-height ? parent.width * root.texture-height / root.texture-width : parent.height;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        if root.loaded: Image { source: root.preview; width: parent.width; height: parent.height; image-fit: fill; }
                        if root.loaded && root.valid-region: Rectangle {
                            x: parent.width * root.region-u;
                            y: parent.height * root.region-v;
                            width: parent.width * root.region-width;
                            height: parent.height * root.region-height;
                            border-width: 2px;
                            border-color: #58dfff;
                            background: #45cfff22;
                        }
                        if root.loaded && root.valid-usable-region && root.has-padding: Rectangle {
                            x: parent.width * root.usable-u;
                            y: parent.height * root.usable-v;
                            width: parent.width * root.usable-width;
                            height: parent.height * root.usable-height;
                            border-width: 2px;
                            border-color: #ffd66e;
                            background: #ffd66e22;
                        }
                    }
                    if !root.loaded: Text { text: "Inspect a supported material"; horizontal-alignment: center; vertical-alignment: center; color: #bac2ce; }
                }
                VerticalLayout {
                    spacing: 10px;
                    Text { text: "Rectangle · source image pixels"; font-weight: 600; }
                    HorizontalLayout {
                        Text { text: "X"; width: 54px; vertical-alignment: center; }
                        LineEdit { text <=> root.region-x; input-type: number; accessible-label: "Atlas X"; edited => { root.edited(); } }
                    }
                    HorizontalLayout {
                        Text { text: "Y"; width: 54px; vertical-alignment: center; }
                        LineEdit { text <=> root.region-y; input-type: number; accessible-label: "Atlas Y"; edited => { root.edited(); } }
                    }
                    HorizontalLayout {
                        Text { text: "Width"; width: 54px; vertical-alignment: center; }
                        LineEdit { text <=> root.region-pixels-wide; input-type: number; accessible-label: "Atlas width"; edited => { root.edited(); } }
                    }
                    HorizontalLayout {
                        Text { text: "Height"; width: 54px; vertical-alignment: center; }
                        LineEdit { text <=> root.region-pixels-high; input-type: number; accessible-label: "Atlas height"; edited => { root.edited(); } }
                    }
                    HorizontalLayout {
                        Text { text: "Padding"; width: 54px; vertical-alignment: center; }
                        LineEdit { text <=> root.region-padding; input-type: number; accessible-label: "Atlas padding in source image pixels"; edited => { root.edited(); } }
                    }
                    Text { text: "Padding insets all four edges in whole source image pixels. Zero uses the entire rectangle."; wrap: word-wrap; color: #bac2ce; }
                    Text { text: root.usable-details; wrap: word-wrap; color: root.valid-usable-region ? #ffd66e : #ffb4a8; }
                    Rectangle { vertical-stretch: 1; }
                }
            }
            Text { text: "Cyan: rectangle. Yellow: usable area after padding. Image edges start at the top-left corner; X grows right and Y grows down."; wrap: word-wrap; color: #bac2ce; }
            Text { text: "Each face fits its projected bounds into the usable area, keeping its texture direction, rotation and mirroring. Polygon corners can leave parts unused."; wrap: word-wrap; color: #bac2ce; }
            Text { text: root.message; wrap: word-wrap; }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 10px;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
                Rectangle { horizontal-stretch: 1; }
                Button { text: "Preview atlas fit"; enabled: !root.stale && root.loaded; clicked => { root.preview-fit(); } }
                Button { text: "Apply atlas fit"; enabled: !root.stale && root.ready; clicked => { root.apply-fit(); } }
            }
        }
    }
}
