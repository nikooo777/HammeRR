import { Theme } from "theme.slint";
import {Button, ComboBox, LineEdit, ListView, ScrollView, Slider} from "widgets.slint";

export struct SoundChoiceRow {value:string,name:string,detail:string}

export component SoundBrowserWindow inherits Window {
    background: Theme.panel;
    title:"Choose sound";
    preferred-width:960px;preferred-height:700px;
    in-out property <string> query;
    in property <[string]> groups;
    in-out property <int> group-index;
    in property <[SoundChoiceRow]> rows;
    in property <string> page-info;
    in property <bool> can-previous;
    in property <bool> can-next;
    in-out property <string> value;
    in property <string> target;
    in property <string> details;
    in property <string> script-info;
    in property <[string]> waves;
    in-out property <int> variant;
    in-out property <float> volume:50;
    in property <bool> can-apply;
    in property <bool> can-stop;
    in property <string> playback;
    in property <string> message;
    callback search();callback group-changed();callback page(int);callback choose(string);
    callback inspect();callback variant-changed();callback invalidate();
    callback volume-changed();callback play();callback stop();callback reload();
    callback apply();callback cancel();
    forward-focus:dialog-focus;
    dialog-focus:=FocusScope {
        key-pressed(event)=>{if event.text==Key.Escape{root.cancel();accept}else{reject}}
        VerticalLayout {
            padding: Theme.space-xl;spacing:12px;
            Text {text:"Choose a sound";font-size: Theme.font-display;font-weight:600;}
            Text {text:root.target;color:Theme.text-muted;}
            HorizontalLayout {
                spacing:10px;
                LineEdit {text<=>root.query;placeholder-text:"Search sound files or script names";horizontal-stretch:1;edited=>{root.search();}}
                ComboBox {width:300px;model:root.groups;current-index<=>root.group-index;selected=>{root.group-changed();}}
            }
            HorizontalLayout {
                spacing:16px;vertical-stretch:1;
                VerticalLayout {
                    horizontal-stretch:1;spacing:10px;
                    ListView {
                        for row in root.rows:Rectangle {
                            height:58px;background:row.value==root.value ? Theme.control-strong : (touch.has-hover ? Theme.control-strong : Theme.hover);border-radius:5px;
                            VerticalLayout {
                                padding:8px;spacing:4px;
                                Text {text:row.name;color:Theme.text;overflow:elide;}
                                Text {text:row.detail;color:Theme.text-faint;font-size: Theme.font-small;overflow:elide;}
                            }
                            touch:=TouchArea {clicked=>{root.choose(row.value);}}
                        }
                    }
                    HorizontalLayout {
                        spacing:8px;
                        Button {text:"Previous";enabled:root.can-previous;clicked=>{root.page(-1);}}
                        Text {text:root.page-info;horizontal-alignment:center;vertical-alignment:center;horizontal-stretch:1;color:Theme.text-muted;}
                        Button {text:"Next";enabled:root.can-next;clicked=>{root.page(1);}}
                    }
                }
                ScrollView {
                    width:400px;
                    VerticalLayout {spacing:12px;
                    Text {text:root.value=="" ? "Select a sound to inspect it" : root.value;wrap:word-wrap;font-size: Theme.font-heading;}
                    Text {text:root.details;wrap:word-wrap;color:Theme.text-muted;}
                    if root.waves.length>0:VerticalLayout {
                        spacing:5px;
                        Text {text:root.waves.length>1 ? "Audition variant" : "Sound file";}
                        ComboBox {model:root.waves;current-index<=>root.variant;selected=>{root.variant-changed();}}
                    }
                    if root.script-info!="":Text {text:root.script-info;wrap:word-wrap;color:Theme.text-muted;}
                    Rectangle {vertical-stretch:1;}
                    Text {text:"Preview volume · \{round(root.volume)}%";}
                    Slider {minimum:0;maximum:100;value<=>root.volume;changed=>{root.volume-changed();}}
                    Text {text:"Applies to the next preview, separate from game volume.";font-size: Theme.font;wrap:word-wrap;color:Theme.text-faint;}
                    HorizontalLayout {
                        spacing:8px;
                        Button {text:"Play";enabled:root.can-apply;clicked=>{root.play();}}
                        Button {text:"Stop";enabled:root.can-stop;clicked=>{root.stop();}}
                    }
                    Text {text:root.playback;wrap:word-wrap;color:Theme.text-muted;min-height:30px;}
                    Text {text:"Up to 10 seconds · no game mixing or distance effects";font-size: Theme.font;wrap:word-wrap;color:Theme.text-faint;}
                    }
                }
            }
            HorizontalLayout {
                spacing:8px;
                LineEdit {text<=>root.value;placeholder-text:"Sound path or script name";horizontal-stretch:1;edited=>{root.invalidate();}accepted=>{root.inspect();}}
                Button {text:"Inspect sound";clicked=>{root.inspect();}}
            }
            Text {text:root.message;wrap:word-wrap;color:Theme.text-muted;min-height:32px;}
            HorizontalLayout {
                spacing:8px;
                Button {text:"Cancel";clicked=>{root.cancel();}}
                Button {text:"Reload sounds";clicked=>{root.reload();}}
                Rectangle {horizontal-stretch:1;}
                Button {text:"Use sound";enabled:root.can-apply;clicked=>{root.apply();}}
            }
        }
    }
}
