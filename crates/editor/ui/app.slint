import { Button, CheckBox, ComboBox, LineEdit, ListView, TextEdit } from "std-widgets.slint";

export struct EntityClassRow {
    classname: string,
    description: string,
}

export component EntityWindow inherits Window {
    title: root.brush-mode ? "Brush Entity - HammeRR" : "Place Entity - HammeRR";
    preferred-width: 900px;
    preferred-height: 700px;
    in property <bool> brush-mode;
    in property <[EntityClassRow]> classes;
    in property <string> definition;
    in property <string> message;
    in-out property <string> filter;
    in-out property <string> classname;
    in-out property <string> origin-x;
    in-out property <string> origin-y;
    in-out property <string> origin-z;
    callback filter-changed();
    callback class-selected();
    callback create();
    callback load-fgd();

    VerticalLayout {
        padding: 12px;
        spacing: 10px;
        HorizontalLayout {
            LineEdit {
                placeholder-text: "Search classes or descriptions";
                input-type: search;
                text <=> root.filter;
                edited => { root.filter-changed(); }
            }
            Button { text: "Load FGD…"; clicked => { root.load-fgd(); } }
        }
        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;
            ListView {
                width: 280px;
                for class in root.classes: VerticalLayout {
                    padding-bottom: 4px;
                    Button {
                        text: class.classname;
                        clicked => {
                            root.classname = class.classname;
                            root.class-selected();
                        }
                    }
                }
            }
            TextEdit { text: root.definition; read-only: true; wrap: word-wrap; }
        }
        LineEdit {
            placeholder-text: "Classname (custom classes are supported)";
            text <=> root.classname;
            edited => { root.class-selected(); }
        }
        if !root.brush-mode: HorizontalLayout {
            spacing: 6px;
            Text { text: "Position"; vertical-alignment: center; }
            LineEdit { text <=> root.origin-x; placeholder-text: "X"; }
            LineEdit { text <=> root.origin-y; placeholder-text: "Y"; }
            LineEdit { text <=> root.origin-z; placeholder-text: "Z"; }
        }
        Text { text: root.message; wrap: word-wrap; }
        Button {
            text: root.brush-mode ? "Tie selected brushes to entity" : "Place entity";
            enabled: root.classname != "";
            clicked => { root.create(); }
        }
    }
}

export struct EntityFlag {
    label: string,
    value: string,
    checked: bool,
}

export component GameLogWindow inherits Window {
    title: "CS:S Game Log - HammeRR";
    preferred-width: 900px;
    preferred-height: 600px;
    in property <string> content;
    VerticalLayout {
        padding: 12px;
        TextEdit {
            text: root.content;
            read-only: true;
            font-family: "monospace";
            wrap: no-wrap;
        }
    }
}

export struct KeyValue {
    key: string,
    value: string,
    label: string,
    description: string,
    type-name: string,
    read-only: bool,
    choices: [string],
    choice-values: [string],
    choice-index: int,
    flags: [EntityFlag],
}

export struct Activity {
    actor: string,
    text: string,
}

component StatusText inherits Text {
    color: #8a909c;
    vertical-alignment: center;
    font-size: 12px;
}

component SectionTitle inherits Text {
    color: #8a909c;
    font-size: 11px;
    font-weight: 600;
}

component ToolbarSeparator inherits Rectangle {
    width: 1px;
    background: #2c3038;
}

export component AppWindow inherits Window {
    title: root.map-title + " - HammeRR";
    preferred-width: 1600px;
    preferred-height: 960px;
    background: #111317;
    default-font-size: 13px;
    forward-focus: focus;

    in property <image> frame;
    in property <string> map-title: "untitled.vmf";
    in property <string> message;
    in property <string> stats;
    in property <string> camera;
    in property <string> mcp-status;
    in property <bool> flying;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <bool> compiling;
    in property <bool> launching;
    in property <bool> game-running;
    in property <bool> has-selection;
    in-out property <bool> show-tools: true;
    in-out property <bool> show-leak: true;
    in-out property <string> material: "dev/dev_measuregeneric01";

    in property <string> selection-title: "Nothing selected";
    in property <string> selection-detail;
    in property <bool> entity-selected;
    in property <bool> brush-entity-selected;
    in property <bool> can-tie;
    in property <[KeyValue]> entity-properties;
    in property <[Activity]> activity;

    out property <length> viewport-width: viewport.width;
    out property <length> viewport-height: viewport.height;

    callback new-map();
    callback open-map();
    callback save-map();
    callback compile-map();
    callback run-map();
    callback game-log();
    callback stop-game();
    callback undo();
    callback redo();
    callback create-block();
    callback delete-selection();
    callback apply-material();
    callback options-changed();
    callback property-edited(key: string, value: string);
    callback property-removed(key: string);
    callback flag-toggled(key: string, flag: string, checked: bool);
    callback place-entity();
    callback tie-entity();
    callback move-to-world();
    // Returns whether the key was handled.
    callback key(text: string, down: bool, control: bool, shift: bool) -> bool;
    // button: 0 = left, 1 = right, 2 = middle
    callback mouse-button(button: int, down: bool, x: length, y: length, control: bool);
    callback mouse-moved(x: length, y: length);
    callback wheel(delta: length);
    callback viewport-focus-lost();

    VerticalLayout {
        Rectangle {
            height: 44px;
            background: #1a1d23;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 8px;

                Button {
                    text: "New";
                    clicked => {
                        root.new-map();
                    }
                }

                Button {
                    text: "Open…";
                    clicked => {
                        root.open-map();
                    }
                }

                Button {
                    text: "Save";
                    clicked => {
                        root.save-map();
                    }
                }

                Button {
                    text: root.compiling ? "Compiling…" : "Compile";
                    enabled: !root.compiling && !root.launching;
                    clicked => { root.compile-map(); }
                }

                Button {
                    text: root.launching ? "Launching…" : "Run Map";
                    enabled: !root.compiling && !root.launching && !root.game-running;
                    clicked => { root.run-map(); }
                }

                Button {
                    text: "Game Log";
                    clicked => { root.game-log(); }
                }

                Button {
                    text: "Stop Map";
                    enabled: root.game-running;
                    clicked => { root.stop-game(); }
                }

                ToolbarSeparator { }

                Button {
                    text: "Undo";
                    enabled: root.can-undo;
                    clicked => {
                        root.undo();
                    }
                }

                Button {
                    text: "Redo";
                    enabled: root.can-redo;
                    clicked => {
                        root.redo();
                    }
                }

                ToolbarSeparator { }

                Button {
                    text: "Block";
                    clicked => {
                        root.create-block();
                    }
                }

                Button {
                    text: "Delete";
                    enabled: root.has-selection;
                    clicked => {
                        root.delete-selection();
                    }
                }

                ToolbarSeparator { }

                CheckBox {
                    text: "Tool textures";
                    checked <=> root.show-tools;
                    toggled => {
                        root.options-changed();
                    }
                }

                CheckBox {
                    text: "Leak path";
                    checked <=> root.show-leak;
                    toggled => { root.options-changed(); }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                Text {
                    text: root.mcp-status;
                    color: #6fbf73;
                    vertical-alignment: center;
                    font-size: 12px;
                }
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;

            viewport := Rectangle {
                horizontal-stretch: 1;
                background: #08090b;

                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.frame;
                    image-fit: fill;
                }

                focus := FocusScope {
                    key-pressed(event) => {
                        if (event.modifiers.control && event.text == "o") {
                            root.open-map();
                            return accept;
                        }
                        root.key(event.text, true, event.modifiers.control, event.modifiers.shift) ? EventResult.accept : EventResult.reject
                    }
                    key-released(event) => {
                        root.key(event.text, false, event.modifiers.control, event.modifiers.shift) ? EventResult.accept : EventResult.reject
                    }
                    focus-lost => {
                        root.viewport-focus-lost();
                    }

                    touch := TouchArea {
                        mouse-cursor: root.flying ? MouseCursor.move : MouseCursor.default;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                focus.focus();
                            }
                            if (event.kind == PointerEventKind.down || event.kind == PointerEventKind.up) {
                                root.mouse-button(
                                    event.button == PointerEventButton.left ? 0 : event.button == PointerEventButton.right ? 1 : 2,
                                    event.kind == PointerEventKind.down,
                                    self.mouse-x,
                                    self.mouse-y,
                                    event.modifiers.control);
                            }
                        }
                        moved => {
                            root.mouse-moved(self.mouse-x, self.mouse-y);
                        }
                        scroll-event(event) => {
                            root.wheel(event.delta-y);
                            accept
                        }
                    }
                }

                Rectangle {
                    x: 10px;
                    y: parent.height - self.height - 10px;
                    width: hint.preferred-width + 16px;
                    height: hint.preferred-height + 10px;
                    border-radius: 4px;
                    background: #000000a0;

                    hint := Text {
                        text: "Click select (Ctrl toggles) · hold right mouse to look · WASD/QE fly · arrows/PgUp/PgDn nudge · Del · Ctrl+Z/Y/S/D";
                        color: #c8ccd4;
                        font-size: 12px;
                    }
                }
            }

            Rectangle {
                width: 340px;
                background: #16181d;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    SectionTitle {
                        text: "SELECTION";
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        Button { text: "Entity…"; clicked => { root.place-entity(); } }
                        Button { text: "Tie to entity…"; enabled: root.can-tie; clicked => { root.tie-entity(); } }
                    }

                    if root.brush-entity-selected: Button {
                        text: "Move to world";
                        clicked => { root.move-to-world(); }
                    }

                    Text {
                        text: root.selection-title;
                        color: #e6e8ec;
                        font-size: 15px;
                        wrap: word-wrap;
                    }

                    if root.selection-detail != "": Text {
                        text: root.selection-detail;
                        color: #8a909c;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    if root.entity-selected: ListView {
                        min-height: 120px;
                        vertical-stretch: 1;

                        for row in root.entity-properties: VerticalLayout {
                            spacing: 3px;
                            padding-bottom: 8px;
                            Text {
                                text: row.label + " · " + row.key + " (" + row.type-name + ")";
                                color: #aab0bb;
                                font-size: 11px;
                                overflow: elide;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                if row.choices.length > 0: ComboBox {
                                    horizontal-stretch: 1;
                                    model: row.choices;
                                    current-index: row.choice-index;
                                    enabled: !row.read-only;
                                    selected => { root.property-edited(row.key, row.choice-values[self.current-index]); }
                                }
                                if row.choices.length == 0: LineEdit {
                                    horizontal-stretch: 1;
                                    text: row.value;
                                    enabled: !row.read-only;
                                    input-type: row.type-name == "integer" || row.type-name == "float" || row.type-name == "angle" ? InputType.decimal : InputType.text;
                                    accepted(text) => { root.property-edited(row.key, text); }
                                }
                                Button {
                                    text: "×";
                                    width: 28px;
                                    enabled: row.key != "classname" && !row.read-only;
                                    clicked => { root.property-removed(row.key); }
                                }
                            }
                            for flag in row.flags: CheckBox {
                                text: flag.label;
                                checked: flag.checked;
                                enabled: !row.read-only;
                                toggled => { root.flag-toggled(row.key, flag.value, self.checked); }
                            }
                            if row.description != "": Text {
                                text: row.description;
                                color: #8a909c;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    if root.entity-selected: HorizontalLayout {
                        spacing: 6px;

                        new-key := LineEdit {
                            width: 110px;
                            placeholder-text: "key";
                        }

                        new-value := LineEdit {
                            horizontal-stretch: 1;
                            placeholder-text: "value";
                            accepted(text) => {
                                root.property-edited(new-key.text, text);
                                new-key.text = "";
                                self.text = "";
                            }
                        }
                    }

                    if !root.entity-selected: Rectangle {
                        vertical-stretch: 1;
                    }

                    SectionTitle {
                        text: "MATERIAL";
                    }

                    HorizontalLayout {
                        spacing: 6px;

                        LineEdit {
                            horizontal-stretch: 1;
                            text <=> root.material;
                            accepted => {
                                root.apply-material();
                            }
                        }

                        Button {
                            text: "Apply";
                            enabled: root.has-selection;
                            clicked => {
                                root.apply-material();
                            }
                        }
                    }

                    SectionTitle {
                        text: "ACTIVITY";
                    }

                    ListView {
                        height: 200px;

                        for entry in root.activity: HorizontalLayout {
                            spacing: 6px;
                            padding-bottom: 2px;

                            Text {
                                width: 40px;
                                text: entry.actor;
                                color: entry.actor == "agent" ? #6fbf73 : #6c9bd2;
                                font-size: 12px;
                            }

                            Text {
                                horizontal-stretch: 1;
                                text: entry.text;
                                color: #c8ccd4;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 26px;
            background: #1a1d23;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 20px;

                StatusText {
                    text: root.message;
                    color: #c8ccd4;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                StatusText {
                    text: root.stats;
                }

                StatusText {
                    text: root.camera;
                    font-family: "monospace";
                }
            }
        }
    }
}
