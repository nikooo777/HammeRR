import { Button, CheckBox, ComboBox, LineEdit, ListView, ScrollView, Slider, SpinBox, TextEdit } from "widgets.slint";

export struct EntityClassRow {
    classname: string,
    description: string,
}

export struct ConnectionRow {
    source: string,
    index: int,
    label: string,
    detail: string,
    warning: string,
}

component ConnectionField inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <[string]> suggestions;
    in property <string> help;
    in-out property <string> value;
    callback changed();
    spacing: 4px;
    Text { text: root.label; font-weight: 600; }
    HorizontalLayout {
        spacing: 6px;
        LineEdit {
            horizontal-stretch: 1;
            text <=> root.value;
            placeholder-text: root.placeholder;
            accessible-label: root.label;
            edited => { root.changed(); }
        }
        if root.suggestions.length > 1: ComboBox {
            width: 170px;
            model: root.suggestions;
            current-index: 0;
            accessible-label: root.label + " suggestions";
            selected(value) => { if self.current-index > 0 { root.value = value; root.changed(); } }
        }
    }
    if root.help != "": Text { text: root.help; wrap: word-wrap; font-size: Theme.font; }
}

export component ConnectionWindow inherits Window {
    background: Theme.panel;
    title: "Entity Connections - HammeRR";
    preferred-width: 1040px;
    preferred-height: 820px;
    in-out property <string> source-id;
    in property <string> source-label;
    in property <string> generation;
    in property <string> revision;
    in property <string> draft-token;
    in property <[ConnectionRow]> outgoing;
    in property <[ConnectionRow]> incoming;
    in property <bool> editing;
    in property <bool> can-apply;
    in property <string> message;
    in property <string> warnings;
    in property <[string]> outputs;
    in property <[string]> targets;
    in property <[string]> inputs;
    in property <string> output-help;
    in property <string> target-help;
    in property <string> input-help;
    in-out property <string> output;
    in-out property <string> target;
    in-out property <string> input;
    in-out property <string> parameter;
    in-out property <string> delay;
    in-out property <string> times;
    in-out property <string> target-filter;
    in-out property <int> firing-mode;
    in-out property <int> direction;
    callback choose(source: string, index: int);
    callback delete-connection(index: int);
    callback add();
    callback fields-changed();
    callback filter-changed();
    callback apply();
    callback cancel();
    forward-focus: dialog-focus;
    dialog-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); accept } else { reject }
        }
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            Text { text: root.source-label; font-size: Theme.font-display; font-weight: 600; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 18px;
                vertical-stretch: 1;
                VerticalLayout {
                    width: 450px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        ComboBox { model: ["Outgoing", "Incoming"]; current-index <=> root.direction; }
                        Button { text: "Add connection"; clicked => { root.add(); } }
                    }
                    ListView {
                        vertical-stretch: 1;
                        for row in (root.direction == 0 ? root.outgoing : root.incoming): VerticalLayout {
                            padding-bottom: 12px;
                            spacing: 4px;
                            Text { text: row.label; wrap: word-wrap; font-weight: 600; }
                            Text { text: row.detail; wrap: word-wrap; font-size: Theme.font; }
                            if row.warning != "": Text { text: row.warning; wrap: word-wrap; color: Theme.warning; font-size: Theme.font; }
                            HorizontalLayout {
                                spacing: 8px;
                                Button {
                                    text: root.direction == 0 ? "Edit connection" : "Edit source connection";
                                    clicked => { root.choose(row.source, row.index); }
                                }
                                if root.direction == 0: Button {
                                    text: "Delete connection";
                                    clicked => { root.delete-connection(row.index); }
                                }
                            }
                        }
                    }
                    Text {
                        text: root.direction == 0 ? root.outgoing.length + " outgoing connections" : root.incoming.length + " incoming connections · choose one to edit its source";
                        wrap: word-wrap;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 10px;
                    if !root.editing: Text { text: "Choose a connection to edit, or add a new one."; wrap: word-wrap; }
                    if root.editing: VerticalLayout {
                        spacing: 10px;
                        ConnectionField {
                            label: "When this output fires";
                            value <=> root.output;
                            suggestions: root.outputs;
                            help: root.output-help;
                            placeholder: "Output name";
                            changed => { root.fields-changed(); }
                        }
                        LineEdit {
                            text <=> root.target-filter;
                            placeholder-text: "Search map targets by name, class or ID";
                            input-type: search;
                            edited => { root.filter-changed(); }
                        }
                        ConnectionField {
                            label: "Send to";
                            value <=> root.target;
                            suggestions: root.targets;
                            help: root.target-help;
                            placeholder: "Target name, prefix* or !self";
                            changed => { root.fields-changed(); }
                        }
                        ConnectionField {
                            label: "Run this input";
                            value <=> root.input;
                            suggestions: root.inputs;
                            help: root.input-help;
                            placeholder: "Input name";
                            changed => { root.fields-changed(); }
                        }
                        ConnectionField {
                            label: "With parameter";
                            value <=> root.parameter;
                            placeholder: "Empty uses the output's value";
                            changed => { root.fields-changed(); }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Delay (seconds)"; vertical-alignment: center; }
                            LineEdit {
                                text <=> root.delay;
                                input-type: decimal;
                                accessible-label: "Delay in seconds";
                                edited => { root.fields-changed(); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Fire"; vertical-alignment: center; }
                            ComboBox {
                                model: ["Unlimited", "Once", "Specific count"];
                                current-index <=> root.firing-mode;
                                selected => {
                                    root.times = root.firing-mode == 0 ? "-1" : root.firing-mode == 1 ? "1" : "2";
                                    root.fields-changed();
                                }
                            }
                            if root.firing-mode == 2: LineEdit {
                                text <=> root.times;
                                input-type: number;
                                accessible-label: "Firing count";
                                edited => { root.fields-changed(); }
                            }
                        }
                    }
                    Text { text: root.message; wrap: word-wrap; color: root.can-apply ? Theme.success : Theme.warning; }
                    if root.warnings != "": TextEdit { text: root.warnings; read-only: true; wrap: word-wrap; vertical-stretch: 1; }
                    Rectangle { vertical-stretch: 1; }
                }
            }
            HorizontalLayout {
                spacing: 12px;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
                Button { text: "Apply connection"; enabled: root.editing && root.can-apply; clicked => { root.apply(); } }
            }
        }
    }
}

export struct RenameRow {
    section: string,
    section-note: string,
    label: string,
    change: string,
    reason: string,
    review: bool,
    changed: bool,
    details: string,
}

component RenameReference inherits VerticalLayout {
    in property <RenameRow> entry;
    in property <bool> show-details;
    padding-bottom: 16px;
    spacing: 4px;
    Text { text: root.entry.label; wrap: word-wrap; font-weight: 600; }
    Text { text: root.entry.change; wrap: word-wrap; }
    Text { text: root.entry.reason; wrap: word-wrap; color: root.entry.review ? Theme.warning : Theme.text-faint; font-size: Theme.font; }
    if root.show-details: Text { text: root.entry.details; wrap: word-wrap; font-size: Theme.font-small; color: Theme.text-faint; }
}

export component RenameWindow inherits Window {
    background: Theme.panel;
    title: "Entity References and Rename - HammeRR";
    preferred-width: 920px;
    preferred-height: 740px;
    in property <string> entity-label;
    in property <string> old-name;
    in property <string> draft-token;
    in property <[RenameRow]> references;
    in property <[RenameRow]> changes;
    in property <[RenameRow]> attention;
    in property <[RenameRow]> other;
    in property <string> summary;
    in property <string> members;
    in property <string> message;
    in property <bool> can-apply;
    in property <bool> requires-review;
    in property <bool> has-proposal;
    in property <int> shared-count;
    in-out property <string> new-name;
    in-out property <bool> rename-group;
    in-out property <bool> accept-review;
    in-out property <bool> show-details;
    callback fields-changed();
    callback apply();
    callback cancel();
    forward-focus: rename-focus;
    rename-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); accept } else { reject }
        }
        VerticalLayout {
            padding: Theme.space-xl;
            spacing: 12px;
            Text { text: root.has-proposal ? "Rename entity" : "Entity references"; font-size: Theme.font-display; font-weight: 600; }
            Text { text: root.entity-label; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    Text { text: "Current name"; font-weight: 600; }
                    Text { text: root.old-name == "" ? "Unnamed" : root.old-name; wrap: word-wrap; accessible-label: "Current entity name"; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    Text { text: "New name"; font-weight: 600; }
                    LineEdit {
                        text <=> root.new-name;
                        accessible-label: "New entity name";
                        placeholder-text: "Choose an unused entity name";
                        edited => { root.fields-changed(); }
                    }
                }
            }
            if root.shared-count > 1: CheckBox {
                text: "Rename all " + root.shared-count + " entities named “" + root.old-name + "”";
                checked <=> root.rename-group;
                toggled => { root.fields-changed(); }
            }
            Text { text: root.summary; wrap: word-wrap; font-weight: 600; accessible-label: "Rename summary"; }
            if root.rename-group: Text { text: root.members; wrap: word-wrap; font-size: Theme.font; color: Theme.text-faint; }
            if root.references.length == 0: Text { text: root.has-proposal ? "No linked fields need updating." : "No references found."; wrap: word-wrap; }
            ListView {
                vertical-stretch: 1;
                for row in root.references: VerticalLayout {
                    spacing: 8px;
                    if row.section != "": Text {
                        text: row.section;
                        font-size: Theme.font-heading;
                        font-weight: 600;
                        color: row.review ? Theme.warning : Theme.text;
                    }
                    if row.section-note != "": Text { text: row.section-note; wrap: word-wrap; font-size: Theme.font; }
                    RenameReference { entry: row; show-details: root.show-details; }
                }
            }
            if root.requires-review: CheckBox {
                text: "I’ve reviewed these effects; leave these fields unchanged";
                checked <=> root.accept-review;
                toggled => { root.fields-changed(); }
            }
            CheckBox {
                text: "Show engine details";
                checked <=> root.show-details;
                toggled => { root.fields-changed(); }
            }
            Text { text: root.message; wrap: word-wrap; color: root.can-apply ? Theme.success : Theme.warning; }
            HorizontalLayout {
                spacing: 12px;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
                Rectangle { horizontal-stretch: 1; }
                Button { text: "Apply rename"; enabled: root.can-apply; clicked => { root.apply(); } }
            }
        }
    }
}

export component EntityWindow inherits Window {
    background: Theme.panel;
    title: root.brush-mode ? "Brush Entity - HammeRR" : "Place Entity - HammeRR";
    preferred-width: 900px;
    preferred-height: 700px;
    in property <bool> brush-mode;
    in property <[EntityClassRow]> classes;
    in property <string> definition;
    in property <string> catalog-status;
    in property <string> message;
    in-out property <string> filter;
    in-out property <string> classname;
    in-out property <string> origin-x;
    in-out property <string> origin-y;
    in-out property <string> origin-z;
    callback filter-changed();
    callback class-selected();
    callback pick-surface();
    callback create();
    callback load-fgd();
    callback cancel();

    forward-focus: dialog-focus;
    dialog-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); accept } else { reject }
        }
        VerticalLayout {
            padding: 12px;
            spacing: 10px;
            HorizontalLayout {
                LineEdit {
                    placeholder-text: "Search classes or descriptions";
                    input-type: search;
                    text <=> root.filter;
                    edited => { root.filter-changed(); }
                }
                Button { text: "Load FGD…"; clicked => { root.load-fgd(); } }
            }
            Text { text: root.catalog-status; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 12px;
                vertical-stretch: 1;
                ListView {
                    width: 280px;
                    for class in root.classes: VerticalLayout {
                        padding-bottom: 4px;
                        Button {
                            text: class.classname;
                            clicked => {
                                root.classname = class.classname;
                                root.class-selected();
                            }
                        }
                    }
                }
                TextEdit { text: root.definition; read-only: true; wrap: word-wrap; }
            }
            LineEdit {
                placeholder-text: "Classname (custom classes are supported)";
                text <=> root.classname;
                edited => { root.class-selected(); }
            }
            if !root.brush-mode: HorizontalLayout {
                spacing: 6px;
                Text { text: "Position"; vertical-alignment: center; }
                LineEdit { text <=> root.origin-x; placeholder-text: "X"; }
                LineEdit { text <=> root.origin-y; placeholder-text: "Y"; }
                LineEdit { text <=> root.origin-z; placeholder-text: "Z"; }
            }
            Text { text: root.message; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 10px;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
                if !root.brush-mode: Button {
                    text: "Pick surface…";
                    enabled: root.classname != "";
                    clicked => { root.pick-surface(); }
                }
                Button {
                    text: root.brush-mode ? "Tie selected brushes to entity" : "Place entity";
                    enabled: root.classname != "";
                    clicked => { root.create(); }
                }
            }
        }
    }
}

export struct EntityFlag {
    label: string,
    value: string,
    checked: bool,
}

export component GameLogWindow inherits Window {
    background: Theme.panel;
    title: "CS:S Game Log - HammeRR";
    preferred-width: 900px;
    preferred-height: 600px;
    in property <string> content;
    callback cancel();
    forward-focus: dialog-focus;
    dialog-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); accept } else { reject }
        }
        VerticalLayout {
            padding: 12px;
            TextEdit {
                text: root.content;
                read-only: true;
                font-family: "monospace";
                wrap: no-wrap;
            }
            Button { text: "Close"; clicked => { root.cancel(); } }
        }
    }
}

export struct KeyValue {
    key: string,
    value: string,
    label: string,
    description: string,
    type-name: string,
    numeric: bool,
    read-only: bool,
    choices: [string],
    choice-values: [string],
    choice-index: int,
    flags: [EntityFlag],
    control: string,
    advanced: bool,
    components: [string],
    component-labels: [string],
    swatch: color,
    has-intensity: bool,
    intensity: string,
    intensity-value: float,
    number-value: float,
    minimum: float,
    maximum: float,
}

export component ColorWindow inherits Window {
    background: Theme.panel;
    title: "Choose Color - HammeRR";
    preferred-width: 680px;
    preferred-height: 900px;
    in property <string> field-label;
    in-out property <int> red;
    in-out property <int> green;
    in-out property <int> blue;
    in property <bool> has-intensity;
    in-out property <string> intensity;
    in-out property <float> brightness;
    in property <string> message;
    in-out property <int> model-index;
    in-out property <int> component-model;
    in-out property <string> color-source;
    in-out property <string> component-source;
    in property <bool> normalized;
    in-out property <string> hue;
    in-out property <string> saturation;
    in-out property <string> level;
    in-out property <float> hue-value;
    in-out property <float> saturation-value;
    in-out property <float> level-value;
    in property <[string]> palette-names;
    in-out property <int> palette-index;
    in-out property <string> palette-name;
    in-out property <string> palette-snapshot;
    in property <bool> palette-ready;
    in property <bool> palette-reload-available;
    in property <string> palette-status;
    callback palette-choice();
    callback palette-action(string);
    callback select-model(int);
    callback rgb-changed();
    callback preset(int, int, int);
    callback components-changed();
    callback apply();
    callback cancel();
    forward-focus: dialog-focus;
    dialog-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); accept } else { reject }
        }
        VerticalLayout {
            padding: Theme.space-xl;
            spacing: 12px;
            alignment: start;
            Text { text: root.field-label; font-size: Theme.font-heading; }
            Rectangle { height: 70px; background: rgb(root.red, root.green, root.blue); border-radius: 6px; }
            HorizontalLayout {
                spacing: 8px;
                for preset in [#ffd296, #ffffff, #8cbeff, #ff7070, #8aff9c, #000000]: Rectangle {
                    height: 30px;
                    background: preset;
                    border-radius: 4px;
                    TouchArea { clicked => { root.preset(preset.red, preset.green, preset.blue); } }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                Text { text: "Color model"; vertical-alignment: center; }
                ComboBox { accessible-label: "Color model"; model: ["RGB", "HSV", "HSL"]; current-index <=> root.model-index; selected => { root.select-model(root.model-index); } }
            }
            if root.normalized: Text { text: "Stored as normalized RGB (0–1). RGB controls use 0–255."; wrap: word-wrap; }
            if root.model-index == 0: VerticalLayout {
                spacing: 12px;
                HorizontalLayout {
                    spacing: 10px;
                    Text { width: 45px; text: "Red"; vertical-alignment: center; }
                    Slider { minimum: 0; maximum: 255; value: root.red; changed(value) => { root.red = round(value); root.rgb-changed(); } }
                    SpinBox { width: 90px; minimum: 0; maximum: 255; value <=> root.red; edited => { root.rgb-changed(); } }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text { width: 45px; text: "Green"; vertical-alignment: center; }
                    Slider { minimum: 0; maximum: 255; value: root.green; changed(value) => { root.green = round(value); root.rgb-changed(); } }
                    SpinBox { width: 90px; minimum: 0; maximum: 255; value <=> root.green; edited => { root.rgb-changed(); } }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text { width: 45px; text: "Blue"; vertical-alignment: center; }
                    Slider { minimum: 0; maximum: 255; value: root.blue; changed(value) => { root.blue = round(value); root.rgb-changed(); } }
                    SpinBox { width: 90px; minimum: 0; maximum: 255; value <=> root.blue; edited => { root.rgb-changed(); } }
                }
            }
            if root.model-index > 0: VerticalLayout {
                spacing: 12px;
                HorizontalLayout {
                    spacing: 10px;
                    Text { width: 110px; text: "Hue (degrees)"; vertical-alignment: center; }
                    Slider { minimum: 0; maximum: 360; value: root.hue-value; changed(value) => { root.hue = "\{value}"; root.components-changed(); } }
                    LineEdit { width: 110px; text <=> root.hue; input-type: decimal; accessible-label: "Hue in degrees"; edited => { root.components-changed(); } }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text { width: 110px; text: "Saturation (%)"; vertical-alignment: center; }
                    Slider { minimum: 0; maximum: 100; value: root.saturation-value; changed(value) => { root.saturation = "\{value}"; root.components-changed(); } }
                    LineEdit { width: 110px; text <=> root.saturation; input-type: decimal; accessible-label: "Saturation in percent"; edited => { root.components-changed(); } }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text { width: 110px; text: root.model-index == 1 ? "Value (%)" : "Lightness (%)"; vertical-alignment: center; }
                    Slider { minimum: 0; maximum: 100; value: root.level-value; changed(value) => { root.level = "\{value}"; root.components-changed(); } }
                    LineEdit { width: 110px; text <=> root.level; input-type: decimal; accessible-label: root.model-index == 1 ? "Value in percent" : "Lightness in percent"; edited => { root.components-changed(); } }
                }
                Text { text: "Hue 360° equals 0°. Achromatic conversions use hue 0°."; wrap: word-wrap; }
            }
            if root.has-intensity: VerticalLayout {
                spacing: 6px;
                Text { text: "Brightness"; }
                HorizontalLayout {
                    spacing: 10px;
                    Slider { minimum: 0; maximum: max(1000, root.brightness); value: root.brightness; released(value) => { root.brightness = value; root.intensity = "\{value}"; } }
                    LineEdit { width: 100px; text <=> root.intensity; input-type: decimal; }
                }
            }
            VerticalLayout {
                spacing: 8px;
                Text { text: "Saved colors"; font-weight: 600; }
                HorizontalLayout {
                    spacing: 8px;
                    ComboBox {
                        accessible-label: "Saved colors";
                        model: root.palette-names;
                        current-index <=> root.palette-index;
                        selected => { root.palette-choice(); }
                    }
                    Button { text: "Use saved color"; enabled: root.palette-ready && root.palette-index > 0; clicked => { root.palette-action("use"); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit { accessible-label: "Saved color name"; text <=> root.palette-name; placeholder-text: "Name for a new saved color"; }
                    Button { text: "Rename saved color"; enabled: root.palette-ready && root.palette-index > 0; clicked => { root.palette-action("rename"); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button { text: "Save new color"; enabled: root.palette-ready; clicked => { root.palette-action("save"); } }
                    Button { text: "Replace saved color"; enabled: root.palette-ready && root.palette-index > 0; clicked => { root.palette-action("replace"); } }
                    Button { text: "Delete saved color"; enabled: root.palette-ready && root.palette-index > 0; clicked => { root.palette-action("delete"); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button { text: "Reload palette"; enabled: root.palette-reload-available; clicked => { root.palette-action("reload"); } }
                    Text { text: "16 named colors · brightness stays unchanged"; vertical-alignment: center; wrap: word-wrap; }
                }
                ScrollView { height: 64px; Text { text: root.palette-status; wrap: word-wrap; color: root.palette-ready ? Theme.text-muted : Theme.warning; } }
            }
            Text { text: root.message; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 10px;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
                Button { text: "Apply color"; clicked => { root.apply(); } }
            }
        }
    }
}

export struct MaterialGroup { id: string, label: string }
export struct MaterialTile { name: string, preview: image, favorite: bool, source: string }
export struct MaterialTileRow { tiles: [MaterialTile] }

export component MaterialWindow inherits Window {
    background: Theme.panel;
    in property <bool> sprite-resource;
    title: "Choose Material - HammeRR";
    preferred-width: 1180px;
    preferred-height: 760px;
    in-out property <string> filter;
    in-out property <string> material;
    in-out property <string> group: "all";
    in-out property <int> offset;
    in property <[MaterialGroup]> groups;
    in property <[string]> source-labels;
    in property <[string]> source-ids;
    in-out property <int> source-index;
    in-out property <bool> exclude-generated-map-materials;
    in property <[MaterialTileRow]> rows;
    in property <int> total;
    in property <string> catalog-label;
    in property <string> favorites-status;
    in property <bool> favorites-reload-available;
    in property <string> favorites-revision;
    in property <string> reload-status;
    in-out property <string> asset-generation;
    in property <bool> favorite;
    in property <image> preview;
    in-out property <int> preview-channel;
    in property <string> detail;
    in property <bool> available;
    callback search();
    callback preview-material();
    callback use-material();
    callback toggle-favorite();
    callback reload-favorites();
    callback reload-material-assets();
    callback inspect-source();
    callback cancel();
    forward-focus: dialog-focus;
    dialog-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); accept } else { reject }
        }
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            LineEdit { placeholder-text: "Search materials across folders and categories"; text <=> root.filter; edited => { root.offset = 0; root.search(); } }
            HorizontalLayout {
                spacing: 12px;
                Text { text: "Winning VMT source"; vertical-alignment: center; }
                ComboBox { horizontal-stretch: 1; model: root.source-labels; current-index <=> root.source-index; selected => { root.offset = 0; root.search(); } }
                CheckBox { text: "Exclude maps/ materials"; checked <=> root.exclude-generated-map-materials; toggled => { root.offset = 0; root.search(); } }
            }
            HorizontalLayout {
                spacing: 16px;
                vertical-stretch: 1;
                ListView {
                    width: 210px;
                    for group in root.groups: Button {
                        text: group.label;
                        enabled: root.group != group.id;
                        clicked => { root.group = group.id; root.offset = 0; root.search(); }
                    }
                }
                VerticalLayout {
                    spacing: 8px;
                    Text { text: root.catalog-label; }
                    ListView {
                        vertical-stretch: 1;
                        for row in root.rows: HorizontalLayout {
                            spacing: 8px;
                            padding-bottom: 8px;
                            for tile in row.tiles: Rectangle {
                                width: 165px;
                                height: 188px;
                                background: root.material == tile.name ? Theme.selection : Theme.control-strong;
                                border-radius: 6px;
                                accessible-role: button;
                                accessible-label: tile.name;
                                accessible-action-default => { root.material = tile.name; root.preview-material(); }
                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 6px;
                                    Image { height: 110px; source: tile.preview; image-fit: contain; }
                                    Text { text: (tile.favorite ? "★ " : "") + tile.name; wrap: word-wrap; font-size: Theme.font-small; }
                                    Text { text: tile.source; overflow: elide; font-size: 10px; color: Theme.text-muted; }
                                }
                                TouchArea { clicked => { root.material = tile.name; root.preview-material(); } }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: "Previous"; enabled: root.offset > 0; clicked => { root.offset = max(0, root.offset - 36); root.search(); } }
                        Button { text: "Next"; enabled: root.offset + 36 < root.total; clicked => { root.offset += 36; root.search(); } }
                    }
                }
                VerticalLayout {
                    width: 230px;
                    spacing: 10px;
                    Rectangle {
                        height: 220px;
                        background: Theme.control-strong;
                        preview-image := Image { width: parent.width; height: parent.height; source: root.preview; image-fit: contain; }
                        if !root.available: Text { text: "No texture preview"; horizontal-alignment: center; vertical-alignment: center; color: Theme.text-muted; }
                    }
                    HorizontalLayout {
                        Button { text: "Color"; enabled: root.preview-channel != 0; clicked => { root.preview-channel = 0; root.preview-material(); } }
                        Button { text: "Alpha"; enabled: root.preview-channel != 1; clicked => { root.preview-channel = 1; root.preview-material(); } }
                    }
                    details-scroll := ScrollView {
                        vertical-stretch: 1;
                        content-width: self.visible-width;
                        Text {
                            width: details-scroll.visible-width - 16px;
                            text: root.detail;
                            wrap: word-wrap;
                        }
                    }
                    Button { text: "Source…"; enabled: root.material != ""; clicked => { root.inspect-source(); } }
                    Button { text: root.favorite ? "Remove favorite" : "Add favorite"; enabled: root.material != ""; clicked => { root.toggle-favorite(); } }
                    Button { text: "Reload favorites"; enabled: root.favorites-reload-available; clicked => { root.reload-favorites(); } }
                    favorites-state := Text { text: root.favorites-status; wrap: word-wrap; font-size: Theme.font-small; }
                }
            }
            if root.reload-status != "": ScrollView {
                height: 70px;
                Text { text: root.reload-status; wrap: word-wrap; vertical-alignment: top; }
            }
            LineEdit { text <=> root.material; placeholder-text: "Material path"; accepted => { root.preview-material(); } }
            HorizontalLayout {
                spacing: 10px;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
                Button { text: "Reload material assets"; clicked => { root.reload-material-assets(); } }
                Button { text: "Use material"; enabled: root.material != ""; clicked => { root.use-material(); } }
            }
        }
    }
}

export component TerrainWindow inherits Window {
    background: Theme.panel;
    title: "Edit terrain";
    preferred-width: 520px;
    out property <length> operation-height: root.operation-index == 11 ? 470px : root.operation-index == 8 ? 540px : root.operation-index == 10 ? 480px : root.operation-index == 6 || root.operation-index == 7 ? 470px : root.operation-index == 0 || root.operation-index >= 6 ? 380px : 760px;
    preferred-height: root.operation-height;
    in property <string> selection-label;
    in property <string> message;
    in property <bool> stale;
    in property <bool> ready;
    in property <bool> mask-available;
    in property <string> mask-label;
    in-out property <bool> use-mask;
    in-out property <int> grid-index;
    in-out property <int> operation-index;
    in-out property <int> direction-index;
    in property <string> physics-current;
    in property <string> player-current;
    in property <string> ray-current;
    in-out property <int> physics-index;
    in-out property <int> player-index;
    in-out property <int> ray-index;
    in-out property <bool> sew-blend;
    in property <string> smoothing-current;
    in-out property <int> smoothing-index;
    in-out property <string> smoothing-angle: "45";
    in-out property <float> smoothing-slider: 45;
    in-out property <string> center-x: "0";
    in-out property <string> center-y: "0";
    in-out property <string> center-z: "0";
    in-out property <string> radius: "128";
    in-out property <string> amount: "16";
    in-out property <string> strength: "0.5";
    in-out property <string> blend-value: "128";
    in-out property <string> seed: "1";
    in-out property <string> vertex-x: "0";
    in-out property <string> vertex-y: "0";
    in-out property <string> vertex-z: "0";
    in-out property <float> radius-slider: 128;
    in-out property <float> amount-slider: 16;
    in-out property <float> strength-slider: 0.5;
    in-out property <float> blend-slider: 128;
    callback edited();
    callback preview-edit();
    callback apply();
    callback cancel();
    callback pick-center();
    callback draw-stroke();
    callback move-handles();
    forward-focus: dialog-focus;
    dialog-focus := FocusScope {
        key-pressed(event) => { if event.text == Key.Escape {root.cancel(); accept} else {reject} }
        VerticalLayout {
            padding: Theme.space-xl;
            spacing: 14px;
            Text {text: root.selection-label; font-size: Theme.font-heading; wrap: word-wrap;}
            Text {text: "Operation";}
            ComboBox {model:["Grid resolution", "Raise / lower", "Flatten", "Smooth", "Noise", "Paint blend", "Fill blend", "Invert blend", "Collision", "Sew borders & corners", "Border smoothing", "Move selected vertices", "Subdivide base cage"]; current-index <=> root.operation-index; enabled: !root.stale; selected => {root.edited();}}
            if root.operation-index == 11: VerticalLayout {
                spacing:8px;
                Text {text:root.mask-label;wrap:word-wrap;color:Theme.text-muted;}
                Text {text:"World offset · units";}
                HorizontalLayout {
                    spacing:8px;
                    Text {text:"X";vertical-alignment:center;}
                    LineEdit {preferred-width:100px;min-width:0px;horizontal-stretch:1;text <=> root.vertex-x;enabled:root.mask-available && !root.stale;edited=>{root.edited();}}
                    Text {text:"Y";vertical-alignment:center;}
                    LineEdit {preferred-width:100px;min-width:0px;horizontal-stretch:1;text <=> root.vertex-y;enabled:root.mask-available && !root.stale;edited=>{root.edited();}}
                    Text {text:"Z";vertical-alignment:center;}
                    LineEdit {preferred-width:100px;min-width:0px;horizontal-stretch:1;text <=> root.vertex-z;enabled:root.mask-available && !root.stale;edited=>{root.edited();}}
                }
                Text {text:"Moves only the retained vertex selection by exact world coordinates. X/Y reshape the terrain sideways; Z changes height. Each offset can be −4096 to 4096 units. Neighboring triangles follow their shared vertices.";wrap:word-wrap;color:Theme.text-muted;}
                Button {text:"Move with handles…";enabled:root.mask-available && !root.stale;clicked=>{root.move-handles();}}
                Text {text:"Drag an axis or plane, then review with Apply or Cancel. Handles follow the editor's grid snapping.";wrap:word-wrap;color:Theme.text-muted;font-size: Theme.font;}
            }
            if root.operation-index >= 1 && root.operation-index <= 7: VerticalLayout {
                spacing: 4px;
                CheckBox {text:"Affect only selected terrain vertices";checked <=> root.use-mask;enabled:root.mask-available && !root.stale;toggled=>{root.edited();}}
                Text {text:root.mask-label;wrap:word-wrap;color:Theme.text-faint;font-size: Theme.font;}
            }
            if root.operation-index == 0: VerticalLayout {
                spacing: 12px;
                Text {text: "Grid resolution";}
                ComboBox {model: ["5 × 5 · power 2", "9 × 9 · power 3", "17 × 17 · power 4"]; current-index <=> root.grid-index; enabled: !root.stale; selected => {root.edited();}}
                Text {text: "Finer grids keep existing height and blend samples. Coarser grids can lose detail. Start corner, materials and mapping stay fixed."; wrap: word-wrap; color: Theme.text-muted;}
            }
            if root.operation-index >= 1 && root.operation-index <= 5: VerticalLayout {
                spacing: 8px;
                Text {text: "Brush center · world coordinates";}
                HorizontalLayout {
                    spacing: 8px;
                    Text {text: "X"; vertical-alignment: center;} LineEdit {text <=> root.center-x; edited => {root.edited();}}
                    Text {text: "Y"; vertical-alignment: center;} LineEdit {text <=> root.center-y; edited => {root.edited();}}
                    Text {text: "Z"; vertical-alignment: center;} LineEdit {text <=> root.center-z; edited => {root.edited();}}
                }
                Button {text:"Pick center in viewport…"; enabled:!root.stale; clicked=>{root.pick-center();}}
                Text {text: "Brush direction";}
                ComboBox {model:["Up / down · world Z", "Along the face normal"]; current-index <=> root.direction-index; selected => {root.edited();}}
                Text {text: "Radius · world units";}
                HorizontalLayout {
                    spacing: 12px;
                    Slider {minimum:1; maximum:max(512,root.radius-slider); value:root.radius-slider; released(value)=>{root.radius="\{value}";root.edited();}}
                    LineEdit {preferred-width:90px; horizontal-stretch:0; text <=> root.radius; edited=>{root.edited();}}
                }
            }
            if root.operation-index == 1 || root.operation-index == 4: VerticalLayout {
                spacing: 8px;
                Text {text:root.operation-index == 1 ? "Height change · negative lowers" : "Noise amount · world units";}
                HorizontalLayout {
                    spacing:12px;
                    Slider {minimum:-max(128,abs(root.amount-slider)); maximum:max(128,abs(root.amount-slider)); value:root.amount-slider; released(value)=>{root.amount="\{value}";root.edited();}}
                    LineEdit {preferred-width:90px; horizontal-stretch:0; text <=> root.amount; edited=>{root.edited();}}
                }
            }
            if root.operation-index == 2 || root.operation-index == 3 || root.operation-index == 5: VerticalLayout {
                spacing:8px;
                Text {text:"Strength · 0 leaves terrain unchanged, 1 applies fully"; wrap:word-wrap;}
                HorizontalLayout {
                    spacing:12px;
                    Slider {minimum:0; maximum:1; value:root.strength-slider; released(value)=>{root.strength="\{value}";root.edited();}}
                    LineEdit {preferred-width:90px; horizontal-stretch:0; text <=> root.strength; edited=>{root.edited();}}
                }
            }
            if root.operation-index == 4: HorizontalLayout {
                spacing:12px;
                Text {text:"Noise seed"; vertical-alignment:center;}
                LineEdit {text <=> root.seed; edited=>{root.edited();}}
            }
            if root.operation-index == 5 || root.operation-index == 6: VerticalLayout {
                spacing:8px;
                Text {text:"Blend value · 0 first texture, 255 second texture"; wrap:word-wrap;}
                HorizontalLayout {
                    spacing:12px;
                    Slider {minimum:0; maximum:255; value:root.blend-slider; released(value)=>{root.blend-value="\{value}";root.edited();}}
                    LineEdit {preferred-width:90px; horizontal-stretch:0; text <=> root.blend-value; edited=>{root.edited();}}
                }
            }
            if root.operation-index == 8: VerticalLayout {
                spacing:8px;
                Text {text:"Physics collision · currently " + root.physics-current; wrap:word-wrap;}
                ComboBox {model:["Keep current", "Enabled", "Disabled"]; current-index <=> root.physics-index; selected=>{root.edited();}}
                Text {text:"Player collision · currently " + root.player-current;}
                ComboBox {model:["Keep current", "Enabled", "Disabled"]; current-index <=> root.player-index; selected=>{root.edited();}}
                Text {text:"Ray collision · currently " + root.ray-current;}
                ComboBox {model:["Keep current", "Enabled", "Disabled"]; current-index <=> root.ray-index; selected=>{root.edited();}}
            }
            if root.operation-index == 10: VerticalLayout {
                spacing: 10px;
                Text {text:"Border smoothing · currently " + root.smoothing-current; wrap:word-wrap;}
                ComboBox {model:["Automatic", "Hard borders", "Angle limit"]; current-index <=> root.smoothing-index; selected=>{root.edited();}}
                if root.smoothing-index == 2: VerticalLayout {
                    spacing:8px;
                    Text {text:"Maximum angle · degrees";}
                    HorizontalLayout {
                        spacing:12px;
                        Slider {minimum:0;maximum:180;value:root.smoothing-slider;released(value)=>{root.smoothing-angle="\{value}";root.edited();}}
                        LineEdit {preferred-width:90px;horizontal-stretch:0;text <=> root.smoothing-angle;edited=>{root.edited();}}
                    }
                }
                Text {text:"Changes border shading in the viewport and Direct LDR builds. Both neighboring surfaces must allow the blend. Geometry and collision stay fixed."; wrap:word-wrap;color:Theme.text-muted;}
            }
            if root.operation-index == 9: CheckBox {text:"Also sew blend values"; checked <=> root.sew-blend; toggled=>{root.edited();}}
            if root.operation-index == 12: Text {text:"Round the selected base faces into a connected surface. Replaces existing sculpting; preserves blend values and materials. Matching full edges share samples. Outer base edges stay fixed.";wrap:word-wrap;color:Theme.text-muted;}
            if root.operation-index == 12: Text {text:"Select every base face you want rounded. Half-edge junctions and corner-only contacts need separate actions. Powers and start corners stay fixed.";wrap:word-wrap;color:Theme.text-muted;font-size: Theme.font;}
            if root.operation-index != 0 && root.operation-index != 10 && root.operation-index != 11 && root.operation-index != 12: Text {text:root.operation-index == 9 ? "Join full/half borders or matching corners at different resolutions. Shared points are averaged; finer border points follow the coarser grid. Interior vertices stay fixed." : root.operation-index == 8 ? "Keep current preserves each face. Geometry, blend values and other flags stay fixed. Individual triangle removal is separate." : root.operation-index == 2 ? "Flatten moves toward the plane through the brush center. Center Z sets its height with world-Z direction." : root.operation-index == 3 ? "Smooth uses the original neighboring samples. A brush fades toward its edge." : root.operation-index == 4 ? "The same seed and source give the same noise preview. A brush fades toward its edge." : root.operation-index == 5 ? "Paint moves blend values toward the chosen value, fading toward the brush edge. Choose a two-texture material to see the blend." : root.operation-index == 6 ? "Fill applies one blend value to the complete selected terrain grids." : root.operation-index == 7 ? "Invert swaps first- and second-texture weights across the complete grids." : "Raise / lower follows the chosen direction and fades toward the brush edge."; wrap:word-wrap; color:Theme.text-muted;}
            Rectangle {vertical-stretch: 1;}
            if root.operation-index >= 1 && root.operation-index <= 5: Text {text:"A stroke applies this brush at each sample. Overlapping samples build up the edit.";wrap:word-wrap;font-size: Theme.font;color:Theme.text-muted;}
            if root.operation-index >= 1 && root.operation-index <= 5: Button {text:"Draw stroke in viewport…";enabled:!root.stale;clicked=>{root.draw-stroke();}}
            Text {text: root.message; wrap: word-wrap; color: Theme.text-faint;}
            HorizontalLayout {
                spacing: 8px;
                Button {text: "Cancel"; clicked => {root.cancel();}}
                Button {text: "Preview"; enabled: !root.stale; clicked => {root.preview-edit();}}
                Button {text: "Apply"; enabled: !root.stale && root.ready; clicked => {root.apply();}}
            }
        }
    }
}

export component SurfaceWindow inherits Window {
    background: Theme.panel;
    title: "Face Textures - HammeRR";
    preferred-width: 620px;
    preferred-height: 760px;
    in property <string> selection-label;
    in property <string> message;
    in property <bool> stale;
    in property <bool> sample-present;
    in property <string> sample-label;
    in property <image> sample-preview;
    in-out property <int> operation-index;
    in-out property <int> alignment-index;
    in-out property <int> justify-u-index;
    in-out property <int> justify-v-index;
    in-out property <string> material;
    in property <image> preview;
    in-out property <string> shift-u;
    in-out property <string> shift-v;
    in-out property <string> scale-u;
    in-out property <string> scale-v;
    in-out property <string> rotation;
    in-out property <bool> fit;
    in-out property <bool> direct-vectors;
    in-out property <string> u-x;
    in-out property <string> u-y;
    in-out property <string> u-z;
    in-out property <string> v-x;
    in-out property <string> v-y;
    in-out property <string> v-z;
    in-out property <bool> ready;
    in-out property <string> reviewed-fields;
    in-out property <string> reviewed-token;
    in-out property <string> owned-token;
    in-out property <string> variation-seed: "0";
    in-out property <string> variation-max-u: "16";
    in-out property <string> variation-max-v: "16";
    callback browse();
    callback fit-atlas();
    callback preview-edit();
    callback apply();
    callback cancel();
    forward-focus: dialog-focus;
    dialog-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); accept } else { reject }
        }
        VerticalLayout {
            padding: Theme.space-xl;
            spacing: 12px;
            Text { text: root.selection-label; font-size: Theme.font-heading; }
            ComboBox {
                model: ["Edit texture settings", "Paint sampled material", "Copy sampled projection", "Wrap across a shared edge", "Wrap connected faces", "Vary texture offsets"];
                current-index <=> root.operation-index;
                selected => { root.ready = false; }
            }
            if root.operation-index > 0 && root.operation-index < 5: VerticalLayout {
                spacing: 16px;
                HorizontalLayout {
                    spacing: 16px;
                    Image { width: 96px; height: 96px; source: root.sample-preview; image-fit: contain; }
                    VerticalLayout {
                        spacing: 8px;
                        Text { text: "Sampled texture"; font-size: Theme.font-heading; }
                        Text { text: root.sample-label; wrap: word-wrap; color: Theme.text-muted; }
                    }
                }
                Text {
                    text: root.operation-index == 1 ? "Apply the sampled material. Keep the target faces' offsets, scale and rotation." : root.operation-index == 2 ? "Copy the material and its world-space texture projection. Useful for matching parallel surfaces." : root.operation-index == 3 ? "Fold the sampled projection around each shared edge so the texture meets continuously. Each target must touch the sampled face." : "Carry the sampled texture through connected faces, folding it at each shared edge. Include intermediate faces. Disconnected targets and closed loops that need a seam are rejected; select an open strip to leave a seam.";
                    wrap: word-wrap;
                }
                Text { text: "The sample keeps its captured values even if the source is edited. Sample again to refresh it."; color: Theme.text-faint; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; }
            }
            if root.operation-index == 5: VerticalLayout {
                spacing: 12px;
                Text { text: "Give each face a repeatable U/V offset within the maximum shifts. Texture axes, scale, rotation and materials stay unchanged."; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Seed"; vertical-alignment: center; }
                    LineEdit { text <=> root.variation-seed; input-type: number; accessible-label: "Variation seed"; edited => { root.ready = false; } }
                }
                Text { text: "Maximum shift · texels"; }
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: "U · horizontal"; vertical-alignment: center; }
                    LineEdit { text <=> root.variation-max-u; input-type: decimal; accessible-label: "Maximum U shift in texels"; edited => { root.ready = false; } }
                    Text { text: "V · vertical"; vertical-alignment: center; }
                    LineEdit { text <=> root.variation-max-v; input-type: decimal; accessible-label: "Maximum V shift in texels"; edited => { root.ready = false; } }
                }
                Text { text: "Use seed 0–4294967295 and nonnegative shifts. Each shift can be positive or negative. Set an axis to 0 to keep its offset."; wrap: word-wrap; color: Theme.text-muted; }
                Text { text: "The same seed, faces and starting offsets reproduce the same preview. Applying again adds another shift to the saved offsets."; wrap: word-wrap; color: Theme.text-muted; }
                Text { text: "Preview variation before Apply textures. Both shifts at 0 leave any existing preview untouched."; wrap: word-wrap; color: Theme.text-muted; }
                Rectangle { vertical-stretch: 1; }
            }
            if root.operation-index == 0: ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 10px;
                    Text { text: "Blank fields keep each face's current value."; color: Theme.text-faint; }
                    HorizontalLayout {
                        spacing: 12px;
                        Image { width: 72px; height: 72px; source: root.preview; image-fit: contain; }
                        VerticalLayout {
                            spacing: 6px;
                            Text { text: "Material"; }
                            LineEdit { text <=> root.material; placeholder-text: "Mixed · keep current materials"; edited => { root.ready = false; } }
                            Button { text: "Browse materials…"; clicked => { root.browse(); } }
                            Button { text: "Fit atlas region…"; clicked => { root.fit-atlas(); } }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text { text: "Projection"; vertical-alignment: center; }
                        ComboBox {
                            enabled: !root.direct-vectors;
                            model: ["Keep current axes", "Align to world", "Align to face"];
                            current-index <=> root.alignment-index;
                            selected => { if self.current-index != 0 { root.rotation = "0"; } root.ready = false; }
                        }
                    }
                    Text { text: "Offset · texture pixels"; }
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Horizontal"; vertical-alignment: center; }
                        LineEdit { text <=> root.shift-u; input-type: decimal; placeholder-text: "Keep"; edited => { root.ready = false; } }
                        Text { text: "Vertical"; vertical-alignment: center; }
                        LineEdit { text <=> root.shift-v; input-type: decimal; placeholder-text: "Keep"; edited => { root.ready = false; } }
                    }
                    Text { text: "Scale · world units per texture pixel"; }
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Horizontal"; vertical-alignment: center; }
                        LineEdit { text <=> root.scale-u; input-type: decimal; placeholder-text: "Keep"; edited => { root.ready = false; } }
                        Text { text: "Vertical"; vertical-alignment: center; }
                        LineEdit { text <=> root.scale-v; input-type: decimal; placeholder-text: "Keep"; edited => { root.ready = false; } }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Rotation · degrees"; vertical-alignment: center; }
                        LineEdit { enabled: !root.direct-vectors; text <=> root.rotation; input-type: decimal; placeholder-text: "Keep"; edited => { root.ready = false; } }
                    }
                    Slider {
                        enabled: !root.direct-vectors;
                        minimum: -180; maximum: 180;
                        value: root.rotation == "" ? 0 : root.rotation.to-float();
                        released(value) => { root.rotation = "\{round(value)}"; root.ready = false; }
                    }
                    CheckBox { text: "Advanced U/V world vectors"; checked <=> root.direct-vectors; toggled => { root.ready = false; } }
                    if root.direct-vectors: VerticalLayout {
                        spacing: 8px;
                        Text { text: "U runs horizontally across the texture; V runs vertically. Components use world X, Y and Z. Blank keeps each face’s value."; wrap: word-wrap; color: Theme.text-muted; }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { width: 16px; text: ""; }
                            Text { text: "X"; horizontal-stretch: 1; }
                            Text { text: "Y"; horizontal-stretch: 1; }
                            Text { text: "Z"; horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { width: 16px; text: "U"; vertical-alignment: center; }
                            LineEdit { text <=> root.u-x; input-type: decimal; placeholder-text: "X · mixed / keep"; accessible-label: "U vector X"; edited => { root.ready = false; } }
                            LineEdit { text <=> root.u-y; input-type: decimal; placeholder-text: "Y · mixed / keep"; accessible-label: "U vector Y"; edited => { root.ready = false; } }
                            LineEdit { text <=> root.u-z; input-type: decimal; placeholder-text: "Z · mixed / keep"; accessible-label: "U vector Z"; edited => { root.ready = false; } }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { width: 16px; text: "V"; vertical-alignment: center; }
                            LineEdit { text <=> root.v-x; input-type: decimal; placeholder-text: "X · mixed / keep"; accessible-label: "V vector X"; edited => { root.ready = false; } }
                            LineEdit { text <=> root.v-y; input-type: decimal; placeholder-text: "Y · mixed / keep"; accessible-label: "V vector Y"; edited => { root.ready = false; } }
                            LineEdit { text <=> root.v-z; input-type: decimal; placeholder-text: "Z · mixed / keep"; accessible-label: "V vector Z"; edited => { root.ready = false; } }
                        }
                        Text { text: "Component magnitudes are preserved. Click Preview textures before Apply textures."; wrap: word-wrap; color: Theme.text-muted; }
                    }
                    CheckBox { text: "Fit one texture tile to each face"; checked <=> root.fit; toggled => { root.ready = false; } }
                    Text { text: "Placement within a texture tile · keeps scale"; }
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Horizontal"; vertical-alignment: center; }
                        ComboBox { model: ["Keep offset", "Left", "Center", "Right"]; current-index <=> root.justify-u-index; selected => { root.ready = false; } }
                        Text { text: "Vertical"; vertical-alignment: center; }
                        ComboBox { model: ["Keep offset", "Top", "Center", "Bottom"]; current-index <=> root.justify-v-index; selected => { root.ready = false; } }
                    }
                }
            }
            Text { text: root.message; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 10px;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
                Button { text: root.operation-index == 5 ? "Preview variation" : "Preview textures"; enabled: !root.stale && (root.operation-index == 0 || root.operation-index == 5 || root.sample-present); clicked => { root.preview-edit(); } }
                Button { text: "Apply textures"; enabled: !root.stale && (root.operation-index == 0 || root.operation-index == 5 || root.sample-present) && (root.operation-index == 5 ? root.ready : (root.operation-index != 0 || !root.direct-vectors || root.ready)); clicked => { root.apply(); } }
            }
        }
    }
}

component PropertyField inherits VerticalLayout {
    in property <KeyValue> field;
    in property <bool> advanced;
    in property <bool> model-browsing;
    property <bool> show-help;
    property <bool> browsable: root.field.control == "material" || (root.model-browsing && (root.field.control == "model" || root.field.control == "sound" || root.field.control == "particle"));
    property <bool> inline: root.field.control == "text" || root.field.control == "number" || root.field.control == "slider" || root.field.control == "choices" || root.field.control == "boolean" || root.field.control == "material" || root.field.control == "model" || root.field.control == "sound" || root.field.control == "particle";
    callback edited(string);
    callback component-edited(int, string);
    callback removed();
    callback flag-toggled(string, bool);
    callback pick-color();
    callback pick-material();
    callback pick-model();
    callback pick-sound();
    callback pick-particle();
    function browse() {
        if root.field.control == "material" {
            root.pick-material();
        } else if root.field.control == "model" {
            root.pick-model();
        } else if root.field.control == "sound" {
            root.pick-sound();
        } else if root.field.control == "particle" {
            root.pick-particle();
        }
    }
    spacing: 4px;
    padding-bottom: 4px;
    HorizontalLayout {
        spacing: 8px;
        min-height: 26px;
        if root.inline: Text {
            width: 104px;
            text: root.field.label;
            color: Theme.text-muted;
            vertical-alignment: center;
            overflow: elide;
        }
        if !root.inline: Text {
            horizontal-stretch: 1;
            text: root.field.label;
            color: Theme.text-muted;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.inline && root.field.control == "choices": ComboBox {
            horizontal-stretch: 1;
            model: root.field.choices;
            current-index: root.field.choice-index;
            enabled: !root.field.read-only;
            selected => { root.edited(root.field.choice-values[self.current-index]); }
        }
        if root.inline && root.field.control == "boolean": CheckBox {
            horizontal-stretch: 1;
            text: "";
            checked: root.field.value == "1";
            enabled: !root.field.read-only;
            toggled => { root.edited(self.checked ? "1" : "0"); }
        }
        if root.inline && root.field.control == "slider": Slider {
            horizontal-stretch: 1;
            value: root.field.number-value;
            minimum: root.field.minimum;
            maximum: root.field.maximum;
            enabled: !root.field.read-only;
            released(value) => { root.edited(root.field.type-name == "integer" ? "\{round(value)}" : "\{value}"); }
        }
        if root.field.control == "slider": LineEdit {
            width: 64px;
            text: root.field.value;
            enabled: !root.field.read-only;
            input-type: root.field.numeric ? InputType.decimal : InputType.text;
            accepted(value) => { root.edited(value); }
        }
        if root.inline && root.field.control != "choices" && root.field.control != "boolean" && root.field.control != "slider": LineEdit {
            horizontal-stretch: 1;
            text: root.field.value;
            enabled: !root.field.read-only;
            input-type: root.field.numeric ? InputType.decimal : InputType.text;
            accepted(value) => { root.edited(value); }
        }
        if root.browsable: IconButton { y: -1px; icon: Icon.open; tooltip: "Browse…"; enabled: !root.field.read-only; clicked => { root.browse(); } }
        if root.field.description != "": IconButton { y: -1px; icon: Icon.info; tooltip: "Show help"; checked: root.show-help; clicked => { root.show-help = !root.show-help; } }
    }
    if root.advanced: Text { text: root.field.key + " · " + root.field.type-name; color: Theme.text-faint; font-size: Theme.font-small; }
    if root.show-help: Text { text: root.field.description; wrap: word-wrap; color: Theme.text-faint; font-size: Theme.font-small; }
    if root.field.control == "flags": VerticalLayout {
        spacing: 2px;
        for flag in root.field.flags: CheckBox {
            text: flag.label;
            checked: flag.checked;
            enabled: !root.field.read-only;
            toggled => { root.flag-toggled(flag.value, self.checked); }
        }
    }
    if root.field.control == "vector": HorizontalLayout {
        spacing: 4px;
        for component[index] in root.field.components: Rectangle {
            horizontal-stretch: 1;
            height: 26px;
            border-radius: 4px;
            background: Theme.field;
            border-width: 1px;
            border-color: Theme.border-strong;
            HorizontalLayout {
                padding-left: 6px;
                spacing: 2px;
                Text {
                    text: root.field.component-labels[index];
                    color: index == 0 ? Theme.axis-x : index == 1 ? Theme.axis-y : index == 2 ? Theme.axis-z : Theme.text-faint;
                    font-size: Theme.font-small;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                TextInput {
                    horizontal-stretch: 1;
                    text: component;
                    color: Theme.text;
                    font-size: Theme.font;
                    vertical-alignment: center;
                    single-line: true;
                    input-type: decimal;
                    enabled: !root.field.read-only;
                    accessible-label: root.field.label + " " + root.field.component-labels[index];
                    accepted => { root.component-edited(index, self.text); }
                }
            }
        }
    }
    if root.field.control == "color": HorizontalLayout {
        spacing: 8px;
        Rectangle {
            width: 26px;
            height: 26px;
            background: root.field.swatch;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border-strong;
            TouchArea { enabled: !root.field.read-only; clicked => { root.pick-color(); } }
        }
        Button { text: "Choose color…"; horizontal-stretch: 1; enabled: !root.field.read-only; clicked => { root.pick-color(); } }
        if root.field.has-intensity: LineEdit { width: 64px; text: root.field.intensity; input-type: decimal; enabled: !root.field.read-only; accepted(value) => { root.component-edited(3, value); } }
    }
    if root.field.control == "color" && root.field.has-intensity: Slider {
        minimum: 0;
        maximum: max(1000, root.field.intensity-value);
        value: root.field.intensity-value;
        enabled: !root.field.read-only;
        released(value) => { root.component-edited(3, "\{value}"); }
    }
    if root.advanced && (root.field.control == "color" || root.field.control == "vector" || root.field.control == "flags"): LineEdit {
        text: root.field.value;
        placeholder-text: "Stored value";
        enabled: !root.field.read-only;
        accepted(value) => { root.edited(value); }
    }
    if root.advanced: Button { text: "Remove property"; enabled: root.field.key != "classname" && !root.field.read-only; clicked => { root.removed(); } }
}

export struct ManagedFieldRow {
    field: KeyValue,
    status: string,
    can-reset: bool,
}

export component PropertiesWindow inherits Window {
    background: Theme.panel;
    title: "Properties - HammeRR";
    preferred-width: 740px;
    preferred-height: 780px;
    in-out property <string> draft-token;
    in property <string> heading;
    in property <string> summary;
    in property <string> message;
    in property <bool> can-apply;
    in property <[ManagedFieldRow]> fields;
    in property <bool> world-settings;
    in-out property <string> filter;
    in-out property <string> custom-key;
    in-out property <string> custom-value;
    callback search();
    callback edit(string, string);
    callback component-edit(string, int, string);
    callback flag-edit(string, string, bool);
    callback reset(string);
    callback remove(string);
    callback pick-color(string);
    callback pick-material(string);
    callback inspect-sky-assets();
    callback apply();
    callback cancel();
    forward-focus: dialog-focus;
    dialog-focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => { if event.text == Key.Escape { root.cancel(); accept } else { reject } }
        VerticalLayout {
            padding: Theme.space-xl; spacing: 12px;
            Text { text: root.heading; font-size: Theme.font-display; font-weight: 600; }
            Text { text: root.summary; wrap: word-wrap; }
            if root.world-settings: Button {
                text: "Inspect applied sky…";
                clicked => { root.inspect-sky-assets(); }
            }
            LineEdit { text <=> root.filter; placeholder-text: "Find a property…"; edited => { root.search(); } }
            ListView {
                for row in root.fields: VerticalLayout {
                    padding-bottom: 16px; spacing: 6px;
                    PropertyField {
                        field: row.field;
                        edited(value) => { root.edit(row.field.key, value); }
                        component-edited(index, value) => { root.component-edit(row.field.key, index, value); }
                        flag-toggled(flag, checked) => { root.flag-edit(row.field.key, flag, checked); }
                        pick-color => { root.pick-color(row.field.key); }
                        pick-material => { root.pick-material(row.field.key); }
                    }
                    Text { text: row.status; wrap: word-wrap; color: Theme.text-muted; font-size: Theme.font; }
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: "Use default"; enabled: row.can-reset && !row.field.read-only; clicked => { root.reset(row.field.key); } }
                        Button { text: "Remove override"; enabled: !row.field.read-only; clicked => { root.remove(row.field.key); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                LineEdit { text <=> root.custom-key; placeholder-text: "Custom property key"; }
                LineEdit { text <=> root.custom-value; placeholder-text: "Value"; }
                Button { text: "Stage value"; enabled: root.custom-key != ""; clicked => { root.edit(root.custom-key, root.custom-value); } }
            }
            Text { text: root.message; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 10px;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
                Button { text: "Apply properties"; enabled: root.can-apply; clicked => { root.apply(); } }
            }
        }
    }
}

export struct ObjectReportRow { id: string, label: string, detail: string }

export struct RecoveryRow { id: string, title: string, detail: string }

export struct CheckIssueRow { id: string, title: string, location: string, severity: string }

export component ChecksWindow inherits Window {
    background: Theme.panel;
    title: "Map checks - HammeRR";
    preferred-width: 1040px; preferred-height: 760px;
    in-out property <string> query;
    in-out property <int> severity;
    in-out property <int> page;
    in property <bool> has-next;
    in property <bool> stale;
    in property <string> summary;
    in property <string> page-summary;
    in property <[CheckIssueRow]> rows;
    in-out property <string> report-token;
    in-out property <string> selected-id;
    in property <string> detail-title;
    in property <string> detail;
    in property <string> location;
    in property <bool> can-select;
    in property <bool> can-repair;
    in property <string> preview-token;
    in property <string> preview-text;
    in property <string> message;
    in property <float> aspect: 1.6;
    callback run-checks();
    callback filter();
    callback inspect(string);
    callback navigate(bool);
    callback review-repair();
    callback apply-repair();
    callback cancel-repair();
    callback cancel();
    forward-focus: dialog-focus;
    dialog-focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => { if event.text == Key.Escape { root.cancel(); accept } else { reject } }
        VerticalLayout {
            padding: Theme.space-xl; spacing: 12px;
            HorizontalLayout {
                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Map checks"; font-size: Theme.font-display; font-weight: 600; }
                    Text { text: root.summary; color: Theme.text-muted; }
                }
                Button { text: "Run checks"; clicked => { root.run-checks(); } }
            }
            if root.stale: Text { text: "Results are out of date. Run checks again before selecting or repairing an issue."; color: Theme.warning; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 10px;
                LineEdit { text <=> root.query; placeholder-text: "Search issues…"; edited => { root.page = 0; root.filter(); } }
                ComboBox { model: ["All severities", "Errors", "Warnings", "Notes"]; current-index <=> root.severity; selected => { root.page = 0; root.filter(); } }
            }
            HorizontalLayout {
                spacing: 18px;
                VerticalLayout {
                    horizontal-stretch: 1; min-width: 390px; spacing: 8px;
                    ScrollView {
                        VerticalLayout {
                            spacing: 6px;
                            for row in root.rows: Button {
                                text: (row.severity == "error" ? "Error · " : row.severity == "warning" ? "Warning · " : "Note · ") + row.title + "\n" + row.location;
                                checked: root.selected-id == row.id;
                                height: 62px;
                                clicked => { root.inspect(row.id); }
                            }
                        }
                    }
                    Text { text: root.page-summary; color: Theme.text-faint; font-size: Theme.font; }
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: "Previous"; enabled: root.page > 0; clicked => { root.page -= 1; root.filter(); } }
                        Button { text: "Next"; enabled: root.has-next; clicked => { root.page += 1; root.filter(); } }
                    }
                }
                Rectangle { width: 1px; background: Theme.control-strong; }
                VerticalLayout {
                    horizontal-stretch: 1; min-width: 450px; spacing: 12px;
                    Text { text: root.detail-title; font-size: Theme.font-display; font-weight: 600; wrap: word-wrap; }
                    Text { text: root.detail; wrap: word-wrap; }
                    Text { text: root.location; color: Theme.text-faint; wrap: word-wrap; font-size: Theme.font; }
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: "Select issue"; enabled: root.can-select; clicked => { root.navigate(false); } }
                        Button { text: "Focus issue"; enabled: root.can-select; clicked => { root.navigate(true); } }
                    }
                    Button { text: "Review repair…"; enabled: root.can-repair; clicked => { root.review-repair(); } }
                    if root.preview-token != "": VerticalLayout {
                        spacing: 8px;
                        Text { text: "Proposed repair"; font-size: Theme.font-heading; font-weight: 600; }
                        TextEdit { text: root.preview-text; read-only: true; wrap: word-wrap; preferred-height: 140px; max-height: 230px; }
                        Text { text: "Apply records one undo step. Cancel leaves the map unchanged."; wrap: word-wrap; color: Theme.text-faint; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Cancel repair"; clicked => { root.cancel-repair(); } }
                            Button { text: "Apply repair"; enabled: !root.stale; clicked => { root.apply-repair(); } }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
            if root.message != "": Text { text: root.message; color: Theme.warning; wrap: word-wrap; }
            Text { text: "Checks include hidden objects and exclude pending edits. Compile and test in CS:S to check leaks and playability."; color: Theme.text-faint; font-size: Theme.font; wrap: word-wrap; }
            Button { text: "Cancel / close"; clicked => { root.cancel(); } }
        }
    }
}

export struct RecentMapRow { path: string, title: string, detail: string }

export component RecentMapsWindow inherits Window {
    background: Theme.panel;
    title: "Recent maps - HammeRR";
    preferred-width: 760px;
    preferred-height: 720px;
    in property <[RecentMapRow]> rows;
    in property <string> summary;
    in property <string> selected-detail;
    in property <bool> selected-available;
    in property <bool> writable;
    in property <bool> dirty-map;
    in property <string> warning;
    in property <string> message;
    in-out property <string> selected-path;
    in-out property <string> map-guard;
    in-out property <bool> discard-changes;
    in-out property <bool> confirm-clear;
    callback select-map(string);
    callback open-selected();
    callback remove-selected();
    callback clear-list();
    callback refresh();
    callback cancel();
    forward-focus: dialog-focus;
    dialog-focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => { if event.text == Key.Escape { root.cancel(); accept } else { reject } }
        VerticalLayout {
            padding: Theme.space-xl; spacing: 10px;
            Text { text: "Recent maps"; font-size: Theme.font-display; font-weight: 600; }
            Text { text: "Reopen a map with its retained build settings. Game content stays mounted from this editor session."; wrap: word-wrap; color: Theme.text-muted; }
            HorizontalLayout {
                Text { text: root.summary; horizontal-stretch: 1; vertical-alignment: center; }
                Button { text: "Reload saved list"; clicked => { root.refresh(); } }
            }
            ListView {
                min-height: 140px;
                for row in root.rows: VerticalLayout {
                    spacing: 3px; padding-bottom: 10px;
                    Button { text: row.title + (root.selected-path == row.path ? " · selected" : ""); clicked => { root.select-map(row.path); } }
                    Text { text: row.path; wrap: word-wrap; color: Theme.text-muted; font-size: Theme.font; }
                    Text { text: row.detail; color: Theme.text-muted; font-size: Theme.font; }
                }
            }
            Text { text: root.selected-detail; wrap: word-wrap; color: Theme.text-muted; }
            if root.dirty-map: CheckBox { text: "Discard current unsaved edits when opening"; checked <=> root.discard-changes; }
            HorizontalLayout {
                spacing: 10px;
                Button { text: "Open selected map"; enabled: root.selected-available && (!root.dirty-map || root.discard-changes); clicked => { root.open-selected(); } }
                Button { text: "Remove from list"; enabled: root.writable && root.selected-path != ""; clicked => { root.remove-selected(); } }
            }
            HorizontalLayout {
                spacing: 10px;
                CheckBox { text: "Confirm clear list"; checked <=> root.confirm-clear; }
                Button { text: "Clear list"; enabled: root.writable && root.confirm-clear && root.rows.length > 0; clicked => { root.clear-list(); } }
            }
            if root.warning != "": Text { text: root.warning; wrap: word-wrap; color: Theme.warning; }
            if root.message != "": Text { text: root.message; wrap: word-wrap; }
            Button { text: "Cancel / close"; clicked => { root.cancel(); } }
        }
    }
}

export component RecoveryWindow inherits Window {
    background: Theme.panel;
    title: "Recovery - HammeRR";
    preferred-width: 780px;
    preferred-height: 790px;
    in property <bool> available;
    in property <bool> busy;
    in property <bool> dirty-map;
    in property <string> status;
    in property <string> storage;
    in property <string> warning;
    in property <string> message;
    in property <string> summary;
    in property <string> selected-detail;
    in property <[RecoveryRow]> rows;
    in property <bool> has-next;
    in-out property <string> settings-revision;
    in-out property <bool> autosave-enabled;
    in-out property <int> interval-seconds: 120;
    in-out property <int> keep-count: 10;
    in-out property <bool> settings-dirty;
    in-out property <bool> current-map-only;
    in-out property <int> page;
    in-out property <string> selected-id;
    in-out property <bool> confirm-delete;
    in-out property <bool> discard-changes;
    in-out property <string> map-review;
    callback refresh();
    callback reload-settings();
    callback apply-settings();
    callback select-snapshot(string);
    callback snapshot-now();
    callback restore-snapshot();
    callback delete-snapshot();
    callback cancel();
    forward-focus: dialog-focus;
    dialog-focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => { if event.text == Key.Escape { root.cancel(); accept } else { reject } }
        VerticalLayout {
            padding: Theme.space-xl; spacing: 10px;
            Text { text: "Autosave and recovery"; font-size: Theme.font-display; font-weight: 600; }
            Text { text: root.status; color: Theme.text-muted; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 12px;
                CheckBox { text: "Autosave changes"; checked <=> root.autosave-enabled; toggled => { root.settings-dirty = true; } }
                Text { text: "Every (seconds)"; vertical-alignment: center; }
                SpinBox { value <=> root.interval-seconds; minimum: 30; maximum: 3600; edited => { root.settings-dirty = true; } }
                Text { text: "Keep per map"; vertical-alignment: center; }
                SpinBox { value <=> root.keep-count; minimum: 1; maximum: 50; edited => { root.settings-dirty = true; } }
            }
            HorizontalLayout {
                spacing: 10px;
                Button { text: "Reload settings"; clicked => { root.reload-settings(); } }
                Button { text: "Apply settings"; enabled: root.available && root.settings-dirty; clicked => { root.apply-settings(); } }
                Button { text: "Save snapshot now"; enabled: root.available && !root.busy; clicked => { root.snapshot-now(); } }
            }
            Text { text: "Snapshots include applied edits, even in unnamed maps. Use Save to update the map file."; wrap: word-wrap; color: Theme.text-faint; }
            HorizontalLayout {
                spacing: 10px;
                Text { text: root.summary; vertical-alignment: center; horizontal-stretch: 1; }
                CheckBox { text: "Current map only"; checked <=> root.current-map-only; toggled => { root.page = 0; root.refresh(); } }
                Button { text: "Refresh list"; clicked => { root.refresh(); } }
            }
            ListView {
                min-height: 140px;
                for row in root.rows: VerticalLayout {
                    spacing: 3px; padding-bottom: 8px;
                    Button { text: row.title + (root.selected-id == row.id ? " · selected" : ""); clicked => { root.select-snapshot(row.id); } }
                    Text { text: row.detail; color: Theme.text-muted; font-size: Theme.font; }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Button { text: "Previous"; enabled: root.page > 0; clicked => { root.page -= 1; root.refresh(); } }
                Button { text: "Next"; enabled: root.has-next; clicked => { root.page += 1; root.refresh(); } }
            }
            Text { text: root.selected-detail; wrap: word-wrap; color: Theme.text-muted; }
            if root.dirty-map: CheckBox { text: "Discard current unsaved edits when opening the recovered copy"; checked <=> root.discard-changes; }
            HorizontalLayout {
                spacing: 10px;
                Button { text: "Open recovered copy"; enabled: root.selected-id != "" && (!root.dirty-map || root.discard-changes); clicked => { root.restore-snapshot(); } }
                CheckBox { text: "Confirm permanent deletion"; checked <=> root.confirm-delete; }
                Button { text: "Delete snapshot"; enabled: root.selected-id != "" && root.confirm-delete && !root.busy; clicked => { root.delete-snapshot(); } }
            }
            Text { text: "Recovered maps open as unsaved copies. Choose a save path to keep them."; wrap: word-wrap; color: Theme.text-faint; }
            if root.warning != "": Text { text: root.warning; wrap: word-wrap; color: Theme.warning; }
            if root.message != "": Text { text: root.message; wrap: word-wrap; }
            Text { text: "Storage: " + root.storage; wrap: word-wrap; color: Theme.text-faint; font-size: Theme.font-small; }
            Button { text: "Cancel / close"; clicked => { root.cancel(); } }
        }
    }
}

export component PointfileWindow inherits Window {
    background: Theme.panel;
    title: "Pointfile - HammeRR";
    preferred-width: 660px; preferred-height: 360px;
    in-out property <string> path;
    in property <string> source;
    in property <string> summary;
    in property <string> position;
    in property <string> message;
    in property <string> token;
    in property <string> stamp;
    in property <float> aspect: 1.6;
    in property <bool> current;
    in property <bool> has-path;
    in property <int> total;
    in-out property <int> point: 1;
    callback load(); callback browse(); callback clear(); callback frame();
    callback navigate(int); callback cancel();
    forward-focus: dialog-focus;
    dialog-focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => { if event.text == Key.Escape { root.cancel(); accept } else { reject } }
        VerticalLayout {
            padding: Theme.space-xl; spacing: 14px;
            Text { text: "Follow a leak path"; font-size: Theme.font-display; font-weight: 600; }
            Text { text: "Load a pointfile or explore the latest compile's leak. Navigation moves the editor camera."; wrap: word-wrap; color: Theme.text-muted; }
            HorizontalLayout {
                spacing: 8px;
                LineEdit { text <=> root.path; placeholder-text: "Path to a .lin pointfile"; horizontal-stretch: 1; }
                Button { text: "Browse…"; clicked => { root.browse(); } }
                Button { text: "Load"; enabled: root.path != ""; clicked => { root.load(); } }
            }
            Text { text: root.source; wrap: word-wrap; }
            Text { text: root.summary; wrap: word-wrap; color: root.has-path && !root.current ? Theme.warning : Theme.text-muted; }
            HorizontalLayout {
                spacing: 8px;
                Text { text: "Point"; vertical-alignment: center; }
                SpinBox { preferred-width: 110px; horizontal-stretch: 0; value <=> root.point; minimum: 1; maximum: max(1, root.total); enabled: root.current; }
                Text { text: "of " + root.total; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Button { text: "Go"; enabled: root.current; clicked => { root.navigate(root.point - 1); } }
                Button { text: "Previous"; enabled: root.current && root.point > 1; clicked => { root.navigate(root.point - 2); } }
                Button { text: "Next"; enabled: root.current && root.point < root.total; clicked => { root.navigate(root.point); } }
            }
            Text { text: root.position; color: Theme.text-muted; }
            if root.message != "": Text { text: root.message; wrap: word-wrap; color: Theme.warning; }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 8px;
                Button { text: "Frame path"; enabled: root.current; clicked => { root.frame(); } }
                Button { text: "Unload path"; enabled: root.has-path; clicked => { root.clear(); } }
                Button { text: "Close"; clicked => { root.cancel(); } }
            }
        }
    }
}

export struct StatisticRow { name: string, count: string }

component StatisticCard inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> detail;
    background: Theme.hover; border-radius: 8px;
    VerticalLayout {
        padding: 16px; spacing: 8px;
        Text { text: root.label; color: Theme.text-muted; }
        Text { text: root.value; font-size: 24px; font-weight: 600; }
        Text { text: root.detail; font-size: Theme.font; color: Theme.text-muted; wrap: word-wrap; }
    }
}

export component StatisticsWindow inherits Window {
    background: Theme.panel;
    title: "Map statistics - HammeRR";
    preferred-width: 840px; preferred-height: 680px;
    in property <string> brushes;
    in property <string> brush-detail;
    in property <string> faces;
    in property <string> face-detail;
    in property <string> entities;
    in property <string> entity-detail;
    in property <string> details;
    in property <string> summary;
    in property <string> generation;
    in property <string> revision;
    in property <[StatisticRow]> rows;
    in property <bool> has-next;
    in-out property <int> section;
    in-out property <int> page;
    callback refresh();
    callback cancel();
    forward-focus: dialog-focus;
    dialog-focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => { if event.text == Key.Escape { root.cancel(); accept } else { reject } }
        VerticalLayout {
            padding: Theme.space-xl; spacing: 14px;
            Text { text: "Map statistics"; font-size: Theme.font-display; font-weight: 600; }
            Text { text: "Current map, including hidden objects. Previews are excluded."; color: Theme.text-muted; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 12px;
                StatisticCard { label: "Brushes"; value: root.brushes; detail: root.brush-detail; }
                StatisticCard { label: "Brush sides"; value: root.faces; detail: root.face-detail; }
                StatisticCard { label: "Entities"; value: root.entities; detail: root.entity-detail; }
            }
            Text { text: root.details; wrap: word-wrap; color: Theme.text-muted; }
            HorizontalLayout {
                spacing: 12px;
                ComboBox { model: ["Materials · sides", "Entity classes · entities", "Model paths · references", "Lightmap scales · sides", "Terrain powers · displacements"]; current-index <=> root.section; selected => { root.page = 0; root.refresh(); } }
                Button { text: "Refresh"; clicked => { root.refresh(); } }
            }
            HorizontalLayout {
                Text { text: root.section == 0 ? "Material" : root.section == 1 ? "Entity class" : root.section == 2 ? "Model path" : root.section == 3 ? "Units per lightmap texel" : "Displacement power"; color: Theme.text-muted; horizontal-stretch: 1; }
                Text { text: "Count"; color: Theme.text-muted; width: 80px; horizontal-alignment: right; }
            }
            ListView {
                for row in root.rows: HorizontalLayout {
                    spacing: 12px; padding-top: 5px; padding-bottom: 5px;
                    Text { text: row.name == "" ? "(empty path)" : row.name; wrap: word-wrap; horizontal-stretch: 1; }
                    Text { text: row.count; width: 80px; horizontal-alignment: right; }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Text { text: root.summary; vertical-alignment: center; horizontal-stretch: 1; }
                Button { text: "Previous"; enabled: root.page > 0; clicked => { root.page -= 1; root.refresh(); } }
                Button { text: "Next"; enabled: root.has-next; clicked => { root.page += 1; root.refresh(); } }
            }
            Text { text: "Authored counts, not compiled BSP budgets. Brush sides count plane records. Hidden brushes include those inside hidden entities. Locate IDs with Object report."; wrap: word-wrap; color: Theme.text-faint; font-size: Theme.font; }
            Button { text: "Close"; clicked => { root.cancel(); } }
        }
    }
}

export component ReportWindow inherits Window {
    background: Theme.panel;
    title: "Object report - HammeRR";
    preferred-width: 960px; preferred-height: 760px;
    in-out property <string> query;
    in-out property <string> classname;
    in-out property <bool> exact-class;
    in-out property <string> targetname;
    in-out property <string> material;
    in-out property <int> kind;
    in-out property <int> visibility;
    in-out property <int> page;
    in-out property <int> selection-mode;
    in-out property <bool> limit-bounds;
    in-out property <string> min-x: "-16384";
    in-out property <string> min-y: "-16384";
    in-out property <string> min-z: "-16384";
    in-out property <string> max-x: "16384";
    in-out property <string> max-y: "16384";
    in-out property <string> max-z: "16384";
    in property <float> aspect: 1.6;
    in-out property <string> generation;
    in-out property <string> revision;
    in property <bool> has-next;
    in property <[ObjectReportRow]> rows;
    in property <string> summary;
    in property <string> message;
    callback search();
    callback select-result(string, bool);
    callback select-all(bool);
    callback visibility-action(string);
    callback cancel();
    forward-focus: dialog-focus;
    dialog-focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => { if event.text == Key.Escape { root.cancel(); accept } else { reject } }
        VerticalLayout {
            padding: Theme.space-xl; spacing: 12px;
            Text { text: "Find objects"; font-size: Theme.font-display; font-weight: 600; }
            LineEdit { text <=> root.query; placeholder-text: "Search IDs, names, classes and materials…"; edited => { root.page = 0; root.search(); } }
            HorizontalLayout {
                spacing: 8px;
                LineEdit { text <=> root.classname; placeholder-text: "Entity class contains…"; edited => { root.page = 0; root.search(); } }
                CheckBox { text: "Exact class"; checked <=> root.exact-class; toggled => { root.page = 0; root.search(); } }
                LineEdit { text <=> root.targetname; placeholder-text: "Entity name"; edited => { root.page = 0; root.search(); } }
                LineEdit { text <=> root.material; placeholder-text: "Material"; edited => { root.page = 0; root.search(); } }
            }
            HorizontalLayout {
                spacing: 8px;
                ComboBox { model: ["All types", "World brushes", "All entities", "Point entities", "Brush entities"]; current-index <=> root.kind; selected => { root.page = 0; root.search(); } }
                ComboBox { model: ["Visible and hidden", "Visible", "Hidden"]; current-index <=> root.visibility; selected => { root.page = 0; root.search(); } }
                Button { text: "Refresh"; clicked => { root.search(); } }
            }
            CheckBox { text: "Limit to a map region"; checked <=> root.limit-bounds; toggled => { root.page = 0; root.search(); } }
            if root.limit-bounds: VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Minimum XYZ"; vertical-alignment: center; width: 120px; }
                    LineEdit { text <=> root.min-x; input-type: decimal; edited => { root.page = 0; root.search(); } }
                    LineEdit { text <=> root.min-y; input-type: decimal; edited => { root.page = 0; root.search(); } }
                    LineEdit { text <=> root.min-z; input-type: decimal; edited => { root.page = 0; root.search(); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Maximum XYZ"; vertical-alignment: center; width: 120px; }
                    LineEdit { text <=> root.max-x; input-type: decimal; edited => { root.page = 0; root.search(); } }
                    LineEdit { text <=> root.max-y; input-type: decimal; edited => { root.page = 0; root.search(); } }
                    LineEdit { text <=> root.max-z; input-type: decimal; edited => { root.page = 0; root.search(); } }
                }
            }
            Text { text: root.summary; }
            ListView {
                for row in root.rows: VerticalLayout {
                    spacing: 4px; padding-bottom: 12px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: row.label; horizontal-stretch: 1; vertical-alignment: center; }
                        Button { text: "Select"; clicked => { root.select-result(row.id, false); } }
                        Button { text: "Frame"; clicked => { root.select-result(row.id, true); } }
                    }
                    Text { text: row.detail; wrap: word-wrap; color: Theme.text-muted; font-size: Theme.font; }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Button { text: "Previous"; enabled: root.page > 0; clicked => { root.page -= 1; root.search(); } }
                Button { text: "Next"; enabled: root.has-next; clicked => { root.page += 1; root.search(); } }
                ComboBox { model: ["Replace selection", "Add to selection", "Remove from selection", "Toggle selection"]; current-index <=> root.selection-mode; }
                Button { text: "Select all matches"; clicked => { root.select-all(false); } }
                Button { text: "Frame all matches"; clicked => { root.select-all(true); } }
            }
            HorizontalLayout {
                spacing: 8px;
                Button { text: "Hide selected"; clicked => { root.visibility-action("hide"); } }
                Button { text: "Isolate selected"; clicked => { root.visibility-action("isolate"); } }
                Button { text: "Show selected"; clicked => { root.visibility-action("show"); } }
                Button { text: "Show all"; clicked => { root.visibility-action("show_all"); } }
                Button { text: "Restore visibility"; clicked => { root.visibility-action("restore"); } }
            }
            Text { text: "Hidden objects are saved as hidden and omitted from compilation."; wrap: word-wrap; color: Theme.text-muted; }
            Text { text: root.message; wrap: word-wrap; }
            Button { text: "Close"; clicked => { root.cancel(); } }
        }
    }
}

