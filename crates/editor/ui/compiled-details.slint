import { Theme } from "theme.slint";
import { Button, ComboBox, Slider, TextEdit } from "widgets.slint";

export component CompiledDetailsWindow inherits Window {
    background: Theme.panel;
    title: "Compiled details - HammeRR";
    preferred-width: 1000px;
    preferred-height: 720px;
    min-width: 720px;
    min-height: 540px;
    in property <string> state;
    in property <string> build-state;
    in property <string> rows;
    in property <string> page;
    in property <string> message;
    in property <bool> worker-active;
    in property <bool> has-token;
    in property <bool> previous;
    in property <bool> next;
    in-out property <int> lighting-index;
    in property <string> lighting-state;
    in-out property <int> lighting-channel-index;
    in-out property <float> exposure-ev;
    in property <[string]> style-options;
    in-out property <int> style-index;
    in-out property <float> style-gain;
    callback choose-style(int);
    callback apply-lighting();
    callback prepare-details();
    callback cancel-preparation();
    callback clear-details();
    callback show-details();
    callback hide-details();
    callback change-lighting(int);
    callback refresh-inspection();
    callback page-records(int);
    callback close-dialog();
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.close-dialog(); return accept; }
            return reject;
        }
        VerticalLayout {
            padding: Theme.space-xl;
            spacing: 10px;
            Text { text: "Final compiled details"; font-size: Theme.font-display; font-weight: 600; }
            Text { text: root.state; wrap: word-wrap; color: Theme.warning; }
            Text { text: root.build-state; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 8px;
                Button { text: "Prepare details"; enabled: !root.worker-active; clicked => { root.prepare-details(); } }
                Button { text: "Cancel preparation"; enabled: root.worker-active && root.has-token; clicked => { root.cancel-preparation(); } }
                Button { text: "Clear details"; enabled: root.has-token; clicked => { root.clear-details(); } }
            }
            HorizontalLayout {
                spacing: 8px;
                Button { text: "Show details"; enabled: root.has-token && !root.worker-active; clicked => { root.show-details(); } }
                Button { text: "Hide details"; enabled: root.has-token; clicked => { root.hide-details(); } }
                Rectangle { horizontal-stretch: 1; }
            }
            HorizontalLayout {
                spacing: 8px;
                Text { text: "Preview lighting"; vertical-alignment: center; }
                lighting := ComboBox {
                    model: ["Editor shading", "Baked LDR", "Baked radiance"];
                    current-index <=> root.lighting-index;
                    enabled: root.has-token && !root.worker-active;
                    selected(value) => { root.change-lighting(lighting.current-index); }
                }
                Text { text: root.lighting-state; wrap: word-wrap; horizontal-stretch: 1; }
            }
            if root.lighting-index == 2: VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Lighting channel"; vertical-alignment: center; }
                    ComboBox { model: ["LDR", "HDR"]; current-index <=> root.lighting-channel-index; enabled: root.has-token && !root.worker-active; }
                    Text { text: "Exposure (EV)"; vertical-alignment: center; }
                    Slider { minimum: -8; maximum: 8; value <=> root.exposure-ev; enabled: root.has-token && !root.worker-active; horizontal-stretch: 1; }
                    Text { text: "\{round(root.exposure-ev * 100) / 100}"; width: 55px; vertical-alignment: center; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Style"; vertical-alignment: center; }
                    styles := ComboBox { model: root.style-options; current-index <=> root.style-index; enabled: root.has-token && !root.worker-active && root.style-options.length > 0; selected => { root.choose-style(styles.current-index); } }
                    Text { text: "Style gain"; vertical-alignment: center; }
                    Slider { minimum: 0; maximum: 2; value <=> root.style-gain; enabled: root.has-token && !root.worker-active && root.style-options.length > 0; horizontal-stretch: 1; }
                    Text { text: "\{round(root.style-gain * 100) / 100}"; width: 55px; vertical-alignment: center; }
                    Button { text: "Apply lighting"; enabled: root.has-token && !root.worker-active; clicked => { root.apply-lighting(); } }
                }
                Text { text: "Set style gains and exposure, then Apply lighting. Runtime styles without a gain are off. Static light stays at full weight; dual builds retain separate LDR/HDR static colours when they differ."; wrap: word-wrap; color: Theme.text-muted; }
            }
            Text { text: "Shows final BSP placements. Baked radiance previews stored style contributions with editor tone mapping. Motion and native appearance are not simulated. Details cannot be selected."; wrap: word-wrap; color: Theme.text-muted; }
            HorizontalLayout {
                spacing: 8px;
                Button { text: "Refresh inspection"; clicked => { root.refresh-inspection(); } }
                Button { text: "Previous records"; enabled: root.previous; clicked => { root.page-records(-1); } }
                Button { text: "Next records"; enabled: root.next; clicked => { root.page-records(1); } }
                Text { text: root.page; vertical-alignment: center; }
            }
            TextEdit { text: root.rows; read-only: true; vertical-stretch: 1; }
            Text { text: root.message; wrap: word-wrap; color: Theme.warning; }
            HorizontalLayout {
                Rectangle { horizontal-stretch: 1; }
                Button { text: "Close"; clicked => { root.close-dialog(); } }
            }
        }
    }
}
