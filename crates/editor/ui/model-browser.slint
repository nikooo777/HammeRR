import { Theme } from "theme.slint";
import {Button, ComboBox, LineEdit, ListView, ScrollView, SpinBox, TextEdit} from "widgets.slint";

export struct ModelChoiceRow { path:string, name:string, folder:string, source:string }
export struct ModelBodygroupRow { index:int, label:string, choices:[string], selected:int }

export component ModelBrowserWindow inherits Window {
    background: Theme.panel;
    title:"Choose model — HammeRR";
    preferred-width:960px;
    preferred-height:min(900px,750px + root.bodygroups.length*58px);
    min-width:800px;
    min-height:690px;
    in-out property <string> query;
    in property <[string]> groups;
    in-out property <int> group-index;
    in property <[string]> source-labels;
    in-out property <int> source-index;
    in property <[ModelChoiceRow]> rows;
    in-out property <string> path;
    in-out property <int> skin;
    in-out property <int> body;
    in property <[ModelBodygroupRow]> bodygroups;
    in property <int> skin-count:1;
    in property <image> preview;
    in property <bool> has-preview;
    in property <bool> can-apply;
    in property <bool> can-previous;
    in property <bool> can-next;
    in property <string> page-info;
    in property <string> geometry;
    in property <string> dimensions;
    in property <string> provenance;
    in property <string> materials;
    in property <int> material-count;
    in-out property <bool> show-materials;
    in property <string> message;
    callback search();
    callback group-changed();
    callback page(int);
    callback choose(string);
    callback preview-model();
    callback bodygroup-changed(int,int);
    callback invalidate();
    callback resize-details();
    callback apply();
    callback cancel();
    forward-focus:dialog-focus;
    dialog-focus:=FocusScope {
        key-pressed(event)=>{if event.text==Key.Escape {root.cancel();accept} else {reject}}
        VerticalLayout {
            padding: Theme.space-xl;spacing:12px;
            Text {text:"Choose a model";font-size: Theme.font-display;font-weight:600;}
            HorizontalLayout {
                spacing:10px;
                LineEdit {text<=>root.query;placeholder-text:"Search model names or folders…";edited=>{root.search();}horizontal-stretch:1;}
                ComboBox {width:300px;model:root.groups;current-index<=>root.group-index;selected=>{root.group-changed();}}
            }
            HorizontalLayout {
                spacing:10px;
                Text {text:"Winning source";vertical-alignment:center;}
                ComboBox {horizontal-stretch:1;model:root.source-labels;current-index<=>root.source-index;selected=>{root.search();}}
            }
            HorizontalLayout {
                spacing:16px;vertical-stretch:1;
                VerticalLayout {
                    spacing:8px;horizontal-stretch:1;
                    ListView {
                        for row in root.rows:Rectangle {
                            height:72px;border-radius:5px;
                            background:root.path==row.path ? Theme.control-strong : touch.has-hover ? Theme.control-strong : Theme.hover;
                            VerticalLayout {
                                padding:8px;spacing:3px;
                                Text {text:row.name;color:Theme.text;overflow:elide;}
                                Text {text:row.folder;color:Theme.text-faint;font-size: Theme.font-small;overflow:elide;}
                                Text {text:row.source;color:Theme.text-faint;font-size:10px;overflow:elide;}
                            }
                            touch:=TouchArea {clicked=>{root.choose(row.path);}}
                        }
                    }
                    HorizontalLayout {
                        spacing:8px;
                        Button {text:"Previous";enabled:root.can-previous;clicked=>{root.page(-1);}}
                        Text {text:root.page-info;horizontal-alignment:center;vertical-alignment:center;horizontal-stretch:1;color:Theme.text-muted;}
                        Button {text:"Next";enabled:root.can-next;clicked=>{root.page(1);}}
                    }
                }
                VerticalLayout {
                    width:460px;spacing:10px;
                    Rectangle {
                        min-height:250px;vertical-stretch:1;background:Theme.control;border-radius:8px;clip:true;
                        if root.has-preview:Image {width:parent.width;height:parent.height;source:root.preview;image-fit:contain;}
                        if !root.has-preview:Text {width:parent.width;height:parent.height;text:"Select a model to preview it";horizontal-alignment:center;vertical-alignment:center;color:Theme.text-muted;}
                    }
                    if root.skin-count > 1:HorizontalLayout {
                        spacing:8px;
                        Text {text:"Skin";vertical-alignment:center;}
                        SpinBox {value<=>root.skin;minimum:0;maximum:max(0,root.skin-count - 1);edited=>{root.preview-model();}}
                        Text {text:"\{root.skin-count} skins";vertical-alignment:center;color:Theme.text-muted;horizontal-stretch:1;}
                    }
                    if root.skin-count <= 1:Text {text:"Default skin";color:Theme.text-muted;}
                    if root.bodygroups.length > 0:ScrollView {
                        height:min(130px,root.bodygroups.length*58px);
                        VerticalLayout {
                            spacing:8px;
                            for group in root.bodygroups:VerticalLayout {
                                spacing:4px;
                                Text {text:group.label;color:Theme.text-muted;}
                                ComboBox {model:group.choices;current-index:group.selected;selected=>{root.bodygroup-changed(group.index,self.current-index);}}
                            }
                        }
                    }
                    Text {text:root.geometry;wrap:word-wrap;}
                    Text {text:root.dimensions;wrap:word-wrap;color:Theme.text-muted;}
                    if root.provenance != "":TextEdit {text:root.provenance;read-only:true;height:76px;}
                    if root.material-count > 0:Button {text:root.show-materials ? "Hide materials" : "Show materials (\{root.material-count})";clicked=>{root.show-materials=!root.show-materials;root.resize-details();}}
                    if root.show-materials:TextEdit {text:root.materials;read-only:true;height:80px;}
                }
            }
            HorizontalLayout {
                spacing:8px;
                LineEdit {text<=>root.path;placeholder-text:"models/...mdl";horizontal-stretch:1;edited=>{root.invalidate();}accepted=>{root.preview-model();}}
                Button {text:"Preview model";clicked=>{root.preview-model();}}
            }
            Text {text:root.message;wrap:word-wrap;color:Theme.text-muted;min-height:32px;}
            HorizontalLayout {
                spacing:8px;
                Button {text:"Cancel";clicked=>{root.cancel();}}
                Rectangle {horizontal-stretch:1;}
                Text {text:"Scale 1";vertical-alignment:center;color:Theme.text-faint;font-size: Theme.font;}
                Button {text:"Use model";enabled:root.can-apply;clicked=>{root.apply();}}
            }
        }
    }
}
