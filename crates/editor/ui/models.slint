import { Theme } from "theme.slint";
import {Button, CheckBox, ComboBox, ListView} from "widgets.slint";

export component ModelWindow inherits Window {
    background: Theme.panel;
    title:"Model details";
    preferred-width:620px;
    preferred-height:min(850px, 340px + root.materials.length * 20px + root.bodygroups.length * 40px + (root.attachments.length>0 ? 170px : 0px));
    in property <string> model-path;
    in property <string> geometry;
    in property <string> skin-info;
    in property <string> bounds;
    in property <string> pose-info;
    in property <[string]> materials;
    in property <[string]> bodygroups;
    in property <[string]> attachments;
    in-out property <int> attachment-index:0;
    in property <string> attachment-info;
    in-out property <bool> show-axes:false;
    in property <float> aspect:1;
    in property <string> message;
    callback reload();
    callback cancel();
    callback attachment-changed();
    callback show-attachment();
    callback frame-attachment();
    forward-focus:dialog-focus;
    dialog-focus:=FocusScope {
        key-pressed(event)=>{if event.text==Key.Escape {root.cancel();accept} else {reject}}
        VerticalLayout {
            padding: Theme.space-xl;spacing:12px;
            Text {text:root.model-path;wrap:word-wrap;font-size: Theme.font-heading;}
            Text {text:root.geometry;wrap:word-wrap;}
            Text {text:root.skin-info;wrap:word-wrap;}
            Text {text:root.bounds;wrap:word-wrap;color:Theme.text-muted;}
            Text {text:"Skin materials";}
            ListView {vertical-stretch:1;for material in root.materials:Text {text:material;wrap:word-wrap;color:Theme.text-muted;}}
            if root.bodygroups.length > 0:VerticalLayout {
                spacing:6px;
                for group in root.bodygroups:Text {text:group;wrap:word-wrap;color:Theme.text-muted;}
            }
            if root.attachments.length > 0:VerticalLayout {
                spacing:8px;
                Text {text:"Attachment";}
                ComboBox {model:root.attachments;current-index<=>root.attachment-index;selected=>{root.attachment-changed();}}
                Text {text:root.attachment-info;wrap:word-wrap;color:Theme.text-muted;}
                HorizontalLayout {
                    spacing:8px;
                    CheckBox {text:"Show attachment axes";checked<=>root.show-axes;toggled=>{root.show-attachment();}}
                    Button {text:"Frame attachment";clicked=>{root.frame-attachment();}}
                }
                Text {text:"Reference pose · X red · Y green · Z blue";font-size: Theme.font;color:Theme.text-faint;}
            }
            Text {text:root.pose-info;wrap:word-wrap;font-size: Theme.font;color:Theme.text-muted;}
            Text {text:root.message;wrap:word-wrap;color:Theme.text-faint;}
            HorizontalLayout {
                spacing:8px;
                Button {text:"Cancel";clicked=>{root.cancel();}}
                Button {text:"Reload models";clicked=>{root.reload();}}
            }
        }
    }
}
