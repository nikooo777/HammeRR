import { Theme } from "theme.slint";
import { Button, ComboBox, ListView, ScrollView, SpinBox, TextEdit } from "widgets.slint";

export component BakedPropVerticesWindow inherits Window {
    background: Theme.panel;
    title: "Baked prop vertices - HammeRR";
    width: 1020px;
    height: 900px;
    in-out property <string> channel: "LDR";
    in-out property <int> prop-limit: 32;
    in property <float> aspect: 1;
    in property <bool> can-frame;
    in property <bool> can-select-source;
    in property <bool> can-show-leaf-bounds;
    in property <bool> can-clear-leaf-bounds;
    in property <string> leaf-bounds-state;
    in property <string> source-selection-label: "Select source";
    in property <string> build-state;
    in property <string> channels;
    in property <string> selected;
    in property <string> statistics;
    in property <string> diagnostics;
    in property <[string]> prop-rows;
    in property <[string]> section-rows;
    in property <[string]> vertex-rows;
    in property <string> prop-page;
    in property <string> section-page;
    in property <string> vertex-page;
    in property <bool> previous-props;
    in property <bool> next-props;
    in property <bool> previous-sections;
    in property <bool> next-sections;
    in property <bool> previous-vertices;
    in property <bool> next-vertices;
    callback refresh-inspection();
    callback change-channel();
    callback inspect-prop(int);
    callback inspect-section(int);
    callback page-props(int);
    callback page-sections(int);
    callback page-vertices(int);
    callback frame-prop-origin();
    callback select-source();
    callback show-leaf-bounds();
    callback clear-leaf-bounds();
    callback close-dialog();
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => { if event.text == Key.Escape { root.close-dialog(); accept } else { reject } }
        VerticalLayout {
            ScrollView {
                content-width: self.width;
                VerticalLayout {
                    padding: 20px;
                    spacing: 10px;
                    Text { text: "Baked prop vertices"; font-size: 24px; font-weight: 600; }
                    Text { text: root.build-state; wrap: word-wrap; color: Theme.warning; }
                    Text { text: root.channels; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Channel"; vertical-alignment: center; }
                        ComboBox { model: ["LDR", "HDR"]; current-value <=> root.channel; selected(value) => { root.change-channel(); } }
                        Text { text: "Props per page"; vertical-alignment: center; }
                        SpinBox { minimum: 1; maximum: 32; value <=> root.prop-limit; edited => { root.refresh-inspection(); } }
                        Button { text: "Refresh inspection"; clicked => { root.refresh-inspection(); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Text { text: "Compiled props"; font-size: 18px; font-weight: 600; }
                    Text { text: root.prop-page; }
                    ListView {
                        height: 110px;
                        for row[i] in root.prop-rows: Button { text: row; clicked => { root.inspect-prop(i); } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: "Previous props"; enabled: root.previous-props; clicked => { root.page-props(-1); } }
                        Button { text: "Next props"; enabled: root.next-props; clicked => { root.page-props(1); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Text { text: "Hardware sections"; font-size: 18px; font-weight: 600; }
                    Text { text: root.section-page; }
                    ListView {
                        height: 85px;
                        for row[i] in root.section-rows: Button { text: row; clicked => { root.inspect-section(i); } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: "Previous sections"; enabled: root.previous-sections; clicked => { root.page-sections(-1); } }
                        Button { text: "Next sections"; enabled: root.next-sections; clicked => { root.page-sections(1); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Text { text: root.selected; wrap: word-wrap; }
                    Button { text: "Frame prop origin"; enabled: root.can-frame; clicked => { root.frame-prop-origin(); } }
                    Button { text: root.source-selection-label; enabled: root.can-select-source; clicked => { root.select-source(); } }
                    Text { text: "Frames a 32-unit box around the emitted native origin, not model or collision bounds. Selection stays unchanged."; wrap: word-wrap; color: Theme.text-muted; }
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: "Show leaf bounds"; enabled: root.can-show-leaf-bounds; clicked => { root.show-leaf-bounds(); } }
                        Button { text: "Clear leaf bounds"; enabled: root.can-clear-leaf-bounds; clicked => { root.clear-leaf-bounds(); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Text { text: root.leaf-bounds-state; wrap: word-wrap; }
                    Text { text: "Purple boxes show every native leaf membership bound for this prop. These conservative bounds do not show its exact mesh or runtime visibility. The cyan visibility guide is separate."; wrap: word-wrap; color: Theme.text-muted; }
                    Text { text: "Vertex colors"; font-size: 18px; font-weight: 600; }
                    Text { text: "Local index · hardware index · R · G · B · A"; }
                    Text { text: root.vertex-page; }
                    ListView {
                        height: 150px;
                        for row in root.vertex-rows: Text { text: row; font-family: "monospace"; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: "Previous vertices"; enabled: root.previous-vertices; clicked => { root.page-vertices(-1); } }
                        Button { text: "Next vertices"; enabled: root.next-vertices; clicked => { root.page-vertices(1); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Text { text: root.statistics; wrap: word-wrap; }
                    Text { text: "Stored encoded RGB bytes, range 0–255. HDR is baked independently with the same byte encoding. Values do not measure linear irradiance or game screen brightness. Native ordinals and hardware rows belong to this build. Source addresses describe captured authored entities and helper routes. Select source replaces selection with the current root entity or its outer containing reference in Objects mode; it does not expand groups, unhide objects or open children. Reading rows and framing preserve selection."; wrap: word-wrap; color: Theme.text-muted; }
                    TextEdit { text: root.diagnostics; read-only: true; min-height: 65px; max-height: 100px; }
                }
            }
            HorizontalLayout {
                padding: 16px;
                Rectangle { horizontal-stretch: 1; }
                Button { text: "Close"; clicked => { root.close-dialog(); } }
            }
        }
    }
}
